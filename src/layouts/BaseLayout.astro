---
import '~/styles/global.css';
import BaseHead, { type Props as HeadProps } from '~/components/seo/BaseHead.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import { organizationLd, websiteLd } from '~/lib/schema';
import { warnMissingOnce } from '~/config/site';
import { isSamplePage } from '~/lib/sample';

warnMissingOnce();

export interface Props extends HeadProps {
  /** Adds WebSite markup (homepage only). */
  includeWebsiteLd?: boolean;
}

const { includeWebsiteLd = false, jsonLd = [], noindex, ...head } = Astro.props;
// Pages still holding dummy text are labelled and kept out of search (src/lib/sample.ts).
const sample = isSamplePage(Astro.url.pathname);
const graph = [organizationLd(Astro.site), ...(includeWebsiteLd ? [websiteLd(Astro.site)] : []), ...jsonLd];
---

<!doctype html>
<html lang="fa" dir="rtl" class="no-js">
  <head>
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <BaseHead {...head} noindex={noindex || sample} jsonLd={graph} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">پرش به محتوای اصلی</a>
    <Header />
    {
      sample && (
        <p class="sample-notice" role="note">
          <strong>محتوای نمونه:</strong> متن و اعداد این صفحه موقت‌اند و به‌زودی با اطلاعات واقعی اوکیان جایگزین می‌شوند.
        </p>
      )
    }
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '~/scripts/reveal';
    </script>
  </body>
</html>
