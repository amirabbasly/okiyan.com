---
/**
 * Commodity page — one kind of cargo, one commercial intent.
 *
 * The shell is the same two-column guide layout used by /imports/<id>/ so the
 * reading experience and the CSS budget stay identical. On top of it this
 * template adds the three blocks a buyer of THIS cargo actually needs:
 * the tariff headings, the device licences, and the cost drivers.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/layout/PageHero.astro';
import CtaBand from '~/components/ui/CtaBand.astro';
import Icon from '~/components/ui/Icon.astro';
import ClusterNav from '~/components/ui/ClusterNav.astro';
import { articleLd, breadcrumbLd, faqLd, serviceLd } from '~/lib/schema';
import { formatFaDate, readingMinutes, toFa } from '~/lib/format';
import { companyPhones, isProduction } from '~/config/site';

export async function getStaticPaths() {
  const items = await getCollection('goods');
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const all = await getCollection('goods');
const others = all.filter((g) => g.id !== entry.id).sort((a, b) => a.data.order - b.data.order);
const guides = (await getCollection('guides')).filter((g) => entry.data.relatedGuides.includes(g.id));
const offices = (await getCollection('customs')).filter((o) => entry.data.relatedOffices.includes(o.id));
const origins = (await getCollection('origins')).filter((o) => entry.data.relatedOrigins.includes(o.id));
const path = `/goods/${entry.id}/`;
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'واردات بر اساس کالا', path: '/goods/' },
  { name: entry.data.navTitle, path },
];
const updated = entry.data.updatedDate ?? entry.data.publishDate;
const minutes = readingMinutes(entry.body ?? '');
const toc = headings.filter((h) => h.depth === 2);
const phone = companyPhones[0];
const title = entry.data.seoTitle ?? entry.data.title;
---

<BaseLayout
  title={title}
  description={entry.data.description}
  ogType="article"
  publishedTime={entry.data.publishDate}
  modifiedTime={updated}
  jsonLd={
    [
      breadcrumbLd(crumbs, Astro.site),
      serviceLd(
        {
          name: `واردات و ترخیص ${entry.data.product}`,
          description: entry.data.description,
          path,
          serviceType: 'واردات و ترخیص کالا',
        },
        Astro.site,
      ),
      articleLd(
        {
          title: entry.data.title,
          description: entry.data.description,
          path,
          published: entry.data.publishDate,
          modified: entry.data.updatedDate,
          keywords: entry.data.keywords,
          section: 'واردات بر اساس کالا',
          wordCount: entry.body ? entry.body.trim().split(/\s+/).length : undefined,
          about: [entry.data.product, 'واردات کالا', 'ترخیص کالا'],
        },
        Astro.site,
      ),
      faqLd(entry.data.faq, path, Astro.site),
    ].filter((x) => x !== null)
  }
>
  <PageHero eyebrow={`کالای هدف: ${entry.data.product}`} title={entry.data.title} lead={entry.data.description} crumbs={crumbs}>
    <p class="guide-meta">
      <span>به‌روزرسانی: <time datetime={updated.toISOString().slice(0, 10)}>{formatFaDate(updated)}</time></span>
      <span>زمان مطالعه: حدود {toFa(minutes)} دقیقه</span>
    </p>
  </PageHero>

  <div class="container guide">
    <aside class="guide__aside" aria-label="خلاصه و فهرست مطالب">
      <div class="guide__summary">
        <h2>خلاصه در چند خط</h2>
        <ul class="checklist">
          {entry.data.summary.map((s) => <li>{s}</li>)}
        </ul>
      </div>

      {
        entry.data.hs.length > 0 && (
          <nav class="guide__toc" aria-labelledby="hs-title">
            <h2 id="hs-title">سرفصل‌های تعرفه</h2>
            <ul class="hs-mini">
              {entry.data.hs.map((h) => (
                <li>
                  <code dir="ltr">{h.code}</code>
                  <span>{h.label}</span>
                </li>
              ))}
            </ul>
            <p class="hs-mini__more">
              <a href="/hs-code/">جدول کامل فصل‌های HS</a>
            </p>
          </nav>
        )
      }

      {
        toc.length > 2 && (
          <nav class="guide__toc" aria-labelledby="toc-title">
            <h2 id="toc-title">در این صفحه</h2>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </aside>

    <article class="guide__body">
      {
        entry.data.answer && (
          <section class="guide__answer" aria-labelledby="answer-title">
            <h2 id="answer-title">پاسخ کوتاه</h2>
            <p>{entry.data.answer}</p>
          </section>
        )
      }

      {
        entry.data.permits.length > 0 && (
          <section class="permit-box" aria-labelledby="permits-title">
            <h2 id="permits-title">
              <Icon name="shield" />
              مجوزهایی که معمولاً برای {entry.data.product} لازم می‌شود
            </h2>
            <ul class="checklist">
              {entry.data.permits.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
            <p class="permit-box__note">
              فهرست مجوزها به شرح دقیق کالا و کاربری آن بستگی دارد. مرجع رسمی هر مجوز در
              <a href="/official-sources/">فهرست سامانه‌های رسمی</a> آمده است و برای پروندهٔ شما در
              <a href="/guides/import-permits/">راهنمای مجوزهای واردات</a> توضیح داده شده.
            </p>
          </section>
        )
      }

      <div class="prose">
        <Content />
      </div>

      {
        entry.data.costDrivers.length > 0 && (
          <section class="cost-box" aria-labelledby="cost-title">
            <h2 id="cost-title">
              <Icon name="calc" />
              چه چیزی هزینهٔ پروندهٔ {entry.data.product} را بالا می‌برد
            </h2>
            <ul class="cost-box__list">
              {entry.data.costDrivers.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
            <p class="cost-box__note">
              این صفحه عدد و نرخ اعلام نمی‌کند؛ چون ماخذ حقوق ورودی و نرخ ارز مبنای محاسبه، هر دو متغیرند. ساختار هزینه را در
              <a href="/customs-clearance/cost/">اجزای هزینهٔ ترخیص</a> ببینید، نرخ ارز مبنای محاسبه را در
              <a href="/customs-exchange-rate/">نرخ ارز گمرکی</a> و فرمول محاسبه را در
              <a href="/price-calculator/">ماشین‌حساب هزینه</a> دنبال کنید.
            </p>
          </section>
        )
      }

      {
        entry.data.faq.length > 0 && (
          <section class="guide__faq" id="faq" aria-labelledby="faq-title">
            <h2 id="faq-title">پرسش‌های رایج دربارهٔ {entry.data.navTitle}</h2>
            {entry.data.faq.map((item) => (
              <details class="faq-item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </section>
        )
      }

      {
        origins.length > 0 && (
          <section class="guide__sources" aria-labelledby="origin-title">
            <h2 id="origin-title">مبدأهای رایج این کالا</h2>
            <ul class="related-list">
              {origins.map((o) => (
                <li>
                  <a href={`/imports/${o.id}/`}>{o.data.navTitle}</a>
                  <span class="muted"> — {o.data.country}</span>
                </li>
              ))}
              <li>
                <a href="/imports/">همهٔ مبدأها</a>
              </li>
            </ul>
          </section>
        )
      }

      {
        offices.length > 0 && (
          <section class="guide__sources" aria-labelledby="offices-title">
            <h2 id="offices-title">گمرک‌هایی که این کالا از آن‌ها وارد می‌شود</h2>
            <ul class="related-list">
              {offices.map((o) => (
                <li>
                  <a href={`/customs/${o.id}/`}>{o.data.office}</a>
                  <span class="muted"> — {o.data.city}</span>
                </li>
              ))}
              <li>
                <a href="/customs/">همهٔ گمرکات و بنادر</a>
              </li>
            </ul>
          </section>
        )
      }

      {
        guides.length > 0 && (
          <section class="guide__sources" aria-labelledby="more-title">
            <h2 id="more-title">راهنماهای مرتبط</h2>
            <ul class="related-list">
              {guides.map((g) => (
                <li>
                  <a href={`/guides/${g.id}/`}>{g.data.navTitle}</a>
                  <span class="muted"> — {g.data.description}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="guide__sources" aria-labelledby="other-title">
        <h2 id="other-title">کالاهای دیگر</h2>
        <ul class="related-list">
          {others.map((g) => (
            <li>
              <a href={`/goods/${g.id}/`}>{g.data.navTitle}</a>
              <span class="muted"> — {g.data.product}</span>
            </li>
          ))}
          <li>
            <a href="/goods/">همهٔ کالاها</a>
          </li>
        </ul>
      </section>

      <ClusterNav
        siblings={[
          ...others.slice(0, 4).map((g) => ({ href: `/goods/${g.id}/`, label: g.data.navTitle })),
          ...guides.map((g) => ({ href: `/guides/${g.id}/`, label: g.data.navTitle })),
          ...offices.map((o) => ({ href: `/customs/${o.id}/`, label: `گمرک ${o.data.city}` })),
        ]}
      />

      <div class="notice guide__disclaimer">
        <Icon name="info" />
        <p>
          <strong>این صفحه یک راهنمای عملی است، نه اعلام رویهٔ رسمی.</strong> کد تعرفه، شرط تجاری و مجوزهای هر کالا با
          اصلاحیهٔ سالانهٔ کتاب مقررات صادرات و واردات تغییر می‌کند. پیش از خرید، وضعیت همان کالا را با منابع رسمی یا یک
          کارشناس بررسی کنید.
          {
            phone && (
              <>
                {' '}
                برای بررسی پرونده: <a href={`tel:${phone.e164}`} dir="ltr">{phone.display}</a>
              </>
            )
          }
        </p>
      </div>

      {
        entry.data.sources.length > 0 && (
          <section class="guide__sources" aria-labelledby="sources-title">
            <h2 id="sources-title">منابع و مراجع</h2>
            <ol>
              {entry.data.sources.map((s) => (
                <li>
                  <a href={s.url} rel="noopener" target="_blank">
                    {s.title}
                    <Icon name="external" />
                    <span class="sr-only">(در پنجرهٔ جدید)</span>
                  </a>
                  <span class="muted"> — {s.publisher}</span>
                  {s.note && <p class="muted">{s.note}</p>}
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {
        !isProduction && entry.data.reviewNotes.length > 0 && (
          <section class="placeholder guide__review" aria-label="موارد نیازمند بازبینی">
            <strong>پیش از انتشار بازبینی شود (فقط در نسخهٔ آزمایشی نمایش داده می‌شود):</strong>
            <ul>
              {entry.data.reviewNotes.map((n) => (
                <li>{n}</li>
              ))}
            </ul>
          </section>
        )
      }
    </article>
  </div>

  <CtaBand
    title={`پروندهٔ ${entry.data.product} در دست دارید؟`}
    text="شرح کالا، کد تعرفهٔ پیشنهادی فروشنده و مبدأ را بفرستید؛ پیش از ثبت سفارش، مجوزها، مسیر حمل و اجزای هزینه را برای همان پرونده روشن می‌کنیم."
  />
</BaseLayout>

<style>
  /* Same two-column shell as /imports/<id>/ — kept local so nothing else moves. */
  .guide-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .guide-meta span + span::before {
    content: '';
    display: inline-block;
    inline-size: 4px;
    block-size: 4px;
    border-radius: 50%;
    background: var(--petrol-500);
    margin-inline-end: 1.5rem;
    vertical-align: middle;
    margin-inline-start: -1rem;
  }
  .guide {
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 46rem);
    justify-content: space-between;
    gap: 3rem 4rem;
    padding-block: clamp(2.5rem, 2rem + 3vw, 5rem);
  }
  .guide__aside {
    display: grid;
    gap: 2rem;
    align-content: start;
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    align-self: start;
  }
  .guide__aside h2 {
    font-size: var(--step-0);
    font-weight: 800;
    margin-bottom: 0.9rem;
  }
  .guide__summary {
    padding: 1.4rem;
    border-radius: var(--radius-m);
    background: var(--mist-100);
    border: 1px solid var(--rule);
    font-size: var(--step--1);
    line-height: 1.85;
  }
  .guide__summary .checklist li::before {
    margin-top: 0.25rem;
  }
  .guide__toc ol {
    list-style: none;
    border-inline-start: 2px solid var(--rule);
    display: grid;
    gap: 0.15rem;
    font-size: var(--step--1);
  }
  .guide__toc a {
    display: block;
    padding: 0.35rem 1rem;
    margin-inline-start: -2px;
    border-inline-start: 2px solid transparent;
    color: var(--text-muted);
    text-decoration: none;
    line-height: 1.7;
    transition:
      color var(--dur-fast) ease,
      border-color var(--dur-fast) ease;
  }
  .guide__toc a:hover {
    color: var(--navy-900);
    border-color: var(--petrol-300);
  }
  .hs-mini {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
    font-size: var(--step--1);
  }
  .hs-mini li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
  }
  .hs-mini code {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--petrol-600);
    background: var(--white);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 0.05rem 0.35rem;
  }
  .hs-mini span {
    color: var(--text-muted);
    line-height: 1.6;
  }
  .hs-mini__more {
    margin: 0.8rem 0 0;
    font-size: var(--step--1);
  }
  .guide__answer {
    padding: 1.4rem 1.6rem;
    border-radius: var(--radius-m);
    background: var(--white);
    border: 1px solid var(--rule);
    border-inline-start: 4px solid var(--petrol-500);
  }
  .guide__answer h2 {
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--petrol-600);
    margin-bottom: 0.5rem;
  }
  .guide__answer p {
    margin: 0;
    font-size: var(--step-0);
    line-height: 1.9;
    color: var(--navy-800);
  }
  .permit-box,
  .cost-box {
    padding: 1.4rem 1.6rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--mist-50);
  }
  .permit-box h2,
  .cost-box h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step-1);
    margin-bottom: 0.9rem;
  }
  .permit-box h2 :global(svg),
  .cost-box h2 :global(svg) {
    inline-size: 1.15em;
    block-size: 1.15em;
    color: var(--petrol-600);
  }
  .permit-box .checklist {
    font-size: var(--step--1);
    line-height: 1.85;
  }
  .cost-box__list {
    margin: 0;
    padding-inline-start: 1.2rem;
    display: grid;
    gap: 0.5rem;
    font-size: var(--step--1);
    line-height: 1.85;
  }
  .permit-box__note,
  .cost-box__note {
    margin: 1rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--rule-strong);
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.85;
  }
  .guide__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    align-content: start;
  }
  .guide__body .prose > :global(:first-child) {
    margin-top: 0;
  }
  .guide__body .prose :global(h2) {
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }
  .guide__sources h2 {
    font-size: var(--step-2);
    margin-bottom: 1rem;
  }
  .guide__sources ol {
    padding-inline-start: 1.3rem;
    display: grid;
    gap: 0.9rem;
    font-size: var(--step--1);
  }
  .guide__sources a {
    font-weight: 700;
    color: var(--navy-800);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .guide__sources a :global(svg) {
    inline-size: 0.95em;
    block-size: 0.95em;
  }
  .guide__faq {
    margin-top: 0.5rem;
  }
  .faq-item {
    border-bottom: 1px solid var(--rule);
  }
  .faq-item summary {
    cursor: pointer;
    padding: 0.9rem 0;
    font-weight: 700;
  }
  .faq-item p {
    margin: 0 0 1rem;
    color: var(--slate-700);
  }
  .related-list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 960px) {
    .guide {
      grid-template-columns: minmax(0, 1fr);
    }
    .guide__aside {
      position: static;
    }
  }
</style>
