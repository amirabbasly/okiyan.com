---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/layout/PageHero.astro';
import ConsultForm from '~/components/forms/ConsultForm.astro';
import ContactArt from '~/components/illustrations/ContactArt.astro';
import Icon from '~/components/ui/Icon.astro';
import Placeholder from '~/components/ui/Placeholder.astro';
import { breadcrumbLd } from '~/lib/schema';
import { site, contactChannels, companyPhones, formattedAddress } from '~/config/site';

const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'درخواست مشاوره', path: '/contact/' },
];
const channels = contactChannels();
// Numbers get their own list below, so the channel list carries the other ways in.
const otherChannels = channels.filter((c) => c.channel !== 'phone');
const iconFor = { phone: 'phone', whatsapp: 'chat', telegram: 'send', email: 'mail' } as const;
---

<BaseLayout
  title="درخواست مشاوره ترخیص و واردات کالا"
  description="فرم استعلام قیمت: مشخصات کالا، مرحلهٔ محموله و فهرست عدل‌بندی را بفرستید تا دربارهٔ مدارک لازم، هزینه‌های قابل انتظار و قدم بعدی ترخیص یا واردات کالا صحبت کنیم."
  jsonLd={[breadcrumbLd(crumbs, Astro.site)]}
>
  <PageHero
    eyebrow="مشاوره"
    title="درخواست مشاوره"
    lead="مشخصات کالا، مرحلهٔ محموله و فهرست عدل‌بندی را بفرستید. فیلدهای ستاره‌دار الزامی‌اند؛ کد تعرفه، حجم، وزن، ارزش دلاری و CBM را اگر می‌دانید جداگانه بنویسید تا برآورد دقیق‌تری بگیرید."
    crumbs={crumbs}
  >
    <ContactArt slot="art" />
  </PageHero>

  <section class="section">
    <div class="container contact">
      <div class="contact__form">
        <h2 class="sr-only">فرم درخواست مشاوره</h2>
        <ConsultForm />
      </div>

      <aside class="contact__aside" aria-label="راه‌های تماس و روند پاسخ‌گویی">
        <section class="side-card" aria-labelledby="direct-title">
          <h2 id="direct-title">تماس مستقیم</h2>
          <ul class="channels">
            {
              companyPhones.map((p) => (
                <li>
                  <a href={`tel:${p.e164}`} class="channel">
                    <Icon name="phone" />
                    <span>
                      <span class="channel__label">{p.kind === 'mobile' ? 'تلفن همراه' : 'تلفن دفتر'}</span>
                      <span class="channel__value" dir="ltr">
                        {p.display}
                      </span>
                    </span>
                  </a>
                </li>
              ))
            }
            {
              otherChannels.map((c) => (
                <li>
                  <a href={c.href} class="channel" rel={c.channel === 'whatsapp' || c.channel === 'telegram' ? 'noopener' : undefined}>
                    <Icon name={iconFor[c.channel]} />
                    <span>
                      <span class="channel__label">{c.label}</span>
                      <span class="channel__value" dir={c.channel === 'email' ? 'ltr' : undefined}>
                        {c.value}
                      </span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          {site.contact.hours && <p class="muted">ساعات پاسخ‌گویی: {site.contact.hours}</p>}
          <Placeholder field="واتس‌اپ، تلگرام، ایمیل و ساعات پاسخ‌گویی (contact)" />
        </section>

        {
          formattedAddress() && (
            <section class="side-card" aria-labelledby="office-title">
              <h2 id="office-title">نشانی دفتر</h2>
              <address class="office">
                <Icon name="pin" />
                <span>{formattedAddress()}</span>
              </address>
            </section>
          )
        }

        <section class="side-card side-card--dark on-dark" aria-labelledby="next-title">
          <h2 id="next-title">بعد از ارسال چه می‌شود؟</h2>
          <ol class="next">
            <li><strong>بررسی اطلاعات</strong> — مشخصات کالا و مرحلهٔ محموله را بررسی می‌کنیم.</li>
            <li><strong>پرسش‌های تکمیلی</strong> — اگر سند یا اطلاعاتی لازم باشد، از راه ارتباطی شما می‌پرسیم.</li>
            <li><strong>برآورد و پیشنهاد</strong> — برآورد هزینه و دامنهٔ کار را دریافت می‌کنید؛ تصمیم با شماست.</li>
          </ol>
        </section>

        <section class="side-card" aria-labelledby="privacy-title">
          <h2 id="privacy-title">حریم خصوصی</h2>
          <p class="muted">
            اطلاعات و فایل این فرم فقط برای بررسی و پاسخ به همین درخواست استفاده می‌شود. برای فهرست عدل‌بندی همین فایل کافی است؛ اسناد محرمانهٔ دیگر (قرارداد،
            اسناد بانکی یا مدارک هویتی) را اینجا نفرستید — پس از تماس، راه امن ارسال آن‌ها را هماهنگ می‌کنیم.
          </p>
        </section>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .contact__form {
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--mist-100);
  }
  .contact__aside {
    display: grid;
    gap: 1.25rem;
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }
  .side-card {
    display: grid;
    gap: 0.9rem;
    padding: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
  }
  .side-card h2 {
    font-size: var(--step-1);
    font-weight: 800;
  }
  .side-card--dark {
    background: var(--navy-900);
    color: #c5cbd2;
    border-color: var(--navy-900);
  }
  .side-card--dark h2,
  .side-card--dark strong {
    color: var(--white);
  }
  .channels {
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .channel {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-m);
    text-decoration: none;
    transition: border-color var(--dur-fast) ease, background-color var(--dur-fast) ease;
  }
  .channel:hover {
    border-color: var(--navy-900);
    background: var(--mist-100);
  }
  .channel :global(svg) {
    color: var(--petrol-500);
  }
  .channel > span {
    display: grid;
    line-height: 1.5;
  }
  .channel__label {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .channel__value {
    font-weight: 700;
  }
  .office {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
    font-style: normal;
    line-height: 1.9;
  }
  .office :global(svg) {
    margin-top: 0.3rem;
    color: var(--petrol-500);
  }
  .next {
    padding-inline-start: 1.2rem;
    display: grid;
    gap: 0.7rem;
    font-size: var(--step--1);
  }
  .next li::marker {
    color: var(--petrol-200);
    font-weight: 800;
  }
  @media (max-width: 960px) {
    .contact {
      grid-template-columns: 1fr;
    }
    .contact__aside {
      position: static;
    }
  }
</style>
