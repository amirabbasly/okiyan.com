  .prep-slide {
    grid-area: 1 / 1;
    justify-self: start; /* RTL: flush with the card's right edge */
    inline-size: calc(100% - var(--prep-peek));
    min-inline-size: 0;
    display: grid;
    gap: 0.8rem;
    justify-items: start;
    align-content: start;
    padding: 1.4rem;
    border: 1px solid var(--rule);
    border-radius: 0.9rem;
    background: var(--white);
    box-shadow: 0 26px 44px -32px rgb(0 12 30 / 0.55);
    visibility: hidden;
    opacity: 0;
    /* the waiting slot: beside the front box, a little lower — so it rises in */
    transform: translate(calc(-1 * var(--prep-peek)), 1.1rem) scale(0.97);
    transition:
      transform 680ms var(--prep-ease),
      opacity 420ms ease;
  }
  .prep-slide.is-active {
    z-index: 2;
    visibility: visible;
    opacity: 1;
    transform: none;
  }
  .prep-slide.is-next {
    z-index: 1;
    visibility: visible;
    opacity: 0.5;
    pointer-events: none;
  }
  .prep-slide.is-out {
    z-index: 3;
    visibility: visible;
    opacity: 0;
    transform: translate(3.4rem, -0.6rem) scale(0.99);
    pointer-events: none;
    /* it fades before it reaches the card's edge, so the clip is never seen */
    transition:
      transform 680ms var(--prep-ease),
