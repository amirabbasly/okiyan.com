<script>
  /* Intro video: the source slot stays empty in the markup (data-video-src).
     As soon as a path is filled in, the play button loads and plays it. */
  /* prepare slider: buttons page through, the peeking slice marks what's next */
  /* ---- prepare deck: the front box hands over to the one waiting beside it ---- */
  const stage = document.querySelector<HTMLElement>('[data-prep-stage]');
  if (stage) {
    const slides = Array.from(stage.querySelectorAll<HTMLElement>('.prep-slide'));
    const counter = document.querySelector<HTMLElement>('[data-prep-count]');
    const total = slides.length;
    const HANDOVER = 700; /* matches the transform transition */
    const fa = (n: number) => String(n).replace(/[0-9]/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[Number(d)]);
    let idx = 0;
    let busy = false;

    /** one box in front, the following one peeking; the rest stay out of sight */
    const paint = (skip?: HTMLElement) => {
      slides.forEach((el, k) => {
        if (el === skip) {
          el.inert = true;
          el.setAttribute('aria-hidden', 'true');
          return;
        }
        const rel = (k - idx + total) % total;
        el.classList.toggle('is-active', rel === 0);
        el.classList.toggle('is-next', rel === 1);
        el.inert = rel !== 0;
        el.setAttribute('aria-hidden', rel === 0 ? 'false' : 'true');
      });
      if (counter) counter.textContent = `${fa(idx + 1)} / ${fa(total)}`;
    };

    const go = (step: number) => {
      if (busy || total < 2) return;
      busy = true;
      const out = slides[idx];
      idx = (idx + step + total) % total;
      /* the old box drifts out while the new one rises into its place */
      out.classList.remove('is-active');
      out.classList.add('is-out');
      paint(out);
      window.setTimeout(() => {
        out.classList.remove('is-out');
        paint();
        busy = false;
      }, HANDOVER);
    };

    document.querySelector('[data-prep-next]')?.addEventListener('click', () => go(1));
    document.querySelector('[data-prep-prev]')?.addEventListener('click', () => go(-1));

    /* swipe and arrow keys page the deck too */
    let startX = 0;
    let startY = 0;
    stage.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      startY = e.clientY;
    });
    stage.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
      go(dx < 0 ? 1 : -1); /* RTL: dragging left reveals the next box */
    });
    stage.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      go(e.key === 'ArrowLeft' ? 1 : -1);
    });

    /* the deck rises as the band scrolls into view */
    if ('IntersectionObserver' in window && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            stage.classList.add('is-entering');
            window.setTimeout(() => stage.classList.remove('is-entering'), 1080);
            io.disconnect();
          }
        },
        { threshold: 0.3 },
      );
      io.observe(stage);
    }
    paint();
  }

  const prinVideo = document.querySelector('.prin-video');
  if (prinVideo) {
    const player = prinVideo.querySelector('video');
    const play = prinVideo.querySelector('.prin-video__play');
    play?.addEventListener('click', () => {
      const src = player?.dataset.videoSrc;
      if (!player || !src) return;
      if (!player.currentSrc) player.src = src;
      player.play();
      prinVideo.classList.add('is-playing');
    });
  }
</script>

