---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ShipmentJourney from '~/components/journey/ShipmentJourney.astro';
import Icon from '~/components/ui/Icon.astro';
import Faq from '~/components/ui/Faq.astro';
import CtaBand from '~/components/ui/CtaBand.astro';
import HeroSlider from '~/components/home/HeroSlider.astro';
import ActivityCategories from '~/components/home/ActivityCategories.astro';
import AboutFigures from '~/components/home/AboutFigures.astro';
import Clients from '~/components/ui/Clients.astro';
import { services } from '~/data/services';
import { site, contactCta } from '~/config/site';
import { toFa } from '~/lib/format';
import { faqLd } from '~/lib/schema';
import { getCollection } from 'astro:content';

// The homepage teaser is intentionally a fixed set of three guides: adding new
// guides under /guides/ must not change the homepage layout or its length.
const HOME_GUIDES = ['customs-clearance-cost', 'customs-clearance-documents', 'import-process'];
const guides = (await getCollection('guides'))
  .filter((g) => HOME_GUIDES.includes(g.id))
  .sort((a, b) => HOME_GUIDES.indexOf(a.id) - HOME_GUIDES.indexOf(b.id));

const principles = [
  {
    title: 'اول بررسی، بعد برآورد',
    text: 'پیش از اعلام هزینه، اسناد و مشخصات کالا را می‌بینیم. برآورد را مکتوب و تفکیک‌شده می‌دهیم و اقلامی را که هنوز قطعی نیستند جدا مشخص می‌کنیم.',
  },
  {
    title: 'مرز مسئولیت‌ها از ابتدا روشن است',
    text: 'می‌گوییم چه کاری بر عهدهٔ ماست، چه چیزی را صاحب کالا باید فراهم کند و کدام تصمیم با گمرک یا دستگاه صادرکنندهٔ مجوز است.',
  },
  {
    title: 'به‌جای وعده، ریسک‌ها را می‌گوییم',
    text: 'زمان و نتیجهٔ ترخیص به عوامل بیرونی بستگی دارد. به‌جای تضمین غیرواقعی، نقاط احتمالی توقف را پیش از شروع کار توضیح می‌دهیم.',
  },
  {
    title: 'گزارش روشن از هر مرحله',
    text: 'در هر مرحله می‌دانید پرونده کجاست، منتظر چه چیزی است و اقدام بعدی با چه کسی است.',
  },
];

/** one photograph per principle card, matching its promise */
const PRIN_PHOTOS = [
  { src: '/img/prin-review-640.webp', alt: 'بررسی اسناد و مدارک حمل پیش از برآورد هزینه' },
  { src: '/img/prin-handshake-640.webp', alt: 'توافق و روشن بودن مرز مسئولیت‌ها میان دو طرف' },
  { src: '/img/prin-risk-640.webp', alt: 'کارشناس گمرک در حال بازرسی کانتینرها و بررسی ریسک‌ها' },
  { src: '/img/prin-report-640.webp', alt: 'گزارش مرحله‌به‌مرحلهٔ پرونده روی تبلت' },
];

/** honest reading time: words of the markdown body ÷ 200 w/m, hidden when unknown */
const readMinutes = (g: { body?: string }) => {
  const w = (g.body ?? '').trim().split(/\s+/).filter(Boolean).length;
  return w ? Math.max(2, Math.round(w / 200)) : 0;
};

const prepare = [
  'شرح دقیق کالا و کاربرد آن (در صورت امکان کاتالوگ یا برگهٔ مشخصات فنی)',
  'کد تعرفهٔ پیشنهادی، اگر از قبل دارید',
  'کشور مبدأ، ارزش تقریبی و شرط تحویل (مثلاً FOB یا CFR)',
  'پیش‌فاکتور و وضعیت ثبت سفارش',
  'مرحلهٔ فعلی محموله: پیش از خرید، در حال حمل یا رسیده به گمرک',
  'گمرک یا بندری که کالا وارد آن می‌شود',
];

const tally = [
  { value: 2000, unit: 'محموله', label: 'ترخیص‌شده در ۱۵ سال فعالیت', approx: true, icon: 'cube' as const },
  { value: 500, unit: 'میلیون یورو', label: 'ارزش سالانهٔ کالاهای ترخیص‌شده', approx: true, icon: 'briefcase' as const },
  { value: 15, unit: 'سال', label: 'سابقهٔ فعالیت، از ۱۳۹۳', icon: 'award' as const },
];

/** The four services shown on the homepage, in reading order. */
// The homepage shows the two entry points: import (before the purchase) and customs
// clearance (once the goods are on their way). The other routes stay one click away.
const homepageServices = [services.import, services.clearance];
const relatedServices = [services.sailor, services.container, services.export];

/** Hero slides. Each one points at a page that actually exists. */
const slides = [
  {
    image: 'hero-open-sea',
    alt: 'دریا و آسمان باز در غروب، بدون ساحل — مسیر حرکت کشتی',
    eyebrow: 'واردات ملوانی',
    title: 'از دبی تا انبار شما، با لنج و با اسناد درست',
    text: 'مسیر مستقیم دبی به بوشهر و بندرعباس، بدون جابه‌جایی میانی؛ با بررسی سهمیه و اسناد پیش از حرکت بار.',
    href: '/sailor-import/',
    cta: 'مسیر ملوانی',
  },
  {
    image: 'hero-sailor-port',
    alt: 'لنج باری در بندر جنوبی ایران در غروب و کشتی کانتینری در اسکله',
    eyebrow: 'ترخیص کالا',
    title: 'ترخیصی که از کنترل اسناد شروع می‌شود، نه از انبار',
    text: 'اظهارنامه، ارزیابی، مجوزها و پروانهٔ خروج؛ با برآورد مکتوب و تفکیک‌شدهٔ هزینه‌ها پیش از اظهار.',
    href: '/customs-clearance/',
    cta: 'خدمات ترخیص',
  },
  {
    image: 'hero-warehouse-night',
    alt: 'انبار شبانه با قفسه‌های پالت و لیفتراک در راهرو',
    eyebrow: 'حمل و تحویل',
    title: 'کالا تا انبار شما همراهی می‌شود، نه تا درب گمرک',
    text: 'پس از پروانهٔ خروج، حمل داخلی و تحویل برنامه‌ریزی می‌شود؛ وضعیت هر مرحله هم به‌موقع گزارش می‌شود.',
    href: '/import-services/',
    cta: 'مسیر واردات',
  },
];

/** Cargo families — labels and order follow the reference (RTL), with photos. */
const categories = [
  {
    title: 'کالاهای مصرفی و عمومی',
    image: 'cat-consumer',
    alt: 'کارتن و بسته‌بندی کالای مصرفی روی قفسه‌های توزیع',
    href: '/guides/goods-by-type/#لوازم-برقی-و-الکترونیک',
  },
  {
    title: 'مواد شیمیایی',
    image: 'cat-chemical',
    alt: 'بشکه‌های صنعتی شیمیایی روی پالت و ظروف آزمایشگاهی شیشه‌ای',
    href: '/guides/goods-by-type/#مواد-شیمیایی',
  },
  {
    title: 'محصولات کشاورزی و غذایی',
    image: 'cat-agri',
    alt: 'کیسه‌های گونی غله و جعبه‌های میوه در یک سالن انبار روشن',
    href: '/guides/goods-by-type/#مواد-غذایی-و-کشاورزی',
  },
  {
    title: 'قطعات و تجهیزات',
    image: 'cat-parts',
    alt: 'قطعات صنعتی دقیق شامل بلبرینگ، چرخ‌دنده و موتور برقی روی میز کار',
    href: '/guides/goods-by-type/#ماشینآلات-و-قطعات-صنعتی',
  },
  {
    title: 'مواد اولیه و محصولات صنعتی',
    image: 'cat-industrial',
    alt: 'کلاف فولادی، پروفیل آلومینیوم و رول پارچه در انبار صنعتی',
    href: '/guides/goods-by-type/#کالای-ساختمانی-و-فلزی',
  },
];

const faqs = [
  {
    q: 'ترخیص کالا معمولاً چقدر طول می‌کشد؟',
    a: 'زمان ثابتی وجود ندارد. کامل بودن اسناد، نیاز کالا به مجوز یا آزمایش، مسیر رسیدگی در گمرک و حجم کار گمرک مقصد همه اثر دارند. پس از دیدن اسناد، برآوردی واقع‌بینانه و عواملی را که ممکن است باعث تأخیر شوند اعلام می‌کنیم.',
  },
  {
    q: 'آیا هزینهٔ ترخیص را پیش از شروع کار اعلام می‌کنید؟',
    a: 'بله، پس از بررسی اسناد یک برآورد مکتوب و تفکیک‌شده ارائه می‌شود. بخشی از مبالغ، مانند حقوق ورودی، به ارزش و تعرفهٔ نهایی پذیرفته‌شده در گمرک بستگی دارد؛ این اقلام در برآورد جدا مشخص می‌شوند. توضیح بیشتر در <a href="/guides/customs-clearance-cost/">راهنمای هزینه ترخیص کالا</a>.',
  },
  {
    q: 'کالا به گمرک رسیده و اسناد کامل نیست؛ چه کنیم؟',
    a: 'هرچه زودتر پرونده را بررسی کنیم بهتر است، چون هزینهٔ انبارداری معمولاً با گذشت زمان بیشتر می‌شود. اسنادی را که در دست دارید بفرستید تا کمبودها و راه‌های تکمیل آن‌ها مشخص شود.',
  },
  {
    q: 'برای واردات حتماً باید کارت بازرگانی داشت؟',
    a: 'در بیشتر واردات تجاری، کارت بازرگانی معتبر لازم است؛ اما برخی رویه‌ها قواعد متفاوتی دارند. پیش از خرید، وضعیت خود را بررسی کنید. در <a href="/guides/import-process/">راهنمای مراحل واردات کالا</a> این موضوع را توضیح داده‌ایم.',
  },
  {
    q: 'در کدام گمرکات و بنادر خدمات می‌دهید؟',
    a:
      site.serviceAreas.length > 0
        ? `در حال حاضر در ${site.serviceAreas.join('، ')} خدمات ارائه می‌دهیم. برای سایر گمرکات، در فرم مشاوره مشخص کنید تا امکان همکاری بررسی شود.`
        : 'گمرک یا بندر ورود کالا را در فرم مشاوره بنویسید تا امکان همکاری در همان محل را بررسی و اعلام کنیم.',
  },
];
---

<BaseLayout
  title={`${site.name} | ترخیص کالا، واردات و صادرات کالا`}
  fullTitle
  description="اوکیان؛ شرکت بازرگانی واردات و صادرات و ترخیص کالا از گمرک. بررسی اسناد پیش از حمل، برآورد شفاف هزینه و پیگیری پرونده تا تحویل کالا."
  includeWebsiteLd
  jsonLd={[faqLd(faqs, '/', Astro.site)].filter((x) => x !== null)}
>
  <!-- ============ HEADER: SHIPMENT JOURNEY (H1 + scroll-driven scene) ============ -->
  <ShipmentJourney>
    <HeroSlider slot="backdrop" slides={slides} />
    <div slot="intro" class="hero-intro">
      <h1 class="hero__title">
        <span class="hero__l1">واردات ملوانی و ترخیص کالا،</span>
        <span class="hero__l2">با مسیر روشن</span>
      </h1>
      <a class="btn btn--accent" href={contactCta.href}>
        {contactCta.label}
        <Icon name="arrow" class="btn__icon" />
      </a>
    </div>
    <button slot="controls" class="btn hero-intro__run" type="button" data-journey-run aria-pressed="false">
      <Icon name="play" class="btn__icon btn__icon--play" />
      <Icon name="pause" class="btn__icon btn__icon--pause" />
      <span data-run-label>پخش خودکار مسیر</span>
    </button>
  </ShipmentJourney>

  <!-- ============ CATEGORIES (حوزه‌های فعالیت) ============ -->
  <ActivityCategories categories={categories} />

  <!-- ============ ABOUT (درباره ما + figures) ============ -->
  <AboutFigures
    title="از بندر تا انبار، مسیر کالا روشن باشد"
    lead="اوکیان از سال ۱۳۹۳ در ترخیص کالا، واردات و صادرات کار می‌کند؛ با دفتر در تهران، بوشهر و بندرعباس. کارمان این است که پیش از حرکت بار بدانید چه سندی لازم است، چه هزینه‌ای در انتظار شماست و هر مرحله دست کیست."
    figures={tally}
    href="/about/"
    cta="اطلاعات بیشتر"
  />

  <!-- ============ CLIENTS ============ -->
  <Clients
    title="همکاران ما"
    eyebrow="همکاران"
    lead="از خودروسازی و موتورسیکلت تا اسباب‌بازی و کالای ساختمانی؛ برندها و شرکت‌هایی که در مسیر واردات و ترخیص کالا همراهشان بوده‌ایم."
  />

  <!-- ============ SERVICES ============ -->
  <section class="section section--glow" id="services" aria-labelledby="services-title">
    <div class="container">
      <header class="section-head section-head--split reveal">
        <div>
          <span class="eyebrow">خدمات</span>
          <h2 id="services-title">دو مسیر، دو نقطهٔ شروع متفاوت</h2>
        </div>
        <p class="lead">
          اگر هنوز در حال تصمیم‌گیری برای خرید هستید، مسیر <a href="/import-services/">واردات کالا</a> از مرحلهٔ برنامه‌ریزی همراه شماست؛
          اگر کالا در راه گمرک است، مسیر <a href="/customs-clearance/">ترخیص کالا</a> از بررسی اسناد تا خروج کالا را پیش می‌بریم.
        </p>
      </header>

      <div class="services">
        {
          homepageServices.map((s, i) => (
            <article class="service glass reveal" aria-labelledby={`service-${i}`}>
              <div class="service__top" aria-hidden="true">
                <p class="service__num">{toFa(`0${i + 1}`)}</p>
                <span class="service__icon">
                  <Icon name={s.icon} />
                </span>
              </div>
              <h3 id={`service-${i}`}>
                <a href={s.href}>{s.name}</a>
              </h3>
              <p class="service__summary">{s.summary}</p>
              <ul class="checklist service__list">
                {s.includes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <p class="service__fit">{s.fit}</p>
              <a class="arrow-link" href={s.href} aria-label={`جزئیات خدمات ${s.name}`}>
                جزئیات خدمت
                <Icon name="arrow" />
              </a>
            </article>
          ))
        }
      </div>

      <nav class="routes glass reveal" aria-labelledby="routes-title">
        <p class="routes__label" id="routes-title">مسیرهای مرتبط</p>
        <ul class="routes__list">
          {
            relatedServices.map((r) => (
              <li>
                <a class="routes__link" href={r.href}>
                  <span>{r.name}</span>
                  <Icon name="arrow" />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  <!-- ============ PRINCIPLES ============ -->
  <section class="section section--alt section--grain section--glow" aria-labelledby="principles-title">
    <div class="container principles">
      <div class="principles__top">
        <header class="section-head principles__head reveal">
          <span class="eyebrow">روش کار</span>
          <h2 id="principles-title">چیزی که از همکاری با ما انتظار دارید</h2>
          <p class="lead">در کار گمرکی، بیشتر هزینه‌های پیش‌بینی‌نشده از ابهام می‌آید. روش کار ما برای کم کردن همین ابهام است.</p>
        </header>

        <!-- Introduction video slot: the source is intentionally EMPTY.
             Drop the file path into data-video-src (e.g. /video/team.mp4) and
             the play button loads and plays it; until then the poster preview
             below is what visitors see. -->
        <figure class="prin-video reveal">
          <video
            class="prin-video__player"
            poster="/img/team-video-poster-960.webp"
            preload="none"
            playsinline
            data-video-src=""
          ></video>
          <button class="prin-video__play" type="button" aria-label="پخش ویدیوی معرفی">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M9 6.5v11l9-5.5z" />
            </svg>
          </button>
        </figure>
      </div>
      <ol class="principles__list">
        {
          principles.map((p, i) => (
            <li class="reveal">
              <span class="prin__media">
                <img
                  src={PRIN_PHOTOS[i].src}
                  alt={PRIN_PHOTOS[i].alt}
                  width="640"
                  height="400"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="prin__n" aria-hidden="true">{toFa(i + 1)}</span>
              <div class="prin__body">
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ PREPARE ============ -->
  <section class="section section--dark prepare-band" aria-labelledby="prepare-title">
    <div class="container prepare">
      <div class="prepare__text reveal">
        <span class="eyebrow">پیش از تماس</span>
        <h2 id="prepare-title">این اطلاعات را آماده کنید</h2>
        <p class="lead">با این اطلاعات، بررسی اولیه دقیق‌تر و سریع‌تر انجام می‌شود. اگر بخشی از آن را ندارید، نگران نباشید؛ همان را که دارید بفرستید.</p>
        <ul class="checklist checklist--cols">
          {prepare.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="prepare__slot reveal">
      <aside class="prepare__card" aria-roledescription="carousel" aria-label="قدم‌های شروع همکاری">
        <span class="prepare__seal" aria-hidden="true">
          <Icon name="stamp" />
        </span>
        <div class="prep-stage" data-prep-stage role="group" tabindex="0" aria-label="قدم‌های شروع همکاری">
          <article class="prep-slide is-active" role="group" aria-roledescription="اسلاید" aria-label="گام ۱ از ۳">
            <p class="prepare__kicker">گام اول</p>
            <h3>بررسی اولیهٔ پرونده</h3>
            <p>فرم کوتاه مشاوره را تکمیل کنید. پس از بررسی، دربارهٔ مدارک لازم، هزینه‌های قابل انتظار و قدم بعدی با شما صحبت می‌کنیم.</p>
            <a class="btn" href={contactCta.href}>
              تکمیل فرم مشاوره
              <Icon name="arrow" class="btn__icon" />
            </a>
            <a class="arrow-link" href="/guides/customs-clearance-documents/">
              فهرست مدارک ترخیص کالا
              <Icon name="arrow" />
            </a>
          </article>
          <article
            class="prep-slide"
            role="group"
            aria-roledescription="اسلاید"
            aria-label="گام ۲ از ۳"
            aria-hidden="true"
            inert
          >
            <p class="prepare__kicker">گام دوم</p>
            <h3>برآورد مکتوب و تفکیک‌شده</h3>
            <p>پیش از هر تصمیم، برآورد هزینه را مکتوب و تفکیک‌شده می‌گیرید؛ اقلامی که هنوز قطعی نیستند جدا مشخص می‌شوند تا عدد غافلگیرتان نکند.</p>
            <a class="arrow-link" href="/guides/customs-clearance-cost/">
              راهنمای هزینه ترخیص کالا
              <Icon name="arrow" />
            </a>
          </article>
          <article
            class="prep-slide"
            role="group"
            aria-roledescription="اسلاید"
            aria-label="گام ۳ از ۳"
            aria-hidden="true"
            inert
          >
            <p class="prepare__kicker">گام سوم</p>
            <h3>نقشهٔ قدم‌های بعدی</h3>
            <p>مرز مسئولیت‌ها روشن می‌شود: چه کاری بر عهدهٔ ماست، چه چیزی را صاحب کالا فراهم می‌کند و کدام تصمیم با گمرک یا دستگاه صادرکنندهٔ مجوز است.</p>
            <a class="arrow-link" href="/about/">
              دربارهٔ روش کار ما
              <Icon name="arrow" />
