---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/layout/PageHero.astro';
import AfterSalesArt from '~/components/illustrations/AfterSalesArt.astro';
import Steps from '~/components/ui/Steps.astro';
import Faq from '~/components/ui/Faq.astro';
import CtaBand from '~/components/ui/CtaBand.astro';
import Icon from '~/components/ui/Icon.astro';
import { breadcrumbLd, serviceLd } from '~/lib/schema';
import { contactCta } from '~/config/site';

const path = '/after-sales-services/';
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'خدمات پس از فروش', path },
];
const description =
  'خدمات پس از فروش کالای وارداتی: تأمین و ترخیص قطعات یدکی، هماهنگی گارانتی و تعمیر، رویهٔ کالای برگشتی و پشتیبانی اسناد در دورهٔ بهره‌برداری.';

// REVIEW: confirm with the business owner which of these are offered directly
// and which are coordinated with partners (site.scopeConfirmed).
const offerings = [
  {
    icon: 'cube',
    title: 'تأمین قطعات یدکی',
    text: 'قطعهٔ مورد نیاز را با مشخصات فنی دقیق سفارش می‌دهیم یا مسیر تأمین آن را با تأمین‌کننده هماهنگ می‌کنیم.',
  },
  {
    icon: 'stamp',
    title: 'ترخیص قطعات و ملزومات',
    text: 'قطعات هم پروندهٔ گمرکی دارند: کد تعرفه، مجوز و اظهار. تشریفات آن‌ها را مثل هر محمولهٔ دیگر انجام می‌دهیم.',
  },
  {
    icon: 'ship',
    title: 'حمل و تحویل سریع',
    text: 'برای قطعهٔ متوقف‌کنندهٔ خط تولید، روش حمل را متناسب با فوریت انتخاب و زمان رسیدن را پیگیری می‌کنیم.',
  },
  {
    icon: 'shield',
    title: 'هماهنگی گارانتی',
    text: 'اسناد گارانتی و تعهدهای تأمین‌کننده را بررسی می‌کنیم و پیگیری مطالبه را با شما و فروشنده هماهنگ می‌کنیم.',
  },
  {
    icon: 'route',
    title: 'کالای برگشتی و مرجوعی',
    text: 'برای کالایی که باید برگردد یا برای تعمیر به خارج برود، رویهٔ گمرکی خروج و بازگشت را بررسی و هماهنگ می‌کنیم.',
  },
  {
    icon: 'doc',
    title: 'اسناد و سوابق پرونده',
    text: 'هر محموله سابقهٔ اسنادی خودش را دارد؛ نسخهٔ مرتب اسناد را تحویل می‌دهیم تا برای گارانتی و حسابداری قابل استفاده باشد.',
  },
] as const;

const steps = [
  {
    title: 'دریافت درخواست و مشخصات فنی',
    text: 'شرح قطعه یا مشکل، مدل دستگاه و شمارهٔ سریال را می‌گیریم تا مشخص شود دقیقاً چه چیزی لازم است.',
  },
  {
    title: 'بررسی مسیر تأمین',
    text: 'بررسی می‌کنیم قطعه از تأمین‌کنندهٔ اصلی، نمایندگی یا بازار قابل تأمین است و کدام مسیر با شرایط شما سازگارتر است.',
  },
  {
    title: 'سفارش، حمل و ترخیص',
    text: 'سفارش و اسناد حمل هماهنگ می‌شود و تشریفات گمرکی قطعه انجام می‌شود. اگر مجوزی لازم باشد، از ابتدا در برنامه هست.',
  },
  {
    title: 'تحویل و پیگیری',
    text: 'قطعه به آدرس شما تحویل می‌شود و در صورت نیاز، نصب یا تعمیر با شبکهٔ فنی مورد تأیید شما هماهنگ می‌شود.',
  },
];

const boundaries = [
  {
    title: 'کارهایی که با ما است',
    tone: 'ours',
    items: [
      'بررسی مشخصات فنی و شناسایی قطعهٔ درست',
      'سفارش، هماهنگی حمل و پیگیری مرسوله',
      'تشریفات گمرکی قطعه و کالای برگشتی',
      'پیگیری اسناد گارانتی با تأمین‌کننده',
    ],
  },
  {
    title: 'آنچه شما تأمین می‌کنید',
    tone: 'yours',
    items: [
      'مشخصات دقیق دستگاه و شمارهٔ سریال',
      'مدارک گارانتی و سابقهٔ خرید',
      'تأیید گزینهٔ قطعه و بودجهٔ آن',
      'پرداخت هزینهٔ قطعه و حمل',
    ],
  },
  {
    title: 'آنچه با تأمین‌کننده و شبکهٔ فنی است',
    tone: 'theirs',
    items: [
      'کیفیت و اصالت قطعه',
      'شرایط و مدت گارانتی',
      'تشخیص عیب و انجام تعمیر',
      'زمان تولید یا تأمین قطعه',
    ],
  },
];

const faqs = [
  {
    q: 'قطعهٔ یدکی هم مثل کالای اصلی ترخیص می‌شود؟',
    a: 'بله، قطعات هم اظهارنامه و تشریفات خودشان را دارند؛ کد تعرفه، مجوزها و ارزش، پروندهٔ جداگانه‌ای می‌سازند. برای قطعات حساس یا کمیاب، پیش از سفارش بررسی می‌کنیم چه مجوزی لازم است تا در گمرک متوقف نشود.',
  },
  {
    q: 'کالای معیوب را می‌توانید برگردانید؟',
    a: 'بازگشت کالا یک رویهٔ گمرکی جداگانه است: باید مبنای برگشت، اسناد و شرایط آن روشن باشد. جزئیات پرونده را بفرستید تا مسیر خروج و در صورت نیاز ورود مجدد را بررسی کنیم. تصمیم نهایی دربارهٔ پذیرش، با گمرک است.',
  },
  {
    q: 'تعمیر هم انجام می‌دهید؟',
    a: 'کار ما واردات، ترخیص و هماهنگی است؛ تعمیر تخصصی را خودمان انجام نمی‌دهیم. اگر نمایندگی یا تعمیرگاه مورد اعتماد دارید، حمل، اسناد و ارسال قطعه را با آن‌ها هماهنگ می‌کنیم.',
  },
  {
    q: 'برای خرید اولیه هم خدمات پس از فروش می‌دهید؟',
    a: 'بله. بهتر است پیش از خرید مشخص شود قطعات مصرفی و شرایط گارانتی چه مسیری دارند؛ این موضوع در <a href="/import-services/">خدمات واردات کالا</a> و بررسی پیش از خرید دیده می‌شود.',
  },
];
---

<BaseLayout
  title="خدمات پس از فروش کالای وارداتی؛ قطعات و گارانتی"
  description={description}
  jsonLd={[
    breadcrumbLd(crumbs, Astro.site),
    serviceLd({ name: 'خدمات پس از فروش کالای وارداتی', description, path, serviceType: 'After-sales support' }, Astro.site),
  ]}
>
  <PageHero
    eyebrow="خدمات"
    title="خدمات پس از فروش"
    lead="ورود کالا پایان کار نیست. قطعهٔ یدکی، تعویض، تعمیر یا مرجوعی، هرکدام دوباره پروندهٔ حمل و گمرک می‌سازند؛ این خدمت برای همان مرحله است."
    crumbs={crumbs}
  >
    <div class="hero-actions">
      <a class="btn" href={contactCta.href}>
        {contactCta.label}
        <Icon name="arrow" class="btn__icon" />
      </a>
      <a class="btn btn--ghost" href="#offerings">چه چیزهایی شامل می‌شود</a>
    </div>
    <AfterSalesArt slot="art" />
  </PageHero>

  <!-- Intro -->
  <section class="section" aria-labelledby="intro-title">
    <div class="container split">
      <div class="stack reveal" style="--stack: 1.1rem">
        <h2 id="intro-title">کالای واردشده، بعد از تحویل هم پرونده دارد</h2>
        <p class="lead-text">
          برای دستگاه‌ها و تجهیزات وارداتی، پرسش‌های واقعی معمولاً بعد از تحویل شروع می‌شوند: قطعهٔ مصرفی چه زمانی لازم می‌شود، گارانتی چطور مطالبه می‌شود،
          کالای معیوب چگونه برمی‌گردد و قطعهٔ اضطراری چطور سریع می‌رسد.
        </p>
        <p class="lead-text">
          خدمات پس از فروش اوکیان همین مسیر را پوشش می‌دهد: تأمین و ترخیص قطعات یدکی، هماهنگی گارانتی و تعمیر، و انجام رویه‌های گمرکی کالای برگشتی؛ با همان
          روشی که در واردات و <a href="/customs-clearance/">ترخیص کالا</a> داریم — بررسی اول، برآورد مکتوب، گزارش روشن.
        </p>
      </div>
      <aside class="fit-card reveal" aria-labelledby="fit-title">
        <h3 id="fit-title">این خدمت به کار شما می‌آید اگر…</h3>
        <ul class="checklist">
          <li>ماشین یا تجهیزات وارداتی دارید و قطعهٔ یدکی لازم می‌شود؛</li>
          <li>قطعهٔ حیاتی خط تولید از کار افتاده و باید سریع برسد؛</li>
          <li>گارانتی کالا نزد تأمین‌کنندهٔ خارجی است و پیگیری لازم دارد؛</li>
          <li>کالای معیوب باید برگردد یا برای تعمیر به خارج برود.</li>
        </ul>
        <p class="muted">
          هنوز کالا را وارد نکرده‌اید؟ در <a href="/import-services/">خدمات واردات کالا</a> مسیر تأمین قطعات هم پیش از خرید بررسی می‌شود.
        </p>
      </aside>
    </div>
  </section>

  <!-- Offerings -->
  <section class="section section--alt section--grain" id="offerings" aria-labelledby="offerings-title">
    <div class="container">
      <header class="section-head section-head--split reveal">
        <div>
          <span class="eyebrow">دامنهٔ خدمت</span>
          <h2 id="offerings-title">چه چیزهایی شامل می‌شود</h2>
        </div>
        <p class="lead">خدماتی که معمولاً بعد از تحویل کالا لازم می‌شوند؛ هر کدام با پرونده و اسناد خودش.</p>
      </header>
      <ul class="tiles">
        {
          offerings.map((o) => (
            <li class="tile reveal">
              <span class="tile__icon" aria-hidden="true">
                <Icon name={o.icon} />
              </span>
              <h3>{o.title}</h3>
              <p>{o.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section class="section" aria-labelledby="process-title">
    <div class="container split split--wide">
      <header class="section-head sticky-head reveal">
        <span class="eyebrow">فرایند</span>
        <h2 id="process-title">از درخواست تا تحویل قطعه</h2>
        <p class="lead">مسیر کوتاه است، اما هر مرحله سند خودش را دارد. در هر مرحله می‌دانید مرسوله کجاست.</p>
      </header>
      <Steps items={steps} />
    </div>
  </section>

  <!-- Boundaries -->
  <section class="section section--alt section--grain" aria-labelledby="resp-title">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">مرز مسئولیت‌ها</span>
        <h2 id="resp-title">چه کاری با ماست، چه کاری با شما</h2>
        <p class="lead">در خدمات پس از فروش، روشن بودن این مرزها از هر چیز دیگری مهم‌تر است.</p>
      </header>
      <div class="resp">
        {
          boundaries.map((r) => (
            <section class:list={['resp__col', 'reveal', `resp__col--${r.tone}`]} aria-label={r.title}>
              <h3>{r.title}</h3>
              <ul>
                {r.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container split split--wide">
      <header class="section-head reveal">
        <span class="eyebrow">پرسش‌های رایج</span>
        <h2 id="faq-title">پرسش‌های رایج دربارهٔ خدمات پس از فروش</h2>
      </header>
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand
    title="قطعه یا کالای مرجوعی دارید؟"
    text="مشخصات فنی قطعه، مدل دستگاه و مرحلهٔ کار را بفرستید. مسیر تأمین، مدارک و برآورد هزینه را برایتان مشخص می‌کنیم."
  />
</BaseLayout>

<style>
  .lead-text {
    font-size: var(--step-1);
    line-height: 2;
    color: var(--slate-700);
  }
  .resp {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .resp__col {
    padding: 1.75rem;
    border-radius: var(--radius-l);
    border: 1px solid var(--rule);
    background: var(--white);
    color: var(--slate-700);
  }
  .resp__col h3 {
    font-size: var(--step-1);
    font-weight: 800;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
    color: var(--navy-900);
  }
  .resp__col ul {
    list-style: none;
    display: grid;
    gap: 0.65rem;
  }
  .resp__col li {
    position: relative;
    padding-inline-start: 1.4rem;
    line-height: 1.8;
  }
  .resp__col li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.65em;
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-radius: 50%;
    background: var(--dot, var(--petrol-300));
  }
  .resp__col--ours {
    background: var(--navy-800);
    border-color: var(--navy-800);
    color: #d3dbe7;
  }
  .resp__col--ours h3 {
    color: var(--white);
    border-color: rgb(232 236 238 / 0.15);
  }
  .resp__col--yours {
    --dot: var(--petrol-500);
  }
  .resp__col--theirs {
    --dot: transparent;
    background: transparent;
    border-style: dashed;
    border-color: var(--rule-strong);
  }
  .resp__col--theirs li::before {
    border: 2px solid var(--petrol-300);
  }
  @media (max-width: 960px) {
    .resp {
      grid-template-columns: 1fr;
    }
  }
</style>
