---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/layout/PageHero.astro';
import AboutArt from '~/components/illustrations/AboutArt.astro';
import CtaBand from '~/components/ui/CtaBand.astro';
import Icon from '~/components/ui/Icon.astro';
import Placeholder from '~/components/ui/Placeholder.astro';
import { breadcrumbLd } from '~/lib/schema';
import { site, isProduction, formattedAddress } from '~/config/site';
import { toFa } from '~/lib/format';

const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'درباره ما', path: '/about/' },
];
const facts = [
  site.company.legalName && { label: 'نام حقوقی', value: site.company.legalName },
  site.company.foundingYear && { label: 'سال شروع فعالیت', value: toFa(site.company.foundingYear) },
  ...site.company.licences.map((l) => ({ label: l.title, value: `${toFa(l.number)} — ${l.issuer}` })),
  site.serviceAreas.length > 0 && { label: 'گمرکات و بنادر', value: site.serviceAreas.join('، ') },
  formattedAddress() && { label: 'نشانی', value: formattedAddress() as string },
  site.contact.phone && { label: 'تلفن', value: site.contact.phoneDisplay ?? site.contact.phone },
].filter(Boolean) as Array<{ label: string; value: string }>;
---

<BaseLayout
  title="درباره ما؛ ترخیص و واردات کالا"
  description="اوکیان در ترخیص کالا و هماهنگی مراحل واردات همراه بازرگانان و شرکت‌هاست. با روش کار، مرز مسئولیت‌ها و سیاست محتوایی ما آشنا شوید."
  jsonLd={[breadcrumbLd(crumbs, Astro.site)]}
>
  <PageHero
    eyebrow="درباره ما"
    title="دربارهٔ اوکیان"
    lead="اوکیان برای کسب‌وکارهایی کار می‌کند که می‌خواهند واردات و ترخیص کالا را با تصویر روشن از مراحل، مسئولیت‌ها و هزینه‌ها پیش ببرند."
    crumbs={crumbs}
  >
    <AboutArt slot="art" />
  </PageHero>

  <section class="section" aria-labelledby="why-title">
    <div class="container split">
      <div class="stack prose-lite reveal" style="--stack: 1.1rem">
        <h2 id="why-title">چرا «مسیر روشن»؟</h2>
        <p>
          واردات کالا معمولاً نه به خاطر یک مشکل بزرگ، بلکه به خاطر چند ابهام کوچک گران تمام می‌شود: سندی که با سند دیگر نمی‌خواند، مجوزی که دیر شناسایی
          می‌شود، یا هزینه‌ای که کسی از قبل درباره‌اش حرف نزده بود.
        </p>
        <p>
          کار ما کم کردن همین ابهام‌هاست. پیش از شروع، پرونده را بررسی می‌کنیم، مرز کار خودمان، کار صاحب کالا و تصمیم نهادهای مسئول را مشخص می‌کنیم و در هر
          مرحله می‌گوییم پرونده کجاست و قدم بعدی چیست.
        </p>
        <p>
          خدمات ما در دو بخش ارائه می‌شود: <a href="/customs-clearance/">ترخیص کالا</a> برای کالایی که خریداری شده، و
          <a href="/import-services/">خدمات واردات کالا</a> برای همراهی از مرحلهٔ برنامه‌ریزی خرید.
        </p>
      </div>
      <aside class="fit-card reveal" aria-labelledby="facts-title">
        <h3 id="facts-title">اطلاعات رسمی</h3>
        {
          facts.length > 0 ? (
            <dl class="facts">
              {facts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))}
            </dl>
          ) : isProduction ? (
            <p class="muted">برای دریافت اطلاعات رسمی شرکت، از طریق صفحهٔ تماس با ما در ارتباط باشید.</p>
          ) : null
        }
        <Placeholder field="نام حقوقی، سال شروع فعالیت، مجوزها و گمرکات تحت پوشش (company / serviceAreas)" />
      </aside>
    </div>
  </section>

  <section class="section section--alt section--grain" aria-labelledby="commit-title">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">تعهد ما</span>
        <h2 id="commit-title">آنچه وعده می‌دهیم و آنچه نمی‌دهیم</h2>
      </header>
      <div class="commit">
        <div class="commit__col reveal">
          <h3><Icon name="check" /> وعده می‌دهیم</h3>
          <ul>
            <li>پیش از اعلام هزینه، پرونده را بررسی کنیم.</li>
            <li>برآورد را مکتوب و با تفکیک اقلام قطعی و برآوردی بدهیم.</li>
            <li>مرز مسئولیت‌ها را پیش از شروع کار روشن کنیم.</li>
            <li>وضعیت هر مرحله را به‌موقع گزارش کنیم.</li>
          </ul>
        </div>
        <div class="commit__col commit__col--no reveal">
          <h3><Icon name="close" /> وعده نمی‌دهیم</h3>
          <ul>
            <li>زمان قطعی ترخیص، چون به تصمیم و زمان رسیدگی نهادهای دیگر بستگی دارد.</li>
            <li>نتیجهٔ ارزیابی گمرک یا صدور مجوزها.</li>
            <li>دور زدن مقررات یا راه‌های غیررسمی.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">خدمات</span>
        <h2 id="services-title">اوکیان کجای مسیر واردات می‌ایستد؟</h2>
        <p class="lead">
          هر خدمت، یک بازهٔ مشخص از مسیر است. اگر نمی‌دانید از کجا شروع کنید، <a href="/contact/">مشخصات کالا را بفرستید</a> تا
          قدم درست را مشخص کنیم.
        </p>
      </header>
      <ul class="service-links">
        <li><a href="/customs-clearance/">ترخیص کالا از گمرک</a><span>پس از رسیدن کالا</span></li>
        <li><a href="/import-services/">واردات کالا</a><span>از پیش از خرید تا تحویل</span></li>
        <li><a href="/container-import/">واردات کانتینری</a><span>FCL و LCL</span></li>
        <li><a href="/sailor-import/">واردات ملوانی</a><span>بنادر جنوبی</span></li>
        <li><a href="/export-services/">صادرات کالا</a><span>مجوز و گواهی مبدأ</span></li>
        <li><a href="/commercial-services/">خدمات بازرگانی</a><span>تأمین‌کننده و ثبت سفارش</span></li>
        <li><a href="/special-projects/">پروژه‌های خاص</a><span>محموله‌های سنگین و حساس</span></li>
        <li><a href="/customs/">گمرکات و بنادر</a><span>راهنمای هر گمرک</span></li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="editorial-title">
    <div class="container--narrow stack prose-lite reveal" style="--stack: 1.1rem">
      <span class="eyebrow">سیاست محتوا</span>
      <h2 id="editorial-title">راهنماهای این وب‌سایت چطور نوشته می‌شوند؟</h2>
      <p>
        <a href="/guides/">راهنماهای اوکیان</a> برای این نوشته می‌شوند که پیش از تصمیم، تصویر درستی از مسیر داشته باشید. در این راهنماها نرخ‌ها، درصدها یا
        مهلت‌هایی را که به‌سرعت تغییر می‌کنند ذکر نمی‌کنیم و به‌جای آن، مبنای هر موضوع و منبع رسمی آن را معرفی می‌کنیم.
      </p>
      <p>
        هر راهنما تاریخ به‌روزرسانی دارد و منابع آن در پایان صفحه آمده است. مثال‌ها نمایشی‌اند و با برچسب مشخص شده‌اند. اگر نکته‌ای را نادرست یا قدیمی
        دیدید، از طریق <a href="/contact/">صفحهٔ تماس</a> به ما اطلاع دهید.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .service-links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .service-links a {
    display: block;
    font-weight: 700;
    color: var(--navy-900);
    text-decoration-color: var(--petrol-300);
    text-underline-offset: 4px;
  }
  .service-links li {
    padding: 1rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-s);
    background: var(--white);
  }
  .service-links span {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .facts {
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }
  .facts dt {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .facts dd {
    margin: 0;
    font-weight: 700;
  }
  .commit {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .commit__col {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-l);
    background: var(--navy-900);
    color: #d3dbe7;
  }
  .commit__col h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step-2);
    color: var(--white);
    margin-bottom: 1.25rem;
  }
  .commit__col h3 :global(svg) {
    inline-size: 2rem;
    block-size: 2rem;
    padding: 0.35rem;
    border-radius: 50%;
    background: var(--petrol-300);
    color: var(--navy-950);
  }
  .commit__col ul {
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }
  .commit__col li {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgb(232 236 238 / 0.12);
  }
  .commit__col--no {
    background: var(--white);
    color: var(--slate-700);
    border: 1px dashed var(--rule-strong);
  }
  .commit__col--no h3 {
    color: var(--navy-900);
  }
  .commit__col--no h3 :global(svg) {
    background: var(--mist-200);
    color: var(--navy-900);
  }
  .commit__col--no li {
    border-color: var(--rule);
  }
  @media (max-width: 760px) {
    .commit {
      grid-template-columns: 1fr;
    }
  }
</style>
