---
/**
 * /about/ — the company's public record.
 *
 * Layout follows the registry-lookup sites (linka / sabteno): a short hero, a
 * sticky in-page navigation, then independent, anchor-linked sections —
 * identity, working method, offices, licences, trademark.
 * Data lives in src/data/company.ts so every number has one source.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/layout/PageHero.astro';
import AboutArt from '~/components/illustrations/AboutArt.astro';
import CtaBand from '~/components/ui/CtaBand.astro';
import Icon from '~/components/ui/Icon.astro';
import LicenceDoc from '~/components/about/LicenceDoc.astro';
import { breadcrumbLd } from '~/lib/schema';
import { getCollection } from 'astro:content';
import { site } from '~/config/site';
import { toFa } from '~/lib/format';
import { registry, licences, trademark } from '~/data/company';
import Photo from '~/components/ui/Photo.astro';

const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'درباره ما', path: '/about/' },
];

const sections = [
  { id: 'identity', label: 'شناسنامه' },
  { id: 'method', label: 'روش کار' },
  { id: 'offices', label: 'دفترها' },
  { id: 'licences', label: 'مجوزها' },
  { id: 'trademark', label: 'علامت تجاری' },
];


// Counted from the content collection, never typed by hand.
const offices = await getCollection('customs');

const mapHref = (city: string, address: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${city}، ${address}`)}`;

const aboutLd = {
  '@type': 'AboutPage',
  '@id': new URL('/about/', Astro.site).href,
  name: 'دربارهٔ اوکیان (اوژن تجارت کیان)',
  inLanguage: 'fa-IR',
  mainEntity: { '@id': new URL('/#organization', Astro.site).href },
  about: { '@id': new URL('/#organization', Astro.site).href },
};
---

<BaseLayout
  ogImage="/og/about.jpg"
  ogImageAlt="دفتر کار اوکیان در تهران"
  title="دربارهٔ اوکیان | اوژن تجارت کیان"
  fullTitle
  description="شناسنامهٔ حقوقی اوکیان (اوژن تجارت کیان): شناسهٔ ملی، شمارهٔ ثبت، مجوزها، دفترها، اشخاص و علامت تجاری ثبت‌شده."
  jsonLd={[breadcrumbLd(crumbs, Astro.site), aboutLd]}
>
  <PageHero
    eyebrow="درباره ما"
    title="اوکیان؛ اوژن تجارت کیان"
    lead="شرکت با مسئولیت محدود، ثبت‌شده در تهران از سال ۱۳۹۳؛ فعال در ترخیص کالا، واردات و صادرات، با دفتر در تهران، بوشهر و بندرعباس."
    crumbs={crumbs}
  >
    <AboutArt slot="art" />
  </PageHero>

  <div class="facts">
    <div class="container facts__inner">
      {
        [
          { k: 'تأسیس', v: '۱۳۹۳', s: 'ثبت در تهران' },
          { k: 'دفترها', v: toFa(site.contact.offices.length), s: 'تهران، بوشهر، بندرعباس' },
          { k: 'مجوزها', v: toFa(licences.length), s: 'در حال اعتبار' },
          { k: 'گمرک‌ها', v: toFa(offices.length), s: 'بوشهر، بندرعباس، بازرگان و …' },
        ].map((f) => (
          <div class="facts__item">
            <span class="facts__k">{f.k}</span>
            <strong class="facts__v">{f.v}</strong>
            <span class="facts__s">{f.s}</span>
          </div>
        ))
      }
    </div>
  </div>

  <nav class="sec-nav" aria-label="فهرست بخش‌های این صفحه">
    <div class="container sec-nav__inner">
      <ul>
        {
          sections.map((s) => (
            <li>
              <a href={`#${s.id}`}>{s.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  {/* ───────────────────────── شناسنامه ───────────────────────── */}
  <section class="section section--tight" id="identity" aria-labelledby="identity-title">
    <div class="container">
      <header class="sec-head">
        <span class="eyebrow">شناسنامه</span>
        <h2 id="identity-title">هویت حقوقی</h2>
        <p class="sec-head__lead">اطلاعات ثبت‌شده در ادارهٔ ثبت شرکت‌ها، بدون تغییر.</p>
      </header>

      <dl class="reg">
        {
          registry.map((f) => (
            <div class:list={['reg__row', f.strong && 'reg__row--strong']}>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>

    </div>
  </section>

  {/* ───────────────────────── روش کار ───────────────────────── */}
  <section class="section section--alt section--tight" id="method" aria-labelledby="method-title">
    <div class="container">
      <header class="sec-head">
        <span class="eyebrow">روش کار</span>
        <h2 id="method-title">چهار قاعده و سه چیزی که وعده نمی‌دهیم</h2>
      </header>

      <div class="method">
        <ol class="method__do">
          <li>
            <h3>اول بررسی، بعد برآورد</h3>
            <p>برآورد مکتوب و تفکیک‌شده؛ اقلام قطعی و برآوردی جدا.</p>
          </li>
          <li>
            <h3>مرز مسئولیت از ابتدا</h3>
            <p>روشن است چه کاری با ما، چه کاری با صاحب کالا و چه تصمیمی با گمرک است.</p>
          </li>
          <li>
            <h3>گفتن ریسک، نه وعده</h3>
            <p>نقاط احتمالی توقف پیش از شروع کار توضیح داده می‌شود.</p>
          </li>
          <li>
            <h3>گزارش هر مرحله</h3>
            <p>در هر لحظه می‌دانید پرونده کجاست و قدم بعدی با کیست.</p>
          </li>
        </ol>

        <div class="method__dont">
          <h3>وعده نمی‌دهیم</h3>
          <ul>
            <li>زمان قطعی ترخیص</li>
            <li>نتیجهٔ ارزیابی گمرک یا صدور مجوز</li>
            <li>دور زدن مقررات یا مسیر غیررسمی</li>
          </ul>
          <p class="method__link">
            <a href="/guides/">راهنماهای تخصصی</a> با همین قاعده نوشته شده‌اند: بدون وعده، با منبع.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ───────────────────────── دفترها ───────────────────────── */}
  <section class="section section--tight" id="offices" aria-labelledby="offices-title">
    <div class="container">
      <header class="sec-head">
        <span class="eyebrow">حضور</span>
        <h2 id="offices-title">دفترهای اوکیان</h2>
        <p class="sec-head__lead">سه دفتر فعال؛ دو دفتر بندری برای پیگیری حضوری پرونده.</p>
      </header>

      <ul class="office-grid">
        {
          site.contact.offices.map((o) => (
            <li class="office">
              <h3>{o.city}</h3>
              <p class="office__addr">{o.address}</p>
              {o.phones && (
                <ul class="office__phones">
                  {o.phones.map((p) => (
                    <li>
                      <a href={`tel:${p.e164}`}>{p.display}</a>
                    </li>
                  ))}
                </ul>
              )}
              <a class="office__map" href={mapHref(o.city, o.address)} target="_blank" rel="noopener">
                موقعیت روی نقشه
                <Icon name="external" />
              </a>
            </li>
          ))
        }
      </ul>

      <Photo
        name="office-tehran"
        alt="دفتر تهران اوکیان با میزهای کار، مانیتور و نقشهٔ خلیج فارس روی دیوار"
        width={1600}
        height={900}
        sizes="(max-width: 780px) 100vw, 1120px"
        caption="دفتر تهران؛ پرونده‌هایی که از بندر می‌رسند، در همین دفتر جمع‌بندی و صورتحساب می‌شوند."
      />
    </div>
  </section>

  {/* ───────────────────────── مجوزها ───────────────────────── */}
  <section class="section section--alt section--tight" id="licences" aria-labelledby="licences-title">
    <div class="container">
      <header class="sec-head">
        <span class="eyebrow">مجوزها</span>
        <h2 id="licences-title">مجوزهای صنفی</h2>
        <p class="sec-head__lead">مجوزهای در حال اعتبار، با شمارهٔ پیگیری و تاریخ اعتبار.</p>
      </header>

      <div class="doc-grid">
        {licences.map((l) => <LicenceDoc licence={l} />)}
      </div>

      <p class="note">
        <Icon name="info" />
        <span>
          کارت‌های بالا بازطراحی اطلاعات مجوزها هستند، نه تصویر سند اصلی؛ اصل مدارک در دفتر تهران نگهداری می‌شود.
          پروانهٔ حق‌العمل‌کاری گمرکی، در صورت صدور، به همین بخش اضافه خواهد شد.
        </span>
      </p>
    </div>
  </section>

  {/* ───────────────────────── علامت تجاری ───────────────────────── */}
  <section class="section section--tight" id="trademark" aria-labelledby="trademark-title">
    <div class="container">
      <header class="sec-head">
        <span class="eyebrow">برند</span>
        <h2 id="trademark-title">علامت تجاری {trademark.word}</h2>
        <p class="sec-head__lead">ثبت‌شده به نام {trademark.owner} در هفت طبقه.</p>
      </header>

      <div class="tm">
        <figure class="tm__mark">
          <svg viewBox="0 0 240 160" role="img" aria-label={`نشان ${trademark.word} در کادر لوزی`}>
            <defs>
              <linearGradient id="tm-bg" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#f7fafb" />
                <stop offset="1" stop-color="#e6eef2" />
              </linearGradient>
            </defs>
            <rect x="4" y="4" width="232" height="152" rx="10" fill="url(#tm-bg)" stroke="#162c47" stroke-opacity="0.14" />
            <path d="M120 14 L212 80 L120 146 L28 80 Z" fill="none" stroke="#1b3d52" stroke-width="2.2" />
            <path d="M120 24 L200 80 L120 136 L40 80 Z" fill="none" stroke="#234d66" stroke-width="0.8" stroke-opacity="0.45" />
            <text
              x="120"
              y="80"
              text-anchor="middle"
              dominant-baseline="central"
              font-size="25"
              font-weight="800"
              letter-spacing="7"
              fill="#162c47"
            >
              {trademark.word}
            </text>
          </svg>
          <figcaption>{trademark.description}</figcaption>
        </figure>

        <dl class="reg reg--flat tm__facts">
          <div class="reg__row">
            <dt>شمارهٔ ثبت</dt>
            <dd>{trademark.registrationNumber}</dd>
          </div>
          <div class="reg__row">
            <dt>شمارهٔ اظهارنامه</dt>
            <dd>{trademark.applicationNumber}</dd>
          </div>
          <div class="reg__row">
            <dt>تاریخ ثبت اظهارنامه</dt>
            <dd>{trademark.applicationDate}</dd>
          </div>
          <div class="reg__row">
            <dt>مالک</dt>
            <dd>{trademark.owner}</dd>
          </div>
          <div class="reg__row">
            <dt>طبقه‌های ثبت‌شده</dt>
            <dd>{trademark.classes}</dd>
          </div>
        </dl>
      </div>

      <details class="tm__classes">
        <summary>شرح طبقه‌ها ({toFa(trademark.classes_notes.length)} طبقه)</summary>
        <ul>
          {trademark.classes_notes.map((c) => <li>{c}</li>)}
        </ul>
      </details>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<script>
  // Marks the section currently in view in the sticky chip nav. Progressive:
  // without JS every chip still works as a plain anchor link.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.sec-nav a[href^="#"]'));
  const targets = links
    .map((a) => document.querySelector<HTMLElement>(a.getAttribute('href') || ''))
    .filter((el): el is HTMLElement => Boolean(el));

  if (targets.length) {
    const setCurrent = (id: string) => {
      for (const a of links) {
        a.setAttribute('aria-current', String(a.getAttribute('href') === `#${id}`));
      }
    };
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible?.target.id) setCurrent(visible.target.id);
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: [0, 0.25, 0.5, 1] },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>

<style>
  /* ---------- sticky section navigation ---------- */
  .sec-nav {
    position: sticky;
    top: var(--header-h);
    z-index: 20;
    background: var(--white);
    border-block: 1px solid var(--rule);
  }
  .sec-nav__inner {
    display: flex;
    align-items: center;
    min-block-size: 3.25rem;
  }
  .sec-nav ul {
    display: flex;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding-block: 0.55rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .sec-nav ul::-webkit-scrollbar {
    display: none;
  }
  .sec-nav a {
    display: inline-block;
    white-space: nowrap;
    padding: 0.4rem 0.8rem;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--navy-800);
    border: 1px solid var(--rule);
    border-radius: 999px;
    text-decoration: none;
  }
  .sec-nav a:hover {
    color: var(--petrol-600);
    border-color: var(--petrol-300);
    background: var(--mist-50);
  }
  .sec-nav a[aria-current='true'] {
    color: var(--white);
    background: var(--navy-800);
    border-color: var(--navy-800);
  }

  /* Anchors must clear both the site header and this page's sticky nav. */
  .section[id] {
    scroll-margin-top: calc(var(--header-h) + 3.5rem);
  }

  /* ---------- section rhythm ---------- */
  .section--tight {
    padding-block: clamp(2.75rem, 2rem + 3vw, 4.5rem);
  }
  .sec-head {
    display: grid;
    gap: 0.5rem;
    margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
  }
  .sec-head h2 {
    font-size: var(--step-3);
  }
  .sec-head__lead {
    margin: 0;
    color: var(--text-muted);
    max-width: 60ch;
  }

  /* ---------- registry grid ---------- */
  .facts {
    border-bottom: 1px solid var(--rule);
    background: linear-gradient(180deg, var(--white), var(--mist-50, #f7fafb));
  }
  .facts__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1.25rem;
    padding-block: 1.35rem;
  }
  .facts__item {
    display: grid;
    gap: 0.15rem;
    align-content: center;
    padding-inline-start: 1.1rem;
    border-inline-start: 1px solid var(--rule);
  }
  .facts__item:first-child {
    padding-inline-start: 0;
    border-inline-start: 0;
  }
  .facts__k {
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    color: var(--slate-500);
  }
  .facts__v {
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.45rem);
    line-height: 1.2;
    font-weight: 800;
    color: var(--ink, #162c47);
    font-variant-numeric: tabular-nums;
  }
  .facts__s {
    font-size: 0.8rem;
    color: var(--slate-600);
  }
  @media (max-width: 640px) {
    .facts__item {
      padding-inline-start: 0;
      border-inline-start: 0;
    }
    .facts__inner {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem 1.25rem;
    }
  }

  .reg {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1px;
    margin: 0;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    overflow: hidden;
  }
  .reg__row {
    display: grid;
    gap: 0.2rem;
    padding: 0.9rem 1.1rem;
    background: var(--white);
  }
  .reg__row--strong dd {
    font-weight: 800;
    color: var(--navy-900);
  }
  .reg dt {
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    color: var(--slate-500);
  }
  .reg dd {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--navy-800);
    font-variant-numeric: tabular-nums;
  }
  .reg__row--strong dd {
    font-weight: 800;
    font-size: var(--step-0);
  }
  .reg dt {
    font-size: 0.74rem;
    color: var(--text-muted);
  }
  .reg dd {
    margin: 0;
    font-weight: 700;
    color: var(--navy-900);
    line-height: 1.7;
  }
  .reg dd a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--petrol-600);
    text-decoration-color: var(--petrol-300);
    text-underline-offset: 3px;
  }
  .reg a :global(svg) {
    inline-size: 0.85em;
    block-size: 0.85em;
  }
  .reg--flat {
    grid-template-columns: 1fr;
    border-radius: var(--radius-s);
  }

  .note {
    display: flex;
    gap: 0.6rem;
    margin: 1.5rem 0 0;
    padding: 0.9rem 1.1rem;
    font-size: var(--step--1);
    color: var(--slate-700);
    background: var(--mist-50);
    border: 1px solid var(--rule);
    border-radius: var(--radius-s);
  }
  .note :global(svg) {
    flex: none;
    inline-size: 1.1rem;
    block-size: 1.1rem;
    margin-top: 0.2rem;
    color: var(--petrol-600);
  }
  .note a {
    color: var(--navy-800);
    font-weight: 700;
  }

  /* ---------- offices ---------- */
  .office-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .office {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: clamp(1.1rem, 2.5vw, 1.5rem);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--petrol-600);
    border-radius: var(--radius-m);
    background: var(--white);
  }
  .office h3 {
    font-size: var(--step-1);
  }
  .office__addr {
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.85;
    color: var(--slate-700);
  }
  .office__phones {
    display: grid;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .office__phones a {
    font-weight: 700;
    color: var(--navy-900);
    text-decoration: none;
    direction: ltr;
  }
  .office__map {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.25rem;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--petrol-600);
  }
  .office__map :global(svg) {
    inline-size: 0.85em;
    block-size: 0.85em;
  }

  /* ---------- licences ---------- */
  .doc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: 1.5rem;
  }

  /* ---------- trademark ---------- */
  .tm {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  .tm__mark {
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .tm__mark svg {
    inline-size: 100%;
    block-size: auto;
  }
  .tm__mark figcaption {
    font-size: 0.76rem;
    color: var(--text-muted);
  }
  .tm__facts {
    background: var(--white);
  }
  .tm__classes {
    margin-top: 1.25rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-s);
    background: var(--white);
    padding: 0.9rem 1.1rem;
  }
  .tm__classes summary {
    cursor: pointer;
    font-weight: 700;
    font-size: var(--step--1);
    color: var(--navy-800);
  }
  .tm__classes ul {
    display: grid;
    gap: 0.4rem;
    margin: 0.8rem 0 0;
    padding-inline-start: 1.1rem;
    font-size: 0.82rem;
    line-height: 1.85;
    color: var(--slate-700);
  }

  /* ---------- method ---------- */
  .method {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }
  .method__do {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .method__do li {
    padding: 1rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-s);
    background: var(--white);
  }
