---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/layout/PageHero.astro';
import ClearanceArt from '~/components/illustrations/ClearanceArt.astro';
import Steps from '~/components/ui/Steps.astro';
import Faq from '~/components/ui/Faq.astro';
import CtaBand from '~/components/ui/CtaBand.astro';
import Clients from '~/components/ui/Clients.astro';
import Icon from '~/components/ui/Icon.astro';
import Placeholder from '~/components/ui/Placeholder.astro';
import { breadcrumbLd, serviceLd } from '~/lib/schema';
import { services } from '~/data/services';
import { site, contactCta } from '~/config/site';

const path = '/customs-clearance/';
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'ترخیص کالا', path },
];
const description =
  'ترخیص کالا از گمرک: بررسی اسناد و کد تعرفه، برآورد مکتوب هزینه، ثبت اظهارنامه و پیگیری تا خروج کالا؛ همراه با مراحل، مدارک و عوامل هزینه.';

const responsibilities = [
  {
    title: 'کارهایی که ما انجام می‌دهیم',
    tone: 'ours',
    items: [
      'بررسی اسناد و تطبیق اطلاعات آن‌ها با یکدیگر',
      'بررسی کد تعرفهٔ پیشنهادی و مجوزهای احتمالی',
      'برآورد مکتوب و تفکیک‌شدهٔ هزینه‌ها',
      'تنظیم و ثبت اظهارنامه و پیگیری پرونده در گمرک',
      'همراهی در ارزیابی و پاسخ به پرسش‌های کارشناس',
      'گزارش وضعیت هر مرحله و اقدام بعدی',
    ],
  },
  {
    title: 'آنچه صاحب کالا فراهم می‌کند',
    tone: 'yours',
    items: [
      'اسناد اصلی خرید و حمل، مانند سیاههٔ خرید و بارنامه',
      'اطلاعات دقیق و فنی کالا',
      'کارت بازرگانی یا مجوز فعالیت معتبر',
      'پرداخت حقوق، عوارض و هزینه‌های قانونی',
      'وکالت یا مجوزهای لازم برای اقدام از طرف شما',
    ],
  },
  {
    title: 'آنچه با گمرک و نهادهای مسئول است',
    tone: 'theirs',
    items: [
      'تعیین مسیر رسیدگی و تصمیم دربارهٔ بازرسی',
      'پذیرش نهایی کد تعرفه و ارزش گمرکی',
      'صدور مجوزها، گواهی‌ها و نتیجهٔ آزمایش‌ها',
      'زمان رسیدگی در هر نهاد',
    ],
  },
];

const steps = [
  {
    title: 'بررسی اولیهٔ اسناد و کالا',
    text: 'اسناد موجود، شرح کالا و کد تعرفهٔ پیشنهادی بررسی می‌شود تا مغایرت‌ها، کمبودها و مجوزهای احتمالی پیش از هر اقدام مشخص شود.',
  },
  {
    title: 'برآورد هزینه و توافق دربارهٔ دامنهٔ کار',
    text: 'برآوردی مکتوب از اقلام هزینه ارائه می‌شود که اقلام قطعی و برآوردی را جدا نشان می‌دهد. دامنهٔ خدمت و مسئولیت‌ها پیش از شروع کار توافق می‌شود.',
  },
  {
    title: 'آماده‌سازی پیش از رسیدن کالا',
    text: 'اگر کالا هنوز در راه است، اسناد تکمیل و هم‌خوان می‌شوند و مجوزهایی که پیش از ترخیص لازم است پیگیری می‌شود تا زمان انتظار در انبار کمتر شود.',
  },
  {
    title: 'تحویل انبار و تنظیم اظهارنامه',
    text: 'پس از تخلیهٔ کالا در بندر یا فرودگاه و صدور قبض انبار، اظهارنامه بر پایهٔ اسناد تنظیم و در سامانهٔ گمرک ثبت می‌شود.',
  },
  {
    title: 'ارزیابی و رسیدگی',
    text: 'پرونده بسته به ارزیابی ریسک، ممکن است با کنترل اسنادی یا بازرسی فیزیکی کالا بررسی شود. در این مرحله در ارزیابی حاضر می‌شویم و به پرسش‌ها پاسخ می‌دهیم.',
    note: 'اینکه پرونده در کدام مسیر رسیدگی قرار بگیرد، تصمیم گمرک است و از پیش قابل تعیین نیست.',
  },
  {
    title: 'پرداخت‌ها و تکمیل مجوزها',
    text: 'حقوق ورودی، مالیات و عوارض بر اساس ارزیابی نهایی پرداخت می‌شود و مجوزهای باقی‌مانده، مانند نتیجهٔ آزمایش یا تأیید استاندارد، تکمیل می‌شود.',
  },
  {
    title: 'خروج کالا و تحویل اسناد',
    text: 'پس از صدور اجازهٔ خروج، کالا از انبار خارج و برای حمل داخلی آماده می‌شود. نسخه‌ای از اسناد پرونده برای سوابق شما تحویل داده می‌شود.',
  },
];

const costFactors = [
  { title: 'ارزش و کد تعرفهٔ کالا', text: 'مبنای حقوق ورودی و مالیات‌ها؛ تغییر هرکدام در ارزیابی، مبلغ نهایی را تغییر می‌دهد.' },
  { title: 'مدت ماندن کالا در انبار', text: 'هزینهٔ انبارداری و در برخی موارد دموراژ کانتینر با زمان بیشتر می‌شود.' },
  { title: 'مجوزها و آزمایش‌ها', text: 'نوع کالا تعیین می‌کند چه مجوزهایی لازم است و هرکدام چه هزینه و زمانی دارد.' },
  { title: 'مسیر رسیدگی', text: 'بازرسی فیزیکی، جابه‌جایی و زمان بیشتری نسبت به کنترل اسنادی لازم دارد.' },
  { title: 'پیچیدگی پرونده', text: 'تعداد اقلام، کامل بودن اسناد و نیاز به اصلاحات، بر دامنهٔ کار اثر دارد.' },
  { title: 'حمل داخلی', text: 'مسافت، نوع بار و وسیلهٔ حمل تا مقصد نهایی.' },
];

const faqs = [
  {
    q: 'آیا می‌توانید زمان ترخیص را تضمین کنید؟',
    a: 'خیر. بخش مهمی از زمان ترخیص به تصمیم و زمان رسیدگی گمرک و دستگاه‌های صادرکنندهٔ مجوز بستگی دارد. کاری که انجام می‌دهیم این است که اسناد را پیش از رسیدن کالا آماده کنیم، عوامل احتمالی تأخیر را از قبل بگوییم و پرونده را پیوسته پیگیری کنیم.',
  },
  {
    q: 'کالا هنوز در راه است؛ الان زود نیست؟',
    a: 'بهترین زمان برای شروع، پیش از رسیدن کالاست. در این فاصله می‌توان مغایرت اسناد را برطرف و مجوزهای لازم را پیگیری کرد تا کالا کمترین زمان را در انبار بماند.',
  },
  {
    q: 'آیا برای کالای ارسال‌شده توسط شخص دیگری هم کار می‌کنید؟',
    a: 'پرونده باید به نام واردکننده‌ای باشد که اسناد و ثبت سفارش به نام اوست و بتواند برای اقدام از طرف خود وکالت یا مجوز لازم را بدهد. جزئیات پروندهٔ خود را بفرستید تا امکان کار بررسی شود.',
  },
  {
    q: 'برآورد هزینه چقدر با هزینهٔ نهایی فاصله دارد؟',
    a: 'اقلامی مثل دستمزد خدمات پس از توافق قطعی‌اند. اقلامی مثل حقوق ورودی و انبارداری به ارزیابی نهایی و مدت ترخیص بستگی دارند؛ این اقلام در برآورد با مبنای محاسبه‌شان جدا مشخص می‌شوند تا بدانید کدام بخش ممکن است تغییر کند.',
  },
];
---

<BaseLayout
  title="ترخیص کالا از گمرک؛ مراحل، مدارک و برآورد هزینه"
  description={description}
  jsonLd={[
    breadcrumbLd(crumbs, Astro.site),
    serviceLd({ name: 'ترخیص کالا از گمرک', description, path, serviceType: 'Customs clearance' }, Astro.site),
  ]}
>
  <PageHero
    eyebrow="خدمات"
    title="ترخیص کالا از گمرک"
    lead="تشریفات گمرکی کالای وارداتی شما را از بررسی اسناد و کد تعرفه تا ثبت اظهارنامه، همراهی در ارزیابی و خروج کالا از گمرک پیگیری می‌کنیم؛ با برآورد مکتوب هزینه و گزارش روشن از هر مرحله."
    crumbs={crumbs}
  >
    <div class="hero-actions">
      <a class="btn" href={contactCta.href}>
        {contactCta.label}
        <Icon name="arrow" class="btn__icon" />
      </a>
      <a class="btn btn--ghost" href="#process">مراحل ترخیص کالا</a>
    </div>
    <ClearanceArt slot="art" />
  </PageHero>

  <!-- What it is -->
  <section class="section" aria-labelledby="what-title">
    <div class="container split">
      <div class="stack prose-lite reveal" style="--stack: 1.1rem">
        <h2 id="what-title">ترخیص کالا یعنی چه و این خدمت شامل چیست؟</h2>
        <p>
          ترخیص کالا مجموعه کارهایی است که باید انجام شود تا کالای وارداتی پس از رسیدن به گمرک، با رعایت مقررات اجازهٔ خروج بگیرد: ارائه و تطبیق اسناد،
          اعلام کالا در اظهارنامه، ارزیابی گمرک، تأمین مجوزهای لازم و پرداخت حقوق و عوارض.
        </p>
        <p>
          خدمت ترخیص کالای {site.name} برای این است که این مسیر را با کمترین ابهام طی کنید. پیش از شروع، اسناد را بررسی می‌کنیم و می‌گوییم چه چیزی کم است،
          چه هزینه‌هایی در راه است و کدام بخش‌ها به تصمیم گمرک یا دستگاه‌های دیگر بستگی دارد.
        </p>
        <Placeholder field="گمرکات و بنادری که خدمات ترخیص در آن‌ها ارائه می‌شود (serviceAreas) و پروانهٔ حق‌العمل‌کاری (company.licences)" />
      </div>
      <aside class="fit-card reveal" aria-labelledby="fit-title">
        <h3 id="fit-title">این خدمت برای شماست اگر…</h3>
        <ul class="checklist">
          <li>کالا را خریده‌اید و در راه گمرک است یا به آن رسیده است؛</li>
          <li>اسناد را دارید اما از هم‌خوانی آن‌ها مطمئن نیستید؛</li>
          <li>می‌خواهید پیش از رسیدن کالا هزینه‌ها را بدانید؛</li>
          <li>کالا در گمرک مانده و نمی‌دانید مشکل کجاست.</li>
        </ul>
        <p class="muted">
          هنوز خرید نکرده‌اید؟ <a href={services.import.href}>خدمات واردات کالا</a> از مرحلهٔ برنامه‌ریزی شروع می‌شود.
        </p>
      </aside>
    </div>
  </section>

  <!-- Responsibilities -->
  <section class="section section--alt section--grain" aria-labelledby="resp-title">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">مرز مسئولیت‌ها</span>
        <h2 id="resp-title">چه کاری با ماست، چه کاری با شما</h2>
        <p class="lead">بیشتر سوءتفاهم‌ها در ترخیص از روشن نبودن همین مرزهاست. پیش از شروع کار، این تقسیم را با هم مرور می‌کنیم.</p>
      </header>
      <div class="resp">
        {
          responsibilities.map((r) => (
            <section class:list={['resp__col reveal', `resp__col--${r.tone}`]} aria-label={r.title}>
              <h3>{r.title}</h3>
              <ul>
                {r.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section" id="process" aria-labelledby="process-title">
    <div class="container split split--wide">
      <header class="section-head sticky-head reveal">
        <span class="eyebrow">فرایند</span>
        <h2 id="process-title">مراحل ترخیص کالا</h2>
        <p class="lead">ترتیب کلی کار در یک پروندهٔ معمول. بسته به کالا و رویهٔ گمرکی، ممکن است برخی مراحل هم‌زمان انجام شوند یا مرحله‌ای اضافه شود.</p>
        <a class="arrow-link" href="/guides/import-process/">
          مراحل کامل واردات کالا
          <Icon name="arrow" />
        </a>
      </header>
      <Steps items={steps} />
    </div>
  </section>

  <!-- Required information -->
  <section class="section section--dark" aria-labelledby="docs-title">
    <div class="container split">
      <div class="stack reveal" style="--stack: 1.1rem">
        <span class="eyebrow">شروع کار</span>
        <h2 id="docs-title">اطلاعات و مدارکی که برای شروع لازم است</h2>
        <p class="lead">برای بررسی اولیه لازم نیست همهٔ اسناد کامل باشد. همان چیزی را که دارید بفرستید؛ کمبودها را با هم مشخص می‌کنیم.</p>
        <a class="arrow-link" href="/guides/customs-clearance-documents/">
          فهرست کامل مدارک لازم برای ترخیص کالا
          <Icon name="arrow" />
        </a>
      </div>
      <div class="docs-cols reveal">
        <div>
          <h3>برای بررسی اولیه</h3>
          <ul class="checklist">
            <li>شرح کالا و کاربرد آن</li>
            <li>سیاههٔ خرید یا پیش‌فاکتور</li>
            <li>کشور مبدأ و گمرک ورود</li>
            <li>مرحلهٔ فعلی محموله</li>
          </ul>
        </div>
        <div>
          <h3>برای انجام ترخیص</h3>
          <ul class="checklist">
            <li>بارنامه و فهرست عدل‌بندی</li>
            <li>گواهی مبدأ و بیمه‌نامه</li>
            <li>اطلاعات ثبت سفارش</li>
            <li>کارت بازرگانی و مجوزهای کالا</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Cost factors -->
  <section class="section" aria-labelledby="cost-title">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">هزینه</span>
        <h2 id="cost-title">هزینه ترخیص کالا به چه عواملی بستگی دارد؟</h2>
        <p class="lead">
          هزینهٔ ترخیص مجموع چند قلم با مبناهای متفاوت است. پس از دیدن اسناد، برآوردی مکتوب می‌دهیم که اقلام قطعی و برآوردی را جدا نشان می‌دهد.
        </p>
      </header>
      <dl class="factors">
        {
          costFactors.map((f) => (
            <div class="factors__item reveal">
              <dt>{f.title}</dt>
              <dd>{f.text}</dd>
            </div>
          ))
        }
      </dl>
      <p class="factors__more">
        <a class="arrow-link" href="/guides/customs-clearance-cost/">
          راهنمای کامل هزینه ترخیص کالا
          <Icon name="arrow" />
        </a>
      </p>
    </div>
  </section>

  <!-- Enquiry process -->
  <section class="section section--alt" aria-labelledby="enquiry-title">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">درخواست</span>
        <h2 id="enquiry-title">از درخواست تا شروع کار</h2>
      </header>
      <ol class="enquiry">
        <li class="reveal">
          <h3>ارسال اطلاعات</h3>
          <p>فرم کوتاه مشاوره را با مشخصات کالا و مرحلهٔ فعلی محموله تکمیل کنید.</p>
        </li>
        <li class="reveal">
          <h3>بررسی و پرسش‌های تکمیلی</h3>
          <p>اطلاعات را بررسی می‌کنیم و اگر چیزی لازم باشد، از راه ارتباطی که انتخاب کرده‌اید می‌پرسیم.</p>
        </li>
        <li class="reveal">
          <h3>برآورد مکتوب و توافق</h3>
          <p>برآورد هزینه و دامنهٔ کار را دریافت می‌کنید. کار فقط پس از توافق شما شروع می‌شود.</p>
        </li>
      </ol>
      <a class="btn enquiry__cta" href={contactCta.href}>
        {contactCta.label}
        <Icon name="arrow" class="btn__icon" />
      </a>
    </div>
  </section>

  <!-- Which customs office: internal links to the per-office pages -->
  <section class="section section--alt" aria-labelledby="ports-title">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">گمرکات</span>
        <h2 id="ports-title">کالای شما از کدام گمرک می‌آید؟</h2>
        <p class="lead">
          رویهٔ ترخیص یکی است، اما نوع کالا، انبارها و مسیرهای هر گمرک متفاوت‌اند. راهنمای عملیاتی هر گمرک را ببینید.
        </p>
      </header>
      <ul class="ports-grid">
        <li><a href="/customs/bandar-abbas/">گمرک بندرعباس <small>کانتینر و کالای تجاری</small></a></li>
        <li><a href="/customs/bushehr/">گمرک بوشهر <small>بار خرد و ملوانی</small></a></li>
        <li><a href="/customs/imam-khomeini-port/">گمرک بندر امام خمینی <small>فله و کالای اساسی</small></a></li>
        <li><a href="/customs/khorramshahr/">خرمشهر و آبادان <small>جنوب غرب و مرز عراق</small></a></li>
        <li><a href="/customs/anzali/">گمرک انزلی <small>دریای خزر و CIS</small></a></li>
        <li><a href="/customs/imam-khomeini-airport/">فرودگاه امام <small>بار هوایی و فوری</small></a></li>
        <li><a href="/customs/bazargan/">گمرک بازرگان <small>مرز زمینی ترکیه</small></a></li>
        <li><a href="/customs/">همهٔ گمرکات <small>فهرست کامل</small></a></li>
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container split split--wide">
      <header class="section-head reveal">
        <span class="eyebrow">پرسش‌های رایج</span>
        <h2 id="faq-title">پرسش‌های رایج دربارهٔ ترخیص کالا</h2>
      </header>
      <Faq items={faqs} />
    </div>
  </section>

    <!-- client brands: the same wall as the homepage, without the heading -->
  <div class="section">
    <div class="container" style="padding-bottom: 1.5rem">
      <p class="clients-lead">برخی از برندهایی که محموله‌هایشان را همراهی کرده‌ایم</p>
    </div>
    <Clients title={null} note={false} compact />
  </div>

  <CtaBand />
</BaseLayout>

<style>
  .ports-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 0.9rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .ports-grid a {
    display: grid;
