---
/**
 * /customs-clearance/required-documents/ — «مدارک لازم برای ترخیص کالا»
 *
 * The site already explains documents inside a guide, but this is the query
 * every customer types before they call. A checklist page with a table of
 * 「چه سندی، از چه کسی، برای چه مرحله‌ای» is what answer engines quote, and it
 * is genuinely useful as a printable list.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/layout/PageHero.astro';
import AnswerBlock from '~/components/ui/AnswerBlock.astro';
import CtaBand from '~/components/ui/CtaBand.astro';
import Photo from '~/components/ui/Photo.astro';
import Faq from '~/components/ui/Faq.astro';
import Icon from '~/components/ui/Icon.astro';
import ClusterNav from '~/components/ui/ClusterNav.astro';
import ClearanceArt from '~/components/illustrations/ClearanceArt.astro';
import { breadcrumbLd, serviceLd, faqLd } from '~/lib/schema';
import { contactCta } from '~/config/site';

const path = '/customs-clearance/required-documents/';
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'ترخیص کالا', path: '/customs-clearance/' },
  { name: 'مدارک لازم', path },
];

const title = 'مدارک لازم برای ترخیص کالا؛ فهرست کامل';
const description =
  'فهرست مدارک لازم برای ترخیص کالا: سیاههٔ خرید، بارنامه، گواهی مبدأ، بیمه‌نامه، مجوزها و وکالت‌نامه — هر سند از چه کسی گرفته می‌شود و برای کدام مرحله است.';

const answer =
  'مدارک پایهٔ ترخیص کالا همیشه یکسان است: سیاههٔ خرید (فاکتور)، بارنامه، گواهی مبدأ، بیمه‌نامهٔ باربری، اظهارنامهٔ کوتاژ و مجوزهای دستگاه صادرکنندهٔ مجوز برای آن گروه کالا. سند مالکیت کالا و وکالت‌نامهٔ ترخیص هم از سمت صاحب کالا لازم است. آنچه میان پرونده‌ها تفاوت می‌سازد، مجوزهای ویژهٔ هر کالاست، نه اسناد پایه.';

const docs = [
  {
    name: 'سیاههٔ خرید (فاکتور)',
    from: 'فروشنده / تأمین‌کننده',
    when: 'پیش از اظهار',
    note: 'باید با ارزش اظهاری بخواند؛ شرح کالا در آن همان چیزی باشد که در اظهارنامه می‌آید.',
  },
  {
    name: 'بارنامه (B/L یا CMR)',
    from: 'شرکت حمل / فورواردر',
    when: 'پس از حمل',
    note: 'این سند مالکیت کالا را در مسیر حمل نشان می‌دهد و مبنای ترخیصیه است.',
  },
  {
    name: 'گواهی مبدأ',
    from: 'اتاق بازرگانی کشور مبدأ',
    when: 'پیش از اظهار',
    note: 'برای برخی کشورها و برخی کالاها تعیین‌کنندهٔ نرخ ترجیحی است.',
  },
  {
    name: 'بیمه‌نامهٔ باربری',
    from: 'بیمه‌گر',
    when: 'پیش از اظهار',
    note: 'اگر حمل با شرطی انجام شده که بیمه بر عهدهٔ صاحب کالاست.',
  },
  {
    name: 'وکالت‌نامهٔ ترخیص',
    from: 'صاحب کالا (طرفین مجاز شرکت)',
    when: 'پیش از ثبت اظهارنامه',
    note: 'محدودهٔ اختیارات ترخیص‌کار را مشخص می‌کند؛ در پروندهٔ شرکتی، امضای مجاز لازم است.',
  },
  {
    name: 'مجوزهای دستگاه صادرکننده',
    from: 'سازمان استاندارد، وزارت بهداشت، وزارت صمت، انرژی اتمی و…',
    when: 'پیش از اظهار (بهترین حالت)',
    note: 'وابسته به کد تعرفهٔ کالاست. دیر گرفتن این مجوز، گران‌ترین تأخیر پرونده است.',
  },
  {
    name: 'اظهارنامه و کوتاژ',
    from: 'ترخیص‌کار در سامانهٔ گمرک',
    when: 'مرحلهٔ اظهار',
    note: 'شمارهٔ کوتاژ، شناسهٔ پرونده در گمرک است؛ از این نقطه همهٔ پیگیری‌ها با همین شماره انجام می‌شود.',
  },
  {
    name: 'اسناد حمل داخلی و تحویل',
    from: 'شرکت حمل داخلی',
    when: 'پس از پروانهٔ خروج',
    note: 'برای انتقال کالا از بندر به انبار شما و ثبت تحویل.',
  },
];

const faqs = [
  {
    q: 'آیا بدون کد تعرفه هم می‌توان پروندهٔ ترخیص را شروع کرد؟',
    a: 'اظهارنامه بدون کد تعرفه ثبت نمی‌شود. اما می‌توان پیش از رسیدن کالا، کد تعرفه را تعیین و مجوزهای لازم را شناسایی کرد؛ این کار معمولاً بیشترین تأخیر را حذف می‌کند.',
  },
  {
    q: 'اگر سندی ناقص باشد چه می‌شود؟',
    a: 'بسته به نوع نقص، پرونده در یکی از مراحل متوقف می‌شود: ثبت اظهارنامه، ارزیابی یا صدور پروانه. هر روز توقف، هم هزینهٔ انبار دارد و هم زمان تحویل را عقب می‌اندازد؛ به همین دلیل نقص مدارک را پیش از اظهار بررسی می‌کنیم.',
  },
  {
    q: 'مجوزها را ترخیص‌کار می‌گیرد یا صاحب کالا؟',
    a: 'بیشتر مجوزهای دستگاهی به نام صاحب کالا یا شرکت او صادر می‌شود، اما پیگیری و تشکیل پرونده معمولاً با ترخیص‌کار است. تقسیم کار را پیش از شروع، مکتوب می‌کنیم تا مسئولیت هر طرف روشن باشد.',
  },
  {
    q: 'برای کالای ملوانی هم همین مدارک لازم است؟',
    a: 'نه به همین شکل. رویهٔ ملوانی مدارک خودش را دارد: اسناد شناور، مدارک مالکیت کالا و اطلاعات همان سفر. فهرست جداگانه‌ای در صفحهٔ واردات ملوانی آمده است.',
  },
  {
    q: 'نسخهٔ کپی مدارک کافی است؟',
    a: 'برای بررسی اولیه بله. برای ثبت اظهارنامه و ارائهٔ به گمرک، برخی اسناد باید اصل یا نسخهٔ تأییدشده باشند؛ این را در همان بررسی اولیه مشخص می‌کنیم تا بعداً پرونده متوقف نشود.',
  },
];

const related = [
  { href: '/guides/customs-clearance-documents/', label: 'راهنمای مدارک ترخیص', hint: 'جزئیات هر سند و خطاهای رایج' },
  { href: '/customs-clearance/', label: 'خدمات ترخیص کالا', hint: 'دامنهٔ کار و مراحل' },
  { href: '/customs-clearance/cost/', label: 'هزینهٔ ترخیص', hint: 'اجزا و روش برآورد' },
  { href: '/guides/import-permits/', label: 'مجوزهای واردات', hint: 'چه کالایی چه مجوزی می‌خواهد' },
];
---

<BaseLayout
  ogImage="/og/clearance.jpg"
  ogImageAlt="میز کار کارشناس گمرک با اسناد و مهر"
  title={title}
  description={description}
  jsonLd={[breadcrumbLd(crumbs, Astro.site), serviceLd({ name: 'تنظیم و بررسی مدارک ترخیص کالا', description, path, serviceType: 'Customs documentation' }, Astro.site), faqLd(faqs, path, Astro.site)].filter((x) => x !== null)}
>
  <PageHero eyebrow="ترخیص کالا" title="مدارک لازم برای ترخیص کالا" lead={answer.split('.')[0] + '.'} crumbs={crumbs}>
    <div class="hero-actions">
      <a class="btn" href={contactCta.href}>
        {contactCta.label}
        <Icon name="arrow" class="btn__icon" />
      </a>
      <a class="btn btn--ghost" href="#list">فهرست مدارک</a>
    </div>
    <ClearanceArt slot="art" />
  </PageHero>

  <AnswerBlock text={answer} />

  <section class="section section--tight" aria-label="تصویر اسناد گمرکی">
    <div class="container">
      <Photo
        name="customs-desk"
        alt="انبوه اسناد گمرکی روی میز کار با مهر، خط‌کش و ماشین‌حساب"
        width={1600}
        height={900}
        caption="سندی که پیش از اظهار خوانده شود، پرونده را متوقف نمی‌کند؛ کنترل اسناد، ارزان‌ترین مرحلهٔ کار است."
      />
    </div>
  </section>

  <section class="section" id="list" aria-labelledby="list-title">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">فهرست</span>
        <h2 id="list-title">هر سند، از چه کسی و برای کدام مرحله؟</h2>
        <p class="lead">
          فهرست زیر برای یک پروندهٔ ترخیص تجاری است. ستون سوم همان چیزی است که در عمل بیشترین سؤال را می‌سازد:
          سند را از چه کسی باید گرفت.
        </p>
      </header>

      <ol class="docs reveal">
        {
          docs.map((d, i) => (
            <li class="doc">
              <span class="doc__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div class="doc__body">
                <h3>{d.name}</h3>
                <dl class="doc__meta">
                  <div>
                    <dt>از چه کسی</dt>
                    <dd>{d.from}</dd>
                  </div>
                  <div>
                    <dt>چه زمانی</dt>
                    <dd>{d.when}</dd>
                  </div>
                </dl>
                <p class="doc__note">{d.note}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="notice reveal">
        <Icon name="info" />
        <p>
          این فهرست، حداقلِ پایه است. کالاهای خاص (دارو، مواد غذایی، تجهیزات پزشکی، کالای مستعمل و ماشین‌آلات) مدارک
          اضافه هم می‌خواهند که از کد تعرفهٔ همان کالا می‌آید.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="order-title">
    <div class="container split">
      <div class="stack reveal" style="--stack: 1.1rem">
        <span class="eyebrow">ترتیب کار</span>
        <h2 id="order-title">چه سندی را اول بگیریم؟</h2>
        <p>
          قاعدهٔ ساده: هر چیزی که گرفتنش زمان می‌برد، اول. مجوزهای دستگاهی و کد تعرفه پیش از حمل، فاکتور و گواهی مبدأ
          در همان مرحله، و اسناد حمل وقتی بار در راه است. بارنامه آخرین سند نمی‌آید، اما آخرین سندی است که می‌رسد.
        </p>
        <ul class="checklist">
          <li>کد تعرفه و مجوزهای لازم — پیش از حرکت بار</li>
          <li>فاکتور و گواهی مبدأ — پیش از حمل</li>
          <li>وکالت‌نامه و مدارک شرکتی — پیش از اظهار</li>
          <li>بارنامه و بیمه‌نامه — هنگام حمل</li>
        </ul>
        <a class="arrow-link" href="/guides/clearance-checklist/">
          چک‌لیست کامل ترخیص، مرحله به مرحله
          <Icon name="arrow" />
        </a>
      </div>
      <div class="side-card reveal">
        <h3>مدرک را برای ما بفرستید</h3>
        <p>اگر مطمئن نیستید کدام مدرک لازم است، فهرست فعلی را بفرستید؛ می‌گوییم چه کم است.</p>
        <a class="btn btn--primary" href={contactCta.href}>
          {contactCta.label}
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container split split--wide">
      <header class="section-head reveal">
        <span class="eyebrow">پرسش‌های رایج</span>
        <h2 id="faq-title">پرسش‌های رایج دربارهٔ مدارک</h2>
      </header>
      <Faq items={faqs} />
    </div>
  </section>

  <ClusterNav siblings={related} title="بیشتر بخوانید" />
  <CtaBand
    title="نمی‌دانید چه مدرکی کم دارید؟"
    text="فهرست فعلی مدارک را بفرستید. همان روز می‌گوییم چه چیزی کم است، کدام مدرک را باید از چه کسی بگیرید و کدام مورد پرونده را متوقف می‌کند."
  />
</BaseLayout>

<style>
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .docs {
    display: grid;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .doc {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--white);
  }
  .doc__n {
    font-size: 1.1rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--petrol-300, #8fb4c9);
    line-height: 1.4;
  }
  .doc__body h3 {
    margin: 0 0 0.5rem;
    font-size: var(--step-0);
  }
  .doc__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin: 0 0 0.5rem;
    font-size: 0.84rem;
  }
  .doc__meta div {
    display: flex;
    gap: 0.35rem;
  }
  .doc__meta dt {
    color: var(--text-muted);
  }
  .doc__meta dd {
    margin: 0;
    font-weight: 600;
  }
  .doc__note {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.85;
    color: var(--slate-700);
  }
  .notice {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    margin-top: 1.25rem;
    padding: 1rem 1.2rem;
    border-radius: var(--radius-m);
    border: 1px solid rgb(143 180 201 / 0.35);
    background: var(--mist-50, #f7fafb);
    line-height: 1.9;
  }
  .notice :global(svg) {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.35rem;
    color: var(--petrol);
  }
  .notice p {
    margin: 0;
  }
  .side-card {
    padding: 1.5rem;
    border-radius: var(--radius-l, 18px);
    background: var(--navy-800, #162c47);
    color: var(--white);
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }
  .side-card h3 {
    margin: 0;
    color: var(--white);
  }
  .side-card p {
    margin: 0;
    color: rgb(255 255 255 / 0.78);
    line-height: 1.9;
    font-size: 0.92rem;
  }
  .side-card :global(.btn) {
    justify-self: start;
  }
  .checklist {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .checklist li {
    position: relative;
    padding-inline-start: 1.5rem;
    line-height: 1.9;
  }
  .checklist li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.62rem;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--petrol);
  }
</style>
