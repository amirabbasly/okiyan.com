---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/layout/PageHero.astro';
import SailorArt from '~/components/illustrations/SailorArt.astro';
import RouteMap from '~/components/illustrations/RouteMap.astro';
import Steps from '~/components/ui/Steps.astro';
import Faq from '~/components/ui/Faq.astro';
import CtaBand from '~/components/ui/CtaBand.astro';
import Clients from '~/components/ui/Clients.astro';
import Icon from '~/components/ui/Icon.astro';
import { breadcrumbLd, serviceLd } from '~/lib/schema';
import { contactCta } from '~/config/site';

const path = '/sailor-import/';
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'واردات ملوانی', path },
];
const description =
  'واردات ملوانی (ته لنجی) مستقیم از دبی به بوشهر و بندرعباس: حمل با دوبه و لنج، ترخیص با اسناد گمرکی، مزایای حمل ملوانی نسبت به کانتینر و ضمانت قیمت و زمان تحویل.';

// REVIEW: the permitted goods list, quotas and duty concessions are set by
// regulation and change; nothing numeric about duties is stated on this page.
const fit = [
  'کالای شما از نظر نوع، در فهرست مجاز این رویه قرار می‌گیرد.',
  'حجم و ارزش محموله در سهمیهٔ تعیین‌شده برای همان سفر و همان شناور است.',
  'بار شما در دبی (یا از مسیر خصب) آمادهٔ حمل است و باید به بوشهر یا بندرعباس برسد.',
  'اسناد شناور و مدارک مالکیت کالا روشن و قابل ارائه است.',
];

const scope = [
  'بررسی شرح کالا و تطبیق آن با فهرست کالاهای مجاز این رویه',
  'بررسی سهمیه، ظرفیت شناور و بندری که اظهار در آن انجام می‌شود',
  'مرور اسناد شناور و مدارک مالکیت کالا پیش از حرکت',
  'تنظیم و ثبت اظهارنامه و پیگیری پرونده در گمرک',
  'هماهنگی ارزیابی، کنترل‌ها و پرداخت وجوه قانونی',
  'حمل از بندر ورود به شهر مقصد و تحویل در انبار مشتری',
];

const steps = [
  {
    title: 'بررسی امکان‌پذیری کالا',
    text: 'شرح کالا، کاربرد و کد تعرفهٔ آن را بررسی می‌کنیم و با فهرست کالاهای مجاز این رویه تطبیق می‌دهیم. اگر کالا مناسب این مسیر نباشد، پیش از هر هزینه‌ای اعلام می‌کنیم.',
  },
  {
    title: 'بررسی سهمیه و شناور',
    text: 'شرایط شناور، سهمیهٔ همان سفر و بندری که کالا در آن اظهار می‌شود بررسی می‌شود؛ چون این سه، دامنهٔ کار را تعیین می‌کنند.',
  },
  {
    title: 'هماهنگی اسناد و بار',
    text: 'فهرست بار، اسناد شناور و مدارک کالا با هم هم‌خوان می‌شوند تا کالا در بندر به دلیل مغایرت اسناد متوقف نشود.',
  },
  {
    title: 'اظهار و ارزیابی',
    text: 'اظهارنامه تنظیم و ثبت می‌شود و پرونده در ارزیابی و کنترل‌های مربوط به این رویه پیگیری می‌شود.',
    note: 'مسیر رسیدگی و پذیرش نهایی اسناد و ارزش، تصمیم گمرک است.',
  },
  {
    title: 'پرداخت وجوه، ترخیص و حمل داخلی',
    text: 'وجوه قانونی این رویه بر پایهٔ ارزیابی نهایی پرداخت می‌شود؛ پس از صدور اجازهٔ خروج، کالا ترخیص و به شهر مقصد و انبار شما حمل می‌شود.',
  },
];

const documents = {
  first: ['شرح کالا و کاربرد آن', 'فهرست بار یا مانیفست', 'بندر مبدأ و مقصد', 'مشخصات شناور و مالک آن'],
  full: ['اسناد ثبت شناور و مجوزهای آن', 'مدارک هویتی مالک یا نمایندهٔ قانونی', 'اسناد خرید و مالکیت کالا', 'اطلاعات ثبت‌شده در سامانه‌های مربوط'],
};

/** «مزایای حمل ملوانی نسبت به حمل کانتینری» — supplied by the business owner. */
const advantages = [
  'عدم وجود دِموراژ',
  'هزینهٔ گمرکی کمتر',
  'عدم نیاز به ثبت سفارش',
  'عدم نیاز به کد سِلفا و روال بانکی',
  'عدم نیاز به مجوز بهین‌یاب و سهمیه',
  'عدم وجود بازرسی، کسر دریافتی و کسر تخلیه',
  'عدم ورود به روال‌های پیچیدهٔ گمرکی و استاندارد',
  'عدم رد خوردن کالا در ارزیابی',
  'سرعت بالای مراحل ترخیص',
  'بدون هزینهٔ سنگین انبارداری گمرک',
  'عدم پرداخت هزینهٔ ترخیصیهٔ کشتیرانی',
];

/**
 * Contract-backed commitments quoted from the business owner.
 * REVIEW: confirm the 15–25 day window and the fixed-price wording with the
 * owner (and with a lawyer) before launch — this is a written promise on a page.
 */
const guarantees = [
  {
    title: 'تحویل سالم محموله',
    text: 'سلامت بار از لحظهٔ تحویل در دبی تا تحویل در انبار شما در قرارداد ضمانت می‌شود؛ خسارت در مسیر، تعهد ما است.',
  },
  {
    title: 'ضمانت ثبت قیمت اولیه',
    text: 'قیمت اعلامی اوکیان تا تحویل کامل بار تغییر نمی‌کند؛ عددی که می‌گیرید همان عددی است که می‌پردازید.',
  },
  {
    title: 'تضمین زمان تحویل',
    text: 'جز در شرایط فورس ماژور، بار شما بسته به شرایط از ۱۵ تا ۲۵ روز از دبی در انبار شما تحویل داده می‌شود.',
  },
];

const limits = [
  {
    title: 'فهرست کالاهای مجاز',
    text: 'این رویه برای همهٔ کالاها باز نیست؛ اگر کالا در فهرست مجاز نباشد، مسیر ملوانی برای آن ممکن نیست.',
  },
  {
    title: 'سهمیهٔ سفر و سال',
    text: 'سقف مقدار و ارزش کالا برای هر سفر و در سال تعیین می‌شود و سقف کار شما را مشخص می‌کند.',
  },
  {
    title: 'مشخصات و اسناد شناور',
    text: 'شناور باید در محدودهٔ مشمول این رویه باشد و اسناد و مجوزهای آن کامل باشد.',
  },
  {
    title: 'مالکیت و مدارک کالا',
    text: 'کالا باید سند و صاحب روشن داشته باشد؛ ابهام در مالکیت، پرونده را متوقف می‌کند.',
  },
  {
    title: 'ارزیابی گمرک',
    text: 'تطبیق کالا با اظهار و پذیرش ارزش، بر پایهٔ ارزیابی گمرک انجام می‌شود.',
  },
  {
    title: 'تغییر مقررات',
    text: 'شرایط و امتیازهای این رویه با بخشنامه‌ها و آیین‌نامه‌ها به‌روز می‌شود؛ مبنای کار، مقررات روزِ اقدام است.',
  },
];

const faqs = [
  {
    q: 'بار چند روزه از دبی به انبار من می‌رسد؟',
    a: 'در قرارداد ضمانت، زمان تحویل مشخص می‌شود: بسته به کالا و بندر، از ۱۵ تا ۲۵ روز از دبی تا انبار شما — مگر در شرایط فورس ماژور. اگر کالا نیاز به مجوز یا ارزیابی بیشتری داشته باشد، پیش از شروع کار به شما اعلام می‌کنیم.',
  },
  {
    q: 'قیمت اعلامی تا آخر تغییر نمی‌کند؟',
    a: 'قیمت اعلامی اوکیان تا تحویل کامل بار تغییر نمی‌کند. اگر در جریان کار مشخص شود کالا نیاز به مجوز یا فرایند اضافه‌ای دارد، پیش از هر هزینه‌ای با شما هماهنگ می‌شود.',
  },
  {
    q: 'دوبه (دوویه) چیست؟',
    a: 'دوبه یک شناور باری کوتاه‌برد است که برای مسیرهای نزدیک خلیج فارس استفاده می‌شود و بار را از دبی به بندرهای ایرانی می‌آورد. برای محموله‌های بزرگ‌تر از لنج استفاده می‌شود؛ انتخاب بین این دو به حجم، وزن و بندر ورود بستگی دارد.',
  },
  {
    q: 'آیا واردات ملوانی بدون عوارض گمرکی است؟',
    a: 'خیر. این رویه امتیازها و نرخ‌های خودش را دارد و پرداخت وجوه قانونی بخشی از کار است. اینکه کالای شما چه امتیازی می‌گیرد به نوع کالا و مقررات جاری بستگی دارد؛ پیش از خرید، وضعیت همان کالا را بررسی و مکتوب اعلام می‌کنیم.',
  },
  {
    q: 'تفاوت کالای همراه ملوان با رویهٔ ملوانی چیست؟',
    a: 'کالای همراه ملوان، سهمیهٔ شخصی خدمهٔ شناور است و سقف جداگانه‌ای دارد؛ رویهٔ ملوانی، ورود بار شناور با فهرست بار و اظهارنامهٔ خودش است. این دو را نباید یکی گرفت؛ سقف هیچ‌کدام را هم نمی‌توان بدون دیدن مقررات روز به‌صورت عددی اعلام کرد.',
  },
  {
    q: 'از کدام بندرها انجام می‌شود؟',
    a: 'امروز بار را مستقیم از دبی به بوشهر و بندرعباس می‌آوریم و مسیر قدیمی (از طریق خصب در عمان) هم در شرایطی که لازم باشد بررسی می‌شود. بندر ورود را در فرم استعلام بنویسید تا امکان کار در همان محل و مسیر حمل داخلی بررسی شود.',
  },
];
---

<BaseLayout
  title="واردات ملوانی (ته لنجی)؛ حمل مستقیم از دبی و ضمانت"
  description={description}
  jsonLd={[
    breadcrumbLd(crumbs, Astro.site),
    serviceLd({ name: 'واردات ملوانی (ته لنجی)', description, path, serviceType: 'Sailor/border-trade import' }, Astro.site),
  ]}
>
  <PageHero
    eyebrow="خدمات"
    title="واردات ملوانی (ته لنجی)"
    lead="رویهٔ ملوانی یکی از مسیرهای قانونی ورود کالا از راه دریاست. در روش قدیمی، بار داخل امارات از طریق خصب (عمان) به ایران حمل می‌شد که هزینه‌های حمل را به‌شدت افزایش می‌داد."
    crumbs={crumbs}
  >
    <div class="hero-actions">
      <a class="btn" href={contactCta.href}>
        {contactCta.label}
        <Icon name="arrow" class="btn__icon" />
      </a>
      <a class="btn btn--ghost" href="#routes">مسیرهای حمل</a>
    </div>
    <SailorArt slot="art" />
  </PageHero>

  <!-- What it is -->
  <section class="section" aria-labelledby="what-title">
    <div class="container split">
      <div class="stack reveal" style="--stack: 1.1rem">
        <h2 id="what-title">واردات ملوانی چیست و چه فرقی با واردات کانتینری دارد؟</h2>
        <p class="lead-text">
          رویهٔ ملوانی — که در بازار با نام ته لنجی شناخته می‌شود — ورود کالا با شناورهای مشمول تجارت مرزی از بنادر جنوبی است؛ با فهرست کالای مجاز، سهمیه و
          تشریفات گمرکی مشخص. برخلاف حمل کانتینری، در این رویه خبری از دِموراژ، ثبت سفارش، کد سلفا و بازرسی‌های پیچیدهٔ گمرکی نیست.
        </p>
        <p class="callout-line">
          <Icon name="shield" />
          <span>رویهٔ ملوانی کاملاً قانونی است و از طریق گمرکات و با ارائهٔ مستندات انجام می‌شود.</span>
        </p>
        <div class="notice">
          <Icon name="info" />
          <p>
            فهرست کالاهای مجاز، سهمیه، مدارک و میزان امتیازهای گمرکی این رویه با مقررات تعیین و به‌روز می‌شود. در واردات ملوانی، برای هر محموله، وضعیت همان
            محموله را بررسی و اعلام می‌کنیم.
          </p>
        </div>
      </div>

      <aside class="fit-card reveal" aria-labelledby="fit-title">
        <h3 id="fit-title">این مسیر برای شما مناسب است اگر…</h3>
        <ul class="checklist">
          {fit.map((item) => <li>{item}</li>)}
        </ul>
        <p class="muted">
          اگر کالا در فهرست مجاز نباشد، مسیر جایگزین، <a href="/import-services/">واردات رسمی</a> است؛ پیش از تصمیم، هر دو مسیر را با هم مقایسه می‌کنیم.
        </p>
      </aside>
    </div>
  </section>

  <!-- Routes: the two maps -->
  <section class="section section--alt section--grain" id="routes" aria-labelledby="routes-title">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">مسیر حمل</span>
        <h2 id="routes-title">از مسیر قدیمی خصب تا حمل مستقیم از دبی</h2>
        <p class="lead">
          در روش قدیمی، بار ابتدا داخل امارات جابه‌جا می‌شد و بعد از طریق خصب در عمان به ایران می‌آمد؛ این مسیر هزینهٔ حمل را به‌شدت بالا می‌برد. امروز
          اوکیان همین بار را مستقیم از دبی به بوشهر یا بندرعباس می‌آورد.
        </p>
      </header>

      <div class="routes">
        <figure class="route-card reveal">
          <RouteMap variant="via-khasab" label="نقشهٔ مسیر قدیمی: دبی، خصب در عمان، سپس بندرعباس" />
          <figcaption>
            <span class="route-card__tag">مسیر قدیمی</span>
            <h3>از داخل امارات، از طریق خصب (عمان)</h3>
            <p>جابه‌جایی چندمرحله‌ای، تخلیه و بارگیری اضافه و زمان بیشتر؛ نتیجه‌اش هزینهٔ بالاتر برای صاحب کالا بود.</p>
          </figcaption>
        </figure>

        <figure class="route-card route-card--accent reveal">
          <RouteMap variant="direct" label="نقشهٔ مسیر مستقیم: دبی، بوشهر و بندرعباس" />
          <figcaption>
            <span class="route-card__tag route-card__tag--accent">مسیر امروز اوکیان</span>
            <h3>مستقیم از دبی به بوشهر و بندرعباس</h3>
            <p>یک بارگیری، یک مسیر و یک برنامهٔ زمانی روشن؛ هزینه به‌مراتب کمتر و بار با سرعت بالاتری تحویل شما می‌شود.</p>
          </figcaption>
        </figure>
      </div>

      <div class="route-note reveal">
        <p>
          شرکت اوکیان این امکان را دارد که بار شما را مستقیماً از دبی به یکی از بنادر بوشهر حمل، ترخیص و به همهٔ شهرهای کشور حمل کند و در انبار شما تحویل
          دهد. مسیر دوم، دو راه مستقیم از دبی به بوشهر و بندرعباس را نشان می‌دهد.
        </p>
      </div>
    </div>
  </section>

  <!-- Types of carriage -->
  <section class="section" aria-labelledby="types-title">
    <div class="container split split--wide">
      <header class="section-head sticky-head reveal">
        <span class="eyebrow">انواع حمل</span>
        <h2 id="types-title">با دوبه یا با لنج؟</h2>
        <p class="lead">انتخاب شناور به حجم بار، بندر ورود و زمان تحویل بستگی دارد؛ هر دو نوع را برای همان محموله بررسی می‌کنیم.</p>
      </header>

      <div class="types reveal">
        <article class="type-card">
          <h3><Icon name="ship" /> دوبه (دوویه)</h3>
          <p>
            شناور باری کوتاه‌برد برای مسیرهای نزدیک خلیج فارس؛ برای بارهای حجیم‌تر و محموله‌هایی که باید در بندر مشخصی تخلیه شوند مناسب است.
          </p>
        </article>
        <article class="type-card">
          <h3><Icon name="ship" /> لنج</h3>
          <p>
            شناور سنتی و رایج این رویه؛ برای محموله‌های سبک‌تر و سفرهای پرتعداد استفاده می‌شود و انعطاف بیشتری در بندر تخلیه دارد.
          </p>
        </article>
        <div class="type-routes">
          <p><strong>مسیرها:</strong> مستقیم از دبی به بوشهر یا بندرعباس؛ و در صورت نیاز، مسیر قدیمی از طریق عمان (خصب).</p>
          <p><strong>دوبه چیست؟</strong> همان «دوویه»؛ شناور باری‌ای که مسیر حرکت بار شما را از دبی به بندرهای ایران ممکن می‌کند.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Advantages -->
  <section class="section section--alt" aria-labelledby="adv-title">
    <div class="container split split--wide">
      <header class="section-head sticky-head reveal">
        <span class="eyebrow">مزایا</span>
        <h2 id="adv-title">مزایای حمل ملوانی نسبت به حمل کانتینری</h2>
        <p class="lead">چرا بسیاری از واردکنندگان برای بارهای سازگار با این رویه، ملوانی را به کانتینر ترجیح می‌دهند.</p>
      </header>
      <ul class="checklist adv-list reveal">
        {advantages.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <!-- Guarantees -->
  <section class="section section--dark" aria-labelledby="guarantee-title">
    <div class="container split">
      <div class="stack reveal" style="--stack: 1.1rem">
        <span class="eyebrow">قرارداد ضمانت</span>
        <h2 id="guarantee-title">امنیت حمل ملوانی</h2>
        <p class="lead">
          اوکیان تحت یک قرارداد ضمانت با شما وارد همکاری می‌شود. در این قرارداد سه مورد زیر مورد ضمانت قرار می‌گیرد و در متن قرارداد نوشته می‌شود.
        </p>
        <a class="arrow-link" href="/guarantee/">
          شرایط ضمانت و مرز مسئولیت‌ها
          <Icon name="arrow" />
        </a>
      </div>
      <ol class="guarantees reveal">
        {
          guarantees.map((g) => (
            <li>
              <h3>{g.title}</h3>
              <p>{g.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Scope -->
  <section class="section" aria-labelledby="scope-title">
    <div class="container split split--wide">
      <header class="section-head sticky-head reveal">
        <span class="eyebrow">دامنهٔ خدمت</span>
