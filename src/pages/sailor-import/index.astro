---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/layout/PageHero.astro';
import SailorArt from '~/components/illustrations/SailorArt.astro';
import Steps from '~/components/ui/Steps.astro';
import Faq from '~/components/ui/Faq.astro';
import CtaBand from '~/components/ui/CtaBand.astro';
import Icon from '~/components/ui/Icon.astro';
import { breadcrumbLd, serviceLd } from '~/lib/schema';
import { contactCta } from '~/config/site';

const path = '/sailor-import/';
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'واردات ملوانی', path },
];
const description =
  'واردات ملوانی یا ته لنجی: بررسی کالای مجاز، سهمیه و مدارک شناور، اظهار و ترخیص در بنادر جنوبی. مشاورهٔ تخصصی پیش از خرید کالا.';

// REVIEW: the permitted goods list, quotas and duty concessions are set by
// regulation and change; nothing numeric is stated on this page on purpose.
const fit = [
  'کالای شما از نظر نوع، در فهرست مجاز این رویه قرار می‌گیرد.',
  'حجم و ارزش محموله در سهمیهٔ تعیین‌شده برای همان سفر و همان شناور است.',
  'مبدأ کالا و بندر ورود با مسیرهای مجاز رویهٔ ملوانی هم‌خوانی دارد.',
  'اسناد شناور و مدارک مالکیت کالا روشن و قابل ارائه است.',
];

const scope = [
  'بررسی شرح کالا و تطبیق آن با فهرست کالاهای مجاز این رویه',
  'بررسی سهمیه، ظرفیت شناور و بندری که اظهار در آن انجام می‌شود',
  'مرور اسناد شناور و مدارک مالکیت کالا پیش از حرکت',
  'تنظیم و ثبت اظهارنامه و پیگیری پرونده در گمرک',
  'هماهنگی ارزیابی، کنترل‌ها و پرداخت وجوه قانونی',
  'گزارش وضعیت پرونده در هر مرحله تا تحویل کالا',
];

const steps = [
  {
    title: 'بررسی امکان‌پذیری کالا',
    text: 'شرح کالا، کاربرد و کد تعرفهٔ آن را بررسی می‌کنیم و با فهرست کالاهای مجاز این رویه تطبیق می‌دهیم. اگر کالا مناسب این مسیر نباشد، پیش از هر هزینه‌ای اعلام می‌کنیم.',
  },
  {
    title: 'بررسی سهمیه و شناور',
    text: 'شرایط شناور، سهمیهٔ همان سفر و بندری که کالا در آن اظهار می‌شود بررسی می‌شود؛ چون این سه، دامنهٔ کار را تعیین می‌کنند.',
  },
  {
    title: 'هماهنگی اسناد و بار',
    text: 'فهرست بار، اسناد شناور و مدارک کالا با هم هم‌خوان می‌شوند تا کالا در بندر به دلیل مغایرت اسناد متوقف نشود.',
  },
  {
    title: 'اظهار و ارزیابی',
    text: 'اظهارنامه تنظیم و ثبت می‌شود و پرونده در ارزیابی و کنترل‌های مربوط به این رویه پیگیری می‌شود.',
    note: 'مسیر رسیدگی و پذیرش نهایی اسناد و ارزش، تصمیم گمرک است.',
  },
  {
    title: 'پرداخت وجوه و ترخیص',
    text: 'وجوه قانونی این رویه بر پایهٔ ارزیابی نهایی پرداخت می‌شود و پس از صدور اجازهٔ خروج، کالا ترخیص و برای حمل داخلی آماده می‌شود.',
  },
];

const documents = {
  first: ['شرح کالا و کاربرد آن', 'فهرست بار یا مانیفست', 'بندر مبدأ و مقصد', 'مشخصات شناور و مالک آن'],
  full: ['اسناد ثبت شناور و مجوزهای آن', 'مدارک هویتی مالک یا نمایندهٔ قانونی', 'اسناد خرید و مالکیت کالا', 'اطلاعات ثبت‌شده در سامانه‌های مربوط'],
};

const limits = [
  {
    title: 'فهرست کالاهای مجاز',
    text: 'این رویه برای همهٔ کالاها باز نیست؛ اگر کالا در فهرست مجاز نباشد، مسیر ملوانی برای آن ممکن نیست.',
  },
  {
    title: 'سهمیهٔ سفر و سال',
    text: 'سقف مقدار و ارزش کالا برای هر سفر و در سال تعیین می‌شود و سقف کار شما را مشخص می‌کند.',
  },
  {
    title: 'مشخصات و اسناد شناور',
    text: 'شناور باید در محدودهٔ مشمول این رویه باشد و اسناد و مجوزهای آن کامل باشد.',
  },
  {
    title: 'مالکیت و مدارک کالا',
    text: 'کالا باید سند و صاحب روشن داشته باشد؛ ابهام در مالکیت، پرونده را متوقف می‌کند.',
  },
  {
    title: 'ارزیابی گمرک',
    text: 'تطبیق کالا با اظهار و پذیرش ارزش، بر پایهٔ ارزیابی گمرک انجام می‌شود.',
  },
  {
    title: 'تغییر مقررات',
    text: 'شرایط و امتیازهای این رویه با بخشنامه‌ها و آیین‌نامه‌ها به‌روز می‌شود؛ مبنای کار، مقررات روزِ اقدام است.',
  },
];

const faqs = [
  {
    q: 'آیا واردات ملوانی بدون عوارض گمرکی است؟',
    a: 'خیر. این رویه امتیازها و نرخ‌های خودش را دارد و پرداخت وجوه قانونی بخشی از کار است. اینکه کالای شما چه امتیازی می‌گیرد به نوع کالا و مقررات جاری بستگی دارد؛ پیش از خرید، وضعیت همان کالا را بررسی و مکتوب اعلام می‌کنیم.',
  },
  {
    q: 'تفاوت کالای همراه ملوان با رویهٔ ملوانی چیست؟',
    a: 'کالای همراه ملوان، سهمیهٔ شخصی خدمهٔ شناور است و سقف جداگانه‌ای دارد؛ رویهٔ ملوانی، ورود بار شناور با فهرست بار و اظهارنامهٔ خودش است. این دو را نباید یکی گرفت؛ سقف هیچ‌کدام را هم نمی‌توان بدون دیدن مقررات روز به‌صورت عددی اعلام کرد.',
  },
  {
    q: 'چه کالاهایی از این مسیر وارد می‌شوند؟',
    a: 'فقط کالاهایی که در فهرست مجاز این رویه قرار دارند. این فهرست با مقررات تعیین می‌شود و تغییر می‌کند؛ شرح کالای خود را بفرستید تا تطبیق آن را بررسی کنیم.',
  },
  {
    q: 'از کدام بندرها انجام می‌شود؟',
    a: 'این رویه در بنادر جنوبی و در گمرکات مجازِ آن اجرا می‌شود. بندر ورود را در فرم مشاوره بنویسید تا امکان کار در همان محل و مسیر حمل داخلی بررسی شود.',
  },
];
---

<BaseLayout
  title="واردات ملوانی (ته لنجی)؛ شرایط، مدارک و ترخیص"
  description={description}
  jsonLd={[
    breadcrumbLd(crumbs, Astro.site),
    serviceLd({ name: 'واردات ملوانی (ته لنجی)', description, path, serviceType: 'Sailor/border-trade import' }, Astro.site),
  ]}
>
  <PageHero
    eyebrow="خدمات"
    title="واردات ملوانی (ته لنجی)"
    lead="رویهٔ ملوانی یکی از مسیرهای قانونی ورود کالا از راه دریا است؛ با فهرست کالای مجاز، سهمیه و تشریفات گمرکی مشخص. پیش از خرید، بدانید کالای شما با این مسیر سازگار است یا نه."
    crumbs={crumbs}
  >
    <div class="hero-actions">
      <a class="btn" href={contactCta.href}>
        {contactCta.label}
        <Icon name="arrow" class="btn__icon" />
      </a>
      <a class="btn btn--ghost" href="#process">مراحل کار</a>
    </div>
    <SailorArt slot="art" />
  </PageHero>

  <!-- What it is -->
  <section class="section" aria-labelledby="what-title">
    <div class="container split">
      <div class="stack reveal" style="--stack: 1.1rem">
        <h2 id="what-title">واردات ملوانی چیست و چه فرقی با واردات رسمی دارد؟</h2>
        <p class="lead-text">
          در رویهٔ ملوانی — که در بازار با نام ته لنجی هم شناخته می‌شود — کالا با شناورهای مشمول مقررات تجارت مرزی از بنادر جنوبی وارد می‌شود. این رویه برای
          پشتیبانی از معیشت ساحل‌نشینان شکل گرفته و به همین دلیل محدودیت‌های خودش را دارد: فقط کالاهای فهرست مجاز، در سهمیهٔ تعیین‌شده و با تشریفات مخصوص
          همین رویه.
        </p>
        <p class="lead-text">
          یعنی واردات ملوانی «واردات بدون گمرک» نیست. اظهار کالا، ثبت اطلاعات در سامانه‌ها، ارزیابی و پرداخت وجوه قانونی — با امتیازهایی که مقررات برای این
          رویه در نظر گرفته — بخشی از کار است. تفاوت اصلی با واردات رسمی در همین چارچوب است: نوع کالا، سهمیه و رویهٔ اظهار.
        </p>
        <div class="notice">
          <Icon name="info" />
          <p>
            فهرست کالاهای مجاز، سهمیه، مدارک و میزان امتیازهای گمرکی این رویه با مقررات تعیین و به‌روز می‌شود. در این صفحه عدد قطعی نمی‌آوریم؛ برای هر
            محموله، وضعیت همان کالا را بررسی و مکتوب اعلام می‌کنیم.
          </p>
        </div>
      </div>

      <aside class="fit-card reveal" aria-labelledby="fit-title">
        <h3 id="fit-title">این مسیر برای شما مناسب است اگر…</h3>
        <ul class="checklist">
          {fit.map((item) => <li>{item}</li>)}
        </ul>
        <p class="muted">
          اگر کالا در فهرست مجاز نباشد، مسیر جایگزین، <a href="/import-services/">واردات رسمی</a> است؛ پیش از تصمیم، هر دو مسیر را با هم مقایسه می‌کنیم.
        </p>
      </aside>
    </div>
  </section>

  <!-- Scope -->
  <section class="section section--alt section--grain" aria-labelledby="scope-title">
    <div class="container split split--wide">
      <header class="section-head sticky-head reveal">
        <span class="eyebrow">دامنهٔ خدمت</span>
        <h2 id="scope-title">در این مسیر چه کاری انجام می‌دهیم</h2>
        <p class="lead">تمرکز ما بر بررسی امکان‌پذیری، اسناد و تشریفات گمرکی است؛ نه خرید و فروش کالا.</p>
      </header>
      <ul class="checklist scope-list reveal">
        {scope.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section class="section" id="process" aria-labelledby="process-title">
    <div class="container split split--wide">
      <header class="section-head sticky-head reveal">
        <span class="eyebrow">فرایند</span>
        <h2 id="process-title">از بررسی کالا تا ترخیص</h2>
        <p class="lead">ترتیب کلی کار در یک محمولهٔ ملوانی. بسته به بندر و نوع کالا، ممکن است برخی مراحل هم‌زمان پیش برود.</p>
      </header>
      <Steps items={steps} />
    </div>
  </section>

  <!-- Documents -->
  <section class="section section--dark" aria-labelledby="docs-title">
    <div class="container split">
      <div class="stack reveal" style="--stack: 1.1rem">
        <span class="eyebrow">شروع کار</span>
        <h2 id="docs-title">اطلاعات و مدارکی که لازم است</h2>
        <p class="lead">
          برای بررسی اولیه لازم نیست همهٔ مدارک کامل باشد. اطلاعات کالا و شناور را بفرستید؛ کمبودها را با هم مشخص می‌کنیم.
        </p>
        <a class="arrow-link" href="/guides/customs-clearance-documents/">
          فهرست مدارک ترخیص کالا
          <Icon name="arrow" />
        </a>
      </div>
      <div class="docs-cols reveal">
        <div>
          <h3>برای بررسی اولیه</h3>
          <ul class="checklist">
            {documents.first.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <h3>برای انجام کار</h3>
          <ul class="checklist">
            {documents.full.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Limits -->
  <section class="section" aria-labelledby="limits-title">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">نکته‌های تعیین‌کننده</span>
        <h2 id="limits-title">چه چیزهایی نتیجهٔ کار را تعیین می‌کند؟</h2>
        <p class="lead">در این رویه، بیشتر توقف‌ها از نادیده گرفتن یکی از این شش مورد می‌آید.</p>
      </header>
      <dl class="factors">
        {
          limits.map((f) => (
            <div class="factors__item reveal">
              <dt>{f.title}</dt>
              <dd>{f.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt" aria-labelledby="faq-title">
    <div class="container split split--wide">
      <header class="section-head reveal">
        <span class="eyebrow">پرسش‌های رایج</span>
        <h2 id="faq-title">پرسش‌های رایج دربارهٔ واردات ملوانی</h2>
      </header>
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand
    title="کالای شما با مسیر ملوانی سازگار است؟"
    text="شرح کالا، بندر ورود و مشخصات شناور را بفرستید. بررسی می‌کنیم کالا در فهرست مجاز است یا نه، سهمیه چه محدودیتی می‌گذارد و چه مدارکی لازم است."
  />
</BaseLayout>

<style>
  .lead-text {
    font-size: var(--step-1);
    line-height: 2;
    color: var(--slate-700);
  }
  .scope-list {
    padding-block: 0.5rem;
  }
  .scope-list :global(li) {
    font-size: var(--step-0);
  }
  .docs-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  .docs-cols h3 {
    font-size: var(--step-1);
    color: var(--petrol-200);
    margin-bottom: 1rem;
  }
  .factors {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 2.5rem;
    margin: 0;
  }
  .factors__item {
    padding-block: 1.6rem;
    border-top: 1px solid var(--rule-strong);
  }
  .factors dt {
    margin-bottom: 0.4rem;
    font-weight: 800;
    font-size: var(--step-1);
  }
  .factors dd {
    margin: 0;
    color: var(--text-muted);
  }
  @media (max-width: 960px) {
    .factors {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .factors,
    .docs-cols {
      grid-template-columns: 1fr;
    }
  }
</style>
