---
/**
 * بلاگ / راهنماها — the single index of every content page on the site:
 * guides, origin-country pages and customs-office pages. Kept as the target of
 * the «بلاگ» nav item, so all editorial content is reachable from one place.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/layout/PageHero.astro';
import GuidesArt from '~/components/illustrations/GuidesArt.astro';
import CtaBand from '~/components/ui/CtaBand.astro';
import Icon from '~/components/ui/Icon.astro';
import { breadcrumbLd, itemListLd } from '~/lib/schema';
import { formatFaDate, toFa } from '~/lib/format';
import { services } from '~/data/services';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const origins = (await getCollection('origins')).sort((a, b) => a.data.order - b.data.order);
const offices = (await getCollection('customs')).sort((a, b) => a.data.order - b.data.order);

const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'بلاگ', path: '/guides/' },
];

const groups = [
  { id: 'clearance', service: services.clearance, items: guides.filter((g) => g.data.relatedService === 'customs-clearance') },
  { id: 'import', service: services.import, items: guides.filter((g) => g.data.relatedService === 'import-services') },
];

/** Every page listed below, in the order it appears — used for the ItemList. */
const allItems = [
  ...guides.map((g) => ({ name: g.data.title, path: `/guides/${g.id}/` })),
  ...origins.map((o) => ({ name: o.data.title, path: `/imports/${o.id}/` })),
  ...offices.map((o) => ({ name: o.data.title, path: `/customs/${o.id}/` })),
];

const topics = [
  { href: '/guides/customs-clearance-guide/', label: 'ترخیص کالا چیست' },
  { href: '/guides/customs-clearance-cost/', label: 'هزینهٔ ترخیص' },
  { href: '/guides/customs-clearance-documents/', label: 'مدارک ترخیص' },
  { href: '/guides/customs-routes/', label: 'مسیر سبز، زرد و قرمز' },
  { href: '/guides/customs-declaration-errors/', label: 'خطاهای اظهارنامه' },
  { href: '/guides/import-permits/', label: 'مجوزهای واردات' },
  { href: '/guides/import-process/', label: 'مراحل واردات' },
  { href: '/guides/sailor-import-guide/', label: 'واردات ملوانی' },
  { href: '/guides/goods-by-type/', label: 'ترخیص بر اساس کالا' },
  { href: '/guides/transit-and-warehousing/', label: 'ترانزیت و انبار گمرکی' },
  { href: '/guides/customs-glossary/', label: 'واژه‌نامهٔ گمرکی' },
  { href: '/imports/china/', label: 'واردات از چین' },
  { href: '/imports/dubai/', label: 'واردات از دبی' },
  { href: '/imports/turkey/', label: 'واردات از ترکیه' },
];
---

<BaseLayout
  title="بلاگ و راهنمای ترخیص، واردات و گمرک"
  description="همهٔ راهنماهای اوکیان در یک صفحه: ترخیص کالا از گمرک، هزینه و مدارک، مجوزهای واردات، واردات از چین و دبی و ترکیه، و راهنمای عملیاتی هر گمرک."
  jsonLd={[
    breadcrumbLd(crumbs, Astro.site),
    itemListLd({ name: 'راهنماهای ترخیص، واردات و گمرک', path: '/guides/', items: allItems }, Astro.site),
  ].filter((x) => x !== null)}
>
  <PageHero
    eyebrow="بلاگ"
    title="راهنمای ترخیص، واردات و گمرک"
    lead="همهٔ محتوای تخصصی اوکیان در یک جا: مبانی ترخیص کالا، هزینه و مدارک، مجوزها، واردات از هر مبدأ و رویهٔ عملیاتی هر گمرک. هر صفحه به منابع رسمی ارجاع می‌دهد و جای بررسی پرونده را نمی‌گیرد."
    crumbs={crumbs}
  >
    <GuidesArt slot="art" />
  </PageHero>

  <section class="section" aria-labelledby="topics-title">
    <div class="container">
      <header class="section-head section-head--split reveal">
        <div>
          <span class="eyebrow">از کجا شروع کنم؟</span>
          <h2 id="topics-title">موضوع‌های پرجست‌وجو</h2>
        </div>
        <p class="lead">
          اگر دنبال یک پاسخ مشخص هستید، از این فهرست شروع کنید. فهرست کامل‌تر، پایین‌تر و به ترتیب موضوع آمده است.
        </p>
      </header>
      <ul class="topic-list">
        {
          topics.map((t) => (
            <li>
              <a href={t.href}>{t.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-label="فهرست راهنماها">
    <div class="container guide-groups">
      {
        groups.map((group) => (
          <section class="guide-group" aria-labelledby={`g-${group.id}`}>
            <header class="guide-group__head">
              <h2 id={`g-${group.id}`}>دربارهٔ {group.service.name}</h2>
              <a class="arrow-link" href={group.service.href}>
                صفحهٔ خدمات {group.service.name}
                <Icon name="arrow" />
              </a>
            </header>
            <ul class="guide-list">
              {group.items.map((g) => (
                <li>
                  <article class="guide-item">
                    <p class="guide-item__meta">
                      <time datetime={(g.data.updatedDate ?? g.data.publishDate).toISOString().slice(0, 10)}>
                        {formatFaDate(g.data.updatedDate ?? g.data.publishDate)}
                      </time>
                      <span aria-hidden="true">·</span>
                      <span>{toFa(g.data.summary.length)} نکتهٔ کلیدی</span>
                    </p>
                    <h3>
                      <a href={`/guides/${g.id}/`}>{g.data.title}</a>
                    </h3>
                    <p>{g.data.description}</p>
                    <ul class="guide-item__points">
                      {g.data.summary.slice(0, 2).map((s) => (
                        <li>{s}</li>
                      ))}
                    </ul>
                  </article>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="origins-title">
    <div class="container">
      <header class="section-head section-head--split reveal">
        <div>
          <span class="eyebrow">مبدأ کالا</span>
          <h2 id="origins-title">واردات بر اساس مبدأ</h2>
        </div>
        <a class="arrow-link" href="/imports/">
          صفحهٔ واردات بر اساس مبدأ
          <Icon name="arrow" />
        </a>
      </header>
      <ul class="origin-grid">
        {
          origins.map((o) => (
            <li class="origin-card">
              <span class="origin-card__country">{o.data.country}</span>
              <h3>
                <a href={`/imports/${o.id}/`}>{o.data.navTitle}</a>
              </h3>
              <p>{o.data.description}</p>
              <ul class="origin-card__chips">
                {o.data.corridors.slice(0, 2).map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="ports-hub-title">
    <div class="container">
      <header class="section-head section-head--split reveal">
        <div>
          <span class="eyebrow">مقصد کالا</span>
          <h2 id="ports-hub-title">راهنمای هر گمرک، جداگانه</h2>
        </div>
        <a class="arrow-link" href="/customs/">
          همهٔ گمرکات
          <Icon name="arrow" />
        </a>
      </header>
      <p class="lead section-lead">
        رویهٔ ترخیص یکی است، اما انبارها، مسیرها و نوع کالای هر گمرک متفاوت است. هفت گمرک پرتردد را با جزئیات عملیاتی بررسی
        کرده‌ایم.
      </p>
      <ul class="port-grid">
        {
          offices.map((o) => (
            <li class="port-card">
              <h3>
                <a href={`/customs/${o.id}/`}>{o.data.office}</a>
              </h3>
              <p class="port-card__city">{o.data.city}</p>
              <p class="port-card__desc">{o.data.description}</p>
              <ul class="origin-card__chips">
                {o.data.cargo.slice(0, 3).map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand title="سؤال شما در راهنماها نبود؟" text="مشخصات کالا و پرسش خود را بفرستید. پس از بررسی، پاسخ متناسب با پروندهٔ شما را می‌دهیم." />
</BaseLayout>

<style>
  .section-lead {
    margin-top: 1rem;
    max-width: 60ch;
  }
  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .topic-list a {
    display: inline-block;
    padding: 0.5rem 1rem;
    font-weight: 700;
    font-size: var(--step--1);
    color: var(--navy-800);
    background: var(--mist-100);
    border: 1px solid var(--rule);
    border-radius: 999px;
    text-decoration: none;
    transition:
      border-color var(--dur-fast) ease,
      color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }
  .topic-list a:hover {
    border-color: var(--petrol-300);
    color: var(--petrol-600);
    background: var(--white);
  }
  .guide-groups {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }
  .guide-group__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--navy-900);
  }
  .guide-group__head h2 {
    font-size: var(--step-3);
  }
  .guide-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 0 3rem;
  }
  .guide-item {
    position: relative;
    display: grid;
    gap: 0.75rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--rule);
  }
  .guide-item__meta {
    display: flex;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .guide-item h3 {
    font-size: var(--step-2);
    line-height: 1.5;
  }
  .guide-item h3 a {
    text-decoration: none;
  }
  /* Whole item clickable, while the link text stays the accessible name */
  .guide-item h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .guide-item:hover h3 a {
    text-decoration: underline;
    text-decoration-color: var(--petrol-300);
    text-decoration-thickness: 2px;
  }
  .guide-item > p:not(.guide-item__meta) {
    color: var(--text-muted);
  }
  .guide-item__points {
    list-style: none;
    display: grid;
    gap: 0.35rem;
    font-size: var(--step--1);
    color: var(--slate-700);
  }
  .guide-item__points li {
    padding-inline-start: 1rem;
    position: relative;
  }
  .guide-item__points li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.85em;
    inline-size: 0.4rem;
    block-size: 2px;
    background: var(--petrol-500);
  }
  .origin-grid,
  .port-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .origin-card,
  .port-card {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: clamp(1.3rem, 3vw, 1.8rem);
    border: 1px solid var(--rule);
    border-top: 4px solid var(--petrol-600);
    border-radius: var(--radius-m);
    background: var(--white);
  }
  .origin-card__country,
  .port-card__city {
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--petrol-600);
  }
  .origin-card h3,
  .port-card h3 {
    font-size: var(--step-1);
  }
  .origin-card h3 a,
  .port-card h3 a {
    color: var(--navy-900);
    text-decoration-color: var(--petrol-300);
    text-underline-offset: 4px;
  }
  .origin-card p,
  .port-card__desc {
    margin: 0;
    font-size: var(--step--1);
    color: var(--slate-700);
    line-height: 1.8;
  }
  .origin-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0.3rem 0 0;
    padding: 0;
  }
  .origin-card__chips li {
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--mist-100);
    color: var(--navy-800);
  }
</style>
