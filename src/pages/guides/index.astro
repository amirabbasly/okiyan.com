---
/**
 * بلاگ — the single, calm index of every content page on the site.
 *
 * The brief for this page: one continuous feed (guides, customs offices and
 * origin pages interleaved by topic order, not split into separate blocks) plus
 * a sticky filter bar that works without JavaScript. Filters are radio inputs +
 * `:has()` in CSS, so the page stays static, the markup stays one list, and
 * every item is crawlable even if scripting is off.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/layout/PageHero.astro';
import GuidesArt from '~/components/illustrations/GuidesArt.astro';
import CtaBand from '~/components/ui/CtaBand.astro';
import { breadcrumbLd, itemListLd } from '~/lib/schema';
import { formatFaDate, readingMinutes, toFa } from '~/lib/format';
import { services } from '~/data/services';
import Photo from '~/components/ui/Photo.astro';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const origins = (await getCollection('origins')).sort((a, b) => a.data.order - b.data.order);
const offices = (await getCollection('customs')).sort((a, b) => a.data.order - b.data.order);

const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'بلاگ', path: '/guides/' },
];

type Kind = 'guide' | 'customs' | 'origin';
interface Post {
  kind: Kind;
  cat: 'clearance' | 'import' | 'customs' | 'origin';
  title: string;
  desc: string;
  href: string;
  date: Date;
  minutes: number;
  order: number;
}

const posts: Post[] = [
  ...guides.map((g) => ({
    kind: 'guide' as const,
    cat: (g.data.relatedService === 'customs-clearance' ? 'clearance' : 'import') as Post['cat'],
    title: g.data.title,
    desc: g.data.description,
    href: `/guides/${g.id}/`,
    date: g.data.updatedDate ?? g.data.publishDate,
    minutes: readingMinutes(g.body ?? ''),
    order: g.data.order,
  })),
  ...offices.map((o) => ({
    kind: 'customs' as const,
    cat: 'customs' as const,
    title: o.data.office,
    desc: o.data.description,
    href: `/customs/${o.id}/`,
    date: o.data.updatedDate ?? o.data.publishDate,
    minutes: readingMinutes(o.body ?? ''),
    order: o.data.order,
  })),
  ...origins.map((o) => ({
    kind: 'origin' as const,
    cat: 'origin' as const,
    title: o.data.title,
    desc: o.data.description,
    href: `/imports/${o.id}/`,
    date: o.data.updatedDate ?? o.data.publishDate,
    minutes: readingMinutes(o.body ?? ''),
    order: o.data.order,
  })),
].sort((a, b) => a.order - b.order || ['guide', 'customs', 'origin'].indexOf(a.kind) - ['guide', 'customs', 'origin'].indexOf(b.kind));

const kindLabel: Record<Post['cat'], string> = {
  clearance: 'راهنمای ترخیص',
  import: 'راهنمای واردات',
  customs: 'گمرک',
  origin: 'مبدأ',
};

const filters = [
  { id: 'all', label: 'همه', count: posts.length },
  { id: 'clearance', label: 'ترخیص', count: posts.filter((p) => p.cat === 'clearance').length },
  { id: 'import', label: 'واردات', count: posts.filter((p) => p.cat === 'import').length },
  { id: 'customs', label: 'گمرک‌ها', count: posts.filter((p) => p.cat === 'customs').length },
  { id: 'origin', label: 'مبدأها', count: posts.filter((p) => p.cat === 'origin').length },
];

/** Structured data keeps the editorial, then destination, then origin order. */
const ldItems = [
  ...guides.map((g) => ({ name: g.data.title, path: `/guides/${g.id}/` })),
  ...origins.map((o) => ({ name: o.data.title, path: `/imports/${o.id}/` })),
  ...offices.map((o) => ({ name: o.data.office, path: `/customs/${o.id}/` })),
];
---

<BaseLayout
  ogImage="/og/guides.jpg"
  ogImageAlt="میز مطالعه با کتاب و نقشهٔ دریایی"
  title="بلاگ و راهنمای ترخیص، واردات و گمرک"
  description="همهٔ راهنماهای اوکیان در یک صفحه: ترخیص کالا از گمرک، هزینه و مدارک، مجوزهای واردات، واردات از چین و دبی و ترکیه، و راهنمای عملیاتی هر گمرک."
  jsonLd={[
    breadcrumbLd(crumbs, Astro.site),
    itemListLd({ name: 'راهنماهای ترخیص، واردات و گمرک', path: '/guides/', items: ldItems }, Astro.site),
  ].filter((x) => x !== null)}
>
  <PageHero
    eyebrow="کتابخانهٔ محتوا"
    title="راهنمای ترخیص، واردات و گمرک"
    lead="همهٔ محتوای تخصصی اوکیان در یک جریان پیوسته: مبانی ترخیص، هزینه و مدارک، مجوزها، رویهٔ هر گمرک و مسیر واردات از هر مبدأ. برای پیدا کردن سریع‌تر، از نوار بالای فهرست فیلتر کنید."
    crumbs={crumbs}
  >
    <GuidesArt slot="art" />
  </PageHero>

  <div class="blog">
    <div class="blog__filter" role="group" aria-label="فیلتر نوشته‌ها">
      <div class="container blog__filter-inner">
        <div class="blog__opts">
          {
            filters.map((f, i) => (
              <span class="blog__opt">
                <input
                  class="blog__radio"
                  type="radio"
                  name="blog-filter"
                  id={`bf-${f.id}`}
                  value={f.id}
                  checked={i === 0}
                />
                <label for={`bf-${f.id}`}>
                  {f.label}
                  <span class="blog__count">{toFa(f.count)}</span>
                </label>
              </span>
            ))
          }
        </div>
        <p class="blog__start">
          تازه شروع کرده‌اید؟ از <a href="/guides/customs-clearance-guide/">ترخیص کالا چیست</a> و{' '}
          <a href="/guides/customs-clearance-documents/">مدارک لازم</a> بخوانید.
        </p>
      </div>
    </div>

  <section class="section section--tight" aria-label="تصویر راهنماها با منابع رسمی نوش">
    <div class="container">
      <Photo
        name="guides-desk"
        alt="میز مطالعه در کنار پنجره با کتاب‌های مرجع، دفتر باز، نقشهٔ دریایی و فنجان چای"
        width={1600}
        height={900}
        caption="راهنماها با منابع رسمی نوشته می‌شوند و تاریخ به‌روزرسانی دارند؛ مثال‌ها نمایشی‌اند و با برچسب مشخص شده‌اند."
      />
    </div>
  </section>

    <section class="section blog__feed-wrap" aria-labelledby="feed-title">
      <div class="container">
        <h2 id="feed-title" class="sr-only">فهرست نوشته‌ها</h2>
        <ul class="blog__feed">
          {
            posts.map((p) => (
              <li class="post" data-cat={p.cat}>
                <article class="post__inner">
                  <p class="post__kind">{kindLabel[p.cat]}</p>
                  <h3 class="post__title">
                    <a href={p.href}>{p.title}</a>
                  </h3>
                  <p class="post__desc">{p.desc}</p>
                  <p class="post__meta">
                    <time datetime={p.date.toISOString().slice(0, 10)}>{formatFaDate(p.date)}</time>
                    <span aria-hidden="true">·</span>
                    <span>{toFa(p.minutes)} دقیقه مطالعه</span>
                  </p>
                </article>
              </li>
            ))
          }
        </ul>
        <p class="blog__note">
          این فهرست با هر راهنمای تازه به‌روز می‌شود. راهنمای هر خدمت هم جداگانه در{' '}
          <a href={services.clearance.href}>صفحهٔ ترخیص کالا</a> و <a href={services.import.href}>صفحهٔ واردات کالا</a> آمده است.
        </p>
      </div>
    </section>
  </div>

  <CtaBand title="سؤال شما در راهنماها نبود؟" text="مشخصات کالا و پرسش خود را بفرستید. پس از بررسی، پاسخ متناسب با پروندهٔ شما را می‌دهیم." />
</BaseLayout>

<style>
  /* ---------- Sticky filter bar ---------- */
  .blog__filter {
    position: sticky;
    top: var(--header-h);
    z-index: 20;
    padding-block: 0.75rem;
    background: var(--white);
    border-bottom: 1px solid var(--rule);
  }
  .blog__filter-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }
  .blog__opts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .blog__opt {
    position: relative;
    display: inline-flex;
  }
  .blog__radio {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .blog__opt label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.45rem 0.9rem;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--navy-800);
    background: var(--white);
    border: 1px solid var(--rule);
    border-radius: 999px;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) ease,
      background-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }
  .blog__opt label:hover {
    border-color: var(--petrol-300);
    color: var(--petrol-600);
  }
  .blog__count {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-muted);
  }
  .blog__radio:checked + label {
    color: var(--white);
    background: var(--navy-900);
    border-color: var(--navy-900);
  }
  .blog__radio:checked + label .blog__count {
    color: color-mix(in srgb, var(--white) 70%, transparent);
  }
  .blog__radio:focus-visible + label {
    outline: 2px solid var(--petrol-600);
    outline-offset: 2px;
  }
  .blog__start {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .blog__start a {
    color: var(--petrol-600);
    font-weight: 700;
    text-underline-offset: 3px;
  }

  /* ---------- One continuous feed ---------- */
  .blog__feed-wrap {
    padding-block: clamp(1.5rem, 4vw, 2.75rem) clamp(3rem, 7vw, 5rem);
  }
  .blog__feed {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    column-gap: clamp(2rem, 4vw, 3.5rem);
    margin: 0;
    padding: 0;
  }
  .post__inner {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding-block: 1.6rem;
    border-top: 1px solid var(--rule);
  }
  .post__kind {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--petrol-600);
  }
  .post__title {
    font-size: var(--step-1);
    line-height: 1.55;
  }
  .post__title a {
    color: var(--navy-900);
    text-decoration: none;
  }
  /* The whole row is clickable; the link text remains the accessible name. */
  .post__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .post__inner:hover .post__title a {
    text-decoration: underline;
    text-decoration-color: var(--petrol-300);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .post__desc {
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.85;
    color: var(--text-muted);
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.15rem 0 0;
    font-size: 0.76rem;
    color: var(--slate-700);
  }
  .blog__note {
    max-width: 62ch;
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .blog__note a {
    color: var(--navy-800);
    font-weight: 700;
  }

  /* ---------- Filters (progressive: no JS, all items visible if :has() is missing) ---------- */
  .blog:has(#bf-clearance:checked) .post:not([data-cat='clearance']),
  .blog:has(#bf-import:checked) .post:not([data-cat='import']),
  .blog:has(#bf-customs:checked) .post:not([data-cat='customs']),
  .blog:has(#bf-origin:checked) .post:not([data-cat='origin']) {
    display: none;
  }

  @media (max-width: 720px) {
    .blog__filter {
      position: static;
    }
    .blog__start {
      display: none;
    }
  }
</style>
