---
/**
 * محاسبهٔ هزینهٔ ترخیص — a transparent formula engine.
 *
 * This page used to ship with placeholder rates (a fixed VAT %, a fixed port %, a
 * fixed service fee). Those numbers were removed: a default rate on a public page
 * looks authoritative and quietly enters a real business decision.
 *
 * What the page does now:
 * - prints the FORMULA of every cost line, server-side, before any input;
 * - takes every rate from the visitor (duty, VAT, exchange rate) — no defaults;
 * - computes in the browser with the same `estimate()` used for the markup, so the
 *   numbers on screen are exactly the printed formulas applied to typed values;
 * - points at the official source of each rate instead of guessing it.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/layout/PageHero.astro';
import CtaBand from '~/components/ui/CtaBand.astro';
import AnswerBlock from '~/components/ui/AnswerBlock.astro';
import Faq from '~/components/ui/Faq.astro';
import Icon from '~/components/ui/Icon.astro';
import ClusterNav from '~/components/ui/ClusterNav.astro';
import { breadcrumbLd, faqLd } from '~/lib/schema';
import { currencies, excluded, formulae } from '~/data/pricing';
import { toFa } from '~/lib/format';

const path = '/price-calculator/';
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'ابزارها', path: '/tools/' },
  { name: 'ماشین‌حساب هزینهٔ ترخیص', path },
];

const answer =
  'هزینهٔ ترخیص یک محموله از پنج قلم ساخته می‌شود: ارزش گمرکی کالا که از جمع بهای خرید، حمل و بیمه در نرخ ارز روز اظهار به دست می‌آید؛ حقوق ورودی که ماخذ کد تعرفه بر ارزش گمرکی اعمال می‌شود؛ مالیات و عوارض ارزش افزوده که بر جمع ارزش گمرکی و حقوق ورودی حساب می‌شود؛ هزینه‌های بندری و انبارداری؛ و کارمزد خدمات ترخیص. این ماشین‌حساب، همان پنج فرمول را اجرا می‌کند و نرخ‌ها را از شما می‌گیرد، چون ماخذ تعرفه سالانه، نرخ ارزش افزوده با قانون بودجه و نرخ ارز روزانه تغییر می‌کند.';

const faqs = [
  {
    q: 'چرا این ماشین‌حساب نرخ پیش‌فرض ندارد؟',
    a: 'چون سه عددی که نتیجه را می‌سازند، هیچ‌کدام ثابت نیستند: ماخذ حقوق ورودی هر کد ملی با اصلاحیهٔ سالانهٔ کتاب مقررات صادرات و واردات عوض می‌شود، نرخ مالیات و عوارض ارزش افزوده در قانون بودجهٔ هر سال تعیین می‌شود، و نرخ ارز مبنای محاسبهٔ ارزش گمرکی روزانه اعلام می‌شود. عدد پیش‌فرض، یک عدد قدیمی است که با ظاهر اطمینان نمایش داده می‌شود و وارد برآورد واقعی می‌شود.',
  },
  {
    q: 'ماخذ حقوق ورودی را از کجا پیدا کنم؟',
    a: 'کد تعرفهٔ ملی کالا را در کتاب مقررات صادرات و واردات همان سال ببینید؛ مرجع رسمی آن وزارت صنعت، معدن و تجارت است. اگر کد کالا را نمی‌دانید، از <a href="/hs-code/">جدول کد تعرفه</a> شروع کنید و فهرست مرجع‌ها را در <a href="/official-sources/">سامانه‌های رسمی</a> ببینید.',
  },
  {
    q: 'نرخ ارز را با چه عددی وارد کنم؟',
    a: 'با نرخ ارز اعلامی بانک مرکزی در روز اظهار، که مبنای محاسبهٔ ارزش گمرکی است — نه با نرخی که هنگام خرید یا ثبت سفارش دیده‌اید. قاعدهٔ آن و مرجع استعلامش در <a href="/customs-exchange-rate/">نرخ ارز گمرکی</a> توضیح داده شده است.',
  },
  {
    q: 'این برآورد چقدر به هزینهٔ واقعی نزدیک است؟',
    a: 'به دقت نرخ‌هایی که وارد کرده‌اید. اگر ماخذ و نرخ ارز واقعی پرونده را وارد کنید، سه قلم اول دقیق است. دو قلم بعدی — بندری و انبارداری، و کارمزد — به خود پرونده بستگی دارد و باید از ترمینال، انبار و قرارداد خدمات گرفته شود.',
  },
  {
    q: 'چه هزینه‌هایی در این برآورد نیست؟',
    a: 'هزینهٔ استاندارد و آزمون، بازرسی پیش از حمل، دموراژ و توقف کانتینر، حمل داخلی، بیمه، هزینه‌های بانکی و انتقال ارز، حق‌العمل‌کاری و هزینهٔ اخذ مجوزها. فهرست کامل همین پایین آمده است؛ در پرونده‌های واقعی، این اقلام می‌توانند سهم قابل توجهی از بهای تمام‌شده باشند.',
  },
  {
    q: 'چطور برآورد دقیق‌تری بگیرم؟',
    a: 'شرح کالا، کد تعرفهٔ پیشنهادی فروشنده، ارزش سیاهه، شرط تحویل و مبدأ را بفرستید. با دیدن اسناد، هم کد تعرفه قطعی می‌شود و هم اجزای هزینهٔ همان پرونده مشخص می‌شود؛ کاری که با یک فرمول عمومی ممکن نیست.',
  },
];
---

<BaseLayout
  title="ماشین‌حساب هزینهٔ ترخیص کالا: فرمول و اجزای هزینه"
  description="محاسبهٔ شفاف هزینهٔ ترخیص: ارزش گمرکی، حقوق ورودی، مالیات و عوارض ارزش افزوده، هزینه‌های بندری و کارمزد؛ با فرمول هر قلم و نرخ‌هایی که خودتان وارد می‌کنید."
  jsonLd={[breadcrumbLd(crumbs, Astro.site), faqLd(faqs, path, Astro.site)].filter((x) => x !== null)}
>
  <PageHero
    eyebrow="ابزار"
    title="ماشین‌حساب هزینهٔ ترخیص"
    lead="فرمول پنج قلم هزینه، بدون عدد پیش‌فرض. نرخ روز پروندهٔ خودتان را وارد کنید تا جمع برآوردی ساخته شود."
    crumbs={crumbs}
  >
    <div class="hero-actions">
      <a class="btn" href="#calc">
        شروع محاسبه
        <Icon name="arrow" class="btn__icon" />
      </a>
      <a class="btn btn--ghost" href="/customs-clearance/cost/">اجزای هزینهٔ ترخیص</a>
    </div>
  </PageHero>

  <AnswerBlock text={answer} />

  <section class="section" id="calc" aria-labelledby="calc-title">
    <div class="container">
      <h2 id="calc-title" class="sr-only">ماشین‌حساب هزینهٔ ترخیص</h2>
      <div class="calc" data-calc>
        <form class="calc__form reveal" data-calc-form novalidate>
          <fieldset>
            <legend>کالا</legend>
            <div class="field">
              <label for="c-value">ارزش کالا (FOB)</label>
              <div class="field__row">
                <input id="c-value" name="value" inputmode="decimal" autocomplete="off" placeholder="مبلغ سیاههٔ خرید" aria-describedby="c-value-hint" />
                <select name="currency" aria-label="ارز سیاهه">
                  {currencies.map((c) => <option value={c.code}>{c.label}</option>)}
                </select>
              </div>
              <p class="field__hint" id="c-value-hint">بهای خرید بر پایهٔ سیاهه، بدون هزینهٔ حمل</p>
            </div>
            <div class="field">
              <label for="c-freight">هزینهٔ حمل و بیمه تا نخستین نقطهٔ ورود</label>
              <input id="c-freight" name="freight" inputmode="decimal" autocomplete="off" placeholder="اختیاری" aria-describedby="c-freight-hint" />
              <p class="field__hint" id="c-freight-hint">به همان ارز سیاهه. اگر شرط تحویل CIF است، این دو در بهای خرید هست؛ خالی بگذارید.</p>
            </div>
          </fieldset>

          <fieldset>
            <legend>نرخ‌ها — همه از شما</legend>
            <div class="field">
              <label for="c-rate">نرخ ارز (تومان)</label>
              <input id="c-rate" name="rate" inputmode="decimal" autocomplete="off" placeholder="نرخ روز اظهار" aria-describedby="c-rate-hint" />
              <p class="field__hint" id="c-rate-hint">
                نرخ اعلامی بانک مرکزی در روز اظهار؛ قاعده‌اش در
                <a href="/customs-exchange-rate/">نرخ ارز گمرکی</a>
              </p>
            </div>
            <div class="field">
              <label for="c-duty">ماخذ حقوق ورودی (٪)</label>
              <input id="c-duty" name="duty" inputmode="decimal" autocomplete="off" placeholder="ماخذ کد تعرفه" aria-describedby="c-duty-hint" />
              <p class="field__hint" id="c-duty-hint">
                از کتاب مقررات صادرات و واردات همان سال؛ کد کالا را در <a href="/hs-code/">جدول تعرفه</a> پیدا کنید
              </p>
            </div>
            <div class="field">
              <label for="c-vat">نرخ مالیات و عوارض ارزش افزوده (٪)</label>
              <input id="c-vat" name="vat" inputmode="decimal" autocomplete="off" placeholder="نرخ مصوب سال جاری" aria-describedby="c-vat-hint" />
              <p class="field__hint" id="c-vat-hint">در قانون بودجهٔ همان سال تعیین می‌شود؛ بر جمع ارزش گمرکی و حقوق ورودی اعمال می‌شود</p>
            </div>
          </fieldset>

          <fieldset>
            <legend>اقلام پرونده‌محور (اختیاری)</legend>
            <div class="field">
              <label for="c-port">هزینه‌های بندری و انبارداری (تومان)</label>
              <input id="c-port" name="port" inputmode="decimal" autocomplete="off" placeholder="اختیاری" aria-describedby="c-port-hint" />
              <p class="field__hint" id="c-port-hint">از قبض‌های ترمینال و انبار؛ روزشمار است و با تأخیر در ترخیص بزرگ می‌شود</p>
            </div>
            <div class="field">
              <label for="c-fee">کارمزد خدمات ترخیص (تومان)</label>
              <input id="c-fee" name="fee" inputmode="decimal" autocomplete="off" placeholder="اختیاری" aria-describedby="c-fee-hint" />
              <p class="field__hint" id="c-fee-hint">مبلغ قرارداد خدمات. اگر وارد نکنید، در جمع لحاظ نمی‌شود</p>
            </div>
          </fieldset>

          <p class="calc__note">
            <Icon name="info" />
            این ابزار هیچ نرخ پیش‌فرضی ندارد. هر عددی که در نتیجه می‌بینید، از ورودی خودتان ساخته شده است.
          </p>
        </form>

        <div class="calc__result reveal" aria-labelledby="result-title">
          <h3 id="result-title">اجزای هزینه و فرمول هر قلم</h3>
          <dl class="calc__rows">
            {
              formulae.map((f) => (
                <div class:list={['calc__row', { 'calc__row--base': f.key === 'customsValue' }]}>
                  <dt>
                    {f.label}
                    <small>{f.note}</small>
                  </dt>
                  <dd>
                    <output data-out={f.key}>{f.formula}</output>{' '}
                    <span data-calc-unit hidden>تومان</span>
                  </dd>
                </div>
              ))
            }
          </dl>
          <div class="calc__total">
            <span>جمع برآوردی حقوق ورودی، ارزش افزوده و هزینه‌های واردشده</span>
            <strong>
              <output data-out="total">جمع اقلام بالا</output> <span data-calc-unit hidden>تومان</span>
            </strong>
          </div>
          <p class="calc__status" data-calc-status data-state="pending" aria-live="polite">
            برای محاسبه، {toFa(4)} نرخ لازم را وارد کنید: ارزش کالا، نرخ ارز، ماخذ حقوق ورودی و نرخ ارزش افزوده. تا آن زمان،
            فرمول هر قلم نمایش داده می‌شود.
          </p>
          <a class="btn btn--accent" href="/contact/">
            برآورد دقیق با دیدن اسناد
            <Icon name="arrow" class="btn__icon" />
          </a>
          <noscript>
            <p class="calc__noscript">
              بدون جاوااسکریپت، فرمول هر قلم در همین پنل نمایش داده می‌شود و محاسبهٔ عددی انجام نمی‌شود. اجزای کامل هزینه را در
              راهنمای هزینهٔ ترخیص ببینید.
            </p>
          </noscript>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="excluded-title">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">مرز این برآورد</span>
        <h2 id="excluded-title">چه هزینه‌هایی در این محاسبه نیست</h2>
        <p class="lead">
          این پنج قلم، ساختار حقوقی و گمرکی هزینه‌اند. اقلام زیر پرونده‌محورند و از روی ارزش کالا و دو نرخ نمی‌شود برآوردشان
          کرد؛ در پرونده‌های واقعی سهم بزرگی دارند.
        </p>
      </header>
      <ul class="excluded">
        {excluded.map((e) => <li class="reveal">{e}</li>)}
      </ul>
      <p class="excluded__note">
        تفصیل هر قلم و اینکه چه زمانی ظاهر می‌شود، در <a href="/customs-clearance/cost/">هزینهٔ ترخیص کالا</a> و
        <a href="/guides/customs-clearance-cost/">راهنمای هزینهٔ ترخیص</a> آمده است.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="rates-title">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">ورودی‌ها</span>
        <h2 id="rates-title">سه نرخ لازم را از کجا بگیریم</h2>
      </header>
      <ol class="rate-cards">
        <li class="reveal">
          <h3>
            <Icon name="doc" />
            ماخذ حقوق ورودی
          </h3>
          <p>
            به کد تعرفهٔ ملی کالا گره خورده و هر سال با اصلاحیهٔ کتاب مقررات صادرات و واردات تغییر می‌کند. اول کد کالا را
            قطعی کنید.
          </p>
          <a class="arrow-link" href="/hs-code/">
            جدول کد تعرفه
            <Icon name="arrow" />
          </a>
        </li>
        <li class="reveal">
          <h3>
            <Icon name="route" />
            نرخ ارز مبنای محاسبه
          </h3>
          <p>نرخ اعلامی بانک مرکزی در روز اظهار است، نه نرخ روز خرید. قاعدهٔ محاسبهٔ ارزش گمرکی همان‌جا توضیح داده شده.</p>
          <a class="arrow-link" href="/customs-exchange-rate/">
            ارزش گمرکی و نرخ ارز
            <Icon name="arrow" />
          </a>
        </li>
        <li class="reveal">
          <h3>
            <Icon name="shield" />
            نرخ ارزش افزوده و مرجع‌ها
          </h3>
          <p>
            در قانون بودجهٔ همان سال تعیین می‌شود و بر جمع ارزش گمرکی و حقوق ورودی اعمال می‌شود. مرجع هر استعلام در فهرست
            سامانه‌های رسمی هست.
          </p>
          <a class="arrow-link" href="/official-sources/">
            سامانه‌های رسمی
            <Icon name="arrow" />
          </a>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="faq-title">
    <div class="container split split--wide">
      <header class="stack reveal" style="--stack: 1rem">
        <span class="eyebrow">پرسش‌های رایج</span>
        <h2 id="faq-title">دربارهٔ این برآورد</h2>
        <p class="lead">برای برآورد دقیق، مشخصات کالا و اسناد را بفرستید تا پرونده را بررسی کنیم.</p>
      </header>
      <Faq items={faqs} />
    </div>
  </section>

  <div class="container">
    <ClusterNav
      siblings={[
        { href: '/hs-code/', label: 'کد تعرفه (HS)' },
        { href: '/customs-exchange-rate/', label: 'نرخ ارز گمرکی' },
        { href: '/official-sources/', label: 'سامانه‌های رسمی' },
        { href: '/guides/customs-clearance-cost/', label: 'راهنمای هزینهٔ ترخیص' },
        { href: '/guides/customs-valuation/', label: 'ارزش‌گذاری گمرکی' },
      ]}
    />
  </div>

  <CtaBand />
</BaseLayout>

<script>
  import { initCalculator } from '~/scripts/calculator';
  document.querySelectorAll<HTMLElement>('[data-calc]').forEach(initCalculator);
</script>

<style>
  .calc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .calc__form {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-l);
    background: var(--mist-50);
  }
  fieldset {
    display: grid;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    border: 0;
  }
  legend {
    margin-bottom: 0.25rem;
    font-size: var(--step-1);
    font-weight: 800;
    color: var(--navy-900);
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field label {
    font-weight: 700;
    color: var(--navy-900);
  }
  .field__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem;
  }
  .field input,
  .field select {
    width: 100%;
    min-width: 0;
    min-height: 3rem;
    padding: 0.5rem 0.9rem;
    border: 1.5px solid var(--rule-strong);
    border-radius: var(--radius-s);
    background: var(--white);
    font: inherit;
    font-size: var(--step-0);
    color: var(--navy-900);
  }
  .field input {
    direction: ltr;
    text-align: right;
    font-weight: 700;
  }
  .field input::placeholder {
    font-weight: 400;
    color: var(--slate-600);
    opacity: 0.75;
  }
  .field input:focus,
  .field select:focus {
    border-color: var(--petrol-500);
  }
  .field input[aria-invalid='true'] {
    border-color: var(--danger);
  }
  .field__hint {
    font-size: 0.85rem;
    color: var(--slate-600);
  }
  .field__hint a {
    color: var(--petrol-600);
    font-weight: 700;
  }
  .calc__note {
    display: flex;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--slate-700);
  }
  .calc__note :global(svg) {
    flex: none;
    inline-size: 1.2rem;
    block-size: 1.2rem;
    margin-top: 0.3rem;
    color: var(--petrol-500);
  }

  .calc__result {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-l);
    background: var(--navy-900);
    color: var(--mist-100);
  }
  .calc__result h3 {
    font-size: var(--step-2);
    color: var(--white);
  }
  .calc__rows {
    margin: 0;
    display: grid;
  }
  .calc__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid rgb(232 236 238 / 0.12);
  }
  .calc__row dt {
    display: grid;
    gap: 0.15rem;
    font-weight: 700;
  }
  .calc__row small {
    font-size: 0.8rem;
    font-weight: 400;
    color: #bcc3cb;
  }
  .calc__row dd {
    margin: 0;
    flex: none;
    max-width: 15rem;
    text-align: end;
    font-weight: 700;
    color: var(--white);
  }
  /* Before any rate is typed the cell holds the formula, not a number. */
  .calc__row dd output {
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.7;
    color: var(--petrol-200);
  }
