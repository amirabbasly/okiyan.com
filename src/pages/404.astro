---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import { getCollection } from 'astro:content';
import { contactCta } from '~/config/site';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const links = [
  { href: '/customs-clearance/', title: 'ترخیص کالا', text: 'تشریفات گمرکی کالای خریداری‌شده' },
  { href: '/import-services/', title: 'خدمات واردات کالا', text: 'همراهی از پیش از خرید تا تحویل' },
  ...guides.map((g) => ({ href: `/guides/${g.id}/`, title: g.data.navTitle, text: 'راهنما' })),
];
---

<BaseLayout title="صفحه پیدا نشد" description="صفحه‌ای که دنبال آن بودید پیدا نشد. از پیوندهای این صفحه به خدمات ترخیص و واردات کالا یا راهنماها بروید." noindex>
  <section class="nf section--grain">
    <div class="container nf__grid">
      <div class="nf__text">
        <p class="eyebrow">خطای ۴۰۴</p>
        <h1>این محموله به مقصد نرسید</h1>
        <p class="lead">
          صفحه‌ای که دنبال آن بودید پیدا نشد؛ ممکن است نشانی اشتباه وارد شده باشد یا صفحه جابه‌جا شده باشد. از یکی از مسیرهای زیر ادامه دهید.
        </p>
        <div class="hero-actions">
          <a class="btn" href="/">
            صفحهٔ اصلی
            <Icon name="arrow" class="btn__icon" />
          </a>
          <a class="btn btn--ghost" href={contactCta.href}>{contactCta.label}</a>
        </div>
      </div>
      <svg class="nf__art" viewBox="0 0 320 220" width="320" height="220" aria-hidden="true" focusable="false">
        <path d="M20 170C80 170 90 90 160 90S250 150 300 120" fill="none" stroke="#0a1c38" stroke-opacity="0.25" stroke-width="2.5" stroke-dasharray="3 10" stroke-linecap="round"></path>
        <path d="M20 170C60 170 80 130 110 108" fill="none" stroke="#c9a24a" stroke-width="3.5" stroke-linecap="round"></path>
        <circle cx="20" cy="170" r="8" fill="#0a1c38"></circle>
        <g transform="translate(176 96) rotate(-10)">
          <rect x="-48" y="-21" width="96" height="42" rx="2" fill="#c9a24a"></rect>
          <path d="M-40 -17V17M-30 -17V17M-20 -17V17M-10 -17V17M0 -17V17M10 -17V17M20 -17V17M30 -17V17M40 -17V17" stroke="#000" stroke-opacity="0.15" stroke-width="2"></path>
        </g>
        <g transform="translate(262 52)">
          <circle r="26" fill="#fcf9f2" stroke="#0a1c38" stroke-width="2.5"></circle>
          <text y="9" text-anchor="middle" font-size="26" font-weight="800" fill="#0a1c38">؟</text>
        </g>
      </svg>
    </div>
    <nav class="container nf__links" aria-labelledby="nf-links">
      <h2 id="nf-links">شاید دنبال این صفحه‌ها بودید</h2>
      <ul>
        {
          links.map((l) => (
            <li>
              <div class="nf__card stretch">
                <a class="nf__t stretch__link" href={l.href}>
                  {l.title}
                </a>
                <span class="nf__d">{l.text}</span>
                <Icon name="arrow" />
              </div>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(3rem, 2rem + 5vw, 7rem);
    background-color: var(--ivory-100);
  }
  .nf__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
  }
  .nf__text {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .nf h1 {
    font-size: var(--step-5);
  }
  .nf__art {
    width: 100%;
    max-width: 22rem;
    justify-self: center;
  }
  .nf__art text {
    font-family: var(--font-sans);
  }
  .nf__links {
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .nf__links h2 {
    font-size: var(--step-2);
    margin-bottom: 1.25rem;
  }
  .nf__links ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 0.9rem;
  }
  .nf__card {
    position: relative;
    display: grid;
    gap: 0.2rem;
    padding: 1.1rem 1.25rem 1.1rem 3rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-m);
    background: var(--ivory-50);
    text-decoration: none;
    transition: border-color var(--dur-fast) ease;
  }
  .nf__card:hover {
    border-color: var(--navy-900);
  }
  .nf__t {
    font-weight: 800;
  }
  .nf__d {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .nf__links :global(svg) {
    position: absolute;
    inset-inline-end: 1rem;
    top: 50%;
    translate: 0 -50%;
    color: var(--gold-500);
  }
  @media (max-width: 760px) {
    .nf__grid {
      grid-template-columns: 1fr;
    }
    .nf__art {
      max-width: 16rem;
      order: -1;
    }
  }
</style>
