---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/layout/PageHero.astro';
import ImportArt from '~/components/illustrations/ImportArt.astro';
import Faq from '~/components/ui/Faq.astro';
import CtaBand from '~/components/ui/CtaBand.astro';
import AnswerBlock from '~/components/ui/AnswerBlock.astro';
import Clients from '~/components/ui/Clients.astro';
import Icon from '~/components/ui/Icon.astro';
import Placeholder from '~/components/ui/Placeholder.astro';
import { breadcrumbLd, serviceLd } from '~/lib/schema';
import { services } from '~/data/services';
import { contactCta } from '~/config/site';
import { toFa } from '~/lib/format';
import Photo from '~/components/ui/Photo.astro';

const path = '/import-services/';
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'واردات کالا', path },
];
const description =
  'خدمات واردات کالا از پیش از خرید: امکان‌سنجی و کد تعرفه، برآورد هزینهٔ تمام‌شده، هماهنگی اسناد با تأمین‌کننده، حمل و ترخیص. دامنه و مرزهای خدمت را ببینید.';

// REVIEW: confirm every phase and exclusion with the business owner (site.scopeConfirmed).
const phases = [
  {
    title: 'برنامه‌ریزی و امکان‌سنجی',
    text: 'پیش از سفارش بررسی می‌کنیم واردات این کالا با چه شرایطی ممکن است.',
    items: ['بررسی کد تعرفهٔ کالا بر اساس مشخصات فنی', 'شناسایی محدودیت‌ها و مجوزهای احتمالی', 'برآورد هزینهٔ تمام‌شدهٔ تقریبی تا انبار'],
  },
  {
    title: 'هماهنگی با تأمین‌کننده',
    text: 'تأمین‌کننده را شما انتخاب می‌کنید؛ ما کمک می‌کنیم اسناد و شرایط معامله برای واردات درست تنظیم شود.',
    items: ['بررسی پیش‌فاکتور و شرح فنی کالا', 'پیشنهاد شرط تحویل مناسب (اینکوترمز)', 'فهرست اسنادی که فروشنده باید همراه کالا بفرستد'],
  },
  {
    title: 'ثبت سفارش و اسناد',
    text: 'اطلاعات معامله باید از ابتدا تا ترخیص هم‌خوان بماند.',
    items: ['همراهی در تکمیل اطلاعات ثبت سفارش', 'تطبیق ثبت سفارش با پیش‌فاکتور', 'پیگیری مجوزهایی که پیش از حمل لازم است'],
  },
  {
    title: 'هماهنگی حمل',
    text: 'روش حمل دریایی، هوایی یا زمینی را متناسب با کالا، فوریت و هزینه بررسی و با زمان‌بندی ترخیص هماهنگ می‌کنیم.',
    items: ['هماهنگی با فرستنده و شرکت حمل دریایی یا هوایی', 'بررسی پیش‌نویس بارنامه پیش از صدور', 'پیگیری زمان تقریبی رسیدن'],
  },
  {
    title: 'ترخیص و تحویل',
    text: 'وقتی کالا می‌رسد، اسناد آماده است و ترخیص بدون انتظار برای تکمیل مدارک شروع می‌شود.',
    items: ['ترخیص کالا از گمرک', 'هماهنگی حمل داخلی تا انبار', 'تحویل اسناد نهایی پرونده'],
  },
];

const exclusions = [
  { title: 'تأمین یا تولید کالا', text: 'ما سازنده یا فروشندهٔ کالا نیستیم و کیفیت محصول تأمین‌کننده را تضمین نمی‌کنیم.' },
  { title: 'انتقال ارز و پرداخت به فروشنده', text: 'پرداخت از مسیرهای مجاز و به نام واردکننده انجام می‌شود؛ ما اسناد مرتبط را هماهنگ می‌کنیم.' },
  { title: 'صدور مجوزها', text: 'مجوزها را دستگاه‌های مسئول صادر می‌کنند؛ کار ما آماده‌سازی مدارک و پیگیری است.' },
  { title: 'تضمین زمان یا نتیجهٔ ترخیص', text: 'تصمیم دربارهٔ ارزیابی، مسیر رسیدگی و پذیرش اسناد با گمرک است.' },
];

const supplierChecks = [
  'شرح کالا در پیش‌فاکتور به‌اندازهٔ کافی فنی و دقیق است تا کد تعرفه با آن سازگار باشد.',
  'کشور سازنده مشخص است و فروشنده می‌تواند گواهی مبدأ ارائه کند.',
  'شرط تحویل و محل تحویل روشن نوشته شده است.',
  'فروشنده می‌تواند اسناد فنی، گواهی‌ها یا نمونه‌هایی را که برای مجوزها لازم است فراهم کند.',
  'وزن، بسته‌بندی و تعداد اقلام با اسناد حمل قابل تطبیق است.',
];

const faqs = [
  {
    q: 'تأمین‌کننده را هم پیدا می‌کنید؟',
    a: 'تمرکز ما بر واردات و ترخیص است: بررسی امکان واردات، اسناد معامله و هماهنگی مسیر. اگر چند تأمین‌کننده را در نظر دارید، می‌توانیم پیش‌فاکتورها و اسناد آن‌ها را از نظر الزامات واردات مقایسه کنیم؛ انتخاب نهایی تأمین‌کننده با شماست.',
  },
  {
    q: 'برای اولین واردات از کجا شروع کنم؟',
    a: 'از مشخصات فنی کالا. با داشتن شرح دقیق کالا می‌توان کد تعرفه، مجوزها و هزینه‌ها را بررسی کرد. خلاصهٔ مسیر را در <a href="/guides/import-process/">راهنمای مراحل واردات کالا</a> بخوانید.',
  },
  {
    q: 'برآورد هزینهٔ تمام‌شده چقدر دقیق است؟',
    a: 'برآورد پیش از خرید بر پایهٔ اطلاعات آن زمان است و اقلامی مثل حقوق ورودی، نرخ‌ها و هزینهٔ حمل ممکن است تا زمان ترخیص تغییر کنند. این اقلام و مبنای محاسبه‌شان در برآورد جدا مشخص می‌شوند.',
  },
];
---

<BaseLayout
  ogImage="/og/import.jpg"
  ogImageAlt="بندر کانتینری در ساعت آبی"
  title="خدمات واردات کالا؛ از امکان‌سنجی تا ترخیص"
  description={description}
  jsonLd={[
    breadcrumbLd(crumbs, Astro.site),
    serviceLd({ name: 'خدمات واردات کالا', description, path, serviceType: 'Import coordination' }, Astro.site),
  ]}
>
  <PageHero
    eyebrow="خدمات"
    title="خدمات واردات کالا"
    lead="پیش از اینکه سفارش بدهید، بدانید واردات کالای شما چه الزامات و هزینه‌هایی دارد. از امکان‌سنجی و کد تعرفه تا هماهنگی اسناد با تأمین‌کننده، حمل و ترخیص، مسیر را با شما برنامه‌ریزی و پیگیری می‌کنیم."
    crumbs={crumbs}
  >
    <div class="hero-actions">
      <a class="btn" href={contactCta.href}>
        {contactCta.label}
        <Icon name="arrow" class="btn__icon" />
      </a>
      <a class="btn btn--ghost" href="#scope">دامنهٔ خدمات</a>
    </div>
    <ImportArt slot="art" />
  </PageHero>

  <AnswerBlock text={"خدمات واردات کالا، همراهی در کل مسیر ورود کالا است: امکان‌سنجی و تعیین کد تعرفه، بررسی مجوزها و هزینهٔ تمام‌شده، هماهنگی اسناد با تأمین‌کننده، حمل بین‌المللی و در پایان ترخیص گمرکی تا تحویل. بیشتر تأخیرها و اختلاف هزینه‌ها در سه مرحلهٔ اول شکل می‌گیرد، نه در گمرک."} />

  <section class="section section--tight" aria-label="تصویر مسیر واردات از پیش از خرید">
    <div class="container">
      <Photo
        name="port-cranes"
        alt="بندر کانتینری در ساعت آبی، با جرثقیل‌های دروازه‌ای، کشتی در اسکله و ردیف کانتینر"
        width={1600}
        height={900}
        caption="مسیر واردات از پیش از خرید شروع می‌شود؛ آنچه در گمرک گران تمام می‌شود، معمولاً همان چیزی است که در مرحلهٔ تأمین‌کننده و سند نهایی شده است."
      />
    </div>
  </section>

  <!-- Intro -->
  <section class="section" aria-labelledby="intro-title">
    <div class="container split">
      <div class="stack prose-lite reveal" style="--stack: 1.1rem">
        <h2 id="intro-title">واردات کالا، پیش از خرید شروع می‌شود</h2>
        <p>
          بسیاری از مشکلاتی که در گمرک دیده می‌شوند، ریشه در تصمیم‌های پیش از خرید دارند: شرح کالایی که با کد تعرفه سازگار نیست، مجوزی که دیر شناسایی شده
          یا شرط تحویلی که هزینه و ریسک را به شکل پیش‌بینی‌نشده‌ای جابه‌جا کرده است.
        </p>
        <p>
          در خدمات واردات کالا، این تصمیم‌ها را پیش از سفارش با شما مرور می‌کنیم و سپس مسیر را تا <a href={services.clearance.href}>ترخیص کالا</a> و تحویل در
          انبار پیگیری می‌کنیم.
        </p>
      </div>
      <aside class="fit-card reveal" aria-labelledby="fit-title">
        <h3 id="fit-title">مناسب برای</h3>
        <ul class="checklist">
          <li>شرکت‌هایی که اولین واردات خود را برنامه‌ریزی می‌کنند؛</li>
          <li>واردکنندگانی که کالای تازه‌ای به سبد خود اضافه می‌کنند؛</li>
          <li>تیم‌های خریدی که پیش از سفارش، هزینهٔ تمام‌شده را می‌خواهند؛</li>
          <li>کسب‌وکارهایی که می‌خواهند یک طرف پاسخ‌گو برای کل مسیر داشته باشند.</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- Scope: phases as a route -->
  <section class="section section--dark" id="scope" aria-labelledby="scope-title">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">دامنهٔ همراهی</span>
        <h2 id="scope-title">از برنامه‌ریزی تا تحویل، در پنج بخش</h2>
        <p class="lead">می‌توانید همهٔ مسیر یا فقط بخش‌هایی را که لازم دارید به ما بسپارید.</p>
      </header>
      <Placeholder field="تأیید دامنهٔ خدمات واردات توسط مدیریت (scopeConfirmed در src/config/site.ts)" />
      <ol class="phases">
        {
          phases.map((ph, i) => (
            <li class="phase reveal">
              <span class="phase__n" aria-hidden="true">
                {toFa(i + 1)}
              </span>
              <h3>{ph.title}</h3>
              <p>{ph.text}</p>
              <ul>
                {ph.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Boundaries -->
  <section class="section section--alt section--grain" aria-labelledby="bounds-title">
    <div class="container split split--wide">
      <header class="section-head sticky-head reveal">
        <span class="eyebrow">مرزهای خدمت</span>
        <h2 id="bounds-title">آنچه در این خدمت نیست</h2>
        <p class="lead">روشن بودن مرزها به اندازهٔ دامنهٔ کار اهمیت دارد. این موارد را انجام نمی‌دهیم یا تصمیم آن با ما نیست:</p>
      </header>
      <dl class="bounds">
        {
          exclusions.map((e) => (
            <div class="bounds__item reveal">
              <dt>
                <Icon name="close" />
                {e.title}
              </dt>
              <dd>{e.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Supplier checks -->
  <section class="section" aria-labelledby="supplier-title">
    <div class="container split">
      <div class="stack reveal" style="--stack: 1.1rem">
        <span class="eyebrow">هماهنگی تأمین</span>
        <h2 id="supplier-title">پیش از نهایی کردن خرید، این‌ها را از تأمین‌کننده بخواهید</h2>
        <p class="lead">این فهرست، نکاتی است که در بررسی اسناد تأمین‌کننده از نظر الزامات واردات به آن‌ها نگاه می‌کنیم.</p>
        <ul class="checklist">
          {supplierChecks.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <aside class="compare reveal" aria-labelledby="compare-title">
        <h3 id="compare-title">از کدام خدمت شروع کنم؟</h3>
        <div class="compare__row">
          <p class="compare__label">هنوز خرید نکرده‌اید</p>
          <p>
            <a href={services.import.href} aria-current="page">خدمات واردات کالا</a>
          </p>
        </div>
        <div class="compare__row">
          <p class="compare__label">سفارش داده‌اید یا کالا در راه است</p>
          <p>
            <a href={services.clearance.href}>ترخیص کالا</a>، با بررسی اسناد پیش از رسیدن
          </p>
        </div>
        <div class="compare__row">
          <p class="compare__label">کالا به گمرک رسیده است</p>
          <p>
            <a href={services.clearance.href}>ترخیص کالا</a>
          </p>
        </div>
      </aside>
    </div>
  </section>

  <!-- Related guides -->
  <section class="section section--alt" aria-labelledby="read-title">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">برای مطالعه</span>
        <h2 id="read-title">پیش از اولین سفارش بخوانید</h2>
      </header>
      <div class="reads">
        <div class="read reveal stretch">
          <a class="read__t stretch__link" href="/guides/import-process/">مراحل واردات کالا</a>
          <span class="read__d">از امکان‌سنجی و کد تعرفه تا ثبت سفارش، حمل و ترخیص</span>
          <Icon name="arrow" />
        </div>
        <div class="read reveal stretch">
          <a class="read__t stretch__link" href="/guides/customs-clearance-cost/">هزینه ترخیص کالا</a>
          <span class="read__d">اقلام هزینه و آنچه برآورد را دقیق‌تر می‌کند</span>
          <Icon name="arrow" />
        </div>
        <div class="read reveal stretch">
          <a class="read__t stretch__link" href="/guides/customs-clearance-documents/">مدارک لازم برای ترخیص کالا</a>
          <span class="read__d">اسناد پایه و مجوزهای وابسته به نوع کالا</span>
          <Icon name="arrow" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container split split--wide">
      <header class="section-head reveal">
        <span class="eyebrow">پرسش‌های رایج</span>
        <h2 id="faq-title">پرسش‌های رایج دربارهٔ واردات کالا</h2>
      </header>
      <Faq items={faqs} />
    </div>
  </section>

    <!-- client brands: the same wall as the homepage, without the heading -->
  <div class="section">
    <div class="container" style="padding-bottom: 1.5rem">
      <p class="clients-lead">برخی از برندهایی که محموله‌هایشان را همراهی کرده‌ایم</p>
    </div>
    <Clients title={null} note={false} compact />
  </div>

  <section class="section section--alt" aria-labelledby="origins-title">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">مبدأ کالا</span>
        <h2 id="origins-title">واردات از چین، دبی و ترکیه</h2>
        <p class="lead">
          مسیر حمل، اسناد کلیدی و ریسک هر مبدأ متفاوت است. راهنمای اختصاصی هر کشور را ببینید.
        </p>
      </header>
      <ul class="read-list">
        <li><a href="/imports/china/">واردات از چین</a></li>
        <li><a href="/imports/dubai/">واردات از دبی</a></li>
        <li><a href="/imports/turkey/">واردات از ترکیه</a></li>
        <li><a href="/imports/">همهٔ مبدأها</a></li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="read-title">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">بیشتر بخوانید</span>
        <h2 id="read-title">راهنمای مرتبط و خدمات مکمل</h2>
      </header>
      <ul class="read-list">
        <li><a href="/guides/import-process/">مراحل واردات کالا به ایران</a></li>
        <li><a href="/guides/import-permits/">مجوزهای واردات</a></li>
        <li><a href="/guides/goods-by-type/">ترخیص کالا بر اساس نوع کالا</a></li>
        <li><a href="/commercial-services/">خدمات بازرگانی و تأمین‌کننده</a></li>
        <li><a href="/special-projects/">پروژه‌های خاص و محموله‌های سنگین</a></li>
        <li><a href="/customs/">گمرکات و بنادر</a></li>
      </ul>
    </div>
  </section>

  <CtaBand title="کالایی را در نظر دارید؟" text="مشخصات کالا و کشور تأمین را بفرستید تا پیش از سفارش، الزامات و هزینه‌های تقریبی واردات آن را بررسی کنیم." />
</BaseLayout>

<style>
  .read-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .read-list a {
    display: inline-block;
    padding: 0.5rem 1rem;
    font-weight: 700;
    font-size: var(--step--1);
    color: var(--navy-800);
    background: var(--white);
    border: 1px solid var(--rule);
    border-radius: 999px;
    text-decoration: none;
  }
  .read-list a:hover {
    border-color: var(--petrol-300);
    color: var(--petrol-600);
  }

  .clients-lead {
    margin: 0 0 1rem;
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    text-align: center;
  }

  .phases {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    margin-top: 1rem;
    position: relative;
  }
  .phase {
    position: relative;
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 0 0 0 1.25rem;
    padding-inline: 0 1.5rem;
  }
  .phase::before {
    /* the route line joining phases */
    content: '';
    position: absolute;
    top: 1.5rem;
    inset-inline: 3rem 0;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--petrol-300) 0 6px, transparent 6px 12px);
    opacity: 0.6;
  }
  .phase:last-child::before {
    display: none;
  }
  .phase__n {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: 50%;
    background: var(--petrol-300);
    color: var(--navy-950);
    font-weight: 800;
    font-size: var(--step-1);
  }
  .phase h3 {
    font-size: var(--step-1);
    color: var(--white);
    margin-top: 0.5rem;
  }
  .phase > p {
    color: #bcc3cb;
    font-size: var(--step--1);
  }
  .phase ul {
    list-style: none;
    display: grid;
    gap: 0.45rem;
    padding-top: 0.8rem;
    border-top: 1px solid rgb(232 236 238 / 0.12);
    font-size: var(--step--1);
    color: #d3dbe7;
  }
  .phase ul li {
    position: relative;
