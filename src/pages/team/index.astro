---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/layout/PageHero.astro';
import CtaBand from '~/components/ui/CtaBand.astro';
import Icon from '~/components/ui/Icon.astro';
import { breadcrumbLd } from '~/lib/schema';

const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'تیم ما', path: '/team/' },
];

/**
 * Roles, not invented people: until the team agrees to publish names and
 * faces, the page states who does what on a file and what each role hands
 * over. No name, title or photo here is made up.
 */
const roles = [
  {
    icon: 'doc',
    title: 'کارشناس بررسی اسناد',
    text: 'پیش از هر عددی، مشخصات کالا، پیش‌فاکتور و اسناد حمل را می‌بیند؛ کسری و تناقض را همان‌جا فهرست می‌کند تا پرونده با مدرک ناقص جلو نرود.',
    out: 'خروجی: برگ بررسی اولیه با اقلام قطعی و اقلام نیازمند استعلام.',
  },
  {
    icon: 'calc',
    title: 'کارشناس تعرفه و مجوز',
    text: 'کد تعرفهٔ پیشنهادی، نیاز به مجوز و محدودیت‌های ثبت سفارش را روشن می‌کند و برآورد هزینه را مکتوب و تفکیک‌شده می‌دهد؛ اقلام غیرقطعی جدا مشخص می‌شوند.',
    out: 'خروجی: برآورد مکتوب هزینه و فهرست مجوزها با دستگاه صادرکننده.',
  },
  {
    icon: 'route',
    title: 'هماهنگ‌کنندهٔ حمل',
    text: 'مسیر و شرایط حمل را با شرایط تحویل و اسناد تطبیق می‌دهد؛ از رزرو فضا تا بارنامه، زنجیرهٔ حمل را با پروندهٔ ثبت سفارش هم‌زمان نگه می‌دارد.',
    out: 'خروجی: برنامهٔ حمل با تاریخ‌ها و مسئول هر برگه.',
  },
  {
    icon: 'stamp',
    title: 'رابط گمرک و پیگیری پرونده',
    text: 'مراحل ترخیص را پیگیری می‌کند و در هر مرحله می‌گوید پرونده کجاست، منتظر چه چیزی است و اقدام بعدی با کیست؛ توقف‌های احتمالی پیش از وقوع اعلام می‌شوند.',
    out: 'خروجی: گزارش مرحله‌به‌مرحلهٔ پرونده تا خروج کالا.',
  },
];
---

<BaseLayout
  title="تیم ما؛ نقش‌هایی که پروندهٔ شما را جلو می‌برند | اوکیان"
  description="پشت هر پروندهٔ اوکیان چهار نقش روشن است: بررسی اسناد، تعرفه و مجوز، هماهنگی حمل و رابط گمرک. می‌گوییم هر نقش چه چیزی را تحویل می‌دهد و مرزها کجاست."
  jsonLd={[breadcrumbLd(crumbs, Astro.site)].filter((x) => x !== null)}
>
  <PageHero
    eyebrow="درباره ما"
    title="تیم ما"
    lead="یک پرونده را کمیته جلو نمی‌برد؛ نقش‌های روشن جلو می‌برند. اینجا می‌گویید هر نقش چه چیزی را می‌بیند و چه چیزی تحویل می‌دهد."
    crumbs={crumbs}
  >
    <div class="hero-actions">
      <a class="btn" href="/about/">
        دربارهٔ اوکیان
        <Icon name="arrow" class="btn__icon" />
      </a>
      <a class="btn btn--ghost" href="/resume/">رزومه و سوابق</a>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="team-title">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">نقش‌ها</span>
        <h2 id="team-title">روی پروندهٔ شما چه کسانی کار می‌کنند؟</h2>
        <p class="lead">
          هر پرونده چهار جفت چشم می‌خواهد: یکی که اسناد را پیش از هر عددی ببیند، یکی که تعرفه و مجوز را قطعی کند، یکی که حمل را با پرونده هم‌زمان نگه دارد و یکی که در گمرک پیگیر باشد. مرز این نقش‌ها با وظایف صاحب کالا را پیش از شروع مکتوب می‌کنیم.
        </p>
      </header>

      <ul class="team-grid">
        {
          roles.map((r) => (
            <li class="team-card reveal">
              <span class="team-card__icon" aria-hidden="true">
                <Icon name={r.icon} />
              </span>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
              <p class="team-card__out">{r.out}</p>
            </li>
          ))
        }
      </ul>

      <div class="notice reveal" role="note">
        <Icon name="shield" />
        <p>
          <strong>نام‌ها و چهره‌ها:</strong> به‌زودی، با اجازهٔ خودِ اعضای تیم، اینجا منتشر می‌شوند. تا آن زمان هم هیچ پرونده‌ای بی‌نام نمی‌ماند: در برگهٔ شروع کار، نام مسئول پرونده و راه ارتباط مستقیم با او نوشته می‌شود؛ عکس پروفایل و نام ساختگی پیش از آن منتشر نمی‌کنیم.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="team-more-title">
    <div class="container container--narrow">
      <header class="section-head reveal">
        <span class="eyebrow">ادامه</span>
        <h2 id="team-more-title">تیم را از کارش بشناسید</h2>
        <p class="lead">روش کار، سوابق و شبکهٔ همکاران ما، تصویر کامل‌تری از این چهار نقش می‌دهد.</p>
      </header>
      <ul class="team-links reveal">
        <li>
          <a href="/about/">
            روش کار و مرز مسئولیت‌ها
            <Icon name="arrow" />
          </a>
        </li>
        <li>
          <a href="/resume/">
            سوابق و پرونده‌های منتخب
            <Icon name="arrow" />
          </a>
        </li>
        <li>
          <a href="/partners/">
            همکارانی که کنار این تیم می‌ایستند
            <Icon name="arrow" />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <CtaBand
    title="می‌خواهید بدانید پروندهٔ شما با کیست؟"
    text="مشخصات کالا را بفرستید؛ در همان برگهٔ بررسی اولیه می‌نویسیم مسئول پروندهٔ شما کیست، هر مرحله چه چیزی تحویل می‌دهد و اقدام بعدی با کیست."
  />
</BaseLayout>

<style>
  .team-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
    margin: 0;
    padding: 0;
  }
  .team-card {
    display: grid;
    gap: 0.7rem;
    justify-items: start;
    align-content: start;
    padding: 1.5rem 1.6rem 1.4rem;
    border: 1px solid rgb(2 56 126 / 0.14);
    border-radius: var(--radius-m);
    background: var(--white);
    box-shadow: 0 24px 48px -36px rgb(0 18 48 / 0.4);
    transition:
      transform var(--dur-med) var(--ease-out),
      border-color var(--dur-med) ease,
      box-shadow var(--dur-med) var(--ease-out);
  }
  .team-card:hover {
    transform: translateY(-4px);
    border-color: rgb(254 93 2 / 0.5);
    box-shadow:
      0 30px 54px -34px rgb(0 18 48 / 0.45),
      0 0 0 1px rgb(254 93 2 / 0.26);
  }
  .team-card__icon {
    display: grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: 0.9rem;
    background: linear-gradient(140deg, #1554a8, #012b64);
    color: var(--petrol-200);
    box-shadow: 0 14px 30px -18px rgb(0 18 48 / 0.7);
  }
  .team-card__icon :global(svg) {
    inline-size: 1.6rem;
    block-size: 1.6rem;
  }
  .team-card h3 {
    font-size: var(--step-1);
    color: var(--navy-900);
  }
  .team-card p {
    color: var(--slate-700);
    font-size: var(--step--1);
    line-height: 1.9;
  }
  .team-card__out {
    padding-top: 0.7rem;
    border-top: 1px dashed rgb(2 56 126 / 0.22);
    color: var(--text-muted);
    font-weight: 700;
  }
  .team-links {
    list-style: none;
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
  }
  .team-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--white);
    color: var(--navy-900);
    font-weight: 700;
    text-decoration: none;
    transition:
      border-color var(--dur-med) ease,
      color var(--dur-med) ease,
      transform var(--dur-med) var(--ease-out);
  }
  .team-links a:hover {
    border-color: var(--petrol-300);
    color: var(--petrol-600);
    transform: translateY(-2px);
  }
  .team-links :global(svg) {
    inline-size: 1.1rem;
    block-size: 1.1rem;
    flex: none;
  }
  @media (max-width: 760px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
