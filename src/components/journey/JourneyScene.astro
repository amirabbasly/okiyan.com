      <path d="M84 6V36M90 6V36" stroke="#6e521a" stroke-opacity="0.55" stroke-width="1.6"></path>
      <rect x="22" y="13" width="44" height="16" rx="2" fill="#0a1c38"></rect>
      <text x="44" y="24.6" text-anchor="middle" font-size="8.5" font-weight="800" fill="#dfc17f" letter-spacing="1.2" font-family="Vazirmatn, Tahoma, sans-serif" direction="ltr">OKIYAN</text>
    </g>

    <line data-j="scan-line" x1="655" y1="398" x2="655" y2="468" stroke="#f3dc9f" stroke-width="2.5" opacity={f.scan.beam.toFixed(3)}></line>

    <!-- Barrier at the customs exit -->
    <g>
      <rect x="576" y="432" width="10" height="38" rx="2" fill={STEEL}></rect>
      <circle cx="581" cy="430" r="2.5" fill="#f2a65a"></circle>
