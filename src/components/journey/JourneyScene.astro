      <!-- reflection + wake (wake fades in at sea) -->
      <ellipse cx="0" cy="12" rx="150" ry="7" fill="#000" fill-opacity="0.22"></ellipse>
      <g data-j="wake" opacity={(f.atSea * 0.9).toFixed(3)} fill="none" stroke="#f7f1e4" stroke-linecap="round">
        <path d="M142 4 Q190 10 250 6" stroke-opacity="0.45" stroke-width="2.5"></path>
        <path d="M150 9 Q210 16 300 12" stroke-opacity="0.25" stroke-width="2"></path>
        <path d="M-150 2 Q-170 8 -190 5" stroke-opacity="0.4" stroke-width="2"></path>
      </g>
      <rect x="-148" y="-72" width="58" height="42" rx="1.5" fill="#2f5583"></rect>
      <rect x="18" y="-72" width="52" height="42" rx="1.5" fill="#3f6b78"></rect>
      <path d="M-140 -68V-34M-130 -68V-34M-120 -68V-34M-110 -68V-34M-100 -68V-34M26 -68V-34M36 -68V-34M46 -68V-34M56 -68V-34" stroke="#000" stroke-opacity="0.16" stroke-width="2"></path>
      <!-- hull with raked bow (left) -->
      <path d="M-162 -32L148 -32L140 -2Q137 6 128 6L-118 6Q-132 6 -140 -4Z" fill="#ece4d2"></path>
      <path d="M-143 -8L141 -8L140 -2Q137 6 128 6L-118 6Q-132 6 -140 -4Z" fill="#7a3a2f"></path>
      <path d="M-160 -31H146" stroke="#c9a24a" stroke-width="2"></path>
      <g fill="#0a1c38" fill-opacity="0.35">
        <circle cx="-120" cy="-19" r="2"></circle><circle cx="-60" cy="-19" r="2"></circle><circle cx="0" cy="-19" r="2"></circle><circle cx="60" cy="-19" r="2"></circle>
      </g>
      <!-- superstructure -->
      <rect x="74" y="-88" width="54" height="58" rx="2" fill="#f4eee0"></rect>
      <rect x="70" y="-92" width="62" height="6" rx="1.5" fill="#dcd3bf"></rect>
      <rect x="78" y="-82" width="46" height="8" rx="1" fill={LIT} fill-opacity="0.85"></rect>
      <path d="M82 -64H120M82 -52H120M82 -40H120" stroke="#0a1c38" stroke-opacity="0.22" stroke-width="2.5"></path>
      <rect x="100" y="-110" width="16" height="18" fill="#1b3961"></rect>
      <rect x="100" y="-105" width="16" height="4" fill="#c9a24a"></rect>
      <path d="M-146 -32V-66" stroke="#f4eee0" stroke-width="2.5"></path>
      <circle cx="-146" cy="-67" r="2.2" fill={LIT}></circle>
      <path d="M118 -110V-122" stroke="#f4eee0" stroke-width="1.5"></path>
      <circle cx="118" cy="-123" r="1.8" fill="#f2a65a"></circle>
    </g>

    <!-- Scanner arch (front post) -->
    <rect x="758" y="392" width="7" height="78" fill={STEEL_HI}></rect>

    <!-- Truck -->
    <g data-j="truck" transform={`translate(${f.truckX.toFixed(2)} 0)`}>
      <path d="M0 446L-70 434V472L0 460Z" fill="url(#j-beam)" opacity="0.55"></path>
      <ellipse cx="78" cy="471" rx="82" ry="3.5" fill="#000" fill-opacity="0.3"></ellipse>
      <rect x="44" y="446" width="110" height="7" rx="1.5" fill="#0a1c38" stroke="#8fa3c0" stroke-width="1.2"></rect>
      <path d="M4 458V434Q4 422 16 422H48V458Z" fill="#ece4d2"></path>
      <path d="M8 444V436Q8 428 16 428H28V444Z" fill="#1b3961"></path>
      <path d="M10 440L20 430" stroke="#f7f1e4" stroke-opacity="0.35" stroke-width="2"></path>
      <rect x="4" y="448" width="44" height="3" fill="#c9a24a"></rect>
      <rect x="0" y="450" width="8" height="9" rx="1.5" fill={STEEL}></rect>
      <rect x="1" y="444" width="5" height="4" rx="1" fill={LIT}></rect>
      <rect x="36" y="426" width="4" height="32" fill="#0a1c38" fill-opacity="0.18"></rect>
      <g fill="#061226" stroke={STEEL} stroke-width="2">
        <circle cx="24" cy="461" r="9"></circle>
        <circle cx="112" cy="461" r="9"></circle>
        <circle cx="136" cy="461" r="9"></circle>
