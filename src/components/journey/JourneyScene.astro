---
/**
 * The illustrated world for the shipment journey: a harbour at dusk.
 * Purely decorative (aria-hidden): every stage is described in semantic HTML by
 * ShipmentJourney.astro.
 *
 * Moving parts carry `data-j` hooks that journey-client.ts updates each frame.
 * The initial attributes come from computeFrame(initialP), so the server-rendered
 * scene already shows a coherent moment of the journey.
 *
 * Layers (back → front): sky (static) · parallax backdrop (sun, skyline, clouds)
 * · world under the camera (sea, shores, port, customs, road, vehicles, container).
 */
import { computeFrame, cameraTransform, poseTransform, ROUTE_D, WORLD, STAGE_COUNT, SHEET_SPREAD } from './timeline';
import { toFa } from '~/lib/format';

export interface Props {
  initialP?: number;
}
const { initialP = 0 } = Astro.props;
const f = computeFrame(initialP);
const C = WORLD.container;

// Palette (scene-local; brand navy / ivory / gold with warm lamp light)
const LIT = '#f3d58f';
const STEEL = '#c9d3e2';
const STEEL_HI = '#e6ecf4';

// Wavy line generator for the sea (period 80 units so the CSS loop is seamless).
const wave = (y: number, amp: number, x0 = -320, x1 = 3200) => {
  let d = `M${x0} ${y}`;
  for (let x = x0; x < x1; x += 80) d += ` q20 ${-amp} 40 0 t40 0`;
  return d;
};

// Deterministic pseudo-random so server output is stable.
let seed = 7;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);

/** A row of window lights; roughly 70% lit. */
const windows = (x0: number, y: number, n: number, gap: number, w = 10, h = 7) =>
  Array.from({ length: n }, (_, i) => {
    const lit = rnd() > 0.3;
    return `<rect x="${x0 + i * gap}" y="${y}" width="${w}" height="${h}" rx="1" fill="${lit ? LIT : '#0b1f3d'}" fill-opacity="${lit ? (0.55 + rnd() * 0.35).toFixed(2) : 0.9}"/>`;
  }).join('');

/** Quay-side lamp post with a soft pool of light. */
const lamp = (x: number, h = 52, dir: 1 | -1 = -1) => `
  <circle cx="${x + dir * 9}" cy="${470 - h + 4}" r="34" fill="url(#j-lamp)"/>
  <path d="M${x} 470V${470 - h}h${dir * 9}" fill="none" stroke="#7f93b0" stroke-width="2"/>
  <rect x="${x + dir * 9 - 4}" y="${470 - h}" width="8" height="4" rx="1" fill="${LIT}"/>`;

// Stars in the upper sky (view space).
const stars = Array.from({ length: 26 }, () => ({ x: rnd() * 800, y: rnd() * 170, r: 0.6 + rnd() * 0.9, o: 0.25 + rnd() * 0.45 }));

const markers = [
  { x: 2545, y: 214 },
  { x: 2120, y: 214 },
  { x: 1188, y: 118 },
  { x: 700, y: 296 },
  { x: 145, y: 256 },
];

const sheetLabels = ['پیش‌فاکتور', 'کد تعرفه', 'مجوزها'];
const docsAnchor = { x: 2545, y: 296 };
const craneCables = (tx: number, boomY: number, hookY: number) => ({
  l1: { x: tx - 30, y1: boomY + 10, y2: hookY },
  l2: { x: tx + 30, y1: boomY + 10, y2: hookY },
});
const oc = craneCables(f.originCrane.tx, WORLD.originCrane.boomY, f.originCrane.hookY);
const dc = craneCables(f.destCrane.tx, WORLD.destCrane.boomY, f.destCrane.hookY);
const bgShift = 400 - f.camera.x * 0.28;

/** Lattice for a crane boom between x0 and x1 at the given top y. */
const lattice = (x0: number, x1: number, y: number, hgt: number) => {
  let d = '';
  for (let x = x0; x < x1; x += 22) d += `M${x} ${y + hgt}L${x + 11} ${y}L${x + 22} ${y + hgt}`;
  return d;
};
---

<svg
  class="j-svg"
  direction="ltr"
  viewBox="0 0 800 560"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
  data-j="svg"
>
  <defs>
    <linearGradient id="j-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#061329"></stop>
      <stop offset="0.38" stop-color="#0f2547"></stop>
      <stop offset="0.5" stop-color="#22406a"></stop>
      <stop offset="0.56" stop-color="#5a5f72"></stop>
      <stop offset="0.6" stop-color="#3b4c6c"></stop>
      <stop offset="1" stop-color="#16305a"></stop>
    </linearGradient>
    <linearGradient id="j-sea" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2b4a73"></stop>
      <stop offset="0.12" stop-color="#1a3a64"></stop>
      <stop offset="0.5" stop-color="#112c52"></stop>
      <stop offset="1" stop-color="#081c3a"></stop>
    </linearGradient>
    <linearGradient id="j-horizon" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f3d58f" stop-opacity="0.28"></stop>
      <stop offset="1" stop-color="#f3d58f" stop-opacity="0"></stop>
    </linearGradient>
    <linearGradient id="j-quay" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1b385f"></stop>
      <stop offset="0.12" stop-color="#132c4f"></stop>
      <stop offset="1" stop-color="#0a1d3a"></stop>
    </linearGradient>
    <linearGradient id="j-bld" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#26497a"></stop>
      <stop offset="1" stop-color="#1a375f"></stop>
    </linearGradient>
    <radialGradient id="j-sun" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#f6dc9c" stop-opacity="0.55"></stop>
      <stop offset="0.35" stop-color="#e2b866" stop-opacity="0.18"></stop>
      <stop offset="1" stop-color="#e2b866" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="j-lamp" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#f3d58f" stop-opacity="0.38"></stop>
      <stop offset="1" stop-color="#f3d58f" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id="j-beam" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#f3d58f" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#f3d58f" stop-opacity="0.5"></stop>
    </linearGradient>
    <pattern id="j-grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M40 0H0V40" fill="none" stroke="#f7f1e4" stroke-opacity="0.035" stroke-width="1"></path>
    </pattern>
    <g id="j-box">
      <rect width={C.w} height={C.h} rx="1.5"></rect>
      <path d="M8 4V38M16 4V38M24 4V38M32 4V38M40 4V38M48 4V38M56 4V38M64 4V38M72 4V38M80 4V38M88 4V38" stroke="#000" stroke-opacity="0.17" stroke-width="2"></path>
      <rect width={C.w} height="3" fill="#fff" fill-opacity="0.2"></rect>
      <rect y={C.h - 3} width={C.w} height="3" fill="#000" fill-opacity="0.18"></rect>
      <path d="M2 2h4v4h-4zM90 2h4v4h-4zM2 36h4v4h-4zM90 36h4v4h-4z" fill="#000" fill-opacity="0.22"></path>
    </g>
  </defs>

  <!-- ===== Sky (static, view space) ===== -->
  <rect width="800" height="560" fill="url(#j-sky)"></rect>
  <g fill="#f7f1e4">
    {stars.map((s) => <circle cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={s.r.toFixed(2)} opacity={s.o.toFixed(2)} />)}
  </g>
  <rect width="800" height="560" fill="url(#j-grid)"></rect>

  <!-- ===== Parallax backdrop: sun, skyline, cloud streaks (view space, shifted) ===== -->
  <g data-j="bg" transform={`translate(${bgShift.toFixed(1)} 0)`}>
    <circle cx="420" cy="292" r="150" fill="url(#j-sun)"></circle>
    <circle cx="420" cy="296" r="26" fill="#f2d391"></circle>
    <g fill="#f7f1e4">
      <rect x="-520" y="118" width="210" height="4" rx="2" opacity="0.07"></rect>
      <rect x="-470" y="128" width="120" height="3" rx="1.5" opacity="0.05"></rect>
      <rect x="150" y="214" width="260" height="4" rx="2" opacity="0.1"></rect>
      <rect x="220" y="224" width="150" height="3" rx="1.5" opacity="0.07"></rect>
      <rect x="560" y="166" width="180" height="3" rx="1.5" opacity="0.06"></rect>
      <rect x="900" y="132" width="230" height="4" rx="2" opacity="0.06"></rect>
    </g>
    <path
      d="M-1100 330 L-1100 292 Q-980 268 -860 284 T-600 278 T-340 288 L-300 330Z M-260 330 L-260 300 Q-120 274 20 292 T300 286 T560 294 L600 330Z M700 330 L700 296 Q860 276 1000 290 T1300 288 L1300 330Z"
      fill="#173359"></path>
    <g fill="#1b3a63">
      <rect x="-760" y="258" width="22" height="74"></rect><rect x="-732" y="242" width="16" height="90"></rect><rect x="-710" y="266" width="28" height="66"></rect>
      <rect x="-200" y="256" width="18" height="76"></rect><rect x="-176" y="238" width="12" height="94"></rect><rect x="-158" y="264" width="30" height="68"></rect><rect x="-122" y="250" width="16" height="82"></rect>
      <rect x="200" y="262" width="24" height="70"></rect><rect x="230" y="248" width="14" height="84"></rect>
      <rect x="880" y="258" width="20" height="74"></rect><rect x="904" y="246" width="12" height="86"></rect><rect x="920" y="268" width="26" height="64"></rect>
    </g>
    <g fill={LIT} opacity="0.7">
      <rect x="-754" y="270" width="3" height="2"></rect><rect x="-746" y="282" width="3" height="2"></rect><rect x="-727" y="256" width="3" height="2"></rect>
      <rect x="-702" y="280" width="3" height="2"></rect><rect x="-194" y="270" width="3" height="2"></rect><rect x="-172" y="252" width="3" height="2"></rect>
      <rect x="-150" y="276" width="3" height="2"></rect><rect x="-116" y="262" width="3" height="2"></rect><rect x="206" y="276" width="3" height="2"></rect>
      <rect x="234" y="262" width="3" height="2"></rect><rect x="886" y="272" width="3" height="2"></rect><rect x="908" y="258" width="3" height="2"></rect>
    </g>
  </g>

  <!-- ===== World (camera space) ===== -->
  <g data-j="camera" transform={cameraTransform(f.camera)}>
    <!-- Sea, horizon glow -->
    <rect x="-400" y={WORLD.horizon} width="3600" height="420" fill="url(#j-sea)"></rect>
    <rect x="-400" y={WORLD.horizon} width="3600" height="46" fill="url(#j-horizon)"></rect>
    <line x1="-400" y1={WORLD.horizon} x2="3200" y2={WORLD.horizon} stroke="#f3d58f" stroke-opacity="0.35"></line>

    <!-- Far shores with a few lights -->
    <path d="M-400 372 L-400 352 Q-200 340 0 350 T420 346 T820 352 T1240 362 L1300 372Z" fill="#1a365e"></path>
    <path d="M2000 372 L2060 360 Q2300 342 2520 352 T2900 344 T3200 352 L3200 372Z" fill="#1a365e"></path>
    <g fill={LIT} opacity="0.65">
      <circle cx="60" cy="356" r="1.4"></circle><circle cx="230" cy="352" r="1.4"></circle><circle cx="520" cy="352" r="1.4"></circle>
      <circle cx="860" cy="357" r="1.4"></circle><circle cx="2330" cy="352" r="1.4"></circle><circle cx="2600" cy="353" r="1.4"></circle><circle cx="2950" cy="351" r="1.4"></circle>
    </g>

    <!-- Swell (independent loop; paused offscreen and for reduced motion) -->
    <g class="j-waves" fill="none" stroke="#f7f1e4" stroke-linecap="round">
      <path d={wave(388, 1.2)} stroke-opacity="0.1" stroke-width="1"></path>
      <path d={wave(404, 1.6)} stroke-opacity="0.1" stroke-width="1"></path>
      <path d={wave(426, 2)} stroke-opacity="0.11" stroke-width="1.2"></path>
      <path d={wave(456, 2.6)} stroke-opacity="0.12" stroke-width="1.4"></path>
      <path d={wave(498, 3.2)} stroke-opacity="0.13" stroke-width="1.6"></path>
      <path d={wave(540, 3.8)} stroke-opacity="0.1" stroke-width="1.8"></path>
    </g>
    <!-- Sun glitter on the water -->
    <g fill="#f3d58f" opacity="0.22">
      <rect x="1500" y="380" width="60" height="2" rx="1"></rect><rect x="1470" y="392" width="40" height="2" rx="1"></rect>
      <rect x="1560" y="400" width="34" height="2" rx="1"></rect><rect x="1520" y="414" width="52" height="2" rx="1"></rect>
      <rect x="1600" y="388" width="24" height="2" rx="1"></rect>
    </g>

    <!-- Sea route: planned (dashed) and travelled (drawn) -->
    <path d={ROUTE_D} fill="none" stroke="#dfc17f" stroke-opacity="0.45" stroke-width="2" stroke-dasharray="2 9" stroke-linecap="round"></path>
    <path
      data-j="route"
      d={ROUTE_D}
      pathLength="1"
      fill="none"
      stroke="#c9a24a"
      stroke-width="3"
      stroke-linecap="round"
      stroke-dasharray="1 1"
      stroke-dashoffset={(1 - f.route).toFixed(4)}></path>

    <!-- ===== Destination land: road, warehouse, customs, port ===== -->
    <rect x="-400" y={WORLD.ground} width="1560" height="200" fill="url(#j-quay)"></rect>
    <rect x="-400" y={WORLD.ground} width="1560" height="3" fill="#3a5f8f"></rect>
    <path d="M1160 470V640" stroke="#f7f1e4" stroke-opacity="0.22" stroke-width="2"></path>
    <path d="M-400 520H1160M-400 572H1160M-300 474V640M-100 474V640M100 474V640M300 474V640M500 474V640M700 474V640M900 474V640" stroke="#f7f1e4" stroke-opacity="0.035"></path>
    <path d="M1080 471.5H1158" stroke="#c9a24a" stroke-width="3" stroke-dasharray="10 8"></path>
        <g fill={STEEL} fill-opacity="0.55">
      <rect x="1140" y="463" width="8" height="7" rx="2"></rect><rect x="1070" y="463" width="8" height="7" rx="2"></rect>
    </g>

    <!-- Road -->
    <rect x="-400" y="473" width="1060" height="13" fill="#071731"></rect>
    <path d="M-400 479.5H660" stroke="#f7f1e4" stroke-opacity="0.28" stroke-width="1.5" stroke-dasharray="14 12"></path>
    <path
      data-j="trail"
      d="M600 479.5H250"
      pathLength="1"
      fill="none"
      stroke="#c9a24a"
      stroke-width="3"
      stroke-linecap="round"
      stroke-dasharray="1 1"
      stroke-dashoffset={(1 - f.trail).toFixed(4)}></path>

    <!-- Destination warehouse -->
    <g>
      <path d="M30 470V384L145 344L262 384V470Z" fill="url(#j-bld)"></path>
      <path d="M22 388L145 342L270 388" fill="none" stroke="#dfc17f" stroke-opacity="0.75" stroke-width="3" stroke-linejoin="round"></path>
      <path d="M30 392H262" stroke="#f7f1e4" stroke-opacity="0.08"></path>
      <rect x="138" y="402" width="102" height="68" fill="#061226"></rect>
      <rect x="140" y="440" width="98" height="30" fill="#f3d58f" fill-opacity="0.18"></rect>
      <g data-j="door" style={`transform: scaleY(${(1 - f.door * 0.86).toFixed(4)}); transform-origin: 189px 402px;`}>
        <rect x="140" y="402" width="98" height="68" fill="#2f5583"></rect>
        <path d="M140 412H238M140 422H238M140 432H238M140 442H238M140 452H238M140 462H238" stroke="#f7f1e4" stroke-opacity="0.2"></path>
      </g>
      <g set:html={windows(48, 404, 3, 28, 16, 10)}></g>
      <rect x="132" y="396" width="114" height="6" rx="1" fill="#2d5282"></rect>
      <text x="189" y="376" text-anchor="middle" font-size="11" font-weight="800" fill="#dfc17f" opacity="0.9">انبار مقصد</text>
    </g>
    <g set:html={lamp(300, 54, 1) + lamp(420, 54, -1)}></g>
    <g data-j="done" opacity={f.done > 0 ? 1 : 0}>
      <circle cx="236" cy="322" r="34" fill="url(#j-lamp)"></circle>
      <circle cx="236" cy="322" r="20" fill="#0a1c38" stroke="#c9a24a" stroke-width="3" pathLength="1" stroke-dasharray="1 1" stroke-dashoffset={(1 - f.done).toFixed(4)} transform="rotate(-90 236 322)"></circle>
      <path d="M227 322.5l6.5 6.5 12-13" fill="none" stroke="#dfc17f" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" pathLength="1" stroke-dasharray="1 1" stroke-dashoffset={(1 - f.done).toFixed(4)}></path>
    </g>

    <!-- Customs house -->
    <g>
      <rect x="440" y="384" width="310" height="86" fill="url(#j-bld)"></rect>
      <rect x="430" y="376" width="330" height="10" rx="1" fill="#2d5282"></rect>
      <rect x="430" y="376" width="330" height="2" fill="#dfc17f" fill-opacity="0.5"></rect>
      <path d="M470 392V470M520 392V470M670 392V470M720 392V470" stroke="#f7f1e4" stroke-opacity="0.13" stroke-width="7"></path>
      <g set:html={windows(538, 400, 4, 30, 16, 12) + windows(538, 424, 4, 30, 16, 12)}></g>
      <rect x="548" y="346" width="96" height="28" rx="3" fill="#0a1c38" stroke="#dfc17f" stroke-width="1.5"></rect>
      <text x="596" y="366" text-anchor="middle" font-size="15" font-weight="800" fill="#f3d58f">گمرک</text>
    </g>
    <g set:html={lamp(790, 50, -1)}></g>

    <!-- Stamp card: verification at customs -->
    <g data-j="stamp-card" opacity={f.stamp.card.toFixed(3)}>
      <g transform="translate(560 250)">
        <rect x="3" y="5" width="72" height="88" rx="4" fill="#000" fill-opacity="0.25"></rect>
        <rect width="72" height="88" rx="4" fill="#f4eee0"></rect>
        <rect width="72" height="14" rx="4" fill="#2a4c7a"></rect>
        <path d="M12 26H60M12 38H52M12 50H58M12 62H40" stroke="#0a1c38" stroke-opacity="0.35" stroke-width="3" stroke-linecap="round"></path>
        <g data-j="stamp-mark" opacity={f.stamp.mark.toFixed(3)}>
          <circle cx="48" cy="70" r="13" fill="none" stroke="#a8832f" stroke-width="2.5"></circle>
          <path d="M42 70.5l4.2 4.2 7.8-8.6" fill="none" stroke="#a8832f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </g>
        <g data-j="stamp" transform={`translate(0 ${(-34 + 30 * f.stamp.press).toFixed(2)})`} opacity={f.stamp.press > 0.02 ? 1 : 0}>
          <rect x="36" y="46" width="24" height="8" rx="2" fill="#c9a24a"></rect>
          <rect x="44" y="30" width="8" height="16" rx="3" fill={STEEL_HI}></rect>
          <circle cx="48" cy="28" r="6" fill={STEEL_HI}></circle>
        </g>
      </g>
    </g>

    <!-- Container stacks on the quay (other cargo) -->
    <g>
      <use href="#j-box" x="800" y="428" fill="#2f5583"></use>
      <use href="#j-box" x="898" y="428" fill="#3f6b78"></use>
      <use href="#j-box" x="849" y="386" fill="#6b4f45"></use>
    </g>

    <!-- Scanner arch (back posts + beam) -->
    <g>
      <rect x="643" y="392" width="7" height="78" fill={STEEL}></rect>
      <rect x="643" y="386" width="122" height="8" rx="1" fill={STEEL}></rect>
      <circle cx="652" cy="390" r="2" fill={LIT}></circle><circle cx="756" cy="390" r="2" fill={LIT}></circle>
      <rect data-j="scan-beam" x="650" y="394" width="108" height="76" fill="#dfc17f" opacity={(f.scan.beam * 0.16).toFixed(3)}></rect>
    </g>

    <!-- Destination STS crane -->
    <g stroke={STEEL} stroke-linecap="round" fill="none">
      <path d="M1010 470V216M1120 470V216" stroke-width="7"></path>
      <path d="M1010 330H1120M1010 330L1120 400M1120 330L1010 400M1010 260H1120M1010 260L1120 300M1120 260L1010 300" stroke-width="2.5"></path>
      <path d="M1010 216L1065 132L1120 216M1065 132L895 220M1065 132L1480 220" stroke-width="2.5"></path>
    </g>
    <rect x="1000" y="462" width="30" height="8" rx="2" fill="#7f93b0"></rect>
    <rect x="1100" y="462" width="30" height="8" rx="2" fill="#7f93b0"></rect>
    <rect x="895" y="214" width="590" height="14" rx="1" fill={STEEL}></rect>
    <path d={lattice(900, 1478, 215, 12)} fill="none" stroke="#0a1c38" stroke-opacity="0.28" stroke-width="1.2"></path>
    <rect x="1030" y="194" width="70" height="20" rx="2" fill={STEEL_HI}></rect>
    <rect x="1038" y="199" width="54" height="6" rx="1" fill="#1b3961"></rect>
    <circle cx="1065" cy="132" r="3" fill="#f2a65a"></circle>
    <circle cx="1482" cy="221" r="2.5" fill={LIT}></circle><circle cx="897" cy="221" r="2.5" fill={LIT}></circle>
    <g data-j="dc-rig">
      <line data-j="dc-l1" x1={dc.l1.x} y1={dc.l1.y1} x2={dc.l1.x} y2={dc.l1.y2} stroke={STEEL_HI} stroke-width="1.6"></line>
      <line data-j="dc-l2" x1={dc.l2.x} y1={dc.l2.y1} x2={dc.l2.x} y2={dc.l2.y2} stroke={STEEL_HI} stroke-width="1.6"></line>
      <rect data-j="dc-trolley" x={f.destCrane.tx - 38} y="228" width="76" height="12" rx="2" fill="#f4eee0"></rect>
      <rect data-j="dc-spreader" x={f.destCrane.tx - 50} y={f.destCrane.hookY} width="100" height="5" rx="1" fill="#dfc17f"></rect>
    </g>

    <!-- ===== Origin land: yard, crane, office ===== -->
    <rect x="2150" y={WORLD.ground} width="1100" height="200" fill="url(#j-quay)"></rect>
    <rect x="2150" y={WORLD.ground} width="1100" height="3" fill="#3a5f8f"></rect>
    <path d="M2150 470V640" stroke="#f7f1e4" stroke-opacity="0.22" stroke-width="2"></path>
    <path d="M2150 520H3250M2150 572H3250M2300 474V640M2500 474V640M2700 474V640M2900 474V640" stroke="#f7f1e4" stroke-opacity="0.035"></path>
    <path d="M2152 471.5H2230" stroke="#c9a24a" stroke-width="3" stroke-dasharray="10 8"></path>
    <g>
      <rect x="2420" y="372" width="270" height="98" fill="url(#j-bld)"></rect>
