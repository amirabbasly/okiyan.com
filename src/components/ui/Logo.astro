---
import { site } from '~/config/site';
import Mark from './Mark.astro';
export interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---

<span class:list={['logo', `logo--${tone}`]}>
  <Mark class="logo__mark" tone={tone === 'light' ? 'on-dark' : 'color'} />
  <span class="logo__text">
    <span class="logo__fa">{site.name}</span>
    <span class="logo__en" lang="en">{site.wordmarkLatin}</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--navy-900);
  }
  .logo--light {
    color: var(--white);
  }
  .logo :global(.logo__mark) {
    inline-size: 2.6rem;
    block-size: 2.6rem;
    flex: none;
  }
  .logo__text {
    display: grid;
    line-height: 1.1;
  }
  .logo__fa {
    font-weight: 800;
    font-size: 1.4rem;
  }
  .logo__en {
    /* echoes the geometric, widely tracked OKIYAN.IR wordmark of the logo */
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    opacity: 0.75;
    direction: ltr;
    text-align: end;
  }
</style>
