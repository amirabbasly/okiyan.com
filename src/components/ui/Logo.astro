---
import { site } from '~/config/site';
export interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---

<span class:list={['logo', `logo--${tone}`]}>
  <img class="logo__mark" src="/img/logo-globe.png" alt="" width="909" height="568" />
  <span class="logo__text">
    <span class="logo__fa">{site.name}</span>
    <span class="logo__en" lang="en">{site.wordmarkLatin}</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--navy-900);
  }
  .logo--light {
    color: var(--white);
  }
  .logo :global(.logo__mark) {
    /* the globe-scene emblem: transparent outside its orbit ellipse */
    inline-size: auto;
    block-size: 2.7rem;
    flex: none;
    filter: drop-shadow(0 3px 8px rgb(4 16 31 / 0.35));
  }
  .logo__text {
    display: grid;
    line-height: 1.1;
  }
  .logo__fa {
    font-weight: 800;
    font-size: 1.4rem;
  }
  .logo__en {
    /* echoes the geometric, widely tracked OKIYAN.COM wordmark of the logo */
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    opacity: 0.75;
    direction: ltr;
    text-align: end;
  }
</style>
