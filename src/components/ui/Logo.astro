---
import { site } from '~/config/site';
export interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---

<span class:list={['logo', `logo--${tone}`]}>
  <svg class="logo__mark" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true" focusable="false">
    <circle cx="20" cy="20" r="17" fill="none" stroke="currentColor" stroke-width="2.4"></circle>
    <path d="M6.5 24.5c5-1 8.5-5.5 13.5-5.5s8.5 4.5 13.5 5.5" fill="none" stroke="var(--gold-400)" stroke-width="2.4" stroke-linecap="round"></path>
    <rect x="16.4" y="11.2" width="7.2" height="5.6" rx="1" fill="var(--gold-400)"></rect>
  </svg>
  <span class="logo__text">
    <span class="logo__fa">{site.name}</span>
    <span class="logo__en" lang="en">{site.nameLatin}</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--navy-900);
  }
  .logo--light {
    color: var(--ivory-50);
  }
  .logo__mark {
    inline-size: 2.35rem;
    block-size: 2.35rem;
    flex: none;
  }
  .logo__text {
    display: grid;
    line-height: 1.1;
  }
  .logo__fa {
    font-weight: 800;
    font-size: 1.35rem;
  }
  .logo__en {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    opacity: 0.7;
    direction: ltr;
    text-align: end;
  }
</style>
