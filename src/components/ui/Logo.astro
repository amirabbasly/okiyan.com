---
import { site } from '~/config/site';
export interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---

<span class:list={['logo', `logo--${tone}`]}>
  <img
    class="logo__lockup"
    src={tone === 'light' ? '/img/logo-lockup-light.png' : '/img/logo-lockup.png'}
    alt={`${site.name} — ${site.wordmarkLatin}`}
    width="480"
    height="167"
  />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--navy-900);
  }
  .logo--light {
    color: var(--white);
  }
  .logo :global(.logo__lockup) {
    /* the master lockup: crescent mark + OKIYAN wordmark, transparent sheet */
    block-size: 2.55rem;
    inline-size: auto;
    flex: none;
  }
  .logo--light :global(.logo__lockup) {
    filter: drop-shadow(0 2px 10px rgb(0 12 30 / 0.5));
  }
</style>
