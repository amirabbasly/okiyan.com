---
/**
 * «پیش از هر تصمیم، مسیر را روشن کنید» — the closing conversion band.
 *
 * The band is a live, infinitely looping scene instead of a video file:
 *   - a seamless dark-water tile scrolls downwards forever (the ship reads as
 *     sailing forward),
 *   - the vertical container ship — keyed off its isolation sheet, the
 *     horizontal ship of the first render removed for good — rides the water
 *     with a slow bob,
 *   - there is no section background of its own: the scene IS the band,
 *     full-bleed, with only a readability scrim under the copy.
 * Two still layers + CSS keyframes loop perfectly and stay sharp at any size,
 * which a compressed video file could not; `prefers-reduced-motion` freezes it.
 */
import Icon from './Icon.astro';
import { contactCta } from '~/config/site';
export interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'پیش از هر تصمیم، مسیر را روشن کنید',
  text = 'مشخصات کالا و مرحلهٔ فعلی محموله را بفرستید. پس از بررسی، می‌گوییم چه مدارکی لازم است، چه هزینه‌هایی را باید در نظر بگیرید و قدم بعدی چیست.',
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-title">
  <div class="cta-band__scene" aria-hidden="true">
    <div class="cta-band__sea"></div>
    <img class="cta-band__ship" src="/img/ship-vertical.webp" alt="" width="230" height="1400" />
    <div class="cta-band__scrim"></div>
  </div>
  <div class="container cta-band__wrap">
    <div class="cta-band__copy reveal">
      <h2 id="cta-title">{title}</h2>
      <p class="lead">{text}</p>
      <div class="cta-band__actions">
        <a class="btn btn--sun" href={contactCta.href}>
          {contactCta.label}
          <Icon name="arrow" class="btn__icon" />
        </a>
        <a class="arrow-link cta-band__more" href="/guides/">
          ابتدا راهنماها را بخوانید
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    color: #c4cddb;
  }
  .cta-band__scene {
    position: absolute;
    inset: 0;
  }
  /* the water: one seamless tile, scrolled exactly one tile-height per cycle,
     so the loop has no seam and no end */
  .cta-band__sea {
    position: absolute;
    inset: 0;
    background: url('/img/sea-tile.webp') repeat;
    background-size: 232px 232px;
    animation: sea-flow 14s linear infinite;
    filter: brightness(0.9) saturate(1.05);
  }
  @keyframes sea-flow {
    to {
      background-position: 0 232px;
    }
  }
  .cta-band__ship {
    position: absolute;
    left: 26%;
    top: 50%;
    translate: -50% -50%;
    block-size: 132%;
    inline-size: auto;
    animation: ship-bob 9s ease-in-out infinite;
    filter: drop-shadow(0 22px 44px rgb(0 4 14 / 0.55));
  }
  @keyframes ship-bob {
    0%,
    100% {
      transform: translateY(-7px) rotate(-0.5deg);
    }
    50% {
      transform: translateY(7px) rotate(0.5deg);
    }
  }
  /* readability only: darker under the copy (right in RTL), open over the ship */
  .cta-band__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to left,
      rgb(1 10 26 / 0.86),
      rgb(1 10 26 / 0.62) 38%,
      rgb(1 10 26 / 0.18) 66%,
      rgb(1 10 26 / 0.34)
    );
  }
  .cta-band__wrap {
    position: relative;
    display: flex;
    justify-content: flex-start; /* RTL: the copy starts from the right edge */
  }
  .cta-band__copy {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    max-width: 40rem;
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }
  .cta-band h2 {
    color: var(--white);
    font-size: var(--step-4);
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 0.4rem;
  }
  .btn--sun {
    --btn-bg: var(--petrol-600);
    --btn-border: var(--petrol-600);
    --btn-fg: var(--navy-950);
    box-shadow: 0 16px 34px -18px rgb(254 93 2 / 0.65);
  }
  .btn--sun:hover {
    --btn-bg: #ff7a29;
    --btn-border: #ff7a29;
    --btn-fg: var(--navy-950);
  }
  .cta-band__more {
    color: var(--mist-100);
  }
  .cta-band__more:hover {
    color: var(--petrol-200);
  }
  @media (max-width: 860px) {
    .cta-band__ship {
      left: 50%;
      block-size: 118%;
      opacity: 0.9;
    }
    .cta-band__scrim {
      background: rgb(1 10 26 / 0.66);
    }
    .cta-band__copy {
      padding-block: 3rem 3.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-band__sea,
    .cta-band__ship {
      animation: none;
    }
  }
</style>
