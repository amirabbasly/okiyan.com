---
import Icon from './Icon.astro';
import { contactCta } from '~/config/site';
export interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'پیش از هر تصمیم، مسیر را روشن کنید',
  text = 'مشخصات کالا و مرحلهٔ فعلی محموله را بفرستید. پس از بررسی، می‌گوییم چه مدارکی لازم است، چه هزینه‌هایی را باید در نظر بگیرید و قدم بعدی چیست.',
} = Astro.props;
---

<section class="cta-band section section--alt section--grain" aria-labelledby="cta-title">
  <div class="container cta-band__inner reveal">
    <svg class="cta-band__route" viewBox="0 0 320 200" aria-hidden="true" focusable="false">
      <path d="M300 30C240 40 230 120 170 128S70 100 20 170" fill="none" stroke="#c9a24a" stroke-width="2" stroke-dasharray="3 9" stroke-linecap="round"></path>
      <circle cx="300" cy="30" r="7" fill="#c9a24a"></circle>
      <circle cx="20" cy="170" r="7" fill="none" stroke="#0a1c38" stroke-width="2.5"></circle>
      <rect x="150" y="112" width="34" height="22" rx="2" fill="#0a1c38" transform="rotate(-8 167 123)"></rect>
      <rect x="156" y="118" width="22" height="9" rx="1.5" fill="#c9a24a" transform="rotate(-8 167 123)"></rect>
    </svg>
    <div class="stack" style="--stack: 1rem">
      <h2 id="cta-title">{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="cta-band__actions">
      <a class="btn" href={contactCta.href}>
        {contactCta.label}
        <Icon name="arrow" class="btn__icon" />
      </a>
      <a class="arrow-link" href="/guides/">
        ابتدا راهنماها را بخوانید
        <Icon name="arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band__route {
    position: absolute;
    inset-inline-end: 1.75rem;
    top: 1rem;
    width: min(9rem, 22%);
    height: auto;
    opacity: 0.6;
    pointer-events: none;
  }
  .cta-band__inner > :not(.cta-band__route) {
    position: relative;
  }
  .cta-band__inner {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) auto;
    align-items: end;
    gap: 2rem 4rem;
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background:
      radial-gradient(40rem 20rem at 0% 100%, rgb(201 162 74 / 0.12), transparent 70%),
      var(--ivory-50);
  }
  .cta-band h2 {
    font-size: var(--step-4);
  }
  .cta-band__actions {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  @media (max-width: 760px) {
    .cta-band__inner {
      grid-template-columns: 1fr;
    }
    .cta-band__route {
      display: none;
    }
  }
</style>
