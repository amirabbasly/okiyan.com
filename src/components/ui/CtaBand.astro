---
/**
 * «پیش از هر تصمیم، مسیر را روشن کنید» — the closing conversion band.
 *
 * A single, still, full-bleed cinematic frame: the vertical container ship
 * shot from above on dark water (public/img/ship-cta-*.webp). No animation,
 * no panel of its own — the photograph IS the band; a directional scrim keeps
 * the copy readable over it and the logo-orange CTA closes the section.
 */
import Icon from './Icon.astro';
import { contactCta } from '~/config/site';
export interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'پیش از هر تصمیم، مسیر را روشن کنید',
  text = 'مشخصات کالا و مرحلهٔ فعلی محموله را بفرستید. پس از بررسی، می‌گوییم چه مدارکی لازم است، چه هزینه‌هایی را باید در نظر بگیرید و قدم بعدی چیست.',
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-title">
  <picture aria-hidden="true">
    <source srcset="/img/ship-cta-1600.webp" type="image/webp" />
    <img class="cta-band__photo" src="/img/ship-cta-1600.webp" alt="" width="1600" height="900" />
  </picture>
  <div class="cta-band__scrim" aria-hidden="true"></div>
  <div class="container cta-band__wrap">
    <div class="cta-band__copy reveal">
      <h2 id="cta-title">{title}</h2>
      <p class="lead">{text}</p>
      <div class="cta-band__actions">
        <a class="btn btn--sun" href={contactCta.href}>
          {contactCta.label}
          <Icon name="arrow" class="btn__icon" />
        </a>
        <a class="arrow-link cta-band__more" href="/guides/">
          ابتدا راهنماها را بخوانید
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    color: #c4cddb;
  }
  .cta-band__photo {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center 42%;
  }
  /* readability only: darker under the copy (right in RTL), open over the ship */
  .cta-band__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to left,
      rgb(1 10 26 / 0.88),
      rgb(1 10 26 / 0.66) 40%,
      rgb(1 10 26 / 0.18) 68%,
      rgb(1 10 26 / 0.3)
    );
  }
  .cta-band__wrap {
    position: relative;
    display: flex;
    justify-content: flex-start; /* RTL: the copy starts from the right edge */
  }
  .cta-band__copy {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    max-width: 40rem;
    padding-block: clamp(4rem, 9vw, 7rem);
  }
  .cta-band h2 {
    color: var(--white);
    font-size: var(--step-4);
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 0.4rem;
  }
  .btn--sun {
    --btn-bg: var(--petrol-600);
    --btn-border: var(--petrol-600);
    --btn-fg: var(--navy-950);
    box-shadow: 0 16px 34px -18px rgb(254 93 2 / 0.65);
  }
  .btn--sun:hover {
    --btn-bg: #ff7a29;
    --btn-border: #ff7a29;
    --btn-fg: var(--navy-950);
  }
  .cta-band__more {
    color: var(--mist-100);
  }
  .cta-band__more:hover {
    color: var(--petrol-200);
  }
  @media (max-width: 860px) {
    .cta-band__photo {
      object-position: 38% center;
    }
    .cta-band__scrim {
      background: rgb(1 10 26 / 0.72);
    }
    .cta-band__copy {
      padding-block: 3rem 3.5rem;
    }
  }
</style>
