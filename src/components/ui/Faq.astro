---
/**
 * FAQ list built on native <details>. Helpful for readers; we intentionally do
 * not emit FAQPage markup (Google limits FAQ rich results to a few site types).
 */
export interface Props {
  items: Array<{ q: string; a: string }>;
  headingLevel?: 'h3' | 'h4';
}
const { items, headingLevel: H = 'h3' } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq__item">
        <summary>
          <H class="faq__q">{item.q}</H>
          <span class="faq__icon" aria-hidden="true" />
        </summary>
        <div class="faq__a">
          <p set:html={item.a} />
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--rule);
  }
  .faq__item {
    border-bottom: 1px solid var(--rule);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.35rem 0.25rem;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-s);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq__q {
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.7;
    transition: color var(--dur-fast) ease;
  }
  summary:hover .faq__q {
    color: var(--petrol-600);
  }
  .faq__icon {
    position: relative;
    flex: none;
    inline-size: 2rem;
    block-size: 2rem;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    transition:
      transform var(--dur-med) var(--ease-out),
      background-color var(--dur-fast) ease;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    inline-size: 0.8rem;
    block-size: 2px;
    background: currentColor;
    translate: -50% -50%;
    border-radius: 2px;
  }
  .faq__icon::after {
    rotate: 90deg;
    transition: rotate var(--dur-med) var(--ease-out);
  }
  details[open] .faq__icon {
    background: var(--petrol-200);
    border-color: var(--petrol-200);
  }
  details[open] .faq__icon::after {
    rotate: 0deg;
  }
  .faq__a {
    padding: 0 0.25rem 1.5rem;
    max-width: 48rem;
    color: var(--text-muted);
  }
  .faq__a :global(a) {
    color: var(--petrol-600);
    font-weight: 600;
  }
</style>
