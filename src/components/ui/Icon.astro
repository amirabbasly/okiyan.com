---
/** Small inline icon set (stroke icons, 24px grid). Decorative by default. */
export interface Props {
  name: 'arrow' | 'check' | 'info' | 'phone' | 'mail' | 'chat' | 'headset' | 'send' | 'doc' | 'menu' | 'close' | 'alert' | 'external' | 'stamp' | 'ship' | 'route' | 'pin' | 'chevron' | 'shield' | 'calc' | 'users' | 'briefcase' | 'cube' | 'award' | 'clock' | 'lock' | 'globe' | 'play' | 'pause';
  class?: string;
  label?: string;
}
const { name, class: className, label } = Astro.props;
const paths: Record<Props['name'], string> = {
  // Points left: "forward" in RTL reading order.
  arrow: '<path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/>',
  check: '<path d="M5 12.5l4.2 4.2L19 7"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 7.6v.2"/>',
  alert: '<path d="M12 3.5l9.5 16.5h-19z"/><path d="M12 10v4.5"/><path d="M12 17.4v.2"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/>',
  chat: '<path d="M4 18.5V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H7.5z"/><path d="M8.5 9.5h7M8.5 12.5h4.5"/>',
  headset: '<path d="M4 13.2v-1.4a8 8 0 0 1 16 0v1.4"/><rect x="3.2" y="12.6" width="4.2" height="7.6" rx="1.7"/><rect x="16.6" y="12.6" width="4.2" height="7.6" rx="1.7"/><path d="M18.7 20.2v.3a1.7 1.7 0 0 1-1.7 1.7H13"/>',
  send: '<path d="M21 3L3 10.5l7 2.5 2.5 7z"/><path d="M10 13l5-5"/>',
  doc: '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="M10 13h6M10 17h6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h10"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  stamp: '<path d="M6 3h8l4 4v6"/><path d="M14 3v4h4"/><path d="M6 3v15h5"/><path d="M9 8h3M9 11h4"/><circle cx="17" cy="17" r="4"/><path d="M15.4 17.1l1.1 1.1 2.1-2.3"/>',
  ship: '<path d="M3 15h18l-2.5 4.5h-13z"/><path d="M6 15V9h5v6M11 11h4v4"/><path d="M16 15V7h2v8"/><path d="M2 21.5q2.5 1.2 5 0t5 0 5 0 5 0"/>',
  route: '<circle cx="6" cy="18" r="2.2"/><circle cx="18" cy="6" r="2.2"/><path d="M8 17c5-1 2-7 7-8.5" stroke-dasharray="2 2.5"/>',
  pin: '<path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/>',
  chevron: '<path d="M7 10l5 5 5-5"/>',
  shield: '<path d="M12 3l7.5 3v5.5c0 4.6-3.2 8-7.5 9.5-4.3-1.5-7.5-4.9-7.5-9.5V6z"/><path d="M8.8 12.2l2.2 2.2 4.2-4.6"/>',
  calc: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8"/><path d="M8.5 11.5h.1M12 11.5h.1M15.5 11.5h.1M8.5 15h.1M12 15h.1M8.5 18h.1M12 18h.1"/><path d="M15.5 15v3"/>',
  users: '<circle cx="9" cy="8.5" r="3.2"/><path d="M3.5 19.5c.6-3.2 2.8-5 5.5-5s4.9 1.8 5.5 5"/><circle cx="16.5" cy="9.5" r="2.5"/><path d="M15.5 14.6c2.6-.3 4.5 1.4 5 4.4"/>',
  briefcase: '<rect x="3.5" y="7" width="17" height="12.5" rx="2"/><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7"/><path d="M3.5 12.5h17"/><path d="M11 12.5v1.5h2v-1.5"/>',
  cube: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5"/><path d="M12 12v9"/>',
  award: '<circle cx="12" cy="9" r="5.5"/><path d="M9 13.8L7.5 21l4.5-2.5 4.5 2.5-1.5-7.2"/><path d="M10 9l1.4 1.4L14.2 7.6"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  lock: '<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/><path d="M12 14.5v2.5"/>',
  globe: '<circle cx="12" cy="12" r="8.6"/><path d="M3.4 12h17.2"/><path d="M12 3.4c2.5 2.4 3.9 5.4 3.9 8.6s-1.4 6.2-3.9 8.6c-2.5-2.4-3.9-5.4-3.9-8.6S9.5 5.8 12 3.4z"/>',
  play: '<path d="M8 4.8l10.5 7.2L8 19.2z"/>',
  pause: '<path d="M9 5v14M15 5v14"/>',
  external: '<path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={paths[name]}
/>
