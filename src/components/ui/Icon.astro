---
/** Small inline icon set (stroke icons, 24px grid). Decorative by default. */
export interface Props {
  name: 'arrow' | 'check' | 'info' | 'phone' | 'mail' | 'chat' | 'send' | 'doc' | 'menu' | 'close' | 'alert' | 'external' | 'stamp' | 'ship' | 'route';
  class?: string;
  label?: string;
}
const { name, class: className, label } = Astro.props;
const paths: Record<Props['name'], string> = {
  // Points left: "forward" in RTL reading order.
  arrow: '<path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/>',
  check: '<path d="M5 12.5l4.2 4.2L19 7"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 7.6v.2"/>',
  alert: '<path d="M12 3.5l9.5 16.5h-19z"/><path d="M12 10v4.5"/><path d="M12 17.4v.2"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/>',
  chat: '<path d="M4 18.5V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H7.5z"/><path d="M8.5 9.5h7M8.5 12.5h4.5"/>',
  send: '<path d="M21 3L3 10.5l7 2.5 2.5 7z"/><path d="M10 13l5-5"/>',
  doc: '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="M10 13h6M10 17h6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h10"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  stamp: '<path d="M6 3h8l4 4v6"/><path d="M14 3v4h4"/><path d="M6 3v15h5"/><path d="M9 8h3M9 11h4"/><circle cx="17" cy="17" r="4"/><path d="M15.4 17.1l1.1 1.1 2.1-2.3"/>',
  ship: '<path d="M3 15h18l-2.5 4.5h-13z"/><path d="M6 15V9h5v6M11 11h4v4"/><path d="M16 15V7h2v8"/><path d="M2 21.5q2.5 1.2 5 0t5 0 5 0 5 0"/>',
  route: '<circle cx="6" cy="18" r="2.2"/><circle cx="18" cy="6" r="2.2"/><path d="M8 17c5-1 2-7 7-8.5" stroke-dasharray="2 2.5"/>',
  external: '<path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={paths[name]}
/>
