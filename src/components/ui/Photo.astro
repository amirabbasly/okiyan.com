---
/**
 * Editorial photograph with an explicit size, so the browser reserves the
 * box before the bytes arrive (no layout shift, good CLS).
 *
 * Only images that show the actual subject of the page belong here — no
 * stock decoration. Each one carries a caption that adds context, because a
 * figure the reader ignores is a figure that costs bandwidth for nothing.
 */
import Icon from '~/components/ui/Icon.astro';

export interface Props {
  /** Base name in /public/img, e.g. "lenj-bushehr". */
  name: string;
  /** Describes the image for screen readers and for search engines. */
  alt: string;
  width: number;
  height: number;
  /** Visible caption under the frame. Skip it when the alt says it all. */
  caption?: string;
  /** Above-the-fold images load eagerly; everything else waits. */
  priority?: boolean;
  /** Rendered width hint for the srcset selection. */
  sizes?: string;
  /** "wide" bleeds to the container edge, "inset" leaves it narrow. */
  variant?: 'wide' | 'inset';
  class?: string;
}

const {
  name,
  alt,
  width,
  height,
  caption,
  priority = false,
  sizes = '(max-width: 780px) 100vw, 1120px',
  variant = 'wide',
  class: className,
} = Astro.props;

const jpg = `/img/${name}.jpg`;
const webp800 = `/img/${name}-800.webp`;
const webp1600 = `/img/${name}-1600.webp`;
---

<figure class:list={['photo', `photo--${variant}`, className]}>
  <div class="photo__frame">
    <picture>
      <source type="image/webp" srcset={`${webp800} 800w, ${webp1600} 1600w`} sizes={sizes} />
      <img
        src={jpg}
        alt={alt}
        width={width}
        height={height}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
      />
    </picture>
  </div>
  {
    caption && (
      <figcaption class="photo__cap">
        <Icon name="info" />
        <span>{caption}</span>
      </figcaption>
    )
  }
</figure>

<style>
  .photo {
    margin: 0;
    display: grid;
    gap: 0.7rem;
  }
  .photo__frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-m, 14px);
    background: var(--mist-200, #e6eef2);
    box-shadow:
      0 1px 0 rgb(22 44 71 / 0.06),
      0 18px 40px -28px rgb(22 44 71 / 0.45);
  }
  /* A hairline inner ring keeps photos from bleeding into the page edge. */
  .photo__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(22 44 71 / 0.1);
    pointer-events: none;
  }
  .photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .photo--inset .photo__frame {
    max-width: 42rem;
  }
  .photo__cap {
    display: flex;
    gap: 0.45rem;
    align-items: flex-start;
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--slate-600, #55606c);
  }
  .photo__cap :global(svg) {
    flex: none;
    width: 1rem;
    height: 1rem;
    margin-top: 0.22rem;
    color: var(--petrol, #234d66);
  }
</style>
