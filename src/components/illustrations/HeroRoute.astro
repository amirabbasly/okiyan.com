---
/**
 * Hero plate: a schematic route from origin to destination, five stage ticks that
 * echo the journey section, and the clearance file that travels with the cargo.
 * One-time entrance (route draw, card rise) only when motion is allowed.
 */
const ticks = [
  { x: 468, y: 150 },
  { x: 404, y: 228 },
  { x: 282, y: 268 },
  { x: 204, y: 326 },
  { x: 128, y: 392 },
];
const fa = ['۱', '۲', '۳', '۴', '۵'];
---

<svg
  class="hero-art"
  direction="ltr"
  viewBox="0 0 560 540"
  width="560"
  height="540"
  role="img"
  aria-label="تصویر نمادین: مسیر یک محموله در پنج مرحله از بندر مبدأ تا مقصد، همراه با پروندهٔ اسناد ترخیص"
>
  <defs>
    <linearGradient id="h-panel" x1="0" y1="0" x2="0.35" y2="1">
      <stop offset="0" stop-color="#0c1f3f"></stop>
      <stop offset="0.55" stop-color="#132d55"></stop>
      <stop offset="1" stop-color="#0a1c38"></stop>
    </linearGradient>
    <radialGradient id="h-sun" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#f3d58f" stop-opacity="0.4"></stop>
      <stop offset="1" stop-color="#f3d58f" stop-opacity="0"></stop>
    </radialGradient>
    <pattern id="h-grid" width="28" height="28" patternUnits="userSpaceOnUse">
      <path d="M28 0H0V28" fill="none" stroke="#f7f1e4" stroke-opacity="0.055"></path>
    </pattern>
    <clipPath id="h-clip"><rect x="40" y="30" width="500" height="430" rx="28"></rect></clipPath>
  </defs>

  <!-- Back plate for depth -->
  <rect x="58" y="52" width="500" height="430" rx="30" fill="none" stroke="#c9a24a" stroke-opacity="0.55" stroke-width="1.5" transform="rotate(3 308 267)"></rect>

  <!-- Panel -->
  <rect x="40" y="38" width="500" height="430" rx="28" fill="#061226" fill-opacity="0.18"></rect>
  <rect x="40" y="30" width="500" height="430" rx="28" fill="url(#h-panel)"></rect>
  <g clip-path="url(#h-clip)">
    <rect x="40" y="30" width="500" height="430" fill="url(#h-grid)"></rect>
    <circle cx="480" cy="96" r="170" fill="url(#h-sun)"></circle>
    <!-- coasts with tiny port silhouettes -->
    <path d="M540 196c-40 6-62 30-104 26s-60-34-98-26V30h202z" fill="#173459" fill-opacity="0.75"></path>
    <path d="M40 372c46-10 70 14 112 8s58-30 96-22V460H40z" fill="#173459" fill-opacity="0.75"></path>
    <path d="M540 196c-40 6-62 30-104 26s-60-34-98-26" fill="none" stroke="#f7f1e4" stroke-opacity="0.2" stroke-width="1.5"></path>
    <path d="M40 372c46-10 70 14 112 8s58-30 96-22" fill="none" stroke="#f7f1e4" stroke-opacity="0.2" stroke-width="1.5"></path>
    <g fill="#24477a">
      <path d="M492 192v-22l12-8v8l12-8v8l12-8v30z"></path>
      <path d="M70 368v-34h4v-10h40v6h-36v38z"></path>
    </g>
    <g fill="#f3d58f" opacity="0.8">
      <rect x="497" y="178" width="4" height="3"></rect><rect x="509" y="178" width="4" height="3"></rect><rect x="521" y="178" width="4" height="3"></rect>
      <circle cx="112" cy="324" r="2"></circle>
    </g>
    <!-- swell lines -->
    <g fill="none" stroke="#f7f1e4" stroke-opacity="0.08">
      <path d="M60 282q15-5 30 0t30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0"></path>
      <path d="M40 314q15-5 30 0t30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0"></path>
      <path d="M60 246q15-5 30 0t30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0"></path>
    </g>
  </g>

  <!-- Route: origin (top-right) → destination (bottom-left), RTL reading order -->
  <path d="M468 150C430 250 330 236 280 270S170 360 128 392" fill="none" stroke="#dfc17f" stroke-opacity="0.45" stroke-width="2" stroke-dasharray="3 9" stroke-linecap="round"></path>
  <path class="h-draw" d="M468 150C430 250 330 236 280 270" pathLength="1" fill="none" stroke="#c9a24a" stroke-width="3.5" stroke-linecap="round"></path>

  <!-- Five stage ticks (the same five stages as the journey section) -->
  {
    ticks.map((t, i) => (
      <g transform={`translate(${t.x} ${t.y})`} class="h-tick">
        <circle r={i === 2 ? 0 : 7} fill={i < 2 ? '#c9a24a' : '#0a1c38'} stroke={i < 2 ? 'none' : '#dfc17f'} stroke-width="1.5" />
        {i !== 2 && (
          <text x={i % 2 === 0 ? -14 : 14} y="5" text-anchor={i % 2 === 0 ? 'end' : 'start'} font-size="13" font-weight="800" fill={i < 2 ? '#dfc17f' : '#c3cddc'}>
            {fa[i]}
          </text>
        )}
      </g>
    ))
  }

  <!-- Origin / destination labels -->
  <circle cx="468" cy="150" r="22" fill="#c9a24a" fill-opacity="0.16"></circle>
  <text x="452" y="124" text-anchor="end" font-size="15" font-weight="800" fill="#f7f1e4">مبدأ</text>
  <circle cx="128" cy="392" r="22" fill="#f7f1e4" fill-opacity="0.07"></circle>
  <text x="128" y="438" text-anchor="middle" font-size="15" font-weight="800" fill="#f7f1e4">مقصد</text>

  <!-- Ship on the route (stage ۳) -->
  <g transform="translate(282 262) rotate(-14)" class="h-ship">
    <ellipse cx="0" cy="11" rx="52" ry="4" fill="#000" fill-opacity="0.25"></ellipse>
    <path d="M-50 -8H46L39 5Q38 8 34 8H-36Q-40 8 -43 4Z" fill="#ece4d2"></path>
    <path d="M-44 2H43L39 5Q38 8 34 8H-36Q-40 8 -43 4Z" fill="#7a3a2f"></path>
    <rect x="-32" y="-24" width="32" height="16" rx="1.5" fill="#c9a24a"></rect>
    <rect x="2" y="-24" width="18" height="16" rx="1.5" fill="#2a4c7a"></rect>
    <rect x="24" y="-32" width="15" height="24" rx="1.5" fill="#f4eee0"></rect>
    <rect x="26" y="-29" width="11" height="3" rx="0.5" fill="#f3d58f"></rect>
    <path d="M-64 10q12 4 24 0M48 10q14 4 28 0" stroke="#f7f1e4" stroke-opacity="0.4" stroke-width="2" fill="none" stroke-linecap="round"></path>
  </g>

  <!-- Compass -->
  <g transform="translate(96 96)" fill="none" stroke="#f7f1e4" stroke-opacity="0.5">
    <circle r="24"></circle>
    <circle r="31" stroke-opacity="0.15" stroke-dasharray="2 4"></circle>
    <path d="M0 -34V34M-34 0H34" stroke-opacity="0.22"></path>
    <path d="M0 -18L6 0L0 18L-6 0Z" fill="#c9a24a" fill-opacity="0.95" stroke="none"></path>
  </g>

  <!-- Clearance file overlapping the panel -->
  <g class="h-card">
    <g transform="translate(330 306) rotate(-5)">
      <rect x="8" y="12" width="200" height="190" rx="14" fill="#061226" fill-opacity="0.22"></rect>
      <rect width="200" height="190" rx="14" fill="#fdfaf3"></rect>
      <rect width="200" height="44" rx="14" fill="#f1e8d4"></rect>
      <rect y="30" width="200" height="14" fill="#f1e8d4"></rect>
      <rect x="20" y="15" width="40" height="14" rx="7" fill="#0a1c38"></rect>
      <text x="40" y="25.5" text-anchor="middle" font-size="9" font-weight="800" fill="#dfc17f">۳ از ۵</text>
      <text x="180" y="28" text-anchor="end" font-size="14" font-weight="800" fill="#0a1c38">پروندهٔ ترخیص</text>
      <g stroke="#0a1c38" stroke-linecap="round">
        <path d="M180 68H96" stroke-width="3" stroke-opacity="0.55"></path>
        <path d="M180 92H70" stroke-width="3" stroke-opacity="0.25"></path>
        <path d="M180 116H84" stroke-width="3" stroke-opacity="0.25"></path>
        <path d="M180 140H110" stroke-width="3" stroke-opacity="0.25"></path>
      </g>
      <g transform="translate(20 70)" stroke="#0a1c38" stroke-opacity="0.45" fill="none" stroke-width="2">
        <rect width="14" height="14" rx="3"></rect>
        <rect y="24" width="14" height="14" rx="3"></rect>
        <rect y="48" width="14" height="14" rx="3"></rect>
      </g>
      <g stroke="#a8832f" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M23 76.5l3.5 3.5 6-7"></path>
        <path d="M23 100.5l3.5 3.5 6-7"></path>
      </g>
      <g transform="translate(150 158)">
        <circle r="24" fill="#fbf3df" stroke="#a8832f" stroke-width="2.5"></circle>
        <circle r="18" fill="none" stroke="#a8832f" stroke-width="1" stroke-dasharray="2 3"></circle>
        <path d="M-8 0.5l5.5 5.5 11-12" fill="none" stroke="#a8832f" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
      </g>
    </g>
  </g>

  <!-- HS code chip -->
  <g class="h-chip">
    <g transform="translate(66 206) rotate(4)">
      <rect x="3" y="5" width="152" height="46" rx="23" fill="#061226" fill-opacity="0.2"></rect>
      <rect width="152" height="46" rx="23" fill="#fdfaf3"></rect>
      <circle cx="128" cy="23" r="10" fill="#c9a24a"></circle>
      <path d="M123.5 23.3l3 3 5.5-6" fill="none" stroke="#0a1c38" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      <text x="110" y="28.5" text-anchor="end" font-size="13.5" font-weight="800" fill="#0a1c38">کد تعرفه</text>
      <text x="16" y="28" font-size="12" font-weight="800" fill="#465265" direction="ltr" font-family="Vazirmatn, Tahoma, sans-serif">HS</text>
    </g>
  </g>
</svg>

<style>
  .hero-art {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hero-art text {
    font-family: var(--font-sans);
  }
  .h-draw {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .h-draw {
      animation: h-draw 1.6s var(--ease-out) 0.25s both;
    }
    .h-ship {
      animation: h-fade 0.7s var(--ease-out) 1.1s both;
    }
    .h-card {
      animation: h-rise 0.8s var(--ease-out) 0.45s both;
    }
    .h-chip {
      animation: h-rise 0.8s var(--ease-out) 0.65s both;
    }
  }
  @keyframes h-draw {
    from {
      stroke-dashoffset: 1;
    }
  }
  @keyframes h-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes h-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>
