---
/** Export plate: a loaded ship heading away from the quay, with the destination marked. Decorative. */
---

<svg class="plate" direction="ltr" viewBox="0 0 420 360" width="420" height="360" aria-hidden="true" focusable="false">
  <clipPath id="clip-exportart"><rect x="20" y="20" width="380" height="320" rx="26"></rect></clipPath>
  <rect x="20" y="20" width="380" height="320" rx="26" fill="#162c47"></rect>
  <g clip-path="url(#clip-exportart)">
    <circle cx="300" cy="86" r="76" fill="#8fb4c9" fill-opacity="0.09"></circle>
    <g fill="none" stroke="#8fb4c9" stroke-linecap="round">
      <path d="M40 250c16-9 30-9 46 0s30 9 46 0 30-9 46 0 30 9 46 0 30-9 46 0 30 9 46 0" stroke-opacity="0.34" stroke-width="2"></path>
      <path d="M40 276c16-9 30-9 46 0s30 9 46 0 30-9 46 0 30 9 46 0 30-9 46 0 30 9 46 0" stroke-opacity="0.16" stroke-width="2"></path>
    </g>

    <!-- destination globe, top right -->
    <g transform="translate(312 96)">
      <circle r="30" fill="#1d3a5a" stroke="#8fb4c9" stroke-width="2"></circle>
      <ellipse rx="12" ry="30" fill="none" stroke="#b9d1de" stroke-opacity="0.75" stroke-width="1.6"></ellipse>
      <path d="M-30 0H30M-26 -12H26M-26 12H26" stroke="#b9d1de" stroke-opacity="0.55" stroke-width="1.6"></path>
    </g>
    <!-- dashed trade route from the quay to the globe -->
    <path d="M120 196C180 150 236 118 282 104" fill="none" stroke="#b9d1de" stroke-opacity="0.55" stroke-width="2" stroke-dasharray="3 8" stroke-linecap="round"></path>
    <path d="M264 96l20 6-14 14" fill="none" stroke="#b9d1de" stroke-opacity="0.7" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>

    <!-- quay -->
    <rect x="20" y="228" width="120" height="112" fill="#1c3953"></rect>
    <rect x="20" y="228" width="120" height="3" fill="#3a6480"></rect>
    <!-- stacked export cargo on the quay -->
    <g transform="translate(44 186)">
      <rect x="0" y="0" width="36" height="30" rx="3" fill="#8fb4c9"></rect>
      <rect x="8" y="10" width="20" height="4" rx="2" fill="#162c47" opacity="0.4"></rect>
      <rect x="40" y="12" width="30" height="26" rx="3" fill="#b9d1de"></rect>
      <rect x="47" y="20" width="16" height="4" rx="2" fill="#162c47" opacity="0.35"></rect>
      <rect x="4" y="-26" width="30" height="24" rx="3" fill="#dde2e6"></rect>
      <rect x="11" y="-18" width="16" height="4" rx="2" fill="#162c47" opacity="0.3"></rect>
    </g>

    <!-- ship sailing away (bow to the left) -->
    <g transform="translate(236 194)">
      <path d="M-96 10H86L64 46H-70Z" fill="#dde2e6"></path>
      <path d="M-96 10H86L82 20H-92Z" fill="#8fb4c9"></path>
      <path d="M-70 46h134" stroke="#162c47" stroke-opacity="0.15" stroke-width="3"></path>
      <rect x="-60" y="-24" width="30" height="34" rx="3" fill="#2e6282"></rect>
      <rect x="-52" y="-16" width="14" height="4" rx="2" fill="#b9d1de"></rect>
      <rect x="-20" y="-24" width="30" height="34" rx="3" fill="#234d66"></rect>
      <rect x="20" y="-36" width="44" height="46" rx="4" fill="#e8ecee"></rect>
      <rect x="28" y="-26" width="28" height="7" rx="2" fill="#8fb4c9"></rect>
      <path d="M28 -8h28M28 -2h20" stroke="#162c47" stroke-opacity="0.3" stroke-width="2"></path>
      <rect x="34" y="-56" width="12" height="20" rx="2" fill="#234d66"></rect>
      <!-- wake -->
      <path d="M-96 30c-18 4-32 10-44 8M-88 42c-20 6-40 10-58 8" fill="none" stroke="#e8ecee" stroke-opacity="0.35" stroke-width="2" stroke-linecap="round"></path>
    </g>

    <!-- customs seal on the paperwork, bottom right -->
    <g transform="translate(292 268)">
      <rect x="-34" y="-44" width="68" height="86" rx="5" fill="#ffffff" opacity="0.94"></rect>
      <rect x="-34" y="-44" width="68" height="14" rx="5" fill="#2e6282"></rect>
      <path d="M-22 -18H22M-22 -6H16M-22 6H22M-22 18H6" stroke="#162c47" stroke-opacity="0.28" stroke-width="2.6" stroke-linecap="round"></path>
      <circle cx="18" cy="26" r="13" fill="none" stroke="#234d66" stroke-width="2.2"></circle>
      <path d="M12 26.4l4 4 8-9" fill="none" stroke="#234d66" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
    </g>
  </g>
</svg>
