---
/** Guides plate: a stack of reference sheets with tabs and a reading lens. Decorative. */
const back = [
  { x: 150, y: 70, r: 8, tab: '#2e6282' },
  { x: 128, y: 80, r: 2, tab: '#234d66' },
];
---

<svg class="plate" direction="ltr" viewBox="0 0 420 360" width="420" height="360" aria-hidden="true" focusable="false">
  <clipPath id="clip-guidesart"><rect x="20" y="20" width="380" height="320" rx="26"></rect></clipPath>
  <rect x="20" y="20" width="380" height="320" rx="26" fill="#162c47"></rect>
  <g opacity="0.07" stroke="#e8ecee">
    <path d="M20 80H400M20 140H400M20 200H400M20 260H400M80 20V340M140 20V340M200 20V340M260 20V340M320 20V340"></path>
  </g>
  <circle clip-path="url(#clip-guidesart)" cx="330" cy="80" r="100" fill="#8fb4c9" fill-opacity="0.08"></circle>
  {
    back.map((s) => (
      <g transform={`translate(${s.x} ${s.y}) rotate(${s.r})`}>
        <rect x="6" y="8" width="160" height="206" rx="10" fill="#000" fill-opacity="0.22" />
        <rect width="160" height="206" rx="10" fill="#dde2e6" />
        <rect x="118" y="-12" width="30" height="20" rx="4" fill={s.tab} />
      </g>
    ))
  }
  <g transform="translate(106 92) rotate(-5)">
    <rect x="6" y="8" width="160" height="206" rx="10" fill="#000" fill-opacity="0.22"></rect>
    <rect width="160" height="206" rx="10" fill="#ffffff"></rect>
    <rect x="118" y="-12" width="30" height="20" rx="4" fill="#8fb4c9"></rect>
    <text x="142" y="34" text-anchor="end" font-size="13" font-weight="800" fill="#162c47">راهنما</text>
    <g stroke="#162c47" stroke-linecap="round" stroke-width="3">
      <path d="M142 58H40" stroke-opacity="0.5"></path>
      <path d="M142 78H24" stroke-opacity="0.22"></path>
      <path d="M142 98H52" stroke-opacity="0.22"></path>
      <path d="M142 118H34" stroke-opacity="0.22"></path>
      <path d="M142 138H70" stroke-opacity="0.22"></path>
    </g>
    <circle cx="28" cy="58" r="4" fill="#8fb4c9"></circle>
  </g>
  <!-- lens -->
  <g transform="translate(286 236)">
    <circle r="42" fill="#e8ecee" fill-opacity="0.14" stroke="#b9d1de" stroke-width="7"></circle>
    <path d="M30 30L62 62" stroke="#b9d1de" stroke-width="11" stroke-linecap="round"></path>
    <path d="M-20 -8a24 24 0 0 1 22-16" fill="none" stroke="#e8ecee" stroke-opacity="0.6" stroke-width="3" stroke-linecap="round"></path>
  </g>
</svg>

<style>
  .plate {
    width: 100%;
    height: auto;
  }
  .plate text {
    font-family: var(--font-sans);
  }
</style>
