---
/** Container plate: a gantry crane lifting a box onto a stacked container ship. Decorative. */
---

<svg class="plate" direction="ltr" viewBox="0 0 420 360" width="420" height="360" aria-hidden="true" focusable="false">
  <clipPath id="clip-containerart"><rect x="20" y="20" width="380" height="320" rx="26"></rect></clipPath>
  <rect x="20" y="20" width="380" height="320" rx="26" fill="#162c47"></rect>
  <g clip-path="url(#clip-containerart)">
    <circle cx="96" cy="82" r="72" fill="#8fb4c9" fill-opacity="0.09"></circle>
    <g fill="none" stroke="#8fb4c9" stroke-linecap="round">
      <path d="M40 258c16-9 30-9 46 0s30 9 46 0 30-9 46 0 30 9 46 0 30-9 46 0 30 9 46 0" stroke-opacity="0.34" stroke-width="2"></path>
      <path d="M40 284c16-9 30-9 46 0s30 9 46 0 30-9 46 0 30 9 46 0 30-9 46 0 30 9 46 0" stroke-opacity="0.16" stroke-width="2"></path>
    </g>

    <!-- quay apron + berth line -->
    <rect x="20" y="214" width="150" height="122" fill="#1c3953"></rect>
    <rect x="20" y="214" width="150" height="3" fill="#3a6480"></rect>
    <rect x="20" y="236" width="380" height="2" fill="#3a6480" fill-opacity="0.55"></rect>

    <!-- gantry crane: legs, lattice, beam, trolley, hook -->
    <g stroke="#8fb4c9" fill="none" stroke-linecap="round">
      <path d="M52 214V92M96 214V92" stroke-width="5" stroke-opacity="0.9"></path>
      <path d="M52 190l22-24M74 190l22-24M52 158l22-24M74 158l22-24M52 126l22-24M74 126l22-24" stroke-width="2" stroke-opacity="0.45"></path>
      <path d="M52 112h44" stroke-width="2.6" stroke-opacity="0.55"></path>
      <path d="M30 92h190" stroke-width="5" stroke-opacity="0.95"></path>
      <path d="M30 100h190" stroke-width="2" stroke-opacity="0.45"></path>
      <rect x="40" y="204" width="68" height="10" rx="2" fill="#8fb4c9" stroke="none" fill-opacity="0.55"></rect>
    </g>
    <!-- trolley + cables + lifted container -->
    <g transform="translate(168 92)">
      <rect x="-14" y="-6" width="28" height="12" rx="2" fill="#b9d1de"></rect>
      <path d="M-8 6v30M8 6v30" stroke="#b9d1de" stroke-width="2" stroke-opacity="0.8"></path>
      <rect x="-46" y="36" width="92" height="34" rx="3" fill="#8fb4c9"></rect>
      <path d="M-38 36v34M-28 36v34M-18 36v34M-8 36v34M2 36v34M12 36v34M22 36v34M32 36v34" stroke="#162c47" stroke-opacity="0.16" stroke-width="2"></path>
      <rect x="-16" y="49" width="32" height="8" rx="2" fill="#162c47" opacity="0.35"></rect>
    </g>

    <!-- container ship with stacked boxes, bow to the left -->
    <g transform="translate(288 200)">
      <path d="M-124 30H66L46 62H-100Z" fill="#dde2e6"></path>
      <path d="M-124 30H66L62 40H-120Z" fill="#8fb4c9"></path>
      <!-- stacks -->
      <g>
        <rect x="-108" y="0" width="44" height="30" rx="3" fill="#2e6282"></rect>
        <rect x="-60" y="0" width="44" height="30" rx="3" fill="#234d66"></rect>
        <rect x="-12" y="0" width="44" height="30" rx="3" fill="#8fb4c9"></rect>
        <rect x="-108" y="-30" width="44" height="30" rx="3" fill="#b9d1de"></rect>
        <rect x="-60" y="-30" width="44" height="30" rx="3" fill="#2e6282"></rect>
        <rect x="-60" y="-60" width="44" height="30" rx="3" fill="#e8ecee"></rect>
        <rect x="-108" y="-60" width="44" height="30" rx="3" fill="#234d66"></rect>
        <g stroke="#162c47" stroke-opacity="0.16" stroke-width="2">
          <path d="M-102 0v30M-92 0v30M-82 0v30M-72 0v30M-54 0v30M-44 0v30M-34 0v30M-24 0v30M-6 0v30M4 0v30M14 0v30M24 0v30"></path>
        </g>
      </g>
      <!-- bridge tower to the right -->
      <rect x="36" y="-46" width="26" height="76" rx="3" fill="#e8ecee"></rect>
      <rect x="41" y="-38" width="16" height="8" rx="2" fill="#8fb4c9"></rect>
      <path d="M41 -20h16M41 -12h16M41 -4h16" stroke="#162c47" stroke-opacity="0.3" stroke-width="2"></path>
      <rect x="45" y="-58" width="8" height="14" rx="2" fill="#234d66"></rect>
      <!-- waterline shadow -->
      <path d="M-124 46h190" stroke="#162c47" stroke-opacity="0.14" stroke-width="3"></path>
    </g>

    <!-- paperwork slip, bottom left -->
    <g transform="translate(78 292)">
      <rect x="-38" y="-34" width="76" height="60" rx="5" fill="#ffffff" opacity="0.94"></rect>
      <rect x="-38" y="-34" width="76" height="12" rx="5" fill="#2e6282"></rect>
      <path d="M-26 -12H26M-26 0H14M-26 12H22" stroke="#162c47" stroke-opacity="0.26" stroke-width="2.6" stroke-linecap="round"></path>
    </g>
  </g>
</svg>

<style>
  .plate {
    inline-size: 100%;
    block-size: auto;
    filter: drop-shadow(0 18px 34px rgb(11 26 43 / 0.18));
  }
</style>
