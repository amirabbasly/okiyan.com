---
/** After-sales plate: a delivered unit, a spare part and a warranty seal. Decorative. */
---

<svg class="plate" direction="ltr" viewBox="0 0 420 360" width="420" height="360" aria-hidden="true" focusable="false">
  <clipPath id="clip-aftersalesart"><rect x="20" y="20" width="380" height="320" rx="26"></rect></clipPath>
  <rect x="20" y="20" width="380" height="320" rx="26" fill="#162c47"></rect>
  <g clip-path="url(#clip-aftersalesart)">
    <circle cx="118" cy="96" r="92" fill="#8fb4c9" fill-opacity="0.07"></circle>
    <g fill="none" stroke="#e8ecee" stroke-opacity="0.07">
      <circle cx="210" cy="180" r="86"></circle>
      <circle cx="210" cy="180" r="132"></circle>
    </g>
    <!-- gear ring behind the parcel -->
    <g transform="translate(276 236)">
      <circle r="46" fill="none" stroke="#8fb4c9" stroke-opacity="0.4" stroke-width="2" stroke-dasharray="7 9"></circle>
      <circle r="17" fill="none" stroke="#b9d1de" stroke-width="2.5"></circle>
      <path d="M0 -30v-9M0 30v9M-30 0h-9M30 0h9M-21 -21l-6 -6M21 21l6 6M-21 21l-6 6M21 -21l6 -6" stroke="#b9d1de" stroke-width="2.5" stroke-linecap="round"></path>
    </g>
    <!-- parcel -->
    <g transform="translate(146 176)">
      <path d="M-66 -30L0 -62l66 32v64L0 66-66 34Z" fill="#ffffff"></path>
      <path d="M-66 -30L0 2v64l-66 -32z" fill="#dde2e6"></path>
      <path d="M66 -30L0 2v64l66 -32z" fill="#b9d1de"></path>
      <path d="M-66 -30L0 -62l66 32L0 2z" fill="#f4f6f7"></path>
      <path d="M-33 -46L33 -14v18L-33 36Z" fill="#234d66" opacity="0.12"></path>
    </g>
    <!-- warranty seal -->
    <g transform="translate(300 96)">
      <circle r="34" fill="#234d66" stroke="#8fb4c9" stroke-width="2"></circle>
      <path d="M-12 1l8 8 17-18" fill="none" stroke="#e8ecee" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"></path>
    </g>
    <!-- support line back to the parcel -->
    <path d="M258 128C232 148 214 156 190 160" fill="none" stroke="#8fb4c9" stroke-width="1.8" stroke-dasharray="2 7" stroke-linecap="round"></path>
  </g>
</svg>
