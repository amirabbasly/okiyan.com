---
/**
 * Stylised Persian Gulf route map — one visual language, two variants.
 *
 * `variant="via-khasab"` — the old path: cargo was moved inside the UAE and
 *   transhipped through Khasab (Musandam, Oman) before crossing to Iran.
 * `variant="direct"`    — today's path: Dubai straight to Bushehr or Bandar Abbas.
 *
 * Schematic on purpose (a comparison diagram, not a navigational chart); both
 * variants share the same coastline so they can sit side by side.
 */
export interface Props {
  variant: 'via-khasab' | 'direct';
  label?: string;
}
const { variant, label } = Astro.props;
const direct = variant === 'direct';

const ports = [
  { x: 172, y: 208, name: 'بوشهر', dx: 0, dy: -34, w: 72 },
  { x: 596, y: 152, name: 'بندرعباس', dx: 0, dy: -34, w: 104 },
  { x: 232, y: 328, name: 'دبی', dx: 0, dy: 34, w: 58 },
  { x: 566, y: 268, name: 'خصب', dx: -4, dy: 34, w: 58 },
];
---

<svg
  class="route-map"
  viewBox="0 0 720 440"
  role="img"
  aria-label={label ?? (direct ? 'نقشهٔ مسیر مستقیم از دبی به بوشهر و بندرعباس' : 'نقشهٔ مسیر قدیمی از دبی از طریق خصب به ایران')}
>
  <defs>
    <linearGradient id={`sea-${variant}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1d3d59"></stop>
      <stop offset="1" stop-color="#122a41"></stop>
    </linearGradient>
    <marker id={`arr-${variant}`} viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
      <path d="M0 0L10 5L0 10z" fill="#dfeaf2"></path>
    </marker>
    <marker id={`arr-old-${variant}`} viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto-start-reverse">
      <path d="M0 0L10 5L0 10z" fill="#8fb4c9"></path>
    </marker>
  </defs>

  <rect width="720" height="440" fill={`url(#sea-${variant})`}></rect>

  <!-- water texture -->
  <g fill="none" stroke="#8fb4c9" stroke-linecap="round" stroke-opacity="0.13" stroke-width="2">
    <path d="M92 276c16-8 30-8 46 0s30 8 46 0"></path>
    <path d="M300 292c16-8 30-8 46 0s30 8 46 0"></path>
    <path d="M148 306c16-8 30-8 46 0"></path>
  </g>

  <!-- Iran: the whole north side, its coast running north-west to south-east -->
  <path
    d="M0 0h720v110c-48 6-84 18-116 28-36 12-68 36-108 44-44 9-82-6-124 2-46 9-84-4-128 6-44 10-80 2-124 10-44 8-80-2-120 6z"
    fill="#e4e9ec"></path>
  <path
    d="M0 206c40-8 76 2 120-6 44-8 80 0 124-10 44-10 82 3 128-6 42-8 80 7 124-2 40-8 72-32 108-44 32-10 68-22 116-28"
    fill="none"
    stroke="#162c47"
    stroke-opacity="0.18"
    stroke-width="2"></path>

  <!-- Arabia: the UAE on the west, the Musandam peninsula (Oman) reaching north at the strait -->
  <path
    d="M0 440V340c60-6 108-18 160-26 46-7 76 4 108 16 32 12 62 18 98 22 38 4 64-6 90-16 30-12 56-36 80-54l20-20c12-10 22-16 34-12 16 6 28 22 38 42 14 26 36 40 62 48 26 8 46 12 66 14v42z"
    fill="#e4e9ec"></path>
  <path
    d="M0 340c60-6 108-18 160-26 46-7 76 4 108 16 32 12 62 18 98 22 38 4 64-6 90-16 30-12 56-36 80-54l20-20c12-10 22-16 34-12 16 6 28 22 38 42 14 26 36 40 62 48 26 8 46 12 66 14"
    fill="none"
    stroke="#162c47"
    stroke-opacity="0.18"
    stroke-width="2"></path>
  <!-- close the land off along the bottom edge -->
  <path d="M0 440V392h720v48z" fill="#e4e9ec"></path>

  <!-- country names, inset from the edges -->
  <g fill="#8494a2" font-size="22" font-weight="700" direction="rtl">
    <text x="128" y="64" text-anchor="middle">ایران</text>
    <text x="96" y="404" text-anchor="middle">امارات</text>
    <text x="656" y="352" text-anchor="middle">عمان</text>
  </g>
  <text x="430" y="212" fill="#9dbdd0" fill-opacity="0.8" font-size="14" font-weight="600" direction="rtl" text-anchor="middle">
    خلیج فارس
  </text>

  {
    direct ? (
      <g fill="none" stroke="#dfeaf2" stroke-width="3.4" stroke-dasharray="9 8" stroke-linecap="round">
        <path d="M232 328C204 292 186 250 178 220" marker-end={`url(#arr-${variant})`} />
        <path d="M232 328C330 312 498 218 588 166" marker-end={`url(#arr-${variant})`} />
      </g>
    ) : (
      <g fill="none" stroke="#8fb4c9" stroke-opacity="0.6" stroke-width="2.6" stroke-dasharray="4 7" stroke-linecap="round">
        <path d="M232 328C320 326 452 300 552 275" marker-end={`url(#arr-old-${variant})`} />
        <path d="M566 252C574 224 590 190 598 168" marker-end={`url(#arr-old-${variant})`} />
      </g>
    )
  }

  {
    ports
      .filter((p) => !direct || p.name !== 'خصب')
      .map((p) => (
        <g>
          <circle cx={p.x} cy={p.y} r="6.5" fill="#162c47" stroke="#dfeaf2" stroke-width="2.4" />
          <circle cx={p.x} cy={p.y} r="2.1" fill="#dfeaf2" />
          <rect x={p.x + p.dx - p.w / 2} y={p.y + p.dy - 17} width={p.w} height="23" rx="5.5" fill="#162c47" fill-opacity="0.94" />
          <text
            x={p.x + p.dx}
            y={p.y + p.dy}
            text-anchor="middle"
            fill="#ffffff"
            font-size="13"
            font-weight="700"
            direction="rtl">{p.name}</text
          >
        </g>
      ))
  }

  <g>
    <rect x="424" y="22" width="272" height="32" rx="16" fill={direct ? '#234d66' : '#31465b'} stroke={direct ? '#dfeaf2' : '#8fb4c9'} stroke-opacity="0.5"></rect>
    <text x="560" y="43" text-anchor="middle" fill="#ffffff" font-size="14" font-weight="700" direction="rtl">
      {direct ? 'مسیر مستقیم از دبی' : 'مسیر قدیمی از طریق خصب'}
    </text>
  </g>
</svg>

<style>
  .route-map {
    inline-size: 100%;
    block-size: auto;
    display: block;
    border-radius: 14px;
  }
</style>
