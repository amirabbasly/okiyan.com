---
/** Import plate: a route network from supplier to warehouse. Decorative. */
---

<svg class="plate" direction="ltr" viewBox="0 0 420 360" width="420" height="360" aria-hidden="true" focusable="false">
  <clipPath id="clip-importart"><rect x="20" y="20" width="380" height="320" rx="26"></rect></clipPath>
  <rect x="20" y="20" width="380" height="320" rx="26" fill="#162c47"></rect>
  <g fill="none" stroke="#e8ecee" stroke-opacity="0.08" clip-path="url(#clip-importart)">
    <circle cx="210" cy="180" r="70"></circle>
    <circle cx="210" cy="180" r="120"></circle>
    <circle cx="210" cy="180" r="170"></circle>
  </g>
  <!-- route -->
  <path d="M340 90C300 150 250 110 210 170S110 230 84 280" fill="none" stroke="#b9d1de" stroke-opacity="0.5" stroke-width="2" stroke-dasharray="3 8" stroke-linecap="round"></path>
  <path d="M340 90C300 150 250 110 210 170" fill="none" stroke="#8fb4c9" stroke-width="3.5" stroke-linecap="round"></path>
  <!-- air leg: supplier → warehouse -->
  <path d="M340 90C430 190 300 320 84 280" fill="none" stroke="#e8ecee" stroke-opacity="0.4" stroke-width="1.8" stroke-dasharray="1 7" stroke-linecap="round"></path>
  <g transform="translate(327 238) rotate(140)">
    <circle r="20" fill="#1d3a5a" stroke="#e8ecee" stroke-opacity="0.35" stroke-width="1.5"></circle>
    <path d="M17 0C17 -1.6 15.6 -2.4 13 -2.4L5 -2.4L-3 -14H-7L-2.5 -2.4H-10L-13.5 -7H-16L-14 -1.4V1.4L-16 7H-13.5L-10 2.4H-2.5L-7 14H-3L5 2.4H13C15.6 2.4 17 1.6 17 0Z" fill="#b9d1de" transform="scale(0.9)"></path>
  </g>
  <!-- nodes -->
  <g>
    <!-- supplier / factory -->
    <g transform="translate(340 90)">
      <circle r="30" fill="#1d3a5a" stroke="#b9d1de" stroke-width="2"></circle>
      <path d="M-14 10V-4l9-6v6l9-6v6l9-6V10Z" fill="#b9d1de"></path>
    </g>
    <!-- ship -->
    <g transform="translate(210 170)">
      <circle r="30" fill="#1d3a5a" stroke="#e8ecee" stroke-opacity="0.6" stroke-width="2"></circle>
      <path d="M-17 2H17L12 11H-12Z" fill="#dde2e6"></path>
      <rect x="-11" y="-9" width="11" height="10" rx="1" fill="#8fb4c9"></rect>
      <rect x="2" y="-12" width="8" height="13" rx="1" fill="#e8ecee"></rect>
    </g>
    <!-- warehouse -->
    <g transform="translate(84 280)">
      <circle r="30" fill="#1d3a5a" stroke="#e8ecee" stroke-opacity="0.6" stroke-width="2"></circle>
      <path d="M-15 12V-3L0 -12L15 -3V12Z" fill="#dde2e6"></path>
      <rect x="-6" y="1" width="12" height="11" fill="#234d66"></rect>
    </g>
  </g>
  <!-- plan card -->
  <g transform="translate(46 56) rotate(-4)">
    <rect width="128" height="112" rx="12" fill="#ffffff"></rect>
    <text x="112" y="26" text-anchor="end" font-size="12.5" font-weight="800" fill="#162c47">برنامهٔ واردات</text>
    <g stroke-linecap="round" stroke-linejoin="round">
      <path d="M104 46l4 4 7-8" fill="none" stroke="#2e6282" stroke-width="2.4"></path>
      <path d="M94 47H20" stroke="#162c47" stroke-opacity="0.3" stroke-width="3"></path>
      <path d="M104 68l4 4 7-8" fill="none" stroke="#2e6282" stroke-width="2.4"></path>
      <path d="M94 69H34" stroke="#162c47" stroke-opacity="0.3" stroke-width="3"></path>
      <rect x="103" y="84" width="11" height="11" rx="2.5" fill="none" stroke="#162c47" stroke-opacity="0.35" stroke-width="2"></rect>
      <path d="M94 90H44" stroke="#162c47" stroke-opacity="0.18" stroke-width="3"></path>
    </g>
  </g>
</svg>

<style>
  .plate {
    width: 100%;
    height: auto;
  }
  .plate text {
    font-family: var(--font-sans);
  }
</style>
