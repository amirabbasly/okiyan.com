---
/** Customs clearance plate: declaration sheet, inspection lens, release stamp. Decorative. */
---

<svg class="plate" direction="ltr" viewBox="0 0 420 360" width="420" height="360" aria-hidden="true" focusable="false">
  <rect x="20" y="20" width="380" height="320" rx="26" fill="#0a1c38"></rect>
  <g opacity="0.07" stroke="#f7f1e4">
    <path d="M20 80H400M20 140H400M20 200H400M20 260H400M80 20V340M140 20V340M200 20V340M260 20V340M320 20V340"></path>
  </g>
  <circle cx="330" cy="90" r="90" fill="#c9a24a" fill-opacity="0.08"></circle>
  <!-- back sheet -->
  <g transform="translate(150 70) rotate(7)">
    <rect width="170" height="210" rx="12" fill="#2a4c7a"></rect>
  </g>
  <!-- declaration sheet -->
  <g transform="translate(110 64) rotate(-3)">
    <rect width="180" height="226" rx="12" fill="#fcf9f2"></rect>
    <rect width="180" height="40" rx="12" fill="#f0e7d3"></rect>
    <rect y="28" width="180" height="12" fill="#f0e7d3"></rect>
    <text x="162" y="26" text-anchor="end" font-size="13" font-weight="800" fill="#0a1c38">اظهارنامه</text>
    <g stroke="#0a1c38" stroke-linecap="round" stroke-width="3">
      <path d="M162 66H70" stroke-opacity="0.5"></path>
      <path d="M162 88H44" stroke-opacity="0.22"></path>
      <path d="M162 110H60" stroke-opacity="0.22"></path>
      <path d="M162 132H90" stroke-opacity="0.22"></path>
    </g>
    <rect x="18" y="150" width="144" height="44" rx="8" fill="none" stroke="#0a1c38" stroke-opacity="0.2" stroke-dasharray="4 4"></rect>
    <text x="146" y="177" text-anchor="end" font-size="11" font-weight="700" fill="#465265">کد تعرفه</text>
    <text x="32" y="177" font-size="12" font-weight="800" fill="#0a1c38" direction="ltr" font-family="Vazirmatn, Tahoma, sans-serif">HS ····</text>
  </g>
  <!-- lens -->
  <g transform="translate(96 228)">
    <circle r="40" fill="#f7f1e4" fill-opacity="0.12" stroke="#dfc17f" stroke-width="6"></circle>
    <path d="M-28 30L-58 62" stroke="#dfc17f" stroke-width="10" stroke-linecap="round"></path>
  </g>
  <!-- release seal -->
  <g transform="translate(300 252) rotate(-12)">
    <circle r="44" fill="#c9a24a"></circle>
    <circle r="35" fill="none" stroke="#0a1c38" stroke-opacity="0.5" stroke-width="1.5" stroke-dasharray="3 4"></circle>
    <path d="M-15 1l10 10 21-23" fill="none" stroke="#0a1c38" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"></path>
  </g>
</svg>

<style>
  .plate {
    width: 100%;
    height: auto;
  }
  .plate text {
    font-family: var(--font-sans);
  }
</style>
