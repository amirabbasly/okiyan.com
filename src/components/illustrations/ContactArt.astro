---
/** Contact plate: a consultation form being stamped, with a reply bubble. Decorative. */
---

<svg class="plate" direction="ltr" viewBox="0 0 420 360" width="420" height="360" aria-hidden="true" focusable="false">
  <clipPath id="clip-contactart"><rect x="20" y="20" width="380" height="320" rx="26"></rect></clipPath>
  <rect x="20" y="20" width="380" height="320" rx="26" fill="#162c47"></rect>
  <g opacity="0.07" stroke="#e8ecee">
    <path d="M20 80H400M20 140H400M20 200H400M20 260H400M80 20V340M140 20V340M200 20V340M260 20V340M320 20V340"></path>
  </g>
  <circle clip-path="url(#clip-contactart)" cx="90" cy="70" r="110" fill="#8fb4c9" fill-opacity="0.07"></circle>
  <!-- route from form to reply -->
  <path d="M250 270C300 270 320 220 330 170" fill="none" stroke="#b9d1de" stroke-opacity="0.55" stroke-width="2" stroke-dasharray="3 8" stroke-linecap="round"></path>
  <!-- form -->
  <g transform="translate(96 70) rotate(-4)">
    <rect x="6" y="10" width="170" height="220" rx="12" fill="#000" fill-opacity="0.25"></rect>
    <rect width="170" height="220" rx="12" fill="#ffffff"></rect>
    <rect width="170" height="38" rx="12" fill="#dde2e6"></rect>
    <rect y="26" width="170" height="12" fill="#dde2e6"></rect>
    <text x="152" y="25" text-anchor="end" font-size="13" font-weight="800" fill="#162c47">درخواست مشاوره</text>
    <g fill="none" stroke="#162c47" stroke-opacity="0.25" stroke-width="1.5">
      <rect x="18" y="56" width="134" height="20" rx="5"></rect>
      <rect x="18" y="88" width="134" height="20" rx="5"></rect>
      <rect x="18" y="120" width="134" height="40" rx="5"></rect>
    </g>
    <rect x="18" y="172" width="40" height="14" rx="7" fill="#8fb4c9"></rect>
    <rect x="64" y="172" width="52" height="14" rx="7" fill="#8fb4c9" fill-opacity="0.35"></rect>
    <rect x="88" y="196" width="64" height="16" rx="8" fill="#162c47"></rect>
  </g>
  <!-- stamp -->
  <g transform="translate(228 222) rotate(-14)">
    <circle r="34" fill="#8fb4c9"></circle>
    <circle r="26" fill="none" stroke="#162c47" stroke-opacity="0.55" stroke-width="1.5" stroke-dasharray="3 4"></circle>
    <path d="M-11 1l8 8 16-17" fill="none" stroke="#162c47" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path>
  </g>
  <!-- reply bubble -->
  <g transform="translate(286 92)">
    <path d="M20 60l-4 18 20-18" fill="#234d66"></path>
    <rect width="92" height="62" rx="16" fill="#234d66" stroke="#b9d1de" stroke-opacity="0.6"></rect>
    <g fill="#e8ecee" fill-opacity="0.85">
      <circle cx="30" cy="31" r="4"></circle><circle cx="46" cy="31" r="4"></circle><circle cx="62" cy="31" r="4"></circle>
    </g>
  </g>
</svg>

<style>
  .plate {
    width: 100%;
    height: auto;
  }
  .plate text {
    font-family: var(--font-sans);
  }
</style>
