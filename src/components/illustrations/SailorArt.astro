---
/** Sailor-import plate: a traditional vessel unloading at a southern port. Decorative. */
---

<svg class="plate" direction="ltr" viewBox="0 0 420 360" width="420" height="360" aria-hidden="true" focusable="false">
  <clipPath id="clip-sailorart"><rect x="20" y="20" width="380" height="320" rx="26"></rect></clipPath>
  <rect x="20" y="20" width="380" height="320" rx="26" fill="#162c47"></rect>
  <g clip-path="url(#clip-sailorart)">
    <circle cx="312" cy="112" r="84" fill="#8fb4c9" fill-opacity="0.08"></circle>
    <g fill="none" stroke="#8fb4c9" stroke-linecap="round">
      <path
        d="M28 258c18-10 34-10 52 0s34 10 52 0 34-10 52 0 34 10 52 0 34-10 52 0 34 10 52 0"
        stroke-opacity="0.38"
        stroke-width="2"></path>
      <path
        d="M28 284c18-10 34-10 52 0s34 10 52 0 34-10 52 0 34 10 52 0 34-10 52 0 34 10 52 0"
        stroke-opacity="0.18"
        stroke-width="2"></path>
    </g>
    <!-- cargo stacked on the quay -->
    <g transform="translate(72 196)">
      <rect x="0" y="0" width="34" height="30" rx="4" fill="#8fb4c9"></rect>
      <rect x="8" y="10" width="18" height="4" rx="2" fill="#162c47" opacity="0.45"></rect>
      <rect x="6" y="-22" width="26" height="22" rx="4" fill="#b9d1de"></rect>
      <rect x="13" y="-14" width="12" height="4" rx="2" fill="#162c47" opacity="0.4"></rect>
    </g>
    <!-- vessel -->
    <g transform="translate(238 186)">
      <path d="M-92 14H92L68 50H-68Z" fill="#dde2e6"></path>
      <path d="M-92 14H92L86 24H-86Z" fill="#8fb4c9"></path>
      <rect x="30" y="-8" width="28" height="22" rx="3" fill="#234d66"></rect>
      <rect x="38" y="0" width="12" height="4" rx="2" fill="#b9d1de"></rect>
      <rect x="-6" y="-12" width="32" height="26" rx="3" fill="#ffffff" opacity="0.9"></rect>
      <rect x="2" y="-4" width="16" height="4" rx="2" fill="#162c47" opacity="0.4"></rect>
      <path d="M-58 14V-34" stroke="#b9d1de" stroke-width="3" stroke-linecap="round"></path>
      <path d="M-58 -34v-22m0 4h34l-8 9 8 9h-34" fill="none" stroke="#b9d1de" stroke-width="2.5" stroke-linejoin="round"></path>
    </g>
    <!-- route back to the origin port -->
    <path d="M96 130C150 96 236 78 320 96" fill="none" stroke="#e8ecee" stroke-opacity="0.35" stroke-width="1.8" stroke-dasharray="2 8" stroke-linecap="round"></path>
    <circle cx="96" cy="130" r="6" fill="none" stroke="#8fb4c9" stroke-width="2.5"></circle>
    <circle cx="320" cy="96" r="6" fill="#8fb4c9"></circle>
  </g>
</svg>
