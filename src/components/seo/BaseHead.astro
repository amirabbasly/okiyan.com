---
import { Font } from 'astro:assets';
import { GOOGLE_VERIFICATION_TOKEN, BING_VERIFICATION_TOKEN } from 'astro:env/server';
import { site, isProduction } from '~/config/site';
import { absoluteUrl } from '~/lib/url';

export interface Props {
  title: string;
  description: string;
  /** Use the title as-is, without the brand suffix. */
  fullTitle?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  /** Override the canonical path (defaults to the current URL path). */
  canonicalPath?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  fullTitle = false,
  ogType = 'website',
  ogImage = '/og/default.png',
  ogImageAlt = `${site.name} — ${site.tagline}`,
  noindex = false,
  canonicalPath,
  publishedTime,
  modifiedTime,
  jsonLd = [],
} = Astro.props;

const pageTitle = fullTitle ? title : `${title} | ${site.name}`;
const canonical = absoluteUrl(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogImageUrl = absoluteUrl(ogImage, Astro.site);
// Staging/development builds must never be indexed, whatever the page says.
const robots = !isProduction || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const ldJson = jsonLd.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd }).replace(/</g, '\\u003c')
  : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}
<meta name="robots" content={robots} />
{/*
  One language, one host: an explicit fa-IR alternate plus an x-default tells
  Google which page to serve Persian searchers even if a translation or an old
  .ir mirror shows up later.
*/}
{!noindex && <link rel="alternate" hreflang="fa-IR" href={canonical} />}
{!noindex && <link rel="alternate" hreflang="x-default" href={canonical} />}
<meta name="theme-color" content="#001b42" />
<meta name="format-detection" content="telephone=no" />
{GOOGLE_VERIFICATION_TOKEN && <meta name="google-site-verification" content={GOOGLE_VERIFICATION_TOKEN} />}
{BING_VERIFICATION_TOKEN && <meta name="msvalidate.01" content={BING_VERIFICATION_TOKEN} />}

<!-- Preload only what the first screen needs: body (400) and display headings (800). -->
<Font cssVariable="--font-vazirmatn" preload={[{ weight: 400 }, { weight: 800 }]} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:locale" content={site.locale} />
<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:type" content={ogImage.endsWith('.png') ? 'image/png' : 'image/jpeg'} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />

{ldJson && <script type="application/ld+json" set:html={ldJson} />}
