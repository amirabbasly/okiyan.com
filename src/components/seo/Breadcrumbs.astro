---
import type { Crumb } from '~/lib/schema';
export interface Props {
  items: Crumb[];
  tone?: 'light' | 'dark';
}
const { items, tone = 'light' } = Astro.props;
---

<nav class:list={['crumbs', `crumbs--${tone}`]} aria-label="مسیر صفحه">
  <ol>
    {
      items.map((item, i) => (
        <li>
          {i < items.length - 1 ? <a href={item.path}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    list-style: none;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .crumbs li + li::before {
    content: '/';
    margin-inline: 0.6rem;
    opacity: 0.45;
  }
  .crumbs a {
    text-decoration: none;
    color: inherit;
  }
  .crumbs a:hover {
    color: var(--navy-900);
    text-decoration: underline;
  }
  .crumbs [aria-current] {
    color: var(--text);
    font-weight: 600;
  }
</style>
