---
import { nav, contactCta, site, isNavGroup, companyPhones } from '~/config/site';
import Logo from '~/components/ui/Logo.astro';
import Icon from '~/components/ui/Icon.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const groupCurrent = (children: Array<{ href: string }>) => children.some((c) => isCurrent(c.href));
// The first mobile line is printed next to the office number in the header.
const headerPhones = companyPhones.filter((p) => p.kind === 'mobile').slice(0, 1);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand">
      <Logo />
      <span class="sr-only">— صفحه اصلی</span>
    </a>

    <nav class="site-nav" aria-label="ناوبری اصلی">
      <ul>
        {
          nav.map((item, i) =>
            isNavGroup(item) ? (
              <li class="nav-group" data-nav-group>
                <button
                  type="button"
                  class:list={['nav-group__btn', { 'is-current': groupCurrent(item.children) }]}
                  aria-expanded="false"
                  aria-controls={`nav-group-${i}`}
                >
                  {item.label}
                  <Icon name="chevron" />
                </button>
                <div class="nav-group__panel" id={`nav-group-${i}`}>
                  <div class="mega container">
                    <ul class="mega__links">
                      {item.children.map((c) => (
                        <li>
                          <a class="mega__link" href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>
                            {c.icon && (
                              <span class="mega__icon" aria-hidden="true">
                                <Icon name={c.icon} />
                              </span>
                            )}
                            <span class="mega__text">
                              <span class="mega__label">{c.label}</span>
                              {c.hint && <span class="mega__hint">{c.hint}</span>}
                            </span>
                            <Icon name="arrow" class="mega__arrow" />
                          </a>
                        </li>
                      ))}
                    </ul>
                    {
                      item.feature && (
                        <aside class="mega__feature" aria-label={item.feature.title}>
                          <p class="mega__feature-title">{item.feature.title}</p>
                          <p class="mega__feature-text">{item.feature.text}</p>
                          <a class="btn mega__feature-cta" href={item.feature.href}>
                            {item.feature.ctaLabel}
                            <Icon name="arrow" class="btn__icon" />
                          </a>
                        </aside>
                      )
                    }
                  </div>
                </div>
              </li>
            ) : (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <!-- Brand and actions grow equally, so the dark capsule stays centred. -->
    <div class="site-header__actions">
      <!-- Search: a link to the guide library, the only part of the site that
           behaves like a search (client-side filter). No dead input box. -->
      <a class="site-header__icon-btn site-header__search" href="/guides/#feed-title" aria-label="جست‌وجو در راهنماها">
        <Icon name="search" />
      </a>
      <span class="site-header__lang" aria-label="زبان سایت">
        <Icon name="globe" />
        <span>FA</span>
      </span>
      {
        site.contact.phone && (
          <span class="site-header__phones">
            <a href={`tel:${site.contact.phone}`} class="site-header__phone site-header__phone--landline">
              <Icon name="phone" />
              <span class="sr-only">تلفن دفتر</span>
              <span dir="ltr">{site.contact.phoneDisplay ?? site.contact.phone}</span>
            </a>
            {headerPhones.map((p) => (
              <a href={`tel:${p.e164}`} class="site-header__phone site-header__phone--mobile">
                <Icon name="phone" />
                <span class="sr-only">تلفن همراه</span>
                <span dir="ltr">{p.display}</span>
              </a>
            ))}
          </span>
        )
      }
      <a href={contactCta.href} class="btn site-header__cta" aria-current={isCurrent(contactCta.href) ? 'page' : undefined}>
        {contactCta.label}
        <Icon name="arrow" class="btn__icon" />
      </a>

      <!-- Native popover: works without JavaScript, closes with Esc / outside click. -->
      <button class="menu-toggle" type="button" popovertarget="mobile-menu" aria-controls="mobile-menu">
        <Icon name="menu" />
        <span>منو</span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" popover>
    <div class="mobile-menu__top">
      <Logo />
      <button class="menu-close" type="button" popovertarget="mobile-menu" popovertargetaction="hide">
        <Icon name="close" />
        <span class="sr-only">بستن منو</span>
      </button>
    </div>
    <nav aria-label="ناوبری موبایل">
      <ul>
        <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>صفحه اصلی</a></li>
        {
          nav.map((item) =>
            isNavGroup(item) ? (
              <li class="mobile-menu__group">
                <span class="mobile-menu__group-title">{item.label}</span>
                <ul>
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>
    {
      site.contact.phone && (
        <a href={`tel:${site.contact.phone}`} class="btn btn--ghost mobile-menu__call">
          <Icon name="phone" class="btn__icon" />
          تماس: <span dir="ltr">{site.contact.phoneDisplay ?? site.contact.phone}</span>
        </a>
      )
    }
    <a href={contactCta.href} class="btn mobile-menu__cta">
      {contactCta.label}
      <Icon name="arrow" class="btn__icon" />
    </a>
  </div>
</header>

<script>
  // Header dropdowns: click/Enter toggles, Esc or a click/focus elsewhere closes.
  // Without JS they still open on hover and keyboard focus (CSS below).
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-group]'));
  const buttonOf = (g: HTMLElement) => g.querySelector<HTMLButtonElement>('.nav-group__btn')!;
  const setOpen = (g: HTMLElement, open: boolean) => buttonOf(g).setAttribute('aria-expanded', String(open));
  const closeAll = (except?: HTMLElement) => groups.forEach((g) => g !== except && setOpen(g, false));

  for (const g of groups) {
    const btn = buttonOf(g);
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      closeAll(g);
      setOpen(g, open);
    });
    g.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(g, false);
        btn.focus();
      }
    });
    g.addEventListener('focusout', (e) => {
      if (!g.contains(e.relatedTarget as Node | null)) setOpen(g, false);
    });
  }
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('[data-nav-group]')) closeAll();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Solid (no backdrop-filter): cheaper to composite while scrolling and overscrolling. */
    background: var(--white);
    /* The reference bar ends in a thin aqua rule rather than a grey border. */
    border-bottom: 1px solid rgb(0 176 200 / 0.28);
    box-shadow: 0 1px 0 rgb(0 176 200 / 0.1);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 1.6vw, 1.6rem);
    min-height: var(--header-h);
    /* A band of its own: a touch wider than the page column so the brand, the
       seven-item capsule and the phone/CTA cluster never fight for space. */
    inline-size: min(100% - 2 * var(--gutter), 82rem);
  }
  .site-header__icon-btn {
    display: grid;
    place-items: center;
    inline-size: 2.4rem;
    block-size: 2.4rem;
    flex: none;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--navy-800);
    background: var(--white);
    transition:
      color var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }
  .site-header__icon-btn :global(svg) {
    inline-size: 1.1rem;
    block-size: 1.1rem;
  }
  .site-header__icon-btn:hover {
    color: var(--aqua-600);
    border-color: var(--aqua-300);
    background: var(--aqua-100);
  }
  .site-header__lang {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--navy-800);
  }
  .site-header__lang :global(svg) {
    inline-size: 1rem;
    block-size: 1rem;
    color: var(--aqua-600);
  }
  .site-header__brand {
    /* Brand and actions split the free space around the capsule. A slightly smaller
       share for the brand pulls the capsule a few percent towards the logo side
       (right in RTL); both edges stay put, so nothing else is re-placed. */
    flex: 0.84 1 0;
    text-decoration: none;
    border-radius: var(--radius-s);
  }
  .site-header__actions {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.5rem;
  }
  /* ----- Nav: light bar, aqua underline on the current item -----
     Matches the reference: labels sit directly on the white header, the active
     one is marked by a short aqua rule underneath, and the dropdowns open in a
     floating white card instead of a full-bleed dark slab. */
  .site-nav {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .site-nav > ul {
    display: flex;
    align-items: center;
    gap: clamp(0.1rem, 0.6vw, 0.55rem);
    padding: 0;
    list-style: none;
    border-radius: 0;
    border: 0;
    background: none;
    box-shadow: none;
  }
  .site-nav > ul > li {
    display: flex;
    align-items: center;
  }
  /* Only the top-level items carry these styles; the mega panel links are styled
     on their own below. */
  .site-nav > ul > li > a {
    position: relative;
    display: block;
    padding: 0.5rem 0.55rem;
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.6;
    white-space: nowrap;
    color: var(--navy-800);
    text-decoration: none;
    border-radius: var(--radius-s);
    transition:
      color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }
  .site-nav > ul > li > a:hover {
    color: var(--navy-950);
    background: var(--mist-50);
  }
  .site-nav > ul > li > a[aria-current='page'] {
    color: var(--navy-950);
    font-weight: 700;
  }
  .site-nav > ul > li > a[aria-current='page']::after,
  .nav-group__btn.is-current::after {
    content: '';
    position: absolute;
    inset-inline: 0.55rem;
    bottom: 0.1rem;
    height: 2px;
    border-radius: 2px;
    background: var(--aqua, #00b0c8);
  }
  /* ----- Dropdown groups ----- */
  .nav-group {
    position: relative;
  }
  .nav-group__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.55rem;
    border: 0;
    border-radius: var(--radius-s);
    background: transparent;
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.6;
    white-space: nowrap;
    color: var(--navy-800);
    cursor: pointer;
    transition:
      color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }
  .nav-group__btn :global(svg) {
    inline-size: 1rem;
    block-size: 1rem;
    transition: transform var(--dur-fast) ease;
  }
  .nav-group__btn:hover,
  .nav-group__btn[aria-expanded='true'] {
    color: var(--navy-950);
    background: var(--mist-50);
  }
  .nav-group__btn[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }
  .nav-group__btn.is-current {
    color: var(--navy-950);
    font-weight: 700;
  }
  .nav-group__btn.is-current::after {
    inset-inline: 0.55rem 1.4rem;
  }
  /* ----- Mega dropdown -----
     A floating white card under the bar. It keeps the menu readable over any
     page background and stays visually quiet, like the reference. */
  .nav-group__panel {
    display: none;
    /* Fixed to the viewport and centred, not anchored to the button: a panel
       this wide would otherwise run off the edge for the first/last item. */
    position: fixed;
    inset-inline: 0;
    margin-inline: auto;
    top: calc(var(--header-h) + 0.35rem);
    z-index: 10;
    inline-size: min(58rem, calc(100vw - 2 * var(--gutter)));
    max-height: calc(100dvh - var(--header-h) - 1.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(0.9rem, 0.7rem + 0.8vw, 1.35rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    color: var(--text);
    background: var(--white);
    box-shadow:
      0 1px 0 rgb(22 44 71 / 0.04),
      0 30px 60px -30px rgb(13 26 44 / 0.45);
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav-group__panel {
      animation: mega-in 180ms var(--ease-out) both;
    }
  }
  @keyframes mega-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .nav-group__btn[aria-expanded='true'] + .nav-group__panel {
    display: block;
  }
  /* Invisible strip that keeps the pointer inside the group while it travels
     from the bar down to the panel. It exists only while hovering. */
  .nav-group:hover::after {
    content: '';
    position: absolute;
    inset-inline: -0.5rem;
    top: 100%;
    height: 1rem;
  }
  @media (hover: hover) {
    .nav-group:hover .nav-group__panel {
      display: block;
    }
  }
  :global(.no-js) .nav-group:focus-within .nav-group__panel {
    display: block;
  }

  .mega {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 19rem);
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
    align-items: start;
  }
  .mega__links {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 0.65rem;
  }
  .mega__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: center;
    block-size: 100%;
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--white);
    color: var(--navy-800);
    font-weight: 400;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      transform var(--dur-med) var(--ease-out);
  }
  .mega__link:hover,
  .mega__link:focus-visible {
    background: var(--mist-50);
    border-color: var(--aqua-300);
    color: var(--navy-950);
    transform: translateY(-2px);
  }
  .mega__link[aria-current='page'] {
    background: var(--aqua-100);
    border-color: var(--aqua-300);
    color: var(--navy-950);
  }
  .mega__link[aria-current='page']::after {
    display: none;
  }
  .mega__icon {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 0.75rem;
    background: var(--aqua-100);
    color: var(--aqua-600);
  }
  .mega__icon :global(svg) {
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }
  .mega__text {
    display: grid;
    gap: 0.1rem;
  }
  .mega__label {
    font-weight: 700;
    line-height: 1.6;
  }
  .mega__hint {
    font-size: 0.82rem;
    font-weight: 400;
    line-height: 1.7;
    color: var(--slate-600);
  }
  .mega :global(.mega__arrow) {
    inline-size: 1.15rem;
    block-size: 1.15rem;
    color: var(--aqua-500);
    transition: transform var(--dur-med) var(--ease-out);
  }
  .mega__link:hover :global(.mega__arrow) {
    transform: translateX(-4px);
  }

  .mega__feature {
    display: grid;
    gap: 0.7rem;
    justify-items: start;
    padding: clamp(1.2rem, 2vw, 1.6rem);
    border-radius: var(--radius-m);
    background:
      radial-gradient(20rem 10rem at 100% 0%, rgb(0 176 200 / 0.16), transparent 70%),
      var(--mist-50);
    color: var(--navy-900);
    border: 1px solid var(--rule);
  }
  .mega__feature-title {
    font-size: var(--step-1);
    font-weight: 800;
    line-height: 1.55;
  }
  .mega__feature-text {
    font-size: var(--step--1);
    line-height: 1.85;
    color: var(--slate-600);
  }
  .mega__feature-cta {
    min-height: 2.6rem;
    margin-top: 0.2rem;
    font-size: 0.95rem;
  }
  @media (max-width: 1080px) {
    .mega {
      grid-template-columns: 1fr;
    }
  }

  .site-header__phones {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }
  .site-header__phones > a + a {
    padding-inline-start: 0.7rem;
    border-inline-start: 1px solid var(--rule);
  }
  .site-header__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 700;
    font-size: 0.86rem;
    color: var(--navy-900);
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--radius-s);
  }
  .site-header__phone :global(svg) {
    inline-size: 1rem;
    block-size: 1rem;
    color: var(--petrol-500);
  }
  .site-header__phone:hover span {
    text-decoration: underline;
    text-decoration-color: var(--petrol-500);
    text-underline-offset: 0.3em;
  }
  .mobile-menu__call {
    align-self: stretch;
  }
  /* Seven top-level items need room. From 1440px up both numbers show. Between
     1100 and 1439 the mobile line stays and the landline steps aside — one number
     occupies the same footprint as before, so nothing else has to move (a 1440px
     screen with a scrollbar is 1425px, which is why the mobile line was invisible
     on most laptops). Below 1100 the numbers give way to the menu. */
  @media (max-width: 1439px) {
    .site-header__phone--landline {
      display: none;
    }
    /* no landline on the left any more, so the mobile line drops its divider */
    .site-header__phone--mobile {
      padding-inline-start: 0;
      border-inline-start: 0;
    }
  }
  @media (max-width: 1099px) {
    .site-header__phones {
      display: none;
    }
  }
  @media (max-width: 1700px) {
    .site-nav > ul > li > a,
    .nav-group__btn {
      font-size: 0.82rem;
      padding-inline: 0.5rem;
    }
  }
  @media (max-width: 1200px) {
    .site-nav > ul > li > a,
    .nav-group__btn {
      font-size: 0.8rem;
      padding-inline: 0.45rem;
    }
  }
  @media (max-width: 1120px) {
    .site-header__inner {
      gap: 1rem;
    }
    .site-nav > ul {
      padding: 0.24rem;
    }
    .site-nav > ul > li > a,
    .nav-group__btn {
      font-size: 0.8rem;
      padding-inline: 0.5rem;
    }
  }
  @media (max-width: 1040px) {
    .site-header__cta {
      display: none;
    }
  }
  .site-header__cta {
    flex: none;
    gap: 0.4rem;
    min-height: 2.6rem;
    padding-inline: 1.05rem;
    font-size: 0.92rem;
    line-height: 1.2;
    white-space: nowrap;
    box-shadow: 0 10px 20px -16px rgb(13 26 44 / 0.7);
  }
  .site-header__cta .btn__icon {
    inline-size: 0.95rem;
    block-size: 0.95rem;
  }
  .site-header__cta:hover {
    box-shadow: 0 12px 22px -14px rgb(13 26 44 / 0.75);
  }

  .menu-toggle,
  .menu-close {
    display: none;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: transparent;
    font-weight: 700;
    cursor: pointer;
  }
  .menu-toggle svg,
  .menu-close svg {
    inline-size: 1.3rem;
    block-size: 1.3rem;
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 1rem var(--gutter) 2rem;
    border: 0;
    background: var(--white) var(--grain);
    color: var(--text);
    overflow-y: auto;
  }
  .mobile-menu:popover-open {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: calc(var(--header-h) - 1rem);
  }
  .mobile-menu .menu-close {
    display: inline-flex;
    min-width: 2.75rem;
    justify-content: center;
  }
  .mobile-menu ul {
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  .mobile-menu li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0.25rem;
    border-bottom: 1px solid var(--rule);
    font-size: var(--step-2);
    font-weight: 800;
    text-decoration: none;
  }
  .mobile-menu li a[aria-current='page'] {
    color: var(--petrol-600);
  }
  .mobile-menu__group {
    padding-top: 1.1rem;
    border-bottom: 1px solid var(--rule);
  }
  .mobile-menu__group-title {
    font-size: var(--step--1);
    font-weight: 700;
