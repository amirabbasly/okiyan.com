---
/**
 * Desktop: a two-row bar — the structure of the first reference (logo spanning
 * both rows on the right, a thin rule between the rows, the contact cluster on
 * the left) with the text placement of the second one: plain links read from
 * the right edge on row one beside the avatar + line number, the icon services
 * cluster on the right of row two beside the navy CTA pill on the left.
 *
 * Below 1080px the rows collapse into one bar and the whole menu becomes a
 * drawer that slides in from the RIGHT edge (native popover, no JS needed).
 */
import { nav, contactCta, site, isNavGroup, companyPhones } from '~/config/site';
import Logo from '~/components/ui/Logo.astro';
import Icon from '~/components/ui/Icon.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const groupCurrent = (children: Array<{ href: string }>) => children.some((c) => isCurrent(c.href));
// The first mobile line is printed next to the office number in the header.
const headerPhones = companyPhones.filter((p) => p.kind === 'mobile').slice(0, 1);

/* row 1 = plain links & the company group; row 2 = the icon service links */
const rowOf = (item: (typeof nav)[number]) => (item.row === 2 ? 2 : 1);
const row1 = nav.filter((i) => rowOf(i) === 1);
const row2 = nav.filter((i) => rowOf(i) === 2);
---

<header class="site-header">
  <div class="container site-header__band">
    <a href="/" class="site-header__brand">
      <Logo />
      <span class="sr-only">— صفحه اصلی</span>
    </a>

    <!-- ============ row 1: plain links, read from the right edge ============ -->
    <nav class="site-nav site-nav--primary" aria-label="ناوبری اصلی">
      <ul>
        {
          row1.map((item, i) =>
            isNavGroup(item) ? (
              <li class="nav-group" data-nav-group>
                <button
                  type="button"
                  class:list={['nav-group__btn', { 'is-current': groupCurrent(item.children) }]}
                  aria-expanded="false"
                  aria-controls={`nav-group-${i}`}
                >
                  {item.label}
                  {item.badge && <span class="nav-badge">{item.badge}</span>}
                  <Icon name="chevron" />
                </button>
                <div class="nav-group__panel" id={`nav-group-${i}`}>
                  <div class="mega container">
                    <ul class="mega__links">
                      {item.children.map((c) => (
                        <li>
                          <a class="mega__link" href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>
                            {c.icon && (
                              <span class="mega__icon" aria-hidden="true">
                                <Icon name={c.icon} />
                              </span>
                            )}
                            <span class="mega__text">
                              <span class="mega__label">{c.label}</span>
                              {c.hint && <span class="mega__hint">{c.hint}</span>}
                            </span>
                            <Icon name="arrow" class="mega__arrow" />
                          </a>
                        </li>
                      ))}
                    </ul>
                    {
                      item.feature && (
                        <aside class="mega__feature" aria-label={item.feature.title}>
                          <p class="mega__feature-title">{item.feature.title}</p>
                          <p class="mega__feature-text">{item.feature.text}</p>
                          <a class="btn mega__feature-cta" href={item.feature.href}>
                            {item.feature.ctaLabel}
                            <Icon name="arrow" class="btn__icon" />
                          </a>
                        </aside>
                      )
                    }
                  </div>
                </div>
              </li>
            ) : (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                  {item.badge && <span class="nav-badge">{item.badge}</span>}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <!-- ============ row 2: the services, icon first, clustered right ============ -->
    <nav class="site-nav site-nav--services" aria-label="خدمات">
      <ul>
        {
          row2.map((item, i) =>
            isNavGroup(item) ? (
              <li class="nav-group" data-nav-group>
                <button
                  type="button"
                  class:list={['nav-group__btn', 'site-nav__svc', { 'is-current': groupCurrent(item.children) }]}
                  aria-expanded="false"
                  aria-controls={`nav-svc-${i}`}
                >
                  <span class="site-nav__icon" aria-hidden="true">
                    <Icon name={item.icon ?? 'briefcase'} />
                  </span>
                  {item.label}
                  <Icon name="chevron" />
                </button>
                <div class="nav-group__panel" id={`nav-svc-${i}`}>
                  <div class="mega container">
                    <ul class="mega__links">
                      {item.children.map((c) => (
                        <li>
                          <a class="mega__link" href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>
                            {c.icon && (
                              <span class="mega__icon" aria-hidden="true">
                                <Icon name={c.icon} />
                              </span>
                            )}
                            <span class="mega__text">
                              <span class="mega__label">{c.label}</span>
                              {c.hint && <span class="mega__hint">{c.hint}</span>}
                            </span>
                            <Icon name="arrow" class="mega__arrow" />
                          </a>
                        </li>
                      ))}
                    </ul>
                    {
                      item.feature && (
                        <aside class="mega__feature" aria-label={item.feature.title}>
                          <p class="mega__feature-title">{item.feature.title}</p>
                          <p class="mega__feature-text">{item.feature.text}</p>
                          <a class="btn mega__feature-cta" href={item.feature.href}>
                            {item.feature.ctaLabel}
                            <Icon name="arrow" class="btn__icon" />
                          </a>
                        </aside>
                      )
                    }
                  </div>
                </div>
              </li>
            ) : (
              <li>
                <a class="site-nav__svc" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  <span class="site-nav__icon" aria-hidden="true">
                    <Icon name={item.icon ?? 'route'} />
                  </span>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <!-- row 1 left: the answered line, then the conversion pill -->
    <div class="site-header__actions">
      {
        site.contact.phone && (
          <a href={`tel:${site.contact.phone}`} class="site-header__call">
            <span class="sr-only">تلفن دفتر</span>
            <span class="site-header__num" dir="ltr">{site.contact.phoneDisplay ?? site.contact.phone}</span>
            <span class="site-header__agent">
              {/* default avatar: swap the file for a real staff photo later */}
              <img src="/img/support-avatar-160.png" alt="" width="80" height="80" />
              <span class="site-header__agent-dot" aria-hidden="true"></span>
            </span>
          </a>
        )
      }
      <a href={contactCta.href} class="btn site-header__cta" aria-current={isCurrent(contactCta.href) ? 'page' : undefined}>
        <Icon name="headset" class="site-header__cta-icon" />
        {contactCta.label}
      </a>
      <button class="menu-toggle" type="button" popovertarget="mobile-menu" aria-controls="mobile-menu">
        <Icon name="menu" />
        <span>منو</span>
      </button>
    </div>
  </div>

  <!-- Drawer: slides in from the right edge, closes with Esc / outside click. -->
  <div id="mobile-menu" class="mobile-menu" popover>
    <div class="mobile-menu__top">
      <Logo />
      <button class="menu-close" type="button" popovertarget="mobile-menu" popovertargetaction="hide">
        <Icon name="close" />
        <span class="sr-only">بستن منو</span>
      </button>
    </div>
    <nav aria-label="ناوبری موبایل">
      <ul>
        <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>صفحه اصلی</a></li>
        {
          nav.map((item) =>
            isNavGroup(item) ? (
              <li class="mobile-menu__group">
                <span class="mobile-menu__group-title">{item.label}</span>
                <ul>
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                  {item.badge && <span class="nav-badge">{item.badge}</span>}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>
    {
      site.contact.phone && (
        <a href={`tel:${site.contact.phone}`} class="btn btn--ghost mobile-menu__call">
          <Icon name="phone" class="btn__icon" />
          تماس: <span dir="ltr">{site.contact.phoneDisplay ?? site.contact.phone}</span>
        </a>
      )
    }
    <a href={contactCta.href} class="btn mobile-menu__cta">
      {contactCta.label}
      <Icon name="arrow" class="btn__icon" />
    </a>
  </div>
</header>

<script>
  // Header dropdowns: click/Enter toggles, Esc or a click/focus elsewhere closes.
  // Without JS they still open on hover and keyboard focus (CSS below).
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-group]'));
  const buttonOf = (g: HTMLElement) => g.querySelector<HTMLButtonElement>('.nav-group__btn')!;
  const setOpen = (g: HTMLElement, open: boolean) => buttonOf(g).setAttribute('aria-expanded', String(open));
  const closeAll = (except?: HTMLElement) => groups.forEach((g) => g !== except && setOpen(g, false));

  for (const g of groups) {
    const btn = buttonOf(g);
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      closeAll(g);
      setOpen(g, open);
    });
    g.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(g, false);
        btn.focus();
      }
    });
    g.addEventListener('focusout', (e) => {
      if (!g.contains(e.relatedTarget as Node | null)) setOpen(g, false);
    });
  }
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('[data-nav-group]')) closeAll();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Solid (no backdrop-filter): cheaper to composite while scrolling. */
    background: var(--white);
    border-bottom: 1px solid rgb(0 176 200 / 0.28);
    box-shadow: 0 1px 0 rgb(0 176 200 / 0.1);
    /* the logo-orange, which the pinned header blue must not swallow */
    --svc: #fe5d02;
  }

  /* ---------- the two-row band ----------
     logo | rows | side cluster; the rule between the rows stops before the
     logo column, exactly like the first reference. */
  .site-header__band {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    column-gap: clamp(1.2rem, 2.4vw, 2.6rem);
    align-items: center;
  }
  .site-header__brand {
    grid-column: 1;
    grid-row: 1 / 3;
    align-self: center;
    text-decoration: none;
    border-radius: var(--radius-s);
  }
  .site-nav--primary {
    grid-column: 2;
    grid-row: 1;
  }
  .site-header__actions {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  /* the rule between the rows hangs under row one, so it still spans both
     middle columns now that row two's left corner is empty */
  .site-nav--primary,
  .site-header__actions {
    padding-block: 0.45rem 0.4rem;
    border-bottom: 1px solid rgb(0 176 200 / 0.2);
  }
  .site-nav--services {
    grid-column: 2;
    grid-row: 2;
    padding-block: 0.35rem 0.5rem;
  }

  /* ---------- row 1: plain links with hairline dot separators ---------- */
  .site-nav--primary > ul {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav--primary > ul > li {
    display: flex;
    align-items: center;
  }
  .site-nav--primary > ul > li + li {
    position: relative;
    margin-inline-start: clamp(0.55rem, 1vw, 1.05rem);
    padding-inline-start: clamp(0.55rem, 1vw, 1.05rem);
  }
  .site-nav--primary > ul > li + li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 50%;
    inline-size: 3px;
    block-size: 3px;
    margin-top: -1.5px;
    border-radius: 50%;
    background: rgb(5 37 71 / 0.26);
  }
  .site-nav--primary > ul > li > a,
  .site-nav--primary .nav-group__btn {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.28rem 0.1rem;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--navy-900);
    text-decoration: none;
    cursor: pointer;
    border-radius: var(--radius-s);
  }
  .site-nav--primary > ul > li > a:hover,
  .site-nav--primary .nav-group__btn:hover {
    color: var(--petrol-600);
  }
  .site-nav--primary > ul > li > a[aria-current='page'],
  .site-nav--primary .nav-group__btn.is-current {
    color: var(--petrol-600);
    font-weight: 800;
  }
  .site-nav--primary :global(svg) {
    inline-size: 0.95rem;
    block-size: 0.95rem;
    color: var(--petrol-500);
    transition: transform var(--dur-med) var(--ease-out);
  }
  .nav-group__btn[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }

  /* the «جدید» flag */
  .nav-badge {
    padding: 0.02rem 0.5rem 0.06rem;
    border-radius: 999px;
    background: #e11d48;
    color: var(--white);
    font-size: 0.62rem;
    font-weight: 800;
    line-height: 1.7;
  }

  /* ---------- row 1 left: avatar + answered line ---------- */
  .site-header__call {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    border-radius: var(--radius-s);
    /* a hairline between the number and the pill beside it */
    padding-inline-end: 0.8rem;
    border-inline-end: 1px solid rgb(5 37 71 / 0.14);
  }
  .site-header__num {
    font-size: 0.92rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    color: var(--aqua-600);
  }
  .site-header__call:hover .site-header__num {
    text-decoration: underline;
    text-decoration-color: var(--aqua-500);
    text-underline-offset: 0.3em;
  }
  .site-header__agent {
    position: relative;
    flex: none;
    inline-size: 2.3rem;
    block-size: 2.3rem;
  }
  .site-header__agent img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid var(--white);
    box-shadow:
      0 0 0 1px rgb(5 37 71 / 0.16),
      0 8px 16px -10px rgb(0 18 48 / 0.45);
  }
  .site-header__agent-dot {
    position: absolute;
    top: 0;
    left: 0;
    inline-size: 0.72rem;
    block-size: 0.72rem;
    border-radius: 50%;
    background: #22c55e;
    border: 2px solid var(--white);
  }

  /* ---------- row 2: icon services, clustered from the right ---------- */
  .site-nav--services > ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2.1rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav__svc {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.22rem 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--navy-900);
    text-decoration: none;
    cursor: pointer;
    border-radius: var(--radius-s);
  }
  .site-nav__svc:hover {
    color: var(--petrol-600);
  }
  .site-nav__svc[aria-current='page'],
  .site-nav__svc.is-current {
    color: var(--petrol-600);
  }
  .site-nav__icon {
    display: grid;
    place-items: center;
    color: var(--svc);
  }
  .site-nav__icon :global(svg) {
    inline-size: 1.35rem;
    block-size: 1.35rem;
  }
  .site-nav--services :global(svg:not(.site-nav__icon svg)) {
    inline-size: 0.9rem;
    block-size: 0.9rem;
    color: var(--petrol-500);
  }
  .site-nav--services .nav-group__btn :global(svg) {
    transition: transform var(--dur-med) var(--ease-out);
  }

  /* ---------- row 2 left: the navy pill ---------- */
  .site-header__cta {
    --btn-bg: var(--navy-900);
    --btn-border: var(--navy-900);
    --btn-fg: var(--white);
    gap: 0.5rem;
    min-height: 2.5rem;
    padding-inline: 1.15rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 800;
    white-space: nowrap;
    box-shadow: 0 12px 24px -16px rgb(0 18 48 / 0.8);
  }
  .site-header__cta:hover {
    --btn-bg: var(--navy-800);
    --btn-border: var(--navy-800);
  }
  .site-header__cta-icon {
    inline-size: 1.15rem;
    block-size: 1.15rem;
  }

  /* ---------- Mega dropdown (both rows) ----------
     A floating white card under the whole bar. */
  .nav-group {
    position: relative;
  }
  .nav-group__panel {
    display: none;
    position: fixed;
    inset-inline: 0;
    margin-inline: auto;
    top: calc(var(--header-h) + 0.35rem);
    z-index: 10;
    inline-size: min(58rem, calc(100vw - 2 * var(--gutter)));
    max-height: calc(100dvh - var(--header-h) - 1.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(0.9rem, 0.7rem + 0.8vw, 1.35rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    color: var(--text);
    background: var(--white);
    box-shadow:
      0 1px 0 rgb(22 44 71 / 0.04),
      0 30px 60px -30px rgb(13 26 44 / 0.45);
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav-group__panel {
      animation: mega-in 180ms var(--ease-out) both;
    }
  }
  @keyframes mega-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .nav-group__btn[aria-expanded='true'] + .nav-group__panel {
    display: block;
  }
  /* Invisible strip that keeps the pointer inside the group while it travels
     from the bar down to the panel. It exists only while hovering. */
  .nav-group:hover::after {
    content: '';
    position: absolute;
    inset-inline: -0.5rem;
    top: 100%;
    height: 1rem;
  }
  @media (hover: hover) {
    .nav-group:hover .nav-group__panel {
      display: block;
    }
  }
  :global(.no-js) .nav-group:focus-within .nav-group__panel {
    display: block;
  }

  .mega {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 19rem);
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
    align-items: start;
  }
  .mega__links {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 0.65rem;
    margin: 0;
    padding: 0;
  }
  .mega__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: center;
    block-size: 100%;
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--white);
    color: var(--navy-800);
    font-weight: 400;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      transform var(--dur-med) var(--ease-out);
  }
  .mega__link:hover,
  .mega__link:focus-visible {
    background: var(--mist-50);
    border-color: var(--aqua-300);
    color: var(--navy-950);
    transform: translateY(-2px);
  }
  .mega__link[aria-current='page'] {
    background: var(--aqua-100);
    border-color: var(--aqua-300);
    color: var(--navy-950);
  }
  .mega__icon {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 0.75rem;
    background: var(--aqua-100);
    color: var(--aqua-600);
  }
  .mega__icon :global(svg) {
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }
  .mega__text {
    display: grid;
    gap: 0.1rem;
  }
  .mega__label {
    font-weight: 700;
    line-height: 1.6;
  }
  .mega__hint {
    font-size: 0.82rem;
    font-weight: 400;
    line-height: 1.7;
    color: var(--slate-600);
  }
  .mega :global(.mega__arrow) {
    inline-size: 1.15rem;
    block-size: 1.15rem;
    color: var(--aqua-500);
    transition: transform var(--dur-med) var(--ease-out);
  }
  .mega__link:hover :global(.mega__arrow) {
    transform: translateX(-4px);
  }
  .mega__feature {
    display: grid;
    gap: 0.7rem;
    justify-items: start;
    padding: clamp(1.2rem, 2vw, 1.6rem);
    border-radius: var(--radius-m);
    background:
      radial-gradient(20rem 10rem at 100% 0%, rgb(0 176 200 / 0.16), transparent 70%),
      var(--mist-50);
    color: var(--navy-900);
    border: 1px solid var(--rule);
  }
  .mega__feature-title {
    font-size: var(--step-1);
    font-weight: 800;
    line-height: 1.55;
  }
  .mega__feature-text {
    font-size: var(--step--1);
    line-height: 1.85;
    color: var(--slate-600);
  }
  .mega__feature-cta {
    min-height: 2.6rem;
    margin-top: 0.2rem;
    font-size: 0.95rem;
  }
  @media (max-width: 1080px) {
    .mega {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- toggles ---------- */
  .menu-toggle,
  .menu-close {
    display: none;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: transparent;
    font-weight: 700;
    cursor: pointer;
  }
  .menu-toggle svg,
  .menu-close svg {
    inline-size: 1.3rem;
    block-size: 1.3rem;
  }

  /* ---------- the drawer: enters from the right edge ---------- */
  .mobile-menu {
    position: fixed;
