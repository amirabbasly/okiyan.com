---
import { site, contactChannels, socialLinks, isProduction, contactCta, offices } from '~/config/site';
import Logo from '~/components/ui/Logo.astro';
import Icon from '~/components/ui/Icon.astro';
import { persianYear } from '~/lib/format';
import { getCollection } from 'astro:content';

const channels = contactChannels();
const socials = socialLinks();
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const year = persianYear();
---

<footer class="site-footer on-dark">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Logo tone="light" />
      <p>{site.description}</p>
      <a class="btn btn--accent" href={contactCta.href}>
        {contactCta.label}
        <Icon name="arrow" class="btn__icon" />
      </a>
    </div>

    <nav aria-labelledby="footer-services">
      <h2 id="footer-services">خدمات</h2>
      <ul>
        <li><a href="/customs-clearance/">ترخیص کالا</a></li>
        <li><a href="/import-services/">خدمات واردات کالا</a></li>
        <li><a href="/sailor-import/">واردات ملوانی</a></li>
        <li><a href="/commercial-services/">خدمات بازرگانی</a></li>
        <li><a href="/special-projects/">پروژه‌های خاص</a></li>
        <li><a href="/after-sales-services/">خدمات پس از فروش</a></li>
        <li><a href="/price-calculator/">محاسبه قیمت</a></li>
      </ul>
    </nav>

    <nav aria-labelledby="footer-company">
      <h2 id="footer-company">اوکیان</h2>
      <ul>
        <li><a href="/about/">درباره ما</a></li>
        <li><a href="/resume/">رزومه</a></li>
        <li><a href="/partners/">همکاران</a></li>
        <li><a href="/guarantee/">ضمانت</a></li>
        <li><a href="/contact/">درخواست مشاوره</a></li>
      </ul>
    </nav>

    <nav aria-labelledby="footer-guides">
      <h2 id="footer-guides">راهنماها</h2>
      <ul>
        {guides.map((g) => <li><a href={`/guides/${g.id}/`}>{g.data.navTitle}</a></li>)}
        <li><a href="/guides/">همه راهنماها</a></li>
      </ul>
    </nav>

    <div>
      <h2 id="footer-contact">ارتباط</h2>
      {
        channels.length > 0 ? (
          <ul aria-labelledby="footer-contact">
            {channels.map((c) => (
              <li>
                <a href={c.href}>
                  {c.label}: <span dir={c.channel === 'phone' || c.channel === 'email' ? 'ltr' : undefined}>{c.value}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : isProduction ? (
          <p>
            برای گفت‌وگو، <a href="/contact/">فرم درخواست مشاوره</a> را تکمیل کنید.
          </p>
        ) : (
          <span class="placeholder">راه‌های تماس هنوز در src/config/site.ts تنظیم نشده‌اند.</span>
        )
      }
      {
        socials.length > 0 && (
          <ul class="site-footer__social">
            {socials.map((s) => (
              <li>
                <a href={s.href} rel="me noopener">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  <div class="container site-footer__offices">
    <h2 id="footer-offices">دفترهای اوکیان</h2>
    <ul aria-labelledby="footer-offices">
      {
        offices.map((o) => (
          <li class="office">
            <span class="office__city">
              <Icon name="pin" />
              {o.city}
            </span>
            <address class="office__address">{o.address}</address>
            {o.phone && (
              <a class="office__phone" href={`tel:${o.phone.e164}`}>
                <Icon name="phone" />
                <span dir="ltr">{o.phone.display}</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>

  <p class="site-footer__mark" aria-hidden="true">{site.wordmarkLatin}</p>

  <div class="container site-footer__base">
    <p>© {year} {site.name}</p>
    <a href="/about/">درباره {site.name}</a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-900);
    color: #c4cddb;
    padding-block: clamp(3.5rem, 3rem + 3vw, 6rem) 2rem;
    font-size: var(--step--1);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(4, 1fr);
    gap: 2.5rem;
  }
  .site-footer__brand {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-width: 24rem;
  }
  .site-footer h2 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--petrol-200);
    margin-bottom: 1rem;
  }
  .site-footer ul {
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }
  .site-footer a:not(.btn) {
    color: var(--mist-100);
    text-decoration: none;
    background-image: linear-gradient(var(--petrol-300), var(--petrol-300));
    background-size: 0 1px;
    background-position: 100% 100%;
    background-repeat: no-repeat;
    transition: background-size var(--dur-med) var(--ease-out);
  }
  .site-footer a:not(.btn):hover {
    background-size: 100% 1px;
  }
  .site-footer__offices {
    margin-top: clamp(2.25rem, 4vw, 3.25rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid rgb(232 236 238 / 0.12);
  }
  .site-footer__offices ul {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem 2.5rem;
  }
  .office {
    display: grid;
    gap: 0.3rem;
    align-content: start;
    padding-inline-start: 1rem;
    border-inline-start: 2px solid rgb(143 180 201 / 0.35);
  }
  .office__city {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 800;
    color: var(--white);
  }
  .office__city :global(svg) {
    inline-size: 1rem;
    block-size: 1rem;
    color: var(--petrol-300);
  }
  .office__address {
    font-style: normal;
    line-height: 1.95;
    color: #c4cddb;
  }
  .office__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    justify-self: start;
    font-weight: 700;
    margin-top: 0.15rem;
  }
  .office__phone :global(svg) {
    inline-size: 0.95rem;
    block-size: 0.95rem;
    color: var(--petrol-300);
  }
  @media (max-width: 900px) {
    .site-footer__offices ul {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 620px) {
    .site-footer__offices ul {
      grid-template-columns: 1fr;
    }
  }
  .site-footer__social {
    margin-top: 1rem;
  }
  .site-footer__mark {
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    direction: ltr;
    text-align: center;
    font-weight: 800;
    font-size: clamp(3rem, 11.5vw, 11rem);
    line-height: 0.85;
    letter-spacing: 0.12em;
    color: transparent;
    background: linear-gradient(180deg, rgb(143 180 201 / 0.16), rgb(143 180 201 / 0.02) 80%);
    -webkit-background-clip: text;
    background-clip: text;
    user-select: none;
    white-space: nowrap;
    overflow: hidden;
  }
  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(232 236 238 / 0.12);
    color: #9aa8bd;
  }
  .site-footer__base p {
    max-width: 48rem;
  }
  @media (max-width: 900px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
