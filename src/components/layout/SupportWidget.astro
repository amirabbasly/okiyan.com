---
/**
 * Floating support button (bottom corner of every page).
 * Native popover: opens/closes without JavaScript, closes with Esc or an outside
 * click, and the panel's numbers are `tel:` links on touch devices.
 */
import Icon from '~/components/ui/Icon.astro';
import { companyPhones, contactCta } from '~/config/site';

const kindLabel = (kind: 'mobile' | 'landline') => (kind === 'mobile' ? 'تلفن همراه' : 'تلفن دفتر');
// The homepage opens with the pinned journey whose step bar sits along the
// bottom edge; lift the widget there so the two never overlap.
const raised = Astro.url.pathname === '/';
---

<div class:list={['support', { 'support--raised': raised }]}>
  <button
    class="support__toggle"
    type="button"
    popovertarget="support-panel"
    aria-controls="support-panel"
    aria-expanded="false"
  >
    <span class="support__toggle-icon" aria-hidden="true">
      <Icon name="phone" />
      <span class="support__ping" />
    </span>
    <span class="support__toggle-text">تماس</span>
  </button>

  <div id="support-panel" class="support__panel" popover aria-labelledby="support-title">
    <div class="support__head">
      <p id="support-title" class="support__title">تماس با پشتیبانی</p>
      <button class="support__close" type="button" popovertarget="support-panel" popovertargetaction="hide">
        <Icon name="close" />
        <span class="sr-only">بستن پنل پشتیبانی</span>
      </button>
    </div>

    <p class="support__hint">برای مشاورهٔ سریع، با یکی از شماره‌های زیر تماس بگیرید.</p>

    <ul class="support__list">
      {
        companyPhones.map((p) => (
          <li>
            <a class="support__phone" href={`tel:${p.e164}`}>
              <span class="support__phone-icon" aria-hidden="true">
                <Icon name="phone" />
              </span>
              <span class="support__phone-body">
                <span class="support__phone-kind">{kindLabel(p.kind)}</span>
                <span class="support__phone-num" dir="ltr">
                  {p.display}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <a class="btn support__cta" href={contactCta.href}>
      {contactCta.label}
      <Icon name="arrow" class="btn__icon" />
    </a>
  </div>
</div>

<script>
  // Keep aria-expanded in sync with the native popover state.
  const panel = document.getElementById('support-panel');
  const toggle = document.querySelector<HTMLButtonElement>('.support__toggle');
  if (panel && toggle) {
    panel.addEventListener('toggle', (event) => {
      const state = (event as Event & { newState?: string }).newState;
      toggle.setAttribute('aria-expanded', state === 'open' ? 'true' : 'false');
    });
  }
</script>

<style>
  .support {
    --support-bottom: max(1rem, env(safe-area-inset-bottom));
    position: fixed;
    inset-inline-end: clamp(0.75rem, 2.5vw, 1.5rem);
    bottom: var(--support-bottom);
    /* Below the sticky header (50) so an open mega panel covers it; the popover
       itself lives in the top layer and is unaffected. */
    z-index: 45;
  }
  .support--raised {
    --support-bottom: calc(max(1rem, env(safe-area-inset-bottom)) + 3.75rem);
  }
  .support__toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3.6rem;
    padding-inline: 1rem 1.45rem;
    border: 2px solid rgb(255 255 255 / 0.85);
    border-radius: 999px;
    background: linear-gradient(180deg, var(--petrol-600), var(--navy-900));
    color: var(--white);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    line-height: 1;
    cursor: pointer;
    box-shadow:
      0 0 0 4px rgb(46 98 130 / 0.18),
      0 20px 38px -14px rgb(13 26 44 / 0.8);
    transition:
      background-color var(--dur-fast) ease,
      transform var(--dur-med) var(--ease-out),
      box-shadow var(--dur-med) var(--ease-out);
  }
  .support__toggle:hover,
  .support__toggle[aria-expanded='true'] {
    background: linear-gradient(180deg, var(--petrol-500), var(--petrol-700));
    transform: translateY(-2px);
    box-shadow:
      0 0 0 5px rgb(46 98 130 / 0.26),
      0 24px 42px -14px rgb(13 26 44 / 0.85);
  }
  .support__toggle-icon {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 2.15rem;
    block-size: 2.15rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.16);
  }
  .support__toggle-icon :global(svg) {
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }
  /* A live dot: reads as “someone is here to answer”. */
  .support__ping {
    position: absolute;
    top: -2px;
    inset-inline-end: -2px;
    inline-size: 0.7rem;
    block-size: 0.7rem;
    border-radius: 50%;
    background: #4fd18b;
    box-shadow: 0 0 0 2px var(--navy-900);
  }
  @media (prefers-reduced-motion: no-preference) {
    .support__ping::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: #4fd18b;
      animation: support-ping 2s ease-out infinite;
    }
  }
  @keyframes support-ping {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    80%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
  /* Two soft rings on first paint: an invitation, not a loop. */
  @media (prefers-reduced-motion: no-preference) {
    .support__toggle::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      box-shadow: 0 0 0 0 rgb(46 98 130 / 0.5);
      animation: support-ring 2.6s ease-out 1.2s 2;
      pointer-events: none;
    }
  }
  @keyframes support-ring {
    70% {
      box-shadow: 0 0 0 0.9rem rgb(46 98 130 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(46 98 130 / 0);
    }
  }

  .support__panel {
    position: fixed;
    inset: auto;
    inset-inline-end: clamp(0.75rem, 2.5vw, 1.5rem);
    bottom: calc(var(--support-bottom) + 4.5rem);
    margin: 0;
    width: min(21rem, calc(100vw - 1.5rem));
    padding: 1.15rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--white) var(--grain);
    color: var(--text);
    box-shadow:
      0 30px 60px -26px rgb(13 26 44 / 0.6),
      0 0 0 1px rgb(22 44 71 / 0.04);
  }
  .support__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .support__title {
    font-weight: 800;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--navy-900);
  }
  .support__close {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2rem;
    block-size: 2rem;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: transparent;
    color: var(--slate-600);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }
  .support__close:hover {
    background: var(--mist-200);
    color: var(--navy-900);
  }
  .support__close :global(svg) {
    inline-size: 1rem;
    block-size: 1rem;
  }
  .support__hint {
    margin-top: 0.35rem;
    font-size: var(--step--1);
    line-height: 1.85;
    color: var(--text-muted);
  }
  .support__list {
    list-style: none;
    display: grid;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }
  .support__phone {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    text-decoration: none;
    transition:
      border-color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }
  .support__phone:hover {
    border-color: var(--petrol-500);
    background: var(--mist-100);
  }
  .support__phone-icon {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: 50%;
    background: var(--petrol-100);
    color: var(--petrol-600);
  }
  .support__phone-icon :global(svg) {
    inline-size: 1.05rem;
    block-size: 1.05rem;
  }
  .support__phone-body {
    display: grid;
    gap: 0.05rem;
    line-height: 1.5;
  }
  .support__phone-kind {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .support__phone-num {
    font-weight: 800;
    font-size: var(--step-0);
    color: var(--navy-900);
    letter-spacing: 0.01em;
  }
  .support__cta {
    width: 100%;
    margin-top: 1rem;
    min-height: 2.8rem;
    font-size: 0.95rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .support__panel {
      transition:
        opacity 180ms var(--ease-out),
        transform 180ms var(--ease-out),
        overlay 180ms allow-discrete,
        display 180ms allow-discrete;
      opacity: 0;
      transform: translateY(8px);
    }
    .support__panel:popover-open {
      opacity: 1;
      transform: none;
    }
    @starting-style {
      .support__panel:popover-open {
        opacity: 0;
        transform: translateY(8px);
      }
    }
  }
  @media (max-width: 420px) {
    .support__toggle {
      min-height: 3.35rem;
      padding-inline: 0.85rem 1.15rem;
      font-size: 0.98rem;
    }
    .support__toggle-icon {
      inline-size: 1.9rem;
      block-size: 1.9rem;
    }
  }
  @media print {
    .support {
      display: none;
    }
  }
</style>
