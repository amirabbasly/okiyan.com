---
/**
 * «درباره ما» — three explicit columns, exactly like the reference:
 *
 *   RTL:  [ figures, stacked vertically ]  [ «درباره ما» + «اوکیان» + copy + CTA ]  [ globe image ]
 *          (far right)                       (middle)                                    (left)
 *
 * No absolute layers and no overlap: the figures are a real column on the
 * reading-start side, the copy is centred in the middle column, and the globe
 * photograph is a real column on the left, bleeding toward the band's edge.
 *
 * Figures are the site's own verified numbers, not the reference's:
 * ۲۰۰۰ محموله · ۵۰۰ میلیون یورو · ۱۵ سال سابقه (تأسیس ۱۳۹۳).
 */
import Icon from '~/components/ui/Icon.astro';
import { toFaNumber } from '~/lib/format';

export interface Figure {
  value: number;
  /** Renders a «+» in front of the number, as in the reference. */
  approx?: boolean;
  /** Unit that sits on the number line, e.g. «محموله» or «سال». */
  unit?: string;
  /** The short line under the number. */
  label: string;
  icon: 'cube' | 'briefcase' | 'award';
}

export interface Props {
  title: string;
  lead: string;
  figures: Figure[];
  href: string;
  cta: string;
}

const { title, lead, figures, href, cta } = Astro.props;

/**
 * One spoken sentence per figure, so «حدود» is announced to screen readers
 * without sitting in the visible text where it reads as a stray word.
 */
const spoken = (f: Figure) =>
  `${f.approx ? 'حدود ' : ''}${toFaNumber(f.value)}${f.unit ? ' ' + f.unit : ''}، ${f.label}`;
---

<section class="about-band" id="about" aria-labelledby="about-title">
  <div class="container af-grid">
    <!-- figures — far right column, stacked -->
    <ul class="af-figs">
      {
        figures.map((f) => (
          <li class="af-fig">
            <span class="sr-only">{spoken(f)}</span>
            <span class="af-fig__icon" aria-hidden="true">
              <Icon name={f.icon} />
            </span>
            <span class="af-fig__body" aria-hidden="true">
              <span class="af-fig__value">
                {f.approx && <span class="af-fig__plus">+</span>}
                <span class="af-fig__num" data-count={f.value}>
                  {toFaNumber(f.value)}
                </span>
                {f.unit && <span class="af-fig__unit">{f.unit}</span>}
              </span>
              <span class="af-fig__label">{f.label}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <!-- copy — middle column -->
    <div class="af-copy">
      <span class="eyebrow">درباره ما</span>
      <h2 id="about-title" class="af-copy__title">{title}</h2>
      <p class="af-copy__lead">{lead}</p>
      <a class="btn btn--ghost af-copy__cta" href={href}>
        {cta}
        <Icon name="arrow" class="btn__icon" />
      </a>
    </div>

    <!-- globe — left column, decorative -->
    <figure class="af-art">
      <img
        src="/img/globe-dots-1408.webp"
        srcset="/img/globe-dots-960.webp 960w, /img/globe-dots-1408.webp 1408w"
        sizes="(max-width: 1024px) 90vw, 40vw"
        width="1408"
        height="768"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</section>

<script>
  import '~/scripts/counters';
</script>

<style>
  .about-band {
    position: relative;
    isolation: isolate;
    padding-block: clamp(1.8rem, 1.3rem + 2.4vw, 3rem);
    color: var(--mist-100);
    background:
      radial-gradient(48rem 26rem at 82% 0%, rgb(0 176 200 / 0.18), transparent 62%),
      radial-gradient(40rem 28rem at 0% 100%, rgb(0 176 200 / 0.16), transparent 66%),
      linear-gradient(118deg, #0e2136 0%, #14304a 52%, #0f2a42 100%);
    overflow: hidden;
  }

  .af-grid {
    display: grid;
    /* RTL: figures · copy · globe */
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.05fr) minmax(0, 1.3fr);
    gap: clamp(1rem, 0.6rem + 2.2vw, 2.75rem);
    align-items: center;
  }

  /* ---------- figures: vertical stack, far right ---------- */
  .af-figs {
    display: grid;
    gap: clamp(0.85rem, 0.6rem + 0.8vw, 1.4rem);
    margin: 0;
    padding: 0;
    padding-inline-end: clamp(0.9rem, 0.5rem + 1.2vw, 1.5rem);
    border-inline-end: 1px solid rgb(143 180 201 / 0.22);
    list-style: none;
  }
  .af-fig {
    display: grid;
    /* RTL: icon at the outer (right) edge, numbers to its left */
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.65rem;
  }
  .af-fig__icon {
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    color: var(--aqua-300);
  }
  .af-fig__icon :global(svg) {
    inline-size: 1.5rem;
    block-size: 1.5rem;
  }
  .af-fig__body {
    display: grid;
    gap: 0.05rem;
    min-inline-size: 0;
  }
  .af-fig__value {
    display: flex;
    align-items: baseline;
    gap: 0.12rem;
    color: var(--white);
    white-space: nowrap;
  }
  .af-fig__num {
    font-size: clamp(1.2rem, 1rem + 0.75vw, 1.6rem);
    font-weight: 800;
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
  }
  .af-fig__plus {
    font-size: 1rem;
    font-weight: 800;
    color: var(--aqua-300);
  }
  .af-fig__unit {
    font-size: clamp(0.8rem, 0.74rem + 0.22vw, 0.92rem);
    font-weight: 700;
    color: rgb(232 236 238 / 0.92);
  }
  .af-fig__label {
    font-size: 0.74rem;
    line-height: 1.55;
    color: rgb(232 236 238 / 0.68);
  }

  /* ---------- copy ---------- */
  .af-copy {
    display: grid;
    gap: 0.65rem;
    justify-items: center;
    text-align: center;
  }
  .af-copy .eyebrow {
    color: var(--aqua-300);
  }
  .af-copy .eyebrow::before {
    background: var(--aqua-500);
  }
  .af-copy__title {
    margin: 0;
    font-size: clamp(1.5rem, 1.15rem + 1.5vw, 2.25rem);
    font-weight: 800;
    color: var(--white);
    letter-spacing: -0.01em;
    line-height: 1.35;
  }
  .af-copy__lead {
    margin: 0;
    max-inline-size: 44ch;
    font-size: clamp(0.82rem, 0.78rem + 0.2vw, 0.92rem);
    line-height: 1.95;
    color: rgb(232 236 238 / 0.8);
  }
  .af-copy__cta {
    margin-top: 0.25rem;
    border-radius: 999px;
    border-color: rgb(232 236 238 / 0.42);
    color: var(--white);
  }
  .af-copy__cta:hover {
    background: var(--white);
    color: var(--navy-950);
    border-color: var(--white);
  }

  /* ---------- globe image, left column ---------- */
  .af-art {
    margin: 0;
    min-inline-size: 0;
  }
  .af-art img {
    display: block;
    /* oversized and pulled past the band's left edge, so the globe is cropped
       by the band exactly as in the reference */
    inline-size: 152%;
    max-inline-size: none;
    block-size: auto;
    margin-inline-end: -52%;
    margin-block: -19%;
    /* The render is lit dots on black. `screen` drops the black entirely and
       keeps only the lit dots — no mask needed (a mask here stopped Chrome
       from compositing the image at all). */
    mix-blend-mode: screen;
    filter: saturate(1.08) brightness(1.06);
  }

  @media (max-width: 1024px) {
    .af-grid {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 1.35rem;
    }
    .af-copy {
      order: 1;
    }
    .af-art {
      order: 2;
      justify-self: center;
      inline-size: min(100%, 24rem);
    }
    .af-art img {
      inline-size: 100%;
      margin: 0;
    }
    .af-fig {
      /* stacked mini-card: icon · number · label, all centred */
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0.3rem;
      text-align: center;
    }
    .af-fig__value {
      justify-content: center;
    }
    .af-figs {
      order: 3;
      grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
      inline-size: 100%;
      max-inline-size: 34rem;
      gap: 1rem;
      padding-inline-end: 0;
      padding-block-start: 1.35rem;
      border-inline-end: 0;
      border-block-start: 1px solid rgb(143 180 201 / 0.22);
    }
  }

  @media (max-width: 620px) {
    .af-figs {
      grid-template-columns: 1fr;
      max-inline-size: 18rem;
    }
    .af-fig {
      justify-content: start;
    }
  }
</style>
