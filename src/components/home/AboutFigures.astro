---
/**
 * «از بندر تا انبار، مسیر کالا روشن باشد» — built to the reference photo.
 *
 * The band itself is white; a navy crescent panel sits on the RTL-left and one
 * big arc is its right-hand edge. The globe is a real-geography dot sphere
 * sitting inside that panel and cropped by it, so the sphere reads against
 * white only through the arc, exactly like the photo.
 *
 * Geometry, measured off the reference (share of the band's width):
 *   panel edge ~36% at the top, ~46% at mid, ~48% at the bottom
 *   globe      ~46% wide, flush with the left edge
 *   copy       49% → 78%
 *   divider    ~78%
 *   figures    79% → 96%
 *
 * Figures are the site's own verified numbers: ۲۰۰۰ محموله · ۵۰۰ میلیون یورو ·
 * ۱۵ سال سابقه (تأسیس ۱۳۹۳).
 */
import Icon from '~/components/ui/Icon.astro';
import GlobeArt from '~/components/home/GlobeArt.astro';
import { toFaNumber } from '~/lib/format';

export interface Figure {
  value: number;
  /** Renders a «+» in front of the number, as in the reference. */
  approx?: boolean;
  /** Unit that sits on the number line, e.g. «محموله» or «سال». */
  unit?: string;
  /** The short line under the number. */
  label: string;
  icon: 'cube' | 'briefcase' | 'award';
}

export interface Props {
  title: string;
  lead: string;
  figures: Figure[];
  href: string;
  cta: string;
}

const { title, lead, figures, href, cta } = Astro.props;

/**
 * One spoken sentence per figure, so «حدود» reaches screen readers without
 * sitting in the visible text, where it read as a stray word.
 */
const spoken = (f: Figure) =>
  `${f.approx ? 'حدود ' : ''}${toFaNumber(f.value)}${f.unit ? ' ' + f.unit : ''}، ${f.label}`;
---

<section class="about-band" id="about" aria-labelledby="about-title">
  <div class="about-band__crescent" aria-hidden="true">
    <div class="about-band__globe">
      <GlobeArt class="about-band__globe-art" rotate={16} period={80} />
    </div>
  </div>

  <div class="about-band__grid">
    <!-- figures — far right column, stacked -->
    <ul class="af-figs">
      {
        figures.map((f) => (
          <li class="af-fig">
            <span class="sr-only">{spoken(f)}</span>
            <span class="af-fig__icon" aria-hidden="true">
              <Icon name={f.icon} />
            </span>
            <span class="af-fig__body" aria-hidden="true">
              <span class="af-fig__value">
                {f.approx && <span class="af-fig__plus">+</span>}
                <span class="af-fig__num" data-count={f.value}>
                  {toFaNumber(f.value)}
                </span>
                {f.unit && <span class="af-fig__unit">{f.unit}</span>}
              </span>
              <span class="af-fig__label">{f.label}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <!-- copy — middle column -->
    <div class="af-copy">
      <span class="eyebrow">درباره ما</span>
      <h2 id="about-title" class="af-copy__title">{title}</h2>
      <p class="af-copy__lead">{lead}</p>
      <a class="btn btn--ghost af-copy__cta" href={href}>
        {cta}
        <Icon name="arrow" class="btn__icon" />
      </a>
    </div>
  </div>
</section>

<script>
  import '~/scripts/counters';
</script>

<style>
  .about-band {
    position: relative;
    isolation: isolate;
    /* explicit layers: white band (0) → crescent (0) → globe (1) → content (2) */
    overflow: hidden;
    /* the section is white; only the crescent carries the navy */
    background: var(--white);
    border-block: 1px solid var(--rule);
    padding-block: clamp(1.6rem, 1.1rem + 1.8vw, 2.4rem);
  }

  /* The panel's right edge is one big arc, measured off the reference: the
     white band starts at ~36% of the width at the top, ~46% at mid and ~48%
     at the bottom, which is an ellipse centred below the band. */
  .about-band__crescent {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 120% at 8% 34%, #0b559c 0%, #073a6d 40%, #052547 72%, #04182e 100%);
    clip-path: ellipse(24% 112% at 24% 100%);
    z-index: 0;
    /* the globe is a child, so the same arc trims it, exactly like the photo */
    overflow: hidden;
  }

  .about-band__globe {
    position: absolute;
    left: -1%;
    top: 50%;
    translate: 0 -50%;
    inline-size: 46%;
    z-index: 1;
    pointer-events: none;
  }
  .about-band__globe-art {
    inline-size: 100%;
    opacity: 0.95;
  }

  .about-band__grid {
    position: relative;
    z-index: 2;
    display: grid;
    /* Measured off the reference (share of the band's width):
       figures 78–100% · copy 49–78% · globe 0–48%.
       In RTL grid column 1 is the right-hand edge, so the figures take 1,
       the copy 2, and the wide 3 is the globe's empty track. */
    grid-template-columns: 22% 29% 49%;
    align-items: center;
    gap: clamp(1rem, 0.6rem + 2vw, 2.5rem);
  }

  /* ---------- copy ---------- */
  .af-copy {
    grid-column: 2;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding-inline: 0.5rem 1.25rem;
    text-align: center;
  }
  .af-copy .eyebrow {
    color: var(--accent);
  }
  .af-copy .eyebrow::before {
    background: var(--aqua-500);
  }
  .af-copy__title {
    margin: 0;
    font-size: clamp(1.4rem, 1.12rem + 1.15vw, 1.95rem);
    font-weight: 800;
    color: var(--navy-900);
    letter-spacing: -0.01em;
    line-height: 1.4;
    text-wrap: balance;
  }
  .af-copy__lead {
    margin: 0;
    max-inline-size: 46ch;
    font-size: clamp(0.8rem, 0.76rem + 0.16vw, 0.88rem);
    line-height: 1.85;
    color: var(--slate-600);
  }
  .af-copy__cta {
    margin-top: 0.25rem;
    border-radius: 999px;
    border-color: var(--navy-900);
    color: var(--navy-900);
  }
  .af-copy__cta:hover {
    background: var(--navy-900);
    color: var(--white);
  }

  /* ---------- figures: vertical stack, far right ---------- */
  .af-figs {
    grid-column: 1;
    display: grid;
    gap: clamp(0.8rem, 0.6rem + 0.7vw, 1.25rem);
    margin: 0;
    padding: 0;
    /* in RTL `inline-end` is the left side, where the divider belongs */
    padding-inline: var(--gutter) clamp(1rem, 0.6rem + 1.4vw, 2rem);
    border-inline-end: 1px solid var(--rule);
    list-style: none;
  }
  .af-fig {
    display: grid;
    /* RTL: icon at the outer (right) edge, numbers to its left */
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.6rem;
  }
  .af-fig__icon {
    display: grid;
    place-items: center;
    inline-size: 2.1rem;
    block-size: 2.1rem;
    color: var(--accent);
  }
  .af-fig__icon :global(svg) {
    inline-size: 1.45rem;
    block-size: 1.45rem;
  }
  .af-fig__body {
    display: grid;
    gap: 0.02rem;
    min-inline-size: 0;
  }
  .af-fig__value {
    display: flex;
    align-items: baseline;
    gap: 0.12rem;
    color: var(--navy-950);
    white-space: nowrap;
  }
  .af-fig__num {
    font-size: clamp(1.2rem, 1rem + 0.7vw, 1.55rem);
    font-weight: 800;
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
  }
  .af-fig__plus {
    font-size: 1rem;
    font-weight: 800;
    color: var(--aqua-600);
  }
  .af-fig__unit {
    font-size: clamp(0.78rem, 0.72rem + 0.2vw, 0.9rem);
    font-weight: 700;
    color: var(--navy-800);
  }
  .af-fig__label {
    font-size: 0.74rem;
    line-height: 1.55;
    color: var(--slate-600);
  }

  /* ---------- tablet: copy above, figures in a row ---------- */
  @media (max-width: 1024px) {
    /* the figures strip carries its own white bed, so it takes the band's
       bottom padding — otherwise a sliver of navy shows underneath it */
    .about-band {
      padding-block-end: 0;
    }
    .about-band__crescent {
      clip-path: ellipse(38% 120% at 6% 100%);
    }
    .about-band__globe {
      inline-size: 36%;
      left: 0;
      top: 38%;
    }
    .about-band__grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        'copy'
        'figs';
      gap: 1.4rem;
    }
    .af-copy {
      grid-area: copy;
      grid-column: auto;
      /* the copy sits in the white right-hand side, clear of the arc.
         In RTL `inline-end` is the left side, so the auto margin goes there. */
      margin-inline: 0 auto;
      max-inline-size: min(30rem, 54%);
      padding-inline: var(--gutter);
      text-align: start;
      justify-items: start;
    }
    .af-figs {
      grid-area: figs;
      grid-column: auto;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      padding-inline: var(--gutter);
      padding-block: 1.1rem 1.5rem;
      /* the row crosses the arc, so it carries its own white bed */
      background: var(--white);
      border-inline-end: 0;
      border-block-start: 1px solid var(--rule);
    }
    .af-fig {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 0.35rem;
    }
    .af-fig__value {
      justify-content: center;
    }
  }

  /* ---------- phone: copy on the right, globe on the left, figures below ---------- */
  @media (max-width: 640px) {
    .about-band {
      padding-block: 1.5rem 0;
    }
    .about-band__crescent {
      /* same arc, scaled down: the panel edge runs 28% → 38% → 41% */
      clip-path: ellipse(38% 132% at 3% 100%);
    }
    .about-band__globe {
      /* sphere ≈ 0.81 × the box, so 14rem leaves ~180 px of globe on screen */
      inline-size: 14rem;
      left: -4rem;
      top: 41%;
    }
    .about-band__grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        'copy'
        'figs';
      gap: 1.2rem;
    }
    .af-copy {
      max-inline-size: none;
      /* inline-end is the left side in RTL: keep the text off the globe */
      padding-inline: var(--gutter) 9.4rem;
      text-align: start;
      justify-items: start;
    }
    .af-copy__title {
      font-size: 1.1rem;
      line-height: 1.55;
    }
    .af-copy__lead {
      font-size: 0.78rem;
      line-height: 1.8;
    }
    .af-copy__cta {
      font-size: 0.78rem;
      padding: 0.5rem 1rem;
    }
    .af-figs {
      grid-template-columns: 1fr;
      gap: 0.8rem;
      padding-inline: var(--gutter);
      padding-block: 1rem 1.4rem;
    }
    .af-fig {
      grid-template-columns: auto minmax(0, 1fr);
      justify-items: start;
      text-align: start;
      gap: 0.6rem;
    }
    .af-fig__value {
      justify-content: start;
    }
  }
</style>
