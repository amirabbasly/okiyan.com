---
/**
 * «درباره ما» + «مسیر ما در اعداد» in one split band.
 *
 * Layout matches the reference: the copy (or, in RTL, the panel that reads
 * first) sits on one side and the numbers stack on the other. In RTL the
 * numbers take the right column and the about-copy the left, exactly as asked.
 *
 * The figures are the same ones the site already publishes (Counters); nothing
 * new is claimed here. The single-line counters use the existing count-up
 * script, so the block reads correctly without JavaScript.
 */
import Icon from '~/components/ui/Icon.astro';
import { toFaNumber } from '~/lib/format';

export interface Figure {
  value: number;
  unit: string;
  /** Shown after the number, e.g. «+» for an approximate figure. */
  approx?: boolean;
  /** Small line under the unit. */
  note?: string;
}

export interface Props {
  title: string;
  lead: string;
  figures: Figure[];
  bullets: string[];
  href: string;
  cta: string;
  image: string;
  imageAlt: string;
}

const { title, lead, figures, bullets, href, cta, image, imageAlt } = Astro.props;
---

<section class="about-figures section" id="about-numbers" aria-labelledby="about-figures-title">
  <div class="container about-figures__grid">
    <!-- numbers: the right-hand column in RTL -->
    <div class="af-nums">
      <header class="af-nums__head">
        <span class="eyebrow">مسیر ما در اعداد</span>
        <h2 id="about-figures-title">مسیر ما، در اعداد</h2>
      </header>

      <dl class="af-nums__list">
        {
          figures.map((f) => (
            <div class="af-fig">
              <dt class="af-fig__unit">{f.unit}</dt>
              <dd class="af-fig__value">
                <span class="af-fig__num" data-count={f.value}>
                  {toFaNumber(f.value)}
                </span>
                {f.approx && <span class="af-fig__plus" aria-hidden="true">+</span>}
                {f.approx && <span class="sr-only">حدود</span>}
              </dd>
              {f.note && <p class="af-fig__note">{f.note}</p>}
            </div>
          ))
        }
      </dl>
    </div>

    <!-- about: the left-hand column in RTL -->
    <div class="af-about">
      <figure class="af-about__media">
        <picture>
          <source type="image/webp" srcset={`/img/${image}-800.webp 800w, /img/${image}-1600.webp 1600w`} sizes="(max-width: 940px) 100vw, 46vw" />
          <img src={`/img/${image}.jpg`} alt={imageAlt} width={1600} height={900} loading="lazy" decoding="async" />
        </picture>
        <figcaption class="af-about__badge">
          <Icon name="ship" />
          <span>از ۱۳۹۳ در مسیر واردات و ترخیص</span>
        </figcaption>
      </figure>

      <span class="eyebrow">درباره ما</span>
      <h3 class="af-about__title">{title}</h3>
      <p class="af-about__lead">{lead}</p>

      <ul class="af-about__list">
        {
          bullets.map((b) => (
            <li>
              <Icon name="check" />
              <span>{b}</span>
            </li>
          ))
        }
      </ul>

      <a class="btn" href={href}>
        {cta}
        <Icon name="arrow" class="btn__icon" />
      </a>
    </div>
  </div>
</section>

<script>
  import '~/scripts/counters';
</script>

<style>
  .about-figures {
    padding-block: clamp(2.75rem, 2rem + 3vw, 5rem);
    background:
      radial-gradient(46rem 24rem at 88% 0%, rgb(0 176 200 / 0.07), transparent 62%),
      var(--mist-50, #f4f6f7);
    border-block: 1px solid var(--rule);
  }
  .about-figures__grid {
    display: grid;
    /* RTL: first column is the right-hand side. Numbers right, about left. */
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    align-items: center;
  }

  /* ---------- numbers ---------- */
  .af-nums__head h2 {
    margin: 0.35rem 0 1.25rem;
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.4rem);
  }
  .af-nums__list {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }
  .af-fig {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.15rem 0.75rem;
    padding-block: clamp(0.9rem, 0.7rem + 0.6vw, 1.25rem);
    border-bottom: 1px solid var(--rule);
  }
  .af-fig__value {
    grid-column: 2;
    grid-row: 1 / span 2;
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.1rem;
    justify-self: end;
  }
  .af-fig__num {
    font-size: clamp(2rem, 1.4rem + 2.2vw, 2.85rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--navy-950);
    font-variant-numeric: tabular-nums;
  }
  .af-fig__plus {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--aqua-500);
  }
  .af-fig__unit {
    grid-column: 1;
    align-self: end;
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--navy-900);
  }
  .af-fig__note {
    grid-column: 1;
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--slate-600);
  }

  /* ---------- about ---------- */
  .af-about {
    display: grid;
    gap: 0.7rem;
    justify-items: start;
    padding: clamp(1.1rem, 0.9rem + 1vw, 1.75rem);
    border-radius: var(--radius-l);
    background: var(--white);
    border: 1px solid var(--rule);
    box-shadow: 0 30px 60px -46px rgb(13 26 44 / 0.35);
  }
  .af-about__media {
    position: relative;
    margin: 0 0 0.35rem;
    inline-size: 100%;
    border-radius: var(--radius-m);
    overflow: hidden;
    aspect-ratio: 16 / 8;
    background: var(--mist-100);
  }
  .af-about__media img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }
  .af-about__badge {
    position: absolute;
    inset-block-end: 0.6rem;
    inset-inline-start: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    background: rgb(13 26 44 / 0.78);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--white);
    font-size: 0.76rem;
    font-weight: 700;
  }
  .af-about__badge :global(svg) {
    inline-size: 0.95rem;
    block-size: 0.95rem;
    color: var(--aqua-300);
  }
  .af-about__title {
    margin: 0;
    font-size: clamp(1.3rem, 1.1rem + 1vw, 1.75rem);
    color: var(--navy-950);
  }
  .af-about__lead {
    margin: 0;
    line-height: 1.95;
    color: var(--slate-700);
    max-inline-size: 58ch;
  }
  .af-about__list {
    display: grid;
    gap: 0.4rem;
    margin: 0.2rem 0 0.4rem;
    padding: 0;
    list-style: none;
  }
  .af-about__list li {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--slate-700);
  }
  .af-about__list :global(svg) {
    flex: none;
    inline-size: 1.05rem;
    block-size: 1.05rem;
    margin-top: 0.3rem;
    color: var(--aqua-600);
  }

  @media (max-width: 940px) {
    .about-figures__grid {
      grid-template-columns: 1fr;
    }
    /* On one column the copy reads first and the numbers follow it. */
    .af-about {
      order: 1;
    }
    .af-nums {
      order: 2;
    }
  }
</style>
