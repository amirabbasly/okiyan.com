---
/**
 * «از بندر تا انبار، مسیر کالا روشن باشد» — built to the reference photo.
 *
 * The band itself is white; a navy crescent panel sits on the RTL-left and one
 * big arc is its right-hand edge. The brand globe scene (orbit rings, ship,
 * truck, plane) sits inside that panel and is cropped by it, its own night-sky
 * background melting into the panel sweep via a radial mask.
 *
 * Geometry, measured off the reference (share of the band's width):
 *   panel edge ~36% at the top, ~46% at mid, ~48% at the bottom
 *   globe      ~46% wide, flush with the left edge
 *   copy       49% → 78%
 *   divider    ~78%
 *   figures    79% → 96%
 *
 * Figures are the site's own verified numbers: ۲۰۰۰ محموله · ۵۰۰ میلیون یورو ·
 * ۱۵ سال سابقه (تأسیس ۱۳۹۳).
 */
import Icon from '~/components/ui/Icon.astro';
import { toFaNumber } from '~/lib/format';

export interface Figure {
  value: number;
  /** Renders a «+» in front of the number, as in the reference. */
  approx?: boolean;
  /** Unit that sits on the number line, e.g. «محموله» or «سال». */
  unit?: string;
  /** The short line under the number. */
  label: string;
  icon: 'cube' | 'briefcase' | 'award';
}

export interface Props {
  title: string;
  lead: string;
  figures: Figure[];
  href: string;
  cta: string;
}

const { title, lead, figures, href, cta } = Astro.props;

/**
 * One spoken sentence per figure, so «حدود» reaches screen readers without
 * sitting in the visible text, where it read as a stray word.
 */
const spoken = (f: Figure) =>
  `${f.approx ? 'حدود ' : ''}${toFaNumber(f.value)}${f.unit ? ' ' + f.unit : ''}، ${f.label}`;
---

<section class="about-band" id="about" aria-labelledby="about-title">
  <img class="about-band__photo" src="/img/globe-scene.webp" alt="" width="983" height="654" />

  <div class="about-band__panel">
    <div class="about-band__grid">
    <!-- figures — far right column, stacked -->
    <ul class="af-figs">
      {
        figures.map((f) => (
          <li class="af-fig">
            <span class="sr-only">{spoken(f)}</span>
            <span class="af-fig__icon" aria-hidden="true">
              <Icon name={f.icon} />
            </span>
            <span class="af-fig__body" aria-hidden="true">
              <span class="af-fig__value">
                {f.approx && <span class="af-fig__plus">+</span>}
                <span class="af-fig__num" data-count={f.value}>
                  {toFaNumber(f.value)}
                </span>
                {f.unit && <span class="af-fig__unit">{f.unit}</span>}
              </span>
              <span class="af-fig__label">{f.label}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <!-- copy — middle column -->
    <div class="af-copy">
      <span class="eyebrow">درباره ما</span>
      <h2 id="about-title" class="af-copy__title">{title}</h2>
      <p class="af-copy__lead">{lead}</p>
      <a class="btn btn--ghost af-copy__cta" href={href}>
        {cta}
        <Icon name="arrow" class="btn__icon" />
      </a>
        </div>
      </div>
    </div>
  </section>

<script>
  import '~/scripts/counters';
</script>

<style>
  .about-band {
    position: relative;
    isolation: isolate;
    /* layers: photo (0) → white arc panel (1) → content (2) */
    overflow: hidden;
    background: var(--navy-950);
    border-block: 1px solid var(--rule);
  }
  /* the brand scene fills the band edge to edge, from the left edge across */
  .about-band__photo {
    position: absolute;
    inset: 0;
    z-index: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* The white sheet lives in the RIGHT half only; its left edge is the same
     big arc as before (an ellipse centred below the band), now mirrored:
     ~50% of the width at the bottom, ~67% at the top. */
  .about-band__panel {
    position: absolute;
    inset-block: 0;
    right: 0;
    z-index: 1;
    inline-size: 57%;
    background: var(--white);
    clip-path: ellipse(34% 116% at 84% 100%);
    display: flex;
    align-items: center;
    padding-block: clamp(2.2rem, 4vw, 3.4rem);
  }

  .about-band__grid {
    position: relative;
    z-index: 2;
    display: grid;
    /* copy on the right, figures beside the arc; the end padding keeps every
       line clear of the curve */
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.2rem, 0.8rem + 2vw, 2.4rem);
    inline-size: 100%;
    padding-inline: clamp(1.5rem, 3vw, 3rem) clamp(3rem, 5.5vw, 5.5rem);
  }

  /* ---------- copy ---------- */
  .af-copy {
    grid-column: 1;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding-inline: 0.5rem 1.25rem;
    text-align: center;
  }
  .af-copy .eyebrow {
    color: var(--accent);
  }
  .af-copy .eyebrow::before {
    background: var(--aqua-500);
  }
  .af-copy__title {
    margin: 0;
    font-size: clamp(1.4rem, 1.12rem + 1.15vw, 1.95rem);
    font-weight: 800;
    color: var(--navy-900);
    letter-spacing: -0.01em;
    line-height: 1.4;
    text-wrap: balance;
  }
  .af-copy__lead {
    margin: 0;
    max-inline-size: 46ch;
    font-size: clamp(0.8rem, 0.76rem + 0.16vw, 0.88rem);
    line-height: 1.85;
    color: var(--slate-600);
  }
  .af-copy__cta {
    margin-top: 0.25rem;
    border-radius: 999px;
    border-color: var(--navy-900);
    color: var(--navy-900);
  }
  .af-copy__cta:hover {
    background: var(--navy-900);
    color: var(--white);
  }

  /* ---------- figures: vertical stack, far right ---------- */
  .af-figs {
    grid-column: 2;
    display: grid;
    gap: clamp(0.8rem, 0.6rem + 0.7vw, 1.25rem);
    margin: 0;
    padding: 0;
    /* the divider faces the copy (RTL: the figures' right edge) */
    padding-inline-start: clamp(1rem, 0.6rem + 1.4vw, 2rem);
    border-inline-start: 1px solid var(--rule);
    list-style: none;
  }
  .af-fig {
    display: grid;
    /* RTL: icon at the outer (right) edge, numbers to its left */
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.6rem;
  }
  .af-fig__icon {
    display: grid;
    place-items: center;
    inline-size: 2.1rem;
    block-size: 2.1rem;
    color: var(--accent);
  }
  .af-fig__icon :global(svg) {
    inline-size: 1.45rem;
    block-size: 1.45rem;
  }
  .af-fig__body {
    display: grid;
    gap: 0.02rem;
    min-inline-size: 0;
  }
  .af-fig__value {
    display: flex;
    align-items: baseline;
    gap: 0.12rem;
    color: var(--navy-950);
    white-space: nowrap;
  }
  .af-fig__num {
    font-size: clamp(1.2rem, 1rem + 0.7vw, 1.55rem);
    font-weight: 800;
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
  }
  .af-fig__plus {
    font-size: 1rem;
    font-weight: 800;
    color: var(--aqua-600);
  }
  .af-fig__unit {
    font-size: clamp(0.78rem, 0.72rem + 0.2vw, 0.9rem);
    font-weight: 700;
    color: var(--navy-800);
  }
  .af-fig__label {
    font-size: 0.74rem;
    line-height: 1.55;
    color: var(--slate-600);
  }

  /* ---------- tablet: one column inside the panel ---------- */
  @media (max-width: 1024px) {
    .about-band__panel {
      inline-size: 68%;
    }
    .about-band__grid {
      grid-template-columns: 1fr;
      gap: 1.4rem;
      padding-inline-end: clamp(2rem, 4vw, 3.5rem);
    }
    .af-copy {
      grid-column: 1;
      justify-items: start;
      text-align: start;
    }
    .af-figs {
      grid-column: 1;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      border-inline-start: 0;
      border-block-start: 1px solid var(--rule);
      padding-inline-start: 0;
      padding-block-start: 1.1rem;
    }
    .af-fig {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 0.35rem;
    }
    .af-fig__value {
      justify-content: center;
    }
  }

  /* ---------- phone: photo strip on top, sheet below ---------- */
  @media (max-width: 640px) {
    .about-band__photo {
      position: relative;
      block-size: 15rem;
    }
    .about-band__panel {
      position: static;
      inline-size: 100%;
      clip-path: none;
      padding-block: 2rem 2.25rem;
    }
    .about-band__grid {
      padding-inline: 1.25rem;
    }
    .af-copy__title {
      font-size: 1.1rem;
      line-height: 1.55;
    }
    .af-copy__lead {
      font-size: 0.78rem;
      line-height: 1.8;
    }
    .af-copy__cta {
      font-size: 0.78rem;
      padding: 0.5rem 1rem;
    }
    .af-figs {
      grid-template-columns: 1fr;
      gap: 0.8rem;
      padding-block-start: 1rem;
    }
    .af-fig {
      grid-template-columns: auto minmax(0, 1fr);
      justify-items: start;
      text-align: start;
      gap: 0.6rem;
    }
    .af-fig__value {
      justify-content: start;
    }
  }
</style>
