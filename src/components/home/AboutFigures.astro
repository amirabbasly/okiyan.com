---
/**
 * «درباره ما» — the reference's composition with the copy pulled to the left.
 *
 * Desktop, RTL:  [ figures, stacked · far right ]  [ copy · centre ]  [ globe · left, cropped ]
 * The whole block is deliberately NOT centred: the grid is capped and pushed
 * toward the inline-end (visually left), and the globe spills past the band's
 * left edge, so the composition leans left the way the reference does.
 *
 * Phones: copy and globe stay in one row — copy on the right, globe on the
 * left — and the figures follow underneath, each on its own line.
 *
 * Figures are the site's own verified numbers: ۲۰۰۰ محموله · ۵۰۰ میلیون یورو ·
 * ۱۵ سال سابقه (تأسیس ۱۳۹۳).
 */
import Icon from '~/components/ui/Icon.astro';
import GlobeArt from '~/components/home/GlobeArt.astro';
import { toFaNumber } from '~/lib/format';

export interface Figure {
  value: number;
  /** Renders a «+» in front of the number, as in the reference. */
  approx?: boolean;
  /** Unit that sits on the number line, e.g. «محموله» or «سال». */
  unit?: string;
  /** The short line under the number. */
  label: string;
  icon: 'cube' | 'briefcase' | 'award';
}

export interface Props {
  title: string;
  lead: string;
  figures: Figure[];
  href: string;
  cta: string;
}

const { title, lead, figures, href, cta } = Astro.props;

/**
 * One spoken sentence per figure, so «حدود» reaches screen readers without
 * sitting in the visible text, where it read as a stray word.
 */
const spoken = (f: Figure) =>
  `${f.approx ? 'حدود ' : ''}${toFaNumber(f.value)}${f.unit ? ' ' + f.unit : ''}، ${f.label}`;
---

<section class="about-band" id="about" aria-labelledby="about-title">
  <div class="container about-band__grid">
    <!-- figures — far right column, stacked -->
    <ul class="af-figs">
      {
        figures.map((f) => (
          <li class="af-fig">
            <span class="sr-only">{spoken(f)}</span>
            <span class="af-fig__icon" aria-hidden="true">
              <Icon name={f.icon} />
            </span>
            <span class="af-fig__body" aria-hidden="true">
              <span class="af-fig__value">
                {f.approx && <span class="af-fig__plus">+</span>}
                <span class="af-fig__num" data-count={f.value}>
                  {toFaNumber(f.value)}
                </span>
                {f.unit && <span class="af-fig__unit">{f.unit}</span>}
              </span>
              <span class="af-fig__label">{f.label}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <!-- copy — middle column -->
    <div class="af-copy">
      <span class="eyebrow">درباره ما</span>
      <h2 id="about-title" class="af-copy__title">{title}</h2>
      <p class="af-copy__lead">{lead}</p>
      <a class="btn btn--ghost af-copy__cta" href={href}>
        {cta}
        <Icon name="arrow" class="btn__icon" />
      </a>
    </div>

    <!-- globe — left column, animated and cropped by the band edge -->
    <div class="af-art" aria-hidden="true">
      <GlobeArt class="af-art__svg" />
    </div>
  </div>
</section>

<script>
  import '~/scripts/counters';
</script>

<style>
  .about-band {
    position: relative;
    isolation: isolate;
    padding-block: clamp(1.8rem, 1.3rem + 2.4vw, 3rem);
    color: var(--mist-100);
    background:
      radial-gradient(46rem 26rem at 8% 6%, rgb(0 176 200 / 0.16), transparent 62%),
      radial-gradient(38rem 26rem at 96% 96%, rgb(35 77 102 / 0.5), transparent 68%),
      linear-gradient(118deg, #0e2136 0%, #14304a 52%, #0f2a42 100%);
    overflow: hidden;
  }

  .about-band__grid {
    display: grid;
    /* RTL: figures · copy · globe */
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr) minmax(0, 1.28fr);
    gap: clamp(1rem, 0.6rem + 2.2vw, 2.5rem);
    align-items: center;
    /* the block leans left: capped width, pushed to the inline-end edge
       (inline-end is the visual left in RTL), so the empty space sits on the right */
    max-inline-size: 64rem;
    margin-inline-start: auto;
    margin-inline-end: 0;
  }

  /* ---------- figures: vertical stack, far right ---------- */
  .af-figs {
    display: grid;
    gap: clamp(0.8rem, 0.6rem + 0.7vw, 1.25rem);
    margin: 0;
    padding: 0;
    padding-inline-end: clamp(0.9rem, 0.5rem + 1.2vw, 1.5rem);
    border-inline-end: 1px solid rgb(143 180 201 / 0.22);
    list-style: none;
  }
  .af-fig {
    display: grid;
    /* RTL: icon at the outer (right) edge, numbers to its left */
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.6rem;
  }
  .af-fig__icon {
    display: grid;
    place-items: center;
    inline-size: 2.1rem;
    block-size: 2.1rem;
    color: var(--aqua-300);
  }
  .af-fig__icon :global(svg) {
    inline-size: 1.45rem;
    block-size: 1.45rem;
  }
  .af-fig__body {
    display: grid;
    gap: 0.02rem;
    min-inline-size: 0;
  }
  .af-fig__value {
    display: flex;
    align-items: baseline;
    gap: 0.12rem;
    color: var(--white);
    white-space: nowrap;
  }
  .af-fig__num {
    font-size: clamp(1.2rem, 1rem + 0.7vw, 1.55rem);
    font-weight: 800;
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
  }
  .af-fig__plus {
    font-size: 1rem;
    font-weight: 800;
    color: var(--aqua-300);
  }
  .af-fig__unit {
    font-size: clamp(0.78rem, 0.72rem + 0.2vw, 0.9rem);
    font-weight: 700;
    color: rgb(232 236 238 / 0.92);
  }
  .af-fig__label {
    font-size: 0.72rem;
    line-height: 1.55;
    color: rgb(232 236 238 / 0.66);
  }

  /* ---------- copy ---------- */
  .af-copy {
    display: grid;
    gap: 0.6rem;
    justify-items: center;
    text-align: center;
  }
  .af-copy .eyebrow {
    color: var(--aqua-300);
  }
  .af-copy .eyebrow::before {
    background: var(--aqua-500);
  }
  .af-copy__title {
    margin: 0;
    font-size: clamp(1.45rem, 1.15rem + 1.35vw, 2.1rem);
    font-weight: 800;
    color: var(--white);
    letter-spacing: -0.01em;
    line-height: 1.4;
    text-wrap: balance;
  }
  .af-copy__lead {
    margin: 0;
    max-inline-size: 42ch;
    font-size: clamp(0.82rem, 0.78rem + 0.18vw, 0.92rem);
    line-height: 1.95;
    color: rgb(232 236 238 / 0.78);
  }
  .af-copy__cta {
    margin-top: 0.25rem;
    border-radius: 999px;
    border-color: rgb(232 236 238 / 0.42);
    color: var(--white);
  }
  .af-copy__cta:hover {
    background: var(--white);
    color: var(--navy-950);
    border-color: var(--white);
  }

  /* ---------- globe ---------- */
  .af-art {
    position: relative;
    min-inline-size: 0;
    /* spill past the band's left edge so the sphere is cropped, as in the reference */
    margin-inline-end: clamp(-4rem, -3vw, -1rem);
  }
  .af-art__svg {
    display: block;
    inline-size: 118%;
    max-inline-size: none;
    block-size: auto;
    margin-inline-end: -18%;
    filter: drop-shadow(0 18px 42px rgb(0 176 200 / 0.22));
  }

  /* ---------- tablet: copy and globe keep their row, figures below ---------- */
  @media (max-width: 1024px) {
    .about-band__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.72fr);
      grid-template-areas:
        'copy art'
        'figs figs';
      gap: 1.1rem 1rem;
      max-inline-size: 46rem;
      /* centred again on narrow screens: there is no room to lean */
      margin-inline: auto;
      align-items: center;
    }
    .af-copy {
      grid-area: copy;
      justify-items: start;
      text-align: start;
    }
    .af-art {
      grid-area: art;
      margin-inline-end: clamp(-3rem, -4vw, -1rem);
    }
    .af-art__svg {
      inline-size: 132%;
      margin-inline-end: -32%;
    }
    .af-figs {
      grid-area: figs;
      grid-template-columns: 1fr;
      gap: 0.9rem;
      padding-inline-end: 0;
      padding-block-start: 1.1rem;
      border-inline-end: 0;
      border-block-start: 1px solid rgb(143 180 201 / 0.22);
    }
  }

  /* ---------- phone: same row, tighter ---------- */
  @media (max-width: 620px) {
    .about-band {
      padding-block: 1.4rem;
    }
    .about-band__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.62fr);
      gap: 0.75rem 0.5rem;
    }
    .af-copy__title {
      font-size: 1.18rem;
      line-height: 1.5;
    }
    .af-copy__lead {
      font-size: 0.78rem;
      line-height: 1.85;
    }
    .af-copy__cta {
      font-size: 0.78rem;
      padding: 0.5rem 0.9rem;
    }
    .af-art__svg {
      inline-size: 150%;
      margin-inline-end: -50%;
    }
    .af-fig {
      gap: 0.5rem;
    }
    .af-fig__num {
      font-size: 1.15rem;
    }
    .af-fig__label {
      font-size: 0.7rem;
    }
  }
</style>
