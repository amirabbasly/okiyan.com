---
/**
 * «از بندر تا انبار، مسیر کالا روشن باشد» — the responsive composition:
 *
 *   desktop  [ globe photo · left half, full-bleed with a half-circle arc on
 *              its right edge ] [ copy · centre of the page ] [ figures · right ]
 *   tablet   photo keeps the left column (arc unchanged), copy above figures
 *   phone    photo dome on top, copy centred, figures stacked
 *
 * The band's background is plain white; the photo carries the colour.
 * Figures are the site's own verified numbers.
 */
import Icon from '~/components/ui/Icon.astro';
import { toFaNumber } from '~/lib/format';

export interface Figure {
  value: number;
  /** Renders a «+» in front of the number, as in the reference. */
  approx?: boolean;
  /** Unit that sits on the number line, e.g. «محموله» or «سال». */
  unit?: string;
  /** The short line under the number. */
  label: string;
  icon: 'cube' | 'briefcase' | 'award';
}

export interface Props {
  title: string;
  lead: string;
  figures: Figure[];
  href: string;
  cta: string;
}

const { title, lead, figures, href, cta } = Astro.props;

/**
 * One spoken sentence per figure, so «حدود» reaches screen readers without
 * sitting in the visible text, where it read as a stray word.
 */
const spoken = (f: Figure) =>
  `${f.approx ? 'حدود ' : ''}${toFaNumber(f.value)}${f.unit ? ' ' + f.unit : ''}، ${f.label}`;
---

<section class="about-band" id="about" aria-labelledby="about-title">
  <div class="about-band__grid">
    <!-- globe — left, full to the band's edges, half-circle arc on its right -->
    <div class="af-photo" aria-hidden="true">
      <img class="af-photo__img" src="/img/globe-scene.webp" alt="" width="983" height="654" />
    </div>

    <!-- copy — centre of the page -->
    <div class="af-copy">
      <span class="eyebrow">درباره ما</span>
      <h2 id="about-title" class="af-copy__title">{title}</h2>
      <p class="af-copy__lead">{lead}</p>
      <a class="btn btn--ghost af-copy__cta" href={href}>
        {cta}
        <Icon name="arrow" class="btn__icon" />
      </a>
    </div>

    <!-- figures — right column, stacked -->
    <ul class="af-figs">
      {
        figures.map((f) => (
          <li class="af-fig">
            <span class="sr-only">{spoken(f)}</span>
            <span class="af-fig__icon" aria-hidden="true">
              <Icon name={f.icon} />
            </span>
            <span class="af-fig__body" aria-hidden="true">
              <span class="af-fig__value">
                {f.approx && <span class="af-fig__plus">+</span>}
                <span class="af-fig__num" data-count={f.value}>
                  {toFaNumber(f.value)}
                </span>
                {f.unit && <span class="af-fig__unit">{f.unit}</span>}
              </span>
              <span class="af-fig__label">{f.label}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import '~/scripts/counters';
</script>

<style>
  .about-band {
    background: var(--white);
    border-block: 1px solid var(--rule);
    overflow: hidden;
  }
  .about-band__grid {
    display: grid;
    /* RTL: the first area sits on the right — figures right, copy centre,
       photo left */
    grid-template-areas: 'figs copy photo';
    grid-template-columns: minmax(0, 0.66fr) minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: stretch;
  }

  /* ---------- photo: full left half, half-circle arc on its right ---------- */
  .af-photo {
    grid-area: photo;
    position: relative;
    min-block-size: clamp(20rem, 30vw, 29rem);
    overflow: hidden;
    /* left/top/bottom stay flush with the band; the right edge is one arc */
    border-radius: 0 clamp(3.5rem, 8vw, 9rem) clamp(3.5rem, 8vw, 9rem) 0 / 0 50% 50% 0;
  }
  .af-photo__img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* ---------- copy: centred in the middle of the page ---------- */
  .af-copy {
    grid-area: copy;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.55rem;
    text-align: center;
    padding: clamp(2.2rem, 4vw, 3.6rem) clamp(1.2rem, 2.5vw, 2.6rem);
  }
  .af-copy .eyebrow {
    color: var(--petrol-600);
  }
  .af-copy .eyebrow::before {
    background: var(--petrol-600);
  }
  .af-copy__title {
    margin: 0;
    font-size: clamp(1.4rem, 1.12rem + 1.15vw, 1.95rem);
    font-weight: 800;
    color: var(--navy-900);
    letter-spacing: -0.01em;
    line-height: 1.4;
    text-wrap: balance;
  }
  .af-copy__lead {
    margin: 0;
    max-inline-size: 46ch;
    font-size: clamp(0.82rem, 0.78rem + 0.16vw, 0.92rem);
    line-height: 1.9;
    color: var(--slate-600);
  }
  .af-copy__cta {
    margin-top: 0.35rem;
    border-radius: 999px;
    border-color: var(--navy-800);
    color: var(--navy-800);
  }
  .af-copy__cta:hover {
    background: var(--navy-800);
    color: var(--white);
  }

  /* ---------- figures: stacked on the right ---------- */
  .af-figs {
    grid-area: figs;
    display: grid;
    align-content: center;
    gap: clamp(0.9rem, 0.7rem + 0.8vw, 1.4rem);
    margin: 0;
    padding: clamp(2.2rem, 4vw, 3.6rem) clamp(1.5rem, 3vw, 3rem);
    /* the divider faces the copy (the figures' left edge in RTL) */
    border-inline-end: 1px solid var(--rule);
    list-style: none;
  }
  .af-fig {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.7rem;
  }
  .af-fig__icon {
    display: grid;
    place-items: center;
    inline-size: 2.2rem;
    block-size: 2.2rem;
    border-radius: 0.7rem;
    background: var(--mist-100, #e9eef8);
    color: var(--petrol-600);
  }
  .af-fig__icon :global(svg) {
    inline-size: 1.4rem;
    block-size: 1.4rem;
  }
  .af-fig__body {
    display: grid;
    gap: 0.02rem;
    min-inline-size: 0;
  }
  .af-fig__value {
    display: flex;
    align-items: baseline;
    gap: 0.12rem;
    color: var(--navy-950);
    white-space: nowrap;
  }
  .af-fig__num {
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.6rem);
    font-weight: 800;
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
  }
  .af-fig__plus {
    font-size: 1rem;
    font-weight: 800;
    color: var(--petrol-600);
  }
  .af-fig__unit {
    font-size: clamp(0.78rem, 0.72rem + 0.2vw, 0.9rem);
    font-weight: 700;
    color: var(--navy-800);
  }
  .af-fig__label {
    font-size: 0.76rem;
    line-height: 1.6;
    color: var(--slate-600);
  }

  /* ---------- tablet: photo keeps the left, copy above figures ---------- */
  @media (max-width: 1024px) {
    .about-band__grid {
      grid-template-areas:
        'copy photo'
        'figs photo';
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
    }
    .af-photo {
      min-block-size: 100%;
    }
    .af-copy {
      justify-items: start;
      text-align: start;
      padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 3rem) 1.2rem;
    }
    .af-figs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-content: start;
      border-inline-end: 0;
      border-block-start: 1px solid var(--rule);
      margin-inline: clamp(1.5rem, 3vw, 3rem);
      padding: 1.2rem 0 clamp(2rem, 4vw, 3rem);
    }
    .af-fig {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 0.4rem;
    }
    .af-fig__value {
      justify-content: center;
    }
  }

  /* ---------- phone: dome on top, copy centred, figures stacked ---------- */
  @media (max-width: 640px) {
    .about-band__grid {
      grid-template-areas:
        'photo'
        'copy'
        'figs';
      grid-template-columns: minmax(0, 1fr);
    }
    .af-photo {
      min-block-size: 15rem;
      /* the arc moves to the bottom edge: a dome over the copy */
      border-radius: 0 0 50% 50% / 0 0 999px 999px;
    }
    .af-copy {
      justify-items: center;
      text-align: center;
      padding: 1.6rem 1.25rem 1.4rem;
    }
    .af-copy__title {
      font-size: 1.16rem;
      line-height: 1.55;
    }
    .af-copy__lead {
      font-size: 0.8rem;
      line-height: 1.85;
    }
    .af-copy__cta {
      font-size: 0.78rem;
      padding: 0.5rem 1rem;
    }
    .af-figs {
      grid-template-columns: 1fr;
      gap: 0.8rem;
      margin-inline: 1.25rem;
      padding: 1.1rem 0 1.8rem;
    }
    .af-fig {
      grid-template-columns: auto minmax(0, 1fr);
      justify-items: start;
      text-align: start;
      gap: 0.6rem;
    }
    .af-fig__value {
      justify-content: start;
    }
  }
</style>
