---
/**
 * «درباره ما» — structure follows the reference:
 *
 *   [ dotted globe, bleeding to the band's left edge ]  «درباره ما» + «اوکیان»
 *                                                       + lead + «اطلاعات بیشتر»
 *                                        | + figures column at the far right
 *
 * Reading order in RTL is figures → copy → globe, matching the reference exactly.
 * The figures are the ones the site already publishes (۲۰۰۰ محموله، ۵۰۰ میلیون
 * یورو، ۱۵ سال سابقه) — the reference's own numbers are not copied.
 *
 * The globe is a rendered dotted-Earth illustration; its black field is blended
 * with `mix-blend-mode: screen`, so only the lit dots land on the navy band.
 */
import Icon from '~/components/ui/Icon.astro';
import { toFaNumber } from '~/lib/format';

export interface Figure {
  value: number;
  /** Renders a «+» in front of the number, as in the reference. */
  approx?: boolean;
  /** Unit that sits on the number line, e.g. «محموله» or «سال». */
  unit?: string;
  /** The short line under the number. */
  label: string;
  icon: 'cube' | 'briefcase' | 'award';
}

export interface Props {
  title: string;
  lead: string;
  figures: Figure[];
  href: string;
  cta: string;
}

const { title, lead, figures, href, cta } = Astro.props;
---

<section class="about-band" id="about" aria-labelledby="about-title">
  <div class="about-band__globe" aria-hidden="true">
    <img
      src="/img/globe-dots-1408.webp"
      srcset="/img/globe-dots-960.webp 960w, /img/globe-dots-1408.webp 1408w"
      sizes="(max-width: 1024px) 100vw, 48vw"
      width="1408"
      height="768"
      alt=""
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="container about-band__grid">
    <!-- figures — right column in RTL -->
    <ul class="stats">
      {
        figures.map((f) => (
          <li class="stat">
            <span class="stat__icon" aria-hidden="true">
              <Icon name={f.icon} />
            </span>
            <span class="stat__body">
              <span class="stat__value">
                {f.approx && <span class="stat__plus" aria-hidden="true">+</span>}
                <span class="stat__num" data-count={f.value}>
                  {toFaNumber(f.value)}
                </span>
                {f.unit && <span class="stat__unit">{f.unit}</span>}
                {f.approx && <span class="sr-only">حدود</span>}
              </span>
              <span class="stat__label">{f.label}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <!-- copy — middle column in RTL -->
    <div class="about-copy">
      <span class="eyebrow">درباره ما</span>
      <h2 id="about-title" class="about-copy__title">{title}</h2>
      <p class="about-copy__lead">{lead}</p>
      <a class="btn btn--ghost about-copy__cta" href={href}>
        {cta}
        <Icon name="arrow" class="btn__icon" />
      </a>
    </div>

    <!-- reserved for the globe behind the band; the illustration itself is a layer -->
    <div class="about-band__space" aria-hidden="true"></div>
  </div>
</section>

<script>
  import '~/scripts/counters';
</script>

<style>
  .about-band {
    position: relative;
    isolation: isolate;
    padding-block: clamp(2rem, 1.4rem + 3vw, 3.6rem);
    color: var(--mist-100);
    background:
      radial-gradient(55rem 28rem at 78% 0%, rgb(0 176 200 / 0.16), transparent 62%),
      radial-gradient(45rem 30rem at 96% 100%, rgb(35 77 102 / 0.5), transparent 68%),
      linear-gradient(120deg, #0e2136 0%, #14304a 52%, #0f2a42 100%);
    overflow: hidden;
  }
  /* the dotted globe: pinned to the band's left edge, oversized so it bleeds off
     the top and left like the reference, then faded into the navy */
  .about-band__globe {
    position: absolute;
    inset-block: 0;
    left: 0;
    inline-size: min(48%, 40rem);
    overflow: hidden;
    mask-image: linear-gradient(to right, #000 30%, transparent 84%);
    -webkit-mask-image: linear-gradient(to right, #000 30%, transparent 84%);
    pointer-events: none;
    z-index: -1;
  }
  .about-band__globe img {
    position: absolute;
    left: min(-14%, -2.5rem);
    top: -12%;
    inline-size: auto;
    max-inline-size: none;
    block-size: 155%;
    mix-blend-mode: screen;
    opacity: 0.95;
  }

  .about-band__grid {
    position: relative;
    display: grid;
    /* RTL: stats right, copy middle, (globe occupies the left edge behind) */
    grid-template-columns: auto minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(1.25rem, 1rem + 2.6vw, 3.25rem);
    align-items: center;
  }

  /* ---------- figures ---------- */
  .stats {
    display: grid;
    gap: clamp(0.9rem, 0.7rem + 0.6vw, 1.35rem);
    margin: 0;
    padding: 0;
    /* the hairline sits between the copy and the figures, as in the reference */
    padding-inline-end: clamp(0.9rem, 0.5rem + 1.4vw, 1.6rem);
    border-inline-end: 1px solid rgb(143 180 201 / 0.22);
    list-style: none;
  }
  .stat {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .stat__icon {
    display: grid;
    place-items: center;
    flex: none;
    order: 2; /* icon sits at the outer edge, like the reference */
    inline-size: 2.3rem;
    block-size: 2.3rem;
    color: var(--aqua-300);
  }
  .stat__icon :global(svg) {
    inline-size: 1.5rem;
    block-size: 1.5rem;
  }
  .stat__body {
    display: grid;
    gap: 0.02rem;
  }
  .stat__value {
    display: flex;
    align-items: baseline;
    gap: 0.05rem;
    color: var(--white);
  }
  .stat__num {
    font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.6rem);
    font-weight: 800;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }
  .stat__plus {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--aqua-300);
  }
  .stat__unit {
    font-size: clamp(0.82rem, 0.76rem + 0.25vw, 0.95rem);
    font-weight: 700;
    color: rgb(232 236 238 / 0.9);
  }
  .stat__label {
    font-size: 0.74rem;
    line-height: 1.6;
    color: rgb(232 236 238 / 0.7);
  }

  /* ---------- copy ---------- */
  .about-copy {
    display: grid;
    gap: 0.7rem;
    justify-items: center;
    text-align: center;
    padding-block: 0.5rem;
  }
  .about-copy .eyebrow {
    color: var(--aqua-300);
  }
  .about-copy .eyebrow::before {
    background: var(--aqua-500);
  }
  .about-copy__title {
    margin: 0;
    font-size: clamp(1.55rem, 1.2rem + 1.6vw, 2.35rem);
    font-weight: 800;
    color: var(--white);
    letter-spacing: -0.01em;
  }
  .about-copy__lead {
    margin: 0;
    max-inline-size: 46ch;
    font-size: clamp(0.85rem, 0.8rem + 0.22vw, 0.95rem);
    line-height: 2;
    color: rgb(232 236 238 / 0.8);
  }
  .about-copy__cta {
    margin-top: 0.3rem;
    border-radius: 999px;
    border-color: rgb(232 236 238 / 0.4);
    color: var(--white);
  }
  .about-copy__cta:hover {
    background: var(--white);
    color: var(--navy-950);
    border-color: var(--white);
  }

  @media (max-width: 1024px) {
    .about-band__grid {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 1.5rem;
    }
    .about-band__space {
      display: none;
    }
    .stats {
      order: 2;
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
      justify-items: center;
      inline-size: 100%;
      max-inline-size: 34rem;
      gap: 1rem;
      padding-inline-end: 0;
      padding-block-start: 1.25rem;
      border-inline-end: 0;
      border-block-start: 1px solid rgb(143 180 201 / 0.22);
    }
    .about-copy {
      order: 1;
    }
    .about-band__space {
      display: none;
    }
    .about-band__globe {
      inline-size: 100%;
      opacity: 0.3;
      -webkit-mask-image: linear-gradient(to right, #000 0%, transparent 100%);
      mask-image: linear-gradient(to right, #000 0%, transparent 100%);
    }
  }

  @media (max-width: 560px) {
    .stats {
      grid-template-columns: 1fr;
      max-inline-size: 18rem;
    }
    .stat {
      justify-content: center;
    }
    .stat__body {
      text-align: start;
    }
  }
</style>
