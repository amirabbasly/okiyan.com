---
/**
 * «حوزه‌های فعالیت» — the reference's quick index, but with photographs.
 *
 * Layout follows the reference: the heading sits at the reading-start edge with
 * a short aqua rule, then five flat cards in a row (five columns on desktop,
 * one column of pairs on phones). Each card is a photo on top and the family
 * name underneath, so the band still reads as an index at a glance while
 * showing what the goods actually look like.
 *
 * Order matches the reference, right to left: consumer goods · chemicals ·
 * agri-food · parts & equipment · industrial raw materials.
 */
export interface Category {
  title: string;
  /** Base name under /img, e.g. `cat-consumer` (480/960 webp + jpg exist). */
  image: string;
  alt: string;
  href: string;
}

export interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
---

<section class="cats" id="categories" aria-labelledby="cats-title">
  <div class="container">
    <h2 id="cats-title" class="cats__title">
      <span class="cats__rule" aria-hidden="true"></span>
      حوزه‌های فعالیت
    </h2>

    <ul class="cats__grid">
      {
        categories.map((c) => (
          <li class="cat">
            <a class="cat__link" href={c.href}>
              <span class="cat__media">
                <img
                  src={`/img/${c.image}-480.webp`}
                  srcset={`/img/${c.image}-480.webp 480w, /img/${c.image}-960.webp 960w`}
                  sizes="(max-width: 700px) 45vw, (max-width: 1100px) 30vw, 17vw"
                  alt={c.alt}
                  width="480"
                  height="358"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="cat__title">{c.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cats {
    background: var(--mist-50);
    border-block-end: 1px solid var(--rule);
  }
  .cats .container {
    padding-block: clamp(1.4rem, 1.1rem + 1.1vw, 2.1rem);
  }
  .cats__title {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    margin: 0 0 clamp(0.9rem, 0.7rem + 0.7vw, 1.35rem);
    font-size: clamp(1.05rem, 0.94rem + 0.5vw, 1.3rem);
    font-weight: 800;
    color: var(--navy-950);
  }
  .cats__rule {
    inline-size: 2.1rem;
    block-size: 3px;
    border-radius: 2px;
    background: var(--aqua-500);
  }

  .cats__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.5rem, 1vw, 0.9rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cat {
    min-inline-size: 0;
  }
  .cat__link {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--white);
    overflow: hidden;
    text-decoration: none;
    color: var(--navy-900);
    transition:
      border-color var(--dur-med, 220ms) ease,
      box-shadow var(--dur-med, 220ms) ease,
      transform var(--dur-med, 220ms) var(--ease-out, ease),
      color var(--dur-med, 220ms) ease;
  }
  .cat__link:hover {
    border-color: var(--aqua-300);
    color: var(--aqua-600);
    box-shadow: 0 18px 34px -26px rgb(13 26 44 / 0.55);
    transform: translateY(-2px);
  }
  .cat__media {
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--mist-100, #e8ecee);
    overflow: hidden;
  }
  .cat__media img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-out, ease);
  }
  .cat__link:hover .cat__media img {
    transform: scale(1.045);
  }
  .cat__title {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    padding: 0.65rem 0.55rem 0.75rem;
    font-size: clamp(0.76rem, 0.71rem + 0.16vw, 0.86rem);
    font-weight: 700;
    line-height: 1.55;
    text-align: center;
    text-wrap: balance;
  }

  @media (max-width: 1024px) {
    .cats__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .cats__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* five cards over two columns: the fifth takes the full row rather than
       leaving a hole beside it */
    .cat:last-child {
      grid-column: 1 / -1;
    }
    .cat:last-child .cat__media {
      aspect-ratio: 16 / 9;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cat__link,
    .cat__media img {
      transition: none;
    }
  }
</style>
