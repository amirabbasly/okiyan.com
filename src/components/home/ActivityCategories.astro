---
/**
 * «حوزه‌های فعالیت» — five cargo families, laid out like the reference:
 * a heading on the right, five flat white cards in a row, each with a drawn
 * icon above its label. No photographs here: the reference reads as a quick
 * index, and photos turned it into a gallery that competed with the hero.
 *
 * Icons are purpose-drawn for these five families (not a generic icon pack):
 * stacked coils for raw materials, a gear for parts, a flask for chemicals,
 * a leaf for agri-food, a carton for consumer goods.
 */
import Icon from '~/components/ui/Icon.astro';

export interface Category {
  title: string;
  /** Icon name from Icon.astro. */
  icon: 'coils' | 'gear' | 'flask' | 'leaf' | 'carton';
  href: string;
}

export interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
---

<section class="cats" id="categories" aria-labelledby="cats-title">
  <div class="container cats__inner">
    <h2 id="cats-title" class="cats__title">
      <span class="cats__rule" aria-hidden="true"></span>
      حوزه‌های فعالیت
    </h2>

    <ul class="cats__grid">
      {
        categories.map((c) => (
          <li class="cat">
            <a class="cat__link" href={c.href}>
              <span class="cat__icon" aria-hidden="true">
                <Icon name={c.icon} />
              </span>
              <span class="cat__title">{c.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cats {
    /* icon blue sampled from the reference board: a deep azure, not the site aqua */
    --cat-icon: #0b4a7d;
    background: var(--mist-50);
    border-block: 1px solid var(--rule);
  }
  .cats__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(1rem, 2vw, 2.25rem);
    padding-block: clamp(1.1rem, 0.9rem + 0.8vw, 1.7rem);
  }
  /* Heading sits at the reading-start edge, separated by a short aqua rule. */
  .cats__title {
    display: grid;
    justify-items: start;
    gap: 0.45rem;
    margin: 0;
    font-size: clamp(1rem, 0.92rem + 0.4vw, 1.2rem);
    font-weight: 800;
    white-space: nowrap;
    color: var(--navy-950);
  }
  .cats__rule {
    inline-size: 2.1rem;
    block-size: 3px;
    border-radius: 2px;
    background: var(--aqua-500);
  }

  .cats__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.5rem, 1vw, 0.9rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cat {
    min-inline-size: 0;
  }
  .cat__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    block-size: 100%;
    padding: 0.85rem 0.7rem 0.95rem;
    text-align: center;
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--white);
    text-decoration: none;
    color: var(--navy-900);
    transition:
      border-color var(--dur-med, 220ms) ease,
      box-shadow var(--dur-med, 220ms) ease,
      transform var(--dur-med, 220ms) var(--ease-out, ease),
      color var(--dur-med, 220ms) ease;
  }
  .cat__link:hover {
    border-color: var(--aqua-300);
    color: var(--aqua-600);
    box-shadow: 0 14px 30px -24px rgb(13 26 44 / 0.5);
    transform: translateY(-2px);
  }
  .cat__icon {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2.1rem;
    block-size: 2.1rem;
    color: var(--cat-icon);
  }
  .cat__icon :global(svg) {
    inline-size: 1.65rem;
    block-size: 1.65rem;
  }
  .cat__title {
    font-size: clamp(0.78rem, 0.72rem + 0.18vw, 0.88rem);
    font-weight: 700;
    line-height: 1.5;
    text-wrap: balance;
  }

  @media (max-width: 1100px) {
    .cats__inner {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
    .cats__grid {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    }
  }
  @media (max-width: 560px) {
    .cats__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cat__link {
      transition: none;
    }
  }
</style>
