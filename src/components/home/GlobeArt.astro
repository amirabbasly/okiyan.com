---
/**
 * The dotted globe of the «درباره ما» band — real continents, not latitude rings.
 *
 * The point set is real geography: `src/data/globe-points.json` holds ~4700
 * uniform points (Fibonacci lattice) filtered through a Natural Earth land mask,
 * built by `scripts/generate-globe-points.mjs`. Both the server render and the
 * client canvas decode the same file, so what you see before and after the
 * animation starts is the same world.
 *
 * Server: a complete SVG globe with trade lanes and nodes, so the band reads
 * correctly with no JavaScript at all.
 * Client: a canvas takes over — it rotates the sphere, sizes and fades each dot
 * by depth, and runs the lanes. It only swaps in once it has painted its first
 * frame, and it leaves the SVG alone under `prefers-reduced-motion`.
 */
import pointsJson from '~/data/globe-points.json';

export interface Props {
  class?: string;
  /** Initial rotation, in degrees. */
  rotate?: number;
  /** Seconds for one full turn. */
  period?: number;
}

const { class: className, rotate = 16, period = 70 } = Astro.props;

/** The globe's own coordinate system: a 640×640 box with a 260 radius. */
const CX = 320;
const CY = 320;
const R = 260;

/**
 * Trade routes, as cubic beziers in the globe's own coordinates. The canvas
 * redraws these every frame, so the animated arcs and the static fallback
 * always show the same lanes.
 */
const routes = [
  { start: [120, 306], c1: [170, 214], c2: [300, 150], end: [452, 176], dur: 9 },
  { start: [138, 214], c1: [190, 292], c2: [330, 340], end: [470, 300], dur: 12 },
  { start: [96, 268], c1: [170, 250], c2: [330, 236], end: [486, 250], dur: 15 },
  { start: [60, 380], c1: [210, 330], c2: [470, 300], end: [618, 232], dur: 18 },
].map((r) => ({
  ...r,
  d: `M${r.start[0]} ${r.start[1]}C${r.c1[0]} ${r.c1[1]} ${r.c2[0]} ${r.c2[1]} ${r.end[0]} ${r.end[1]}`,
}));

/**
 * The static dots, baked into one path: a zero-length horizontal segment with a
 * round cap paints as a dot, so ~4700 points cost one element instead of 4700.
 */
const decode = () => {
  const bytes = Buffer.from(pointsJson.data, 'base64');
  const out = [];
  for (let i = 0; i < bytes.length; i += 2) {
    out.push({
      lon: (bytes[i] / 255) * 360 - 180,
      lat: (bytes[i + 1] / 255) * 180 - 90,
    });
  }
  return out;
};

const rad = (deg: number) => (deg * Math.PI) / 180;
const spin = rad(rotate);
const dotPath = decode()
  .map((p) => {
    const la = rad(p.lat);
    const lo = rad(p.lon) - spin;
    const z = Math.cos(la) * Math.cos(lo);
    if (z <= 0.06) return '';
    const x = CX + R * Math.cos(la) * Math.sin(lo);
    const y = CY - R * Math.sin(la);
    return `M${x.toFixed(1)} ${y.toFixed(1)}h.01`;
  })
  .join('');
---

<div class:list={['globe', className]} data-rotate={rotate} data-period={period}>
  <svg class="globe__svg" viewBox={`0 0 ${CX * 2} ${CY * 2}`} role="presentation" focusable="false">
    <defs>
      <radialGradient id="gl-halo" cx="50%" cy="50%" r="50%">
        <stop offset="0.62" stop-color="#2f8fd8" stop-opacity="0.28"></stop>
        <stop offset="0.86" stop-color="#2f8fd8" stop-opacity="0.1"></stop>
        <stop offset="1" stop-color="#2f8fd8" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="gl-core" cx="42%" cy="36%" r="66%">
        <stop offset="0" stop-color="#145696" stop-opacity="0.55"></stop>
        <stop offset="0.62" stop-color="#082a56" stop-opacity="0.6"></stop>
        <stop offset="1" stop-color="#030e1e" stop-opacity="0.5"></stop>
      </radialGradient>
      <radialGradient id="gl-limb" cx="50%" cy="50%" r="50%">
        <stop offset="0.84" stop-color="#0b3a6b" stop-opacity="0"></stop>
        <stop offset="0.965" stop-color="#1f6ea8" stop-opacity="0.55"></stop>
        <stop offset="1" stop-color="#56b7ea" stop-opacity="0.85"></stop>
      </radialGradient>
      <clipPath id="gl-clip">
        <circle cx={CX} cy={CY} r={R}></circle>
      </clipPath>
    </defs>

    <circle class="globe__halo" cx={CX} cy={CY} r={R * 1.34} fill="url(#gl-halo)"></circle>
    <circle class="globe__body" cx={CX} cy={CY} r={R} fill="url(#gl-core)"></circle>
    <g clip-path="url(#gl-clip)">
      <path class="globe__dots" d={dotPath} fill="none" stroke="#e2fbff" stroke-width="1.7" stroke-linecap="round"></path>
      <circle class="globe__limb" cx={CX} cy={CY} r={R} fill="url(#gl-limb)"></circle>
    </g>
    <g clip-path="url(#gl-clip)" class="globe__routes" stroke="#9beeff" stroke-width="1.8" stroke-linecap="round" stroke-opacity="0.75">
      {routes.map((r) => <path class="globe__route" d={r.d} fill="none" stroke-dasharray="7 12"></path>)}
    </g>
    <g clip-path="url(#gl-clip)" class="globe__nodes" fill="#ffffff">
      {routes.flatMap((r) =>
        [r.start, r.end].map(([x, y]) => <circle cx={x} cy={y} r="2.2"></circle>)
      )}
    </g>
    <circle class="globe__edge" cx={CX} cy={CY} r={R} fill="none" stroke="#8fd8f5" stroke-opacity="0.32"></circle>
  </svg>

  <canvas class="globe__canvas" width={CX * 2} height={CY * 2} aria-hidden="true"></canvas>
</div>

<script>
  import pointsJson from '~/data/globe-points.json';

  /** Same lanes as the server-rendered fallback (viewBox coordinates). */
  const routes = [
    { start: [120, 306], c1: [170, 214], c2: [300, 150], end: [452, 176], dur: 9,
      d: 'M120 306C170 214 300 150 452 176' },
    { start: [138, 214], c1: [190, 292], c2: [330, 340], end: [470, 300], dur: 12,
      d: 'M138 214C190 292 330 340 470 300' },
    { start: [96, 268], c1: [170, 250], c2: [330, 236], end: [486, 250], dur: 15,
      d: 'M96 268C170 250 330 236 486 250' },
    { start: [60, 380], c1: [210, 330], c2: [470, 300], end: [618, 232], dur: 18,
      d: 'M60 380C210 330 470 300 618 232' },
  ];

  const CX = 320;
  const CY = 320;
  const R = 260;

  const decode = () => {
    const bin = atob(pointsJson.data);
    const pts: Array<{ lat: number; lon: number }> = [];
    for (let i = 0; i < bin.length; i += 2) {
      pts.push({
        lon: (bin.charCodeAt(i) / 255) * 360 - 180,
        lat: (bin.charCodeAt(i + 1) / 255) * 180 - 90,
      });
    }
    return pts;
  };

  const boot = (root: HTMLElement) => {
    const canvas = root.querySelector<HTMLCanvasElement>('.globe__canvas');
    const ctx = canvas?.getContext('2d');
    if (!canvas || !ctx) return;

    const points = decode();
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const period = Number(root.dataset.period) || 70;
    const start = Number(root.dataset.rotate) || 16;
    let raf = 0;
    let t0 = 0;
    let visible = false;

    /** One frame of the sphere at rotation `rot` (degrees). */
    const draw = (rotDeg: number, now: number) => {
      const rot = (rotDeg * Math.PI) / 180;
      ctx.clearRect(0, 0, CX * 2, CY * 2);

      // halo
      const halo = ctx.createRadialGradient(CX, CY, R * 0.86, CX, CY, R * 1.34);
      halo.addColorStop(0, 'rgba(47,143,216,0.26)');
      halo.addColorStop(0.55, 'rgba(47,143,216,0.1)');
      halo.addColorStop(1, 'rgba(47,143,216,0)');
      ctx.fillStyle = halo;
      ctx.beginPath();
      ctx.arc(CX, CY, R * 1.34, 0, Math.PI * 2);
      ctx.fill();

      // body
      const core = ctx.createRadialGradient(CX - R * 0.16, CY - R * 0.28, R * 0.1, CX, CY, R);
      core.addColorStop(0, 'rgba(20,86,150,0.55)');
      core.addColorStop(0.62, 'rgba(8,42,86,0.6)');
      core.addColorStop(1, 'rgba(3,14,30,0.5)');
      ctx.fillStyle = core;
      ctx.beginPath();
      ctx.arc(CX, CY, R, 0, Math.PI * 2);
      ctx.fill();

      // everything below stays inside the sphere
      ctx.save();
      ctx.beginPath();
      ctx.arc(CX, CY, R, 0, Math.PI * 2);
      ctx.clip();

      // dots: a soft halo per point gives the glow, a crisp core keeps the
      // coastlines readable
      for (const p of points) {
        const la = (p.lat * Math.PI) / 180;
        const lo = (p.lon * Math.PI) / 180 - rot;
        const z = Math.cos(la) * Math.cos(lo);
        if (z <= 0.06) continue;
        const x = CX + R * Math.cos(la) * Math.sin(lo);
        const y = CY - R * Math.sin(la);
        const s = 0.85 + z * 1.05;
        ctx.globalAlpha = 0.1 + z * 0.24;
        ctx.fillStyle = '#7fe6fb';
        ctx.beginPath();
        ctx.arc(x, y, s * 1.35, 0, Math.PI * 2);
        ctx.fill();
        ctx.globalAlpha = 0.55 + z * 0.45;
        ctx.fillStyle = '#eafdff';
        ctx.beginPath();
        ctx.arc(x, y, s * 0.55, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;

      // trade routes: dashed lanes that travel, clipped to the sphere, with a
      // node running each one
      const secs = (now - t0) / 1000;
      for (const [i, r] of routes.entries()) {
        const path = new Path2D(r.d);
        ctx.save();
        ctx.strokeStyle = 'rgba(190,244,255,0.85)';
        ctx.lineWidth = 1.9;
        ctx.lineCap = 'round';
        ctx.setLineDash([7, 12]);
        ctx.lineDashOffset = -((secs * 26) % 19) * (i === 1 ? -1 : 1);
        ctx.shadowColor = 'rgba(120,230,255,0.9)';
        ctx.shadowBlur = 8;
        ctx.stroke(path);
        ctx.restore();

        const t = (secs / r.dur) % 1;
        const mt = 1 - t;
        const nx =
          mt * mt * mt * r.start[0] + 3 * mt * mt * t * r.c1[0] + 3 * mt * t * t * r.c2[0] + t * t * t * r.end[0];
        const ny =
          mt * mt * mt * r.start[1] + 3 * mt * mt * t * r.c1[1] + 3 * mt * t * t * r.c2[1] + t * t * t * r.end[1];
        const g = ctx.createRadialGradient(nx, ny, 0, nx, ny, 9);
        g.addColorStop(0, 'rgba(255,255,255,0.95)');
        g.addColorStop(0.35, 'rgba(150,240,255,0.55)');
        g.addColorStop(1, 'rgba(120,230,255,0)');
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(nx, ny, 9, 0, Math.PI * 2);
        ctx.fill();
      }

      // fixed nodes at the route ends, each with the same soft bloom
      for (const r of routes) {
        for (const [x, y] of [r.start, r.end]) {
          const ng = ctx.createRadialGradient(x, y, 0, x, y, 7);
          ng.addColorStop(0, 'rgba(255,255,255,0.95)');
          ng.addColorStop(0.4, 'rgba(150,240,255,0.5)');
          ng.addColorStop(1, 'rgba(120,230,255,0)');
          ctx.fillStyle = ng;
          ctx.beginPath();
          ctx.arc(x, y, 7, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = 'rgba(255,255,255,0.98)';
          ctx.beginPath();
          ctx.arc(x, y, 1.9, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // limb light
      const limb = ctx.createRadialGradient(CX, CY, R * 0.84, CX, CY, R);
      limb.addColorStop(0, 'rgba(11,58,107,0)');
      limb.addColorStop(0.72, 'rgba(31,110,168,0.55)');
      limb.addColorStop(1, 'rgba(86,183,234,0.85)');
      ctx.fillStyle = limb;
      ctx.beginPath();
      ctx.arc(CX, CY, R, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    };

    const frame = (timestamp: number) => {
      if (!t0) t0 = timestamp;
      const elapsed = (timestamp - t0) / 1000;
      draw(start + (elapsed * 360) / period, timestamp);
      raf = requestAnimationFrame(frame);
    };

    const play = () => {
      if (raf || reduce.matches) return;
      raf = requestAnimationFrame(frame);
    };
    const pause = () => {
      cancelAnimationFrame(raf);
      raf = 0;
      t0 = 0;
    };

    // paint one frame first, then reveal the canvas over the SVG
    t0 = performance.now();
    draw(start, t0);
    root.classList.add('is-active');

    if (reduce.matches) return;

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          visible = entry.isIntersecting;
          if (visible && !document.hidden) play();
          else pause();
        }
      },
      { rootMargin: '120px' }
    );
    io.observe(root);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pause();
      else if (visible) play();
    });
  };

  document.querySelectorAll<HTMLElement>('.globe').forEach(boot);
</script>

<style>
  .globe {
    position: relative;
    display: block;
    aspect-ratio: 1;
    inline-size: 100%;
  }
  .globe__svg,
  .globe__canvas {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    display: block;
  }
  .globe__svg {
    transition: opacity 420ms ease;
  }
  .globe__canvas {
    opacity: 0;
    transition: opacity 420ms ease;
  }
  /* the canvas only fades in once it has painted */
  .globe.is-active .globe__svg {
    opacity: 0;
  }
  .globe.is-active .globe__canvas {
    opacity: 1;
  }

  /* the lanes travel on the fallback too */
  .globe__route {
    animation: gl-travel 9s linear infinite;
  }
  .globe__route:nth-child(2) {
    animation-duration: 12s;
    animation-direction: reverse;
  }
  .globe__route:nth-child(3) {
    animation-duration: 15s;
  }
  .globe__route:nth-child(4) {
    animation-duration: 18s;
    animation-direction: reverse;
  }
  @keyframes gl-travel {
    to {
      stroke-dashoffset: -190;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .globe__route {
      animation: none;
    }
  }
</style>
