# Canonical production origin, no trailing slash. Used for canonicals, sitemap, Open Graph.
SITE_URL=https://okiyan.com

# Only "production" allows search engines to index the site.
# Anything else (staging, development, unset) emits noindex + a blocking robots.txt.
SITE_ENV=development

# Endpoint that accepts the consultation form as a multipart POST (FormData,
# including the packing-list file). Leave empty and the form tells visitors that
# online sending is unavailable and shows the phone numbers instead.
PUBLIC_FORM_ENDPOINT=
